#: services.py (control.hub.move)
msgid "No hub has this id."
msgstr "Ningún hub tiene este id."

msgid "Only a ready hub with a database of its own moves."
msgstr "Solo se mueve un hub listo con base de datos propia."

msgid "This hub is already moving."
msgstr "Este hub ya se está moviendo."

msgid "This hub is on that cluster already."
msgstr "Este hub ya está en ese clúster."

msgid "That cluster is closed to new hubs."
msgstr "Ese clúster está cerrado a hubs nuevos."

msgid "That cluster has no room for another hub."
msgstr "Ese clúster no tiene sitio para otro hub."

msgid "The database of this hub is not on its server: there is nothing to move."
msgstr "La base de datos de este hub no está en su servidor: no hay nada que mover."

msgid ""
"This hub's database is too large to move with a copy: it needs logical "
"replication."
msgstr ""
"La base de datos de este hub es demasiado grande para moverla con una copia: "
"necesita replicación lógica."

#: admin.py and templates/admin/control/hub/move_to_cluster.html
msgid "Move to cluster…"
msgstr "Mover a otro clúster…"

msgid "Move to cluster"
msgstr "Mover a otro clúster"

msgid "%(count)d hub will move to %(cluster)s: closed for a few minutes while it moves."
msgid_plural ""
"%(count)d hubs will move to %(cluster)s: each closed for a few minutes while "
"it moves."
msgstr[0] "%(count)d hub se moverá a %(cluster)s: cerrado unos minutos mientras se mueve."
msgstr[1] ""
"%(count)d hubs se moverán a %(cluster)s: cada uno cerrado unos minutos "
"mientras se mueve."
msgstr[2] ""
"%(count)d hubs se moverán a %(cluster)s: cada uno cerrado unos minutos "
"mientras se mueve."

msgid ""
"Each hub chosen closes for a few minutes while its database is copied to the "
"cluster you choose, and opens again there. A database too large for a copy is "
"refused."
msgstr ""
"Cada hub elegido se cierra unos minutos mientras su base de datos se copia al "
"clúster que elijas, y vuelve a abrirse allí. Una base de datos demasiado grande "
"para una copia se rechaza."

msgid "Move them"
msgstr "Moverlos"

#: round 3 of the move (review): its cancel, the demos and what an undone move leaves
msgid "A demo does not move: it ends on its own."
msgstr "Una demo no se mueve: termina sola."

msgid "This hub is not moving."
msgstr "Este hub no se está moviendo."

msgid "Cancel the move"
msgstr "Cancelar el traslado"

msgid "%(count)d move will be undone: the hub goes back to its cluster within a minute."
msgid_plural ""
"%(count)d moves will be undone: each hub goes back to its cluster within a "
"minute."
msgstr[0] "Se deshará %(count)d traslado: el hub vuelve a su clúster en menos de un minuto."
msgstr[1] ""
"Se desharán %(count)d traslados: cada hub vuelve a su clúster en menos de un "
"minuto."
msgstr[2] ""
"Se desharán %(count)d traslados: cada hub vuelve a su clúster en menos de un "
"minuto."

