#, python-format
msgid "There are several with “%(name)s”: %(matches)s. Say which one."
msgstr "Hay varios con «%(name)s»: %(matches)s. Elige uno."

msgid "An open day needs at least one opening interval."
msgstr "Un día abierto necesita al menos un tramo horario."

msgid "An interval cannot open and close at the same time; 00:00–00:00 is open 24 hours."
msgstr "Un tramo no puede empezar y acabar a la misma hora; 00:00–00:00 es abierto 24 horas."

msgid "Two intervals overlap (or one runs past midnight into another); adjust the times so they do not clash."
msgstr "Dos tramos se solapan (o uno cruza la medianoche sobre otro); ajusta las horas para que no se pisen."

msgid "At most 12 intervals a day."
msgstr "Como mucho 12 tramos por día."

msgid "The end date cannot be before the start date."
msgstr "La fecha de fin no puede ser anterior a la de inicio."

msgid "At most 366 days at once."
msgstr "Como mucho 366 días de una vez."

msgid "Say which special day: its id, its name or its date."
msgstr "Di qué día especial: su id, su nombre o su fecha."

msgid "Say which temporary change: its id, its reason or a date it covers."
msgstr "Di qué cambio temporal: su id, su motivo o una fecha que cubra."

msgid "That date and time are not valid."
msgstr "Esa fecha y hora no son válidas."

msgid "Choose a date between 1900 and 2200."
msgstr "Elige una fecha entre 1900 y 2200."

msgid "There is already a special day on that date."
msgstr "Ya existe un día especial en esa fecha."

#, python-format
msgid "Those dates overlap the temporary change “%(reason)s” (%(start)s – %(end)s)."
msgstr "Esas fechas se solapan con el cambio temporal «%(reason)s» (%(start)s – %(end)s)."

msgid "There are no weekly opening hours to confirm."
msgstr "No hay horario semanal que confirmar."

