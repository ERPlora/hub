#, python-format
msgid "%(value)s is not a note or coin of %(currency)s."
msgstr "%(value)s no es un billete ni una moneda de %(currency)s."

#, python-format
msgid "There is no table of notes and coins for %(currency)s: count the drawer and give its total."
msgstr "No hay tabla de billetes y monedas para %(currency)s: cuenta el cajón y escribe el total."

msgid "Say which session: its id or its number."
msgstr "Di qué sesión: su id o su número."

msgid "Say which drawer: its id or its name."
msgstr "Di qué cajón: su id o su nombre."

msgid "Say what changes: the drawer's new name, or whether it is active."
msgstr "Di qué cambia: el nombre nuevo del cajón, o si está activo."

msgid "Ask for the lines of one session (its id or number) or for the unassigned ones, one of the two."
msgstr "Pide las líneas de una sesión (su id o su número) o las que no cayeron en ninguna, una de las dos."

msgid "Count the drawer: give its notes and coins or its total."
msgstr "Cuenta el cajón: indica los billetes y monedas o el total."

msgid "There is already an open cash session. Close it before opening another one."
msgstr "Ya hay una sesión de caja abierta. Ciérrala antes de abrir otra."

msgid "That cash session is closed: a closed session takes no new movements."
msgstr "Esa caja está cerrada: una caja cerrada no acepta movimientos nuevos."

msgid "This business requires an opening float: give the cash the drawer starts with."
msgstr "Este negocio exige fondo de apertura: indica el efectivo con el que empieza la caja."

msgid "Give the counted cash to close the session."
msgstr "Escribe el efectivo contado para cerrar la sesión."

msgid "This cash-out would leave the drawer below zero and a negative balance is not allowed."
msgstr "Esta salida dejaría la caja en negativo y el saldo negativo no está permitido."

msgid "There is already a drawer with that name."
msgstr "Ya hay un cajón con ese nombre."

#, python-format
msgid "Session %(number)s was due to close by itself at %(time)s: open a new session (this one closes then)."
msgstr "La sesión %(number)s debía cerrarse sola a las %(time)s: abre una sesión nueva (esta se cierra entonces)."

msgid "With the blind count on, the report of an open session is printed by whoever may see the expected cash."
msgstr "Con el arqueo ciego, el informe de una sesión abierta lo imprime quien puede ver el efectivo esperado."

