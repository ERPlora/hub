#, python-format
msgid "Several people match “%(name)s”: %(matches)s. Say which one."
msgstr "Hay varias personas que coinciden con «%(name)s»: %(matches)s. Di cuál."

msgid "That working day does not exist in this business."
msgstr "Esa jornada no existe en este negocio."

msgid "You can only see your own working days."
msgstr "Solo puedes ver tus propias jornadas."

msgid "Day closed when the person was terminated in Staff."
msgstr "Jornada cerrada al dar de baja a la persona en Personal."

msgid "Your user is not linked to any staff record: ask a manager to link it in Staff."
msgstr "Tu usuario no está vinculado a ninguna ficha de Personal: pide a un responsable que la vincule en Personal."

msgid "You can only clock yourself in and out."
msgstr "Solo puedes fichar tu propia entrada y salida."

msgid "That staff record is not active (inactive or on leave), so it cannot clock in."
msgstr "Esa ficha de Personal no está activa (inactiva o de baja temporal): no puede fichar la entrada."

msgid "You already have an open working day: clock out before clocking in again."
msgstr "Ya tienes una jornada abierta: ficha la salida antes de volver a entrar."

#, python-format
msgid "%(name)s already has an open working day: clock them out before clocking in again."
msgstr "%(name)s ya tiene una jornada abierta: ficha su salida antes de volver a ficharle la entrada."

msgid "There is no open working day: clock in first."
msgstr "No hay ninguna jornada abierta: ficha la entrada primero."

msgid "A break is already running."
msgstr "Ya hay una pausa en curso."

msgid "There is no running break to end."
msgstr "No hay ninguna pausa en curso que terminar."

msgid "Your location is needed to clock in from this device. Allow it, or clock in at the counter."
msgstr "Hace falta tu ubicación para fichar desde este dispositivo. Permítela o ficha en el mostrador."

msgid "The workplace location is not set yet, so this device cannot clock in. Ask a manager to set it in the time clock settings, or clock in at the counter."
msgstr "Aún no se ha fijado la ubicación del lugar de trabajo, así que este dispositivo no puede fichar. Pide a un responsable que la fije en los ajustes del control horario o ficha en el mostrador."

#, python-format
msgid "You are %(distance)s m from the workplace, outside the allowed %(radius)s m. Move closer to clock in, or clock in at the counter."
msgstr "Estás a %(distance)s m del lugar de trabajo, fuera de los %(radius)s m permitidos. Acércate para fichar o ficha en el mostrador."

msgid "These hours overlap another working day of this person."
msgstr "Estas horas se solapan con otra jornada de esta persona."

msgid "That person already has another open working day: this one cannot be reopened."
msgstr "Esa persona ya tiene otra jornada abierta: no se puede reabrir esta."

msgid "The time cannot be in the future."
msgstr "La hora no puede ser futura."

msgid "made by the system"
msgstr "hecha por el sistema"

msgid "corrected by (name)"
msgstr "corregida por (nombre)"

#, python-format
msgid "This working day has been open more than %(hours)s hours and is waiting for review: a manager corrects it. Clock in to start a new day."
msgstr "Esta jornada lleva abierta más de %(hours)s horas y está por revisar: la corrige un responsable. Ficha la entrada para empezar una jornada nueva."
