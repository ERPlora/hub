{
  "apps": {
    "en": { "customer": "Customers" },
    "es": { "customer": "Clientes" }
  },
  "triggers": [
    { "language": "en", "trigger": { "kind": "event", "event": "sale.sale.completed" }, "said": "When a sale is charged" },
    { "language": "es", "trigger": { "kind": "event", "event": "cash_register.session.closed" }, "said": "Cuando se cierra una caja" },
    { "language": "en", "trigger": { "kind": "event", "event": "customer.badge.deleted" }, "said": "When Customers: badge deleted" },
    { "language": "es", "trigger": { "kind": "event", "event": "customer.badge.deleted" }, "said": "Cuando Clientes: badge borrado" },
    { "language": "en", "trigger": { "kind": "event", "event": "spa.sauna.overheated" }, "said": "When Sauna overheated" },
    { "language": "en", "trigger": { "kind": "event", "event": "" }, "said": "Choose what has to happen for it to start" },
    { "language": "en", "trigger": { "kind": "manual" }, "said": "Only when you press Run" },
    { "language": "en", "trigger": { "kind": "schedule", "every": "day", "time": "09:00" }, "said": "Every day at 9:00 AM" },
    { "language": "es", "trigger": { "kind": "schedule", "every": "day", "time": "10:00" }, "said": "Todos los días a las 10:00" },
    { "language": "es", "trigger": { "kind": "schedule", "every": "day", "time": "09:00" }, "said": "Todos los días a las 9:00" },
    { "language": "en", "trigger": { "kind": "schedule", "every": "week", "weekday": 4, "time": "18:00" }, "said": "Every Friday at 6:00 PM" },
    { "language": "es", "trigger": { "kind": "schedule", "every": "week", "weekday": 4, "time": "18:00" }, "said": "Todos los viernes a las 18:00" },
    { "language": "en", "trigger": { "kind": "schedule", "every": "week", "time": "18:00" }, "said": "Every Monday at 6:00 PM" },
    { "language": "en", "trigger": { "kind": "schedule", "every": "month", "day": 1, "time": "08:30" }, "said": "Every month on day 1 at 8:30 AM" },
    { "language": "en", "trigger": { "kind": "schedule", "every": "month", "time": "08:30" }, "said": "Every month on day 1 at 8:30 AM" },
    { "language": "en", "trigger": { "kind": "at" }, "said": "Once, on a date you choose" }
  ],
  "steps": [
    { "language": "en", "step": { "id": "s1", "kind": "command", "operation": "task.task.create", "params": {} }, "said": "Create a task" },
    { "language": "es", "step": { "id": "s1", "kind": "command", "operation": "task.task.create", "params": {} }, "said": "Crear una tarea" },
    { "language": "en", "step": { "id": "s1", "kind": "command", "operation": "", "params": {} }, "said": "Choose what this step does" },
    { "language": "en", "step": { "id": "s1", "kind": "query", "operation": "customer.customer.detail", "params": {} }, "said": "Look up: Read a customer" },
    { "language": "en", "step": { "id": "s1", "kind": "command", "operation": "spa.sauna.heat", "params": {} }, "said": "heat (sauna)" },
    { "language": "en", "step": { "id": "s2", "kind": "condition", "when": { "input.total": { "gte": 10000 } } }, "said": "Total greater than or equal to 10000" },
    { "language": "en", "step": { "id": "s2", "kind": "condition", "when": { "input.total": { "gte": 10000.0 } } }, "said": "Total greater than or equal to 10000" },
    { "language": "en", "step": { "id": "s2", "kind": "condition", "when": { "input.total": { "gte": 12.5, "lt": 20 } } }, "said": "Total greater than or equal to 12.5; Total less than 20" },
    { "language": "en", "step": { "id": "s2", "kind": "condition", "when": { "input.customer_id": { "exists": true } } }, "said": "Customer present: yes" },
    { "language": "es", "step": { "id": "s2", "kind": "condition", "when": { "input.customer_id": { "exists": false } } }, "said": "Cliente está presente: no" },
    { "language": "en", "step": { "id": "s2", "kind": "condition", "when": { "input.party_size": { "in": [6, 8] } } }, "said": "Party size one of 6, 8" },
    { "language": "en", "step": { "id": "s2", "kind": "condition", "when": { "input.total": { "eq": "input.customer_id" } } }, "said": "Total equal to Customer" },
    { "language": "en", "step": { "id": "s2", "kind": "condition", "when": { "input.note": { "eq": null } } }, "said": "Note equal to —" },
    { "language": "en", "step": { "id": "s2", "kind": "condition", "when": {} }, "said": "nothing yet" },
    { "language": "en", "step": { "id": "s3", "kind": "delay", "seconds": 60 }, "said": "Wait 1 minute" },
    { "language": "es", "step": { "id": "s3", "kind": "delay", "seconds": 60 }, "said": "Esperar 1 minuto" },
    { "language": "en", "step": { "id": "s3", "kind": "delay", "seconds": 90 }, "said": "Wait 2 minutes" },
    { "language": "en", "step": { "id": "s3", "kind": "delay", "seconds": 150 }, "said": "Wait 3 minutes" },
    { "language": "en", "step": { "id": "s3", "kind": "delay", "seconds": 5400 }, "said": "Wait 90 minutes" },
    { "language": "en", "step": { "id": "s3", "kind": "delay", "seconds": 7200 }, "said": "Wait 2 hours" },
    { "language": "es", "step": { "id": "s3", "kind": "delay", "seconds": 3600 }, "said": "Esperar 1 hora" },
    { "language": "en", "step": { "id": "s3", "kind": "delay", "seconds": 86400 }, "said": "Wait 1 day" },
    { "language": "en", "step": { "id": "s4", "kind": "http", "url": "https://api.example.com/orders/{{input.id}}" }, "said": "Call api.example.com" },
    { "language": "en", "step": { "id": "s4", "kind": "http", "url": "https://api.example.com:8443/orders" }, "said": "Call api.example.com:8443" },
    { "language": "en", "step": { "id": "s4", "kind": "http", "url": "https://{{input.host}}/orders" }, "said": "Call another system" },
    { "language": "en", "step": { "id": "s4", "kind": "http", "url": "http://api.example.com" }, "said": "Call another system" },
    { "language": "en", "step": { "id": "s5", "kind": "ask", "title": "Approve {{input.total}}?" }, "said": "Ask: Approve “Total”?" },
    {
      "language": "en",
      "step": { "id": "s5", "kind": "ask", "title": "Close {{ steps.s1.number }} with {{secret.API_KEY}}?" },
      "steps": [{ "id": "s1", "kind": "command", "operation": "task.task.create", "params": {} }],
      "said": "Ask: Close “1. Create a task › Number” with “Secret “API_KEY””?"
    },
    { "language": "en", "step": { "id": "s5", "kind": "ask", "title": "Close {{steps.s9.id}}?" }, "said": "Ask: Close “steps.s9.id”?" },
    { "language": "en", "step": { "id": "s5", "kind": "ask", "title": "" }, "said": "Ask someone first" },
    { "language": "en", "step": { "id": "s6", "kind": "assistant", "prompt": "input.customer_name" }, "said": "Ask the assistant: “Customer name”" },
    { "language": "es", "step": { "id": "s6", "kind": "assistant", "prompt": "Resume {{input.customer.name}}" }, "said": "Pedírselo al asistente: Resume «Cliente › Nombre»" },
    { "language": "en", "step": { "id": "s6", "kind": "assistant", "prompt": "" }, "said": "Ask the assistant" }
  ]
}
