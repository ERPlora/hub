msgid "That cart does not exist in this business."
msgstr "Ese carrito no existe en este negocio."

#, python-format
msgid "“%(said)s” matches several carts: %(codes)s. Say which one."
msgstr "«%(said)s» encaja con varios carritos: %(codes)s. Di cuál."

msgid "That cart line does not exist in this business."
msgstr "Esa línea de carrito no existe en este negocio."

msgid "That order does not exist in this business."
msgstr "Ese pedido no existe en este negocio."

msgid "Enter a valid email."
msgstr "Introduce un email válido."

msgid "That is not a currency code (ISO 4217, such as EUR)."
msgstr "Eso no es un código de moneda (ISO 4217, como EUR)."

msgid "The expiry must be in the future."
msgstr "La caducidad tiene que ser futura."

msgid "The quantity must be greater than 0."
msgstr "La cantidad tiene que ser mayor que 0."

msgid "Say why the order failed: the reason stays on the order."
msgstr "Di por qué falló el pedido: el motivo queda en el pedido."

msgid "Say which cart: its id, its session code, or its customer's email or name."
msgstr "Di qué carrito: su id, su código de sesión, o el email o el nombre de su cliente."

msgid "Say which order: its id, or its number."
msgstr "Di qué pedido: su id o su número."

msgid "There is already a cart with that session."
msgstr "Ya hay un carrito con esa sesión."

#, python-format
msgid "This cart no longer takes changes: it is %(status)s."
msgstr "Este carrito ya no admite cambios: está %(status)s."

msgid "This cart has no lines: add a product before starting the order."
msgstr "Este carrito no tiene líneas: añade un producto antes de iniciar el pedido."

msgid "Say the customer's email: the cart has none."
msgstr "Di el email del cliente: el carrito no tiene."

#, python-format
msgid "Only an initiated order can be marked as paid; this one is %(status)s."
msgstr "Solo un pedido iniciado se puede marcar como pagado; este está %(status)s."

#, python-format
msgid "Only an initiated or paid order can fail; this one is %(status)s."
msgstr "Solo un pedido iniciado o pagado puede fallar; este está %(status)s."

#, python-format
msgid "Only a paid order can be completed; this one is %(status)s."
msgstr "Solo se completa un pedido pagado; este está %(status)s."

msgid "The total of this line (quantity × price) is above what a cart can hold."
msgstr "El total de esta línea (cantidad × precio) supera lo que cabe en un carrito."

msgid "The cart's total would be above what a cart can hold."
msgstr "El total del carrito superaría lo que cabe en un carrito."

