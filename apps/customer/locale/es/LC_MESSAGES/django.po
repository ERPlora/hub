msgid "This customer is no longer available."
msgstr "Este cliente ya no está disponible."

#, python-format
msgid "No customer matches “%(reference)s”."
msgstr "Ningún cliente coincide con «%(reference)s»."

#, python-format
msgid "Several customers match “%(reference)s”: give their id, phone or email."
msgstr "Varios clientes coinciden con «%(reference)s»: indica su id, teléfono o email."

msgid "That group no longer exists."
msgstr "Ese grupo ya no existe."

msgid "That tag no longer exists."
msgstr "Esa etiqueta ya no existe."

msgid "That field no longer exists."
msgstr "Ese campo ya no existe."

#, python-format
msgid "Several match “%(reference)s”: give the id."
msgstr "Varios coinciden con «%(reference)s»: indica el id."

msgid "Enter a valid email."
msgstr "Escribe un email válido."

msgid "Choose a country from the list."
msgstr "Elige un país de la lista."

msgid "Give the customer's id, or their name, phone or email."
msgstr "Indica el id del cliente, o su nombre, teléfono o email."

msgid "Give the duplicate's id, or its name, phone or email."
msgstr "Indica el id de la ficha duplicada, o su nombre, teléfono o email."

msgid "Give the group's id or its name."
msgstr "Indica el id del grupo o su nombre."

msgid "Give the tag's id or its name."
msgstr "Indica el id de la etiqueta o su nombre."

msgid "Give the field's id or its name."
msgstr "Indica el id del campo o su nombre."

msgid "Add at least one option."
msgstr "Añade al menos una opción."

msgid "That kind is the customer app's own: use another one."
msgstr "Ese tipo es de la app de clientes: usa otro."

msgid "This is not a valid phone number of its country: check the digits or write it with its international prefix (+44…)."
msgstr "No es un teléfono válido de su país: revisa las cifras o escríbelo con su prefijo internacional (+44…)."

msgid "This field is required."
msgstr "Este campo es obligatorio."

msgid "Enter a number."
msgstr "Escribe un número."

msgid "Enter a valid date."
msgstr "Escribe una fecha válida."

msgid "Choose yes or no."
msgstr "Elige sí o no."

msgid "Choose one of the options."
msgstr "Elige una de las opciones."

msgid "This field already has values on some cards: its type cannot change."
msgstr "Este campo ya tiene valores en algunas fichas: su tipo no se puede cambiar."

msgid "There is already a group with that name. Choose another name."
msgstr "Ya hay un grupo con ese nombre. Elige otro nombre."

msgid "There is already a tag with that name. Choose another name."
msgstr "Ya hay una etiqueta con ese nombre. Elige otro nombre."

msgid "There is already a field with that name. Choose another name."
msgstr "Ya hay un campo con ese nombre. Elige otro nombre."

msgid "Pick another card: a card cannot be merged into itself."
msgstr "Elige otra ficha: no se puede fusionar una ficha consigo misma."

msgid "This date is in the future."
msgstr "Esta fecha está en el futuro."

msgid "Country not recognised: imported without country, check it on the card."
msgstr "País no reconocido: importado sin país, revísalo en la ficha."

msgid "There is already a card with this name, phone and email: it is not created again."
msgstr "Ya hay una ficha con este nombre, teléfono y email: no se vuelve a crear."

msgid "Enter the date of the test."
msgstr "Pon la fecha de la prueba."

msgid "Health data updated"
