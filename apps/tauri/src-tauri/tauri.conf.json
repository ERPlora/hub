{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ERPlora",
  "version": "0.0.0",
  "identifier": "com.erplora.hub",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm -F @erplora/web dev",
    "beforeBuildCommand": "pnpm -F @erplora/web build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ERPlora",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
