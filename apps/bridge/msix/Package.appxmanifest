<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifest MSIX del BRIDGE para Microsoft Store (2ª ficha, hub#120 · ADR-0136).

  Tokens __MSIX_*__ = scripts/pack-msix.ps1 -Flavor bridge, con la identidad REAL de la ficha
  «ERPlora Bridge» de Partner Center (Identity Name PROPIO; Publisher = el MISMO CN que la app,
  misma cuenta). Se sube SIN FIRMAR: la Store re-firma tras certificación.

  El bridge es un binario de consola (Axum 127.0.0.1:12321, red-only §2.7): la consola con el
  pairing code es la superficie visible del first-run (Policy 10.1; precedente de apps
  background en Store: TranslucentTB). startupTask = auto-arranque, visible y desactivable por
  el usuario en el Administrador de tareas.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity
    Name="__MSIX_IDENTITY_NAME__"
    Publisher="__MSIX_PUBLISHER__"
    Version="__MSIX_VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>ERPlora Bridge</DisplayName>
    <PublisherDisplayName>__MSIX_PUBLISHER_DISPLAY__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="es-es" />
  </Resources>

  <Applications>
    <Application Id="ERPloraBridge" Executable="erplora-bridge.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="ERPlora Bridge"
        Description="Local hardware agent — connects ERPlora to network receipt printers and cash drawers"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="transparent" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="erplora-bridge.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="ERPloraBridge" Enabled="true" DisplayName="ERPlora Bridge" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- internetClient: clave pública JWT del SaaS (auth::jwt_verifier_from_saas).
         privateNetworkClientServer: ESC/POS TCP:9100 en LAN + servidor loopback :12321. -->
    <Capability Name="internetClient" />
    <Capability Name="privateNetworkClientServer" />
  </Capabilities>
</Package>
