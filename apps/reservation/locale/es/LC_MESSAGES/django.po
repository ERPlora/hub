msgid "That reservation does not exist in this business."
msgstr "Esa reserva no existe en este negocio."

#, python-format
msgid "“%(said)s” has several reservations: %(matches)s. Say which day."
msgstr "«%(said)s» tiene varias reservas: %(matches)s. Di qué día."

msgid "That waitlist entry does not exist in this business."
msgstr "Esa entrada de la lista de espera no existe en este negocio."

#, python-format
msgid "“%(said)s” is on the waitlist several times: %(matches)s. Say which day."
msgstr "«%(said)s» está varias veces en la lista de espera: %(matches)s. Di qué día."

msgid "Say who the reservation is for: a customer, or the guest's name."
msgstr "Di para quién es la reserva: un cliente, o el nombre de quien reserva."

msgid "Say which reservation: its id, or its guest's name or phone."
msgstr "Di qué reserva: su id, o el nombre o el teléfono del cliente."

msgid "Say which slot: its id, or its day of the week and start time."
msgstr "Di qué franja: su id, o su día de la semana y su hora de inicio."

msgid "Say which blocked date: its id, or its date."
msgstr "Di qué fecha bloqueada: su id, o su fecha."

msgid "Say which waitlist entry: its id, or its guest's name or phone."
msgstr "Di qué entrada de la lista de espera: su id, o el nombre o el teléfono del cliente."

msgid "A slot has to end after it starts."
msgstr "La franja tiene que terminar después de empezar."

msgid "Give the hours it blocks, or block the whole day."
msgstr "Pon las horas que bloquea, o bloquea el día entero."

msgid "The blocked hours have to end after they start."
msgstr "Las horas bloqueadas tienen que terminar después de empezar."

msgid "This business requires a phone number for every reservation."
msgstr "Este negocio pide un teléfono en cada reserva."

msgid "This business requires an email address for every reservation."
msgstr "Este negocio pide un correo en cada reserva."

#, python-format
msgid "That party size is outside the limits of this business (%(min)s–%(max)s guests)."
msgstr "Ese número de comensales está fuera de los límites del negocio (%(min)s–%(max)s comensales)."

msgid "That time has already passed."
msgstr "Esa hora ya ha pasado."

#, python-format
msgid "Reservations have to be made at least %(hours)s h in advance."
msgstr "Hay que reservar con al menos %(hours)s h de antelación."

#, python-format
msgid "Reservations are taken up to %(days)s days ahead."
msgstr "Solo se reserva hasta %(days)s días vista."

msgid "That date is blocked (holiday or closure): no reservations are taken then."
msgstr "Esa fecha está bloqueada (festivo o cierre): ese día no se aceptan reservas."

msgid "The business is closed at that time."
msgstr "A esa hora el negocio está cerrado."

msgid "There is no service at that time: no time slot covers it."
msgstr "No hay servicio a esa hora: ninguna franja la cubre."

msgid "That time slot is fully booked for that date."
msgstr "Esa franja ya está completa para ese día."

#, python-format
msgid "Table %(table)s cannot be booked: it is blocked or out of service."
msgstr "La mesa %(table)s no se puede reservar: está bloqueada o fuera de servicio."

#, python-format
msgid "Table %(table)s already has a reservation from %(start)s to %(end)s."
msgstr "La mesa %(table)s ya tiene una reserva de %(start)s a %(end)s."

#, python-format
msgid "This reservation is %(status)s: its status can no longer change."
msgstr "Esta reserva está %(status)s: su estado ya no puede cambiar."

#, python-format
msgid "This reservation is %(status)s: it cannot be completed before it is seated."
msgstr "Esta reserva está %(status)s: no se puede completar sin sentarla antes."

#, python-format
msgid "This reservation is %(status)s: it cannot be %(target)s."
msgstr "Esta reserva está %(status)s: no se puede %(target)s."

