#: models.py:572
msgid "Fingerprint chain intact: %(total)s record(s) with their SHA-256 chaining verified (%(issuer_nif)s). Amounts are not re-audited."
msgstr "Cadena de huellas íntegra: %(total)s registro(s) con su encadenado SHA-256 verificado (%(issuer_nif)s). No se re-auditan los importes."

#: models.py:576
msgid "Fingerprint chain BROKEN at sequence %(first_invalid_sequence)s (%(issuer_nif)s)."
msgstr "Cadena de huellas ROTA en la secuencia %(first_invalid_sequence)s (%(issuer_nif)s)."

#: models.py:578
msgid "AEAT query: %(count)s record(s) retrieved for %(issuer_nif)s."
msgstr "Consulta a la AEAT: %(count)s registro(s) recuperados para %(issuer_nif)s."

#: models.py:580
msgid "Chain recovered from the AEAT for %(issuer_nif)s: it continues after invoice %(invoice_number)s (%(found)s record(s) found)."
msgstr "Cadena recuperada desde la AEAT para %(issuer_nif)s: continúa tras la factura %(invoice_number)s (%(found)s registro(s) encontrados)."

#: models.py:584
msgid "Chain continued manually for %(issuer_nif)s after invoice %(invoice_number)s."
msgstr "Cadena continuada manualmente para %(issuer_nif)s tras la factura %(invoice_number)s."

