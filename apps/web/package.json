{
  "name": "@erplora/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Shell web del Hub: Vite + Vue 3 + @ionic/vue + TypeScript + Tailwind v4. Base Ionic; OutfitKit (Lit) aporta los Web Components que Ionic no tiene o compuestos complejos. Carga módulos (WC Lit) en runtime.",
  "scripts": {
    "sync-modules": "node sync-modules.mjs",
    "predev": "node sync-modules.mjs",
    "dev": "vite",
    "prebuild": "node sync-modules.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "test:e2e": "playwright test -c tests/playwright.config.ts",
    "verify": "pnpm run typecheck && pnpm run format:check && pnpm run test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@erplora/module-sdk": "workspace:*",
    "@erplora/module-types": "workspace:*",
    "@erplora/outfitkit": "^0.1.106",
    "@iconify/vue": "^5.0.1",
    "@ionic/core": "^8.8.8",
    "@ionic/vue": "^8.8.8",
    "@ionic/vue-router": "^8.8.8",
    "ionicons": "^8.0.13",
    "mammoth": "^1.12",
    "pdfjs-dist": "^5",
    "read-excel-file": "^5",
    "swagger-ui-dist": "^5.17.14",
    "vue": "^3.5.13",
    "vue-i18n": "^11",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@iconify-json/ion": "^1.2.7",
    "@iconify/utils": "^3.1.3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.10.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.0"
  }
}
