{
  "name": "@erplora/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Shell web del Hub: Vite + Vue 3 + @ionic/vue + TypeScript + Tailwind v4. Base Ionic; OutfitKit (Lit) aporta los Web Components que Ionic no tiene o compuestos complejos. Carga módulos (WC Lit) en runtime.",
  "scripts": {
    "sync-modules": "node sync-modules.mjs",
    "predev": "node sync-modules.mjs",
    "dev": "vite",
    "prebuild": "node sync-modules.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@erplora/module-sdk": "workspace:*",
    "@erplora/module-types": "workspace:*",
    "@erplora/outfitkit": "^0.1.4",
    "@ionic/core": "^8.8.8",
    "@ionic/vue": "^8.8.8",
    "@ionic/vue-router": "^8.8.8",
    "ionicons": "^8.0.13",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  }
}
