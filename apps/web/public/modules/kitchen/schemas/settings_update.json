{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kitchen.settings.update",
  "description": "Configuración de cocina (singleton por hub): display (KDS) + comportamiento de comandas (fusión ADR-0014). La UI envía el snapshot completo (upsert).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "auto_accept_orders": { "type": "boolean" },
    "show_timer": { "type": "boolean" },
    "warning_time_minutes": { "type": "integer", "minimum": 1, "maximum": 120 },
    "critical_time_minutes": { "type": "integer", "minimum": 1, "maximum": 120 },
    "items_per_page": { "type": "integer", "minimum": 4, "maximum": 50 },
    "auto_refresh_seconds": { "type": "integer", "minimum": 3, "maximum": 120 },
    "sound_enabled": { "type": "boolean" },
    "sound_on_new_order": { "type": "boolean" },
    "sound_on_rush": { "type": "boolean" },
    "auto_bump_enabled": { "type": "boolean" },
    "auto_bump_delay_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
    "color_coding_enabled": { "type": "boolean" },
    "auto_print_tickets": { "type": "boolean" },
    "use_rounds": { "type": "boolean" },
    "auto_fire_on_round": { "type": "boolean" },
    "default_order_type": {
      "type": "string",
      "enum": ["dine_in", "takeaway", "delivery"]
    }
  },
  "required": [
    "auto_accept_orders",
    "show_timer",
    "warning_time_minutes",
    "critical_time_minutes",
    "items_per_page",
    "auto_refresh_seconds",
    "sound_enabled",
    "sound_on_new_order",
    "sound_on_rush",
    "auto_bump_enabled",
    "auto_bump_delay_seconds",
    "color_coding_enabled",
    "auto_print_tickets",
    "use_rounds",
    "auto_fire_on_round",
    "default_order_type"
  ]
}
