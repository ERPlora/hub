{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "staff.settings.update",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "default_work_start": { "type": ["string", "null"], "default": "09:00", "title": "Inicio de jornada (HH:MM)" },
    "default_work_end": { "type": ["string", "null"], "default": "18:00", "title": "Fin de jornada (HH:MM)" },
    "default_break_duration": { "type": ["integer", "null"], "minimum": 0, "maximum": 480, "default": 60, "title": "Duración del descanso (minutos)" },
    "min_advance_booking": { "type": ["integer", "null"], "minimum": 0, "maximum": 168, "default": 1, "title": "Antelación mínima de reserva (horas)" },
    "max_daily_hours": { "type": ["integer", "null"], "minimum": 1, "maximum": 24, "default": 12, "title": "Horas máximas por día" },
    "overtime_threshold": { "type": ["integer", "null"], "minimum": 1, "maximum": 168, "default": 40, "title": "Umbral de horas extra (horas/semana)" },
    "show_staff_photos": { "type": ["integer", "null"], "enum": [0, 1, null], "default": 1, "title": "Mostrar fotos del personal" },
    "show_staff_bio": { "type": ["integer", "null"], "enum": [0, 1, null], "default": 1, "title": "Mostrar biografía del personal" },
    "allow_staff_selection": { "type": ["integer", "null"], "enum": [0, 1, null], "default": 1, "title": "Permitir elegir profesional" },
    "notify_new_appointment": { "type": ["integer", "null"], "enum": [0, 1, null], "default": 1, "title": "Avisar de nueva cita" },
    "notify_cancellation": { "type": ["integer", "null"], "enum": [0, 1, null], "default": 1, "title": "Avisar de cancelación" }
  }
}
