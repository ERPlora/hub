{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "services.settings.update",
  "description": "Configuración del módulo services (singleton por hub). La UI envía el snapshot completo (upsert).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "default_duration": { "type": "integer", "title": "Duración por defecto (min)", "minimum": 0, "default": 60 },
    "default_buffer_time": { "type": "integer", "title": "Tiempo de margen por defecto (min)", "minimum": 0, "default": 0 },
    "default_tax_category_key": { "type": "string", "title": "Tipo de IVA por defecto", "default": "" },
    "show_prices": { "type": "boolean", "title": "Mostrar precios", "default": true },
    "show_duration": { "type": "boolean", "title": "Mostrar duración", "default": true },
    "allow_online_booking": { "type": "boolean", "title": "Permitir reserva online", "default": true },
    "include_tax_in_price": { "type": "boolean", "title": "Precios con IVA incluido", "default": true },
    "currency": { "type": "string", "title": "Moneda", "default": "EUR" }
  }
}
