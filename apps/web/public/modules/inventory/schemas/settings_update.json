{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inventory.settings.update",
  "description": "Upsert de los ajustes del módulo (singleton por hub). Flags como 0/1 (columnas INTEGER).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "allow_sell_without_stock": { "type": "integer", "enum": [0, 1], "default": 0, "title": "Permitir vender sin stock" },
    "low_stock_threshold": { "type": "integer", "minimum": 0, "default": 10, "title": "Umbral de stock bajo" },
    "track_stock": { "type": "integer", "enum": [0, 1], "default": 1, "title": "Controlar stock" }
  }
}
