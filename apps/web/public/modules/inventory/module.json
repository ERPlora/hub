{
  "id": "inventory",
  "name": "Inventory",
  "version": "1.0.14",
  "agent": {
    "description": "Manages stock, warehouses and products: check availability, adjust stock, receive goods, create or remove products and categories.",
    "keywords": [
      "stock",
      "inventory",
      "warehouse",
      "product",
      "category",
      "availability",
      "receive"
    ]
  },
  "depends_on": [],
  "permissions": [
    "inventory.view_product",
    "inventory.add_product",
    "inventory.change_product",
    "inventory.delete_product",
    "inventory.view_category",
    "inventory.add_category",
    "inventory.change_category",
    "inventory.delete_category",
    "inventory.export_product",
    "inventory.import_product",
    "inventory.manage_settings"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "inventory.view_product",
      "inventory.add_product",
      "inventory.change_product",
      "inventory.delete_product",
      "inventory.view_category",
      "inventory.add_category",
      "inventory.change_category",
      "inventory.delete_category",
      "inventory.export_product",
      "inventory.import_product",
      "inventory.manage_settings"
    ],
    "employee": [
      "inventory.view_product",
      "inventory.view_category"
    ]
  },
  "navigation": [
    {
      "id": "dashboard",
      "label": "Dashboard",
      "icon": "stats-chart",
      "component": "erp-inventory-dashboard"
    },
    {
      "id": "products",
      "label": "Products",
      "icon": "cube",
      "component": "erp-inventory-products"
    },
    {
      "id": "categories",
      "label": "Categories",
      "icon": "pricetags",
      "component": "erp-inventory-categories"
    },
    {
      "id": "settings",
      "label": "Settings",
      "icon": "settings",
      "component": "erp-inventory-settings"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "sync": [
    { "table": "inventory_settings", "pk": ["id"], "hub_scoped": true, "updated_at": "updated_at" },
    { "table": "inventory_category", "pk": ["id"], "hub_scoped": true, "updated_at": "updated_at" },
    { "table": "inventory_product", "pk": ["id"], "hub_scoped": true, "updated_at": "updated_at" },
    { "table": "inventory_product_variant", "pk": ["id"], "hub_scoped": true, "updated_at": "updated_at" }
  ],
  "queries": {
    "inventory.products.list": {
      "permission": "inventory.view_product",
      "sql": "queries/products_list.sql",
      "list": {
        "search": [
          "name",
          "sku"
        ],
        "sort": [
          "name",
          "sku",
          "price",
          "stock",
          "created_at"
        ],
        "default_sort": "name",
        "default_dir": "asc",
        "filters": {
          "is_active": {
            "op": "eq"
          },
          "product_type": {
            "op": "eq"
          },
          "price": {
            "op": "range"
          },
          "stock": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists inventory products with their current stock."
      }
    },
    "inventory.products.get": {
      "permission": "inventory.view_product",
      "sql": "queries/product_get.sql",
      "ai": {
        "description": "Retrieves the full detail of an inventory product by its identifier."
      }
    },
    "inventory.products.low_stock": {
      "permission": "inventory.view_product",
      "sql": "queries/low_stock.sql",
      "ai": {
        "description": "Lists products whose stock is below the configured minimum threshold."
      }
    },
    "inventory.products.stats": {
      "permission": "inventory.view_product",
      "sql": "queries/stats.sql",
      "ai": {
        "description": "Returns global inventory statistics (totals, value, active products)."
      }
    },
    "inventory.categories.list": {
      "permission": "inventory.view_category",
      "sql": "queries/categories_list.sql",
      "list": {
        "search": [
          "name",
          "slug"
        ],
        "sort": [
          "id",
          "name",
          "slug",
          "icon",
          "color",
          "product_count"
        ],
        "default_sort": "name",
        "default_dir": "asc",
        "filters": {
          "name": {
            "op": "eq"
          },
          "slug": {
            "op": "eq"
          },
          "icon": {
            "op": "eq"
          },
          "color": {
            "op": "eq"
          },
          "product_count": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists inventory product categories."
      }
    },
    "inventory.settings.get": {
      "permission": "inventory.manage_settings",
      "sql": "queries/settings_get.sql",
      "ai": {
        "description": "Returns inventory module settings (e.g. whether selling without stock is allowed)."
      }
    }
  },
  "commands": {
    "inventory.settings.update": {
      "permission": "inventory.manage_settings",
      "schema": "schemas/settings_update.json",
      "transaction": true,
      "sql": [
        "commands/settings_update.sql"
      ],
      "ai": {
        "description": "Updates inventory module settings (allow selling without stock, low-stock threshold, stock tracking)."
      }
    },
    "inventory.products.create": {
      "permission": "inventory.add_product",
      "schema": "schemas/product_create.json",
      "transaction": true,
      "sql": [
        "commands/product_create.sql"
      ],
      "emit": [
        "inventory.product.created"
      ],
      "ai": {
        "description": "Creates a new product in the inventory."
      }
    },
    "inventory.products.update": {
      "permission": "inventory.change_product",
      "schema": "schemas/product_update.json",
      "transaction": true,
      "sql": [
        "commands/product_update.sql"
      ],
      "emit": [
        "inventory.product.updated"
      ],
      "ai": {
        "description": "Updates the data of an existing inventory product."
      }
    },
    "inventory.products.delete": {
      "permission": "inventory.delete_product",
      "schema": "schemas/product_id.json",
      "transaction": true,
      "sql": [
        "commands/product_delete.sql"
      ],
      "emit": [
        "inventory.product.deleted"
      ],
      "ai": {
        "description": "Soft-deletes a product from the inventory (destructive)."
      }
    },
    "inventory.products.bulk_create": {
      "permission": "inventory.add_product",
      "schema": "schemas/products_bulk_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "bulk_create"
      },
      "ai": {
        "description": "Creates multiple products in the inventory in a single operation."
      }
    },
    "inventory.stock.adjust": {
      "permission": "inventory.change_product",
      "schema": "schemas/stock_adjust.json",
      "transaction": true,
      "sql": [
        "commands/stock_adjust.sql"
      ],
      "emit": [
        "inventory.stock_changed"
      ],
      "ai": {
        "description": "Adjusts a product's stock to an absolute value (inventory correction)."
      }
    },
    "inventory.stock.decrease": {
      "permission": "inventory.change_product",
      "schema": "schemas/stock_decrease.json",
      "transaction": true,
      "sql": [
        "commands/stock_decrease.sql"
      ],
      "emit": [
        "inventory.stock_changed"
      ],
      "ai": {
        "description": "Decreases a product's stock by a given quantity."
      }
    },
    "inventory.stock.receive": {
      "permission": "inventory.change_product",
      "schema": "schemas/stock_receive.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "receive_stock"
      },
      "ai": {
        "description": "Records goods received and increases the stock of the received products."
      }
    },
    "inventory.categories.create": {
      "permission": "inventory.add_category",
      "schema": "schemas/category_create.json",
      "transaction": true,
      "sql": [
        "commands/category_create.sql"
      ],
      "ai": {
        "description": "Creates a new product category in the inventory."
      }
    },
    "inventory.categories.update": {
      "permission": "inventory.change_category",
      "schema": "schemas/category_update.json",
      "transaction": true,
      "sql": [
        "commands/category_update.sql"
      ],
      "ai": {
        "description": "Updates the data of an existing product category."
      }
    },
    "inventory.categories.delete": {
      "permission": "inventory.delete_category",
      "schema": "schemas/category_id.json",
      "transaction": true,
      "sql": [
        "commands/category_delete.sql"
      ],
      "ai": {
        "description": "Deletes a product category from the inventory (destructive)."
      }
    },
    "inventory._insert_product": {
      "permission": "inventory.add_product",
      "sql": [
        "commands/_insert_product.sql"
      ]
    },
    "inventory._receive_line": {
      "permission": "inventory.change_product",
      "sql": [
        "commands/_receive_line.sql"
      ]
    },
    "inventory.stock.decrease_on_sale": {
      "permission": "inventory.change_product",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "decrease_on_sale"
      },
      "ai": {
        "description": "Automatically decreases stock of sold products when a sale is completed."
      }
    }
  },
  "events": {
    "listen": {
      "sale.completed": {
        "command": "inventory.stock.decrease_on_sale"
      }
    }
  },
  "ui": {
    "entry": "dist/inventory.esm.js"
  }
}
