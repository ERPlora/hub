{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "orders.settings.update",
  "description": "Configuración del módulo orders (singleton por hub). La UI envía el snapshot completo (upsert).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "auto_confirm": { "type": "boolean", "title": "Confirmar pedidos automáticamente", "default": false },
    "require_customer": { "type": "boolean", "title": "Exigir cliente en el pedido", "default": false },
    "default_channel": {
      "type": "string",
      "title": "Canal por defecto",
      "enum": ["phone", "online", "in_person", "email", "whatsapp"],
      "default": "phone"
    },
    "notify_on_new_order": { "type": "boolean", "title": "Avisar al recibir un pedido nuevo", "default": true },
    "allow_partial_fulfillment": { "type": "boolean", "title": "Permitir entrega parcial", "default": false }
  }
}
