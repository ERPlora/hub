{
  "id": "orders",
  "name": "Orders",
  "version": "1.2.14",
  "agent": {
    "description": "Manages customer orders through their full lifecycle: create, confirm, complete, cancel, and link to sales.",
    "keywords": [
      "order",
      "orders",
      "pipeline",
      "confirm",
      "cancel",
      "complete",
      "customer"
    ]
  },
  "depends_on": [
    "sales",
    "customers",
    "inventory"
  ],
  "permissions": [
    "orders.view_order",
    "orders.add_order",
    "orders.change_order",
    "orders.complete_order",
    "orders.cancel_order",
    "orders.manage_settings"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "orders.view_order",
      "orders.add_order",
      "orders.change_order",
      "orders.complete_order",
      "orders.cancel_order",
      "orders.manage_settings"
    ],
    "employee": [
      "orders.view_order",
      "orders.add_order",
      "orders.complete_order"
    ]
  },
  "navigation": [
    {
      "id": "pipeline",
      "label": "Pipeline",
      "icon": "funnel",
      "component": "erp-orders-pipeline"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql",
      "migrations/sqlite/002_counter_gate.sql"
    ]
  },
  "queries": {
    "orders.orders.list": {
      "permission": "orders.view_order",
      "sql": "queries/orders_list.sql",
      "list": {
        "search": [
          "order_number",
          "customer_name",
          "customer_phone"
        ],
        "sort": [
          "id",
          "order_number",
          "status",
          "channel",
          "customer_name",
          "customer_phone",
          "total",
          "priority",
          "sale_id",
          "created_at"
        ],
        "default_sort": "created_at",
        "default_dir": "desc",
        "filters": {
          "order_number": {
            "op": "eq"
          },
          "status": {
            "op": "eq"
          },
          "channel": {
            "op": "eq"
          },
          "customer_name": {
            "op": "like"
          },
          "customer_phone": {
            "op": "like"
          },
          "total": {
            "op": "range"
          },
          "priority": {
            "op": "eq"
          },
          "sale_id": {
            "op": "eq"
          },
          "created_at": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists orders with their status and customer information."
      }
    },
    "orders.orders.get": {
      "permission": "orders.view_order",
      "sql": "queries/order_get.sql",
      "schema": "schemas/order_get.json",
      "ai": {
        "description": "Retrieves the full details of a single order by its ID."
      }
    },
    "orders.notes.list": {
      "permission": "orders.view_order",
      "sql": "queries/notes_list.sql",
      "list": {
        "search": [
          "author_name"
        ],
        "sort": [
          "id",
          "note_type",
          "content",
          "author_name",
          "from_status",
          "to_status",
          "created_at"
        ],
        "default_sort": "created_at",
        "default_dir": "desc",
        "filters": {
          "note_type": {
            "op": "eq"
          },
          "content": {
            "op": "like"
          },
          "author_name": {
            "op": "like"
          },
          "from_status": {
            "op": "eq"
          },
          "to_status": {
            "op": "eq"
          },
          "created_at": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the internal notes and comments attached to an order."
      }
    },
    "orders.settings.get": {
      "permission": "orders.manage_settings",
      "sql": "queries/settings_get.sql",
      "ai": {
        "description": "Retrieves the current configuration of the orders module."
      }
    }
  },
  "commands": {
    "orders.create": {
      "permission": "orders.add_order",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_order"
      },
      "ai": {
        "description": "Creates a new order with its product lines."
      }
    },
    "orders.confirm": {
      "permission": "orders.change_order",
      "transaction": true,
      "sql": [
        "commands/order_set_status.sql"
      ],
      "emit": [
        "orders.order_confirmed"
      ],
      "ai": {
        "description": "Confirms a draft order, changing its status to confirmed."
      }
    },
    "orders.complete": {
      "permission": "orders.complete_order",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "complete_order"
      },
      "ai": {
        "description": "Marks an order as completed after delivery or service fulfilment."
      }
    },
    "orders.cancel": {
      "permission": "orders.cancel_order",
      "transaction": true,
      "sql": [
        "commands/order_set_status.sql"
      ],
      "emit": [
        "orders.order_cancelled"
      ],
      "ai": {
        "description": "Cancels an existing order (destructive status change) and emits the cancellation event."
      }
    },
    "orders.notes.add": {
      "permission": "orders.change_order",
      "transaction": true,
      "sql": [
        "commands/note_create.sql"
      ],
      "ai": {
        "description": "Adds an internal note or comment to an order."
      }
    },
    "orders.settings.update": {
      "permission": "orders.manage_settings",
      "transaction": true,
      "sql": [
        "commands/settings_upsert.sql"
      ],
      "ai": {
        "description": "Updates the configuration settings of the orders module."
      }
    },
    "orders._note_status_change": {
      "permission": "orders.change_order",
      "sql": [
        "commands/note_status_change.sql"
      ]
    },
    "orders.link_to_sale": {
      "permission": "orders.change_order",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "link_to_sale"
      },
      "ai": {
        "description": "Links an order to a completed sale in the sales module."
      }
    },
    "orders._bump_counter": {
      "permission": "orders.add_order",
      "sql": [
        "commands/_bump_counter.sql"
      ]
    },
    "orders._create_order": {
      "permission": "orders.add_order",
      "sql": [
        "commands/_create_order_insert.sql",
        "commands/_create_order_assert.sql",
        "commands/_create_order_note.sql",
        "commands/_gate_clear.sql"
      ]
    },
    "orders._complete": {
      "permission": "orders.complete_order",
      "sql": [
        "commands/_complete_note.sql",
        "commands/_complete_update.sql",
        "commands/_complete_assert.sql",
        "commands/_gate_clear.sql"
      ]
    },
    "orders._link_to_sale": {
      "permission": "orders.change_order",
      "sql": [
        "commands/_link_to_sale.sql"
      ]
    }
  },
  "events": {
    "listen": {
      "sale.completed": {
        "command": "orders.link_to_sale"
      }
    }
  },
  "ui": {
    "entry": "dist/orders.esm.js"
  }
}
