{
  "id": "tables",
  "name": "Tables",
  "version": "2.0.6",
  "agent": {
    "description": "Manages restaurant floor plan zones, tables, and table sessions: create/update/delete zones and tables, open/close/transfer sessions, and bulk-create tables.",
    "keywords": [
      "table",
      "zone",
      "floor plan",
      "session",
      "restaurant",
      "seating",
      "dining"
    ]
  },
  "depends_on": [],
  "permissions": [
    "tables.view_zone",
    "tables.add_zone",
    "tables.change_zone",
    "tables.delete_zone",
    "tables.view_table",
    "tables.add_table",
    "tables.change_table",
    "tables.delete_table",
    "tables.view_tablesession",
    "tables.add_tablesession",
    "tables.change_tablesession",
    "tables.delete_tablesession",
    "tables.manage_settings"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "tables.view_zone",
      "tables.add_zone",
      "tables.change_zone",
      "tables.view_table",
      "tables.add_table",
      "tables.change_table",
      "tables.view_tablesession",
      "tables.add_tablesession",
      "tables.change_tablesession"
    ],
    "employee": [
      "tables.view_zone",
      "tables.view_table",
      "tables.view_tablesession",
      "tables.add_tablesession",
      "tables.change_tablesession"
    ]
  },
  "navigation": [
    {
      "id": "floor_plan",
      "label": "Floor Plan",
      "icon": "map-outline",
      "component": "erp-tables-floor-plan"
    },
    {
      "id": "zones",
      "label": "Zones",
      "icon": "layers-outline",
      "component": "erp-tables-floor-plan"
    },
    {
      "id": "tables",
      "label": "Tables",
      "icon": "grid-outline",
      "component": "erp-tables-floor-plan"
    },
    {
      "id": "sessions",
      "label": "Sessions",
      "icon": "time-outline",
      "component": "erp-tables-floor-plan"
    },
    {
      "id": "settings",
      "label": "Settings",
      "icon": "settings-outline",
      "component": "erp-tables-floor-plan"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql",
      "migrations/sqlite/002_gate.sql"
    ]
  },
  "queries": {
    "tables.zones.list": {
      "permission": "tables.view_zone",
      "sql": "queries/zones_list.sql",
      "list": {
        "search": [
          "name"
        ],
        "sort": [
          "id",
          "name",
          "color",
          "sort_order",
          "is_active"
        ],
        "default_sort": "name",
        "default_dir": "asc",
        "filters": {
          "name": {
            "op": "eq"
          },
          "color": {
            "op": "eq"
          },
          "sort_order": {
            "op": "eq"
          },
          "is_active": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists all floor plan zones (dining room, terrace, bar, etc.)"
      }
    },
    "tables.zones.get": {
      "permission": "tables.view_zone",
      "sql": "queries/zone_get.sql",
      "schema": "schemas/zone_get.json",
      "ai": {
        "description": "Gets the details of a specific zone by its identifier"
      }
    },
    "tables.tables.list": {
      "permission": "tables.view_table",
      "sql": "queries/tables_list.sql",
      "list": {
        "search": [
          "number",
          "name"
        ],
        "sort": [
          "id",
          "number",
          "name",
          "capacity",
          "shape",
          "status",
          "is_active",
          "position_x",
          "position_y",
          "width",
          "height",
          "zone_id",
          "zone"
        ],
        "default_sort": "name",
        "default_dir": "asc",
        "filters": {
          "number": {
            "op": "eq"
          },
          "name": {
            "op": "eq"
          },
          "capacity": {
            "op": "eq"
          },
          "shape": {
            "op": "eq"
          },
          "status": {
            "op": "eq"
          },
          "is_active": {
            "op": "eq"
          },
          "position_x": {
            "op": "eq"
          },
          "position_y": {
            "op": "eq"
          },
          "width": {
            "op": "eq"
          },
          "height": {
            "op": "eq"
          },
          "zone_id": {
            "op": "eq"
          },
          "zone": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists all available tables with their current status"
      }
    },
    "tables.sessions.list": {
      "permission": "tables.view_tablesession",
      "sql": "queries/sessions_list.sql",
      "list": {
        "search": [
          "table_number"
        ],
        "sort": [
          "id",
          "table_id",
          "table_number",
          "guests_count",
          "status",
          "waiter_id",
          "opened_at",
          "closed_at",
          "notes"
        ],
        "default_sort": "id",
        "default_dir": "asc",
        "filters": {
          "table_id": {
            "op": "eq"
          },
          "table_number": {
            "op": "eq"
          },
          "guests_count": {
            "op": "range"
          },
          "status": {
            "op": "eq"
          },
          "waiter_id": {
            "op": "eq"
          },
          "opened_at": {
            "op": "range"
          },
          "closed_at": {
            "op": "range"
          },
          "notes": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists active or historical table sessions"
      }
    }
  },
  "commands": {
    "tables.zones.create": {
      "permission": "tables.add_zone",
      "transaction": true,
      "sql": [
        "commands/zone_create.sql"
      ],
      "emit": [
        "tables.zone.created"
      ],
      "ai": {
        "description": "Creates a new zone in the floor plan"
      }
    },
    "tables.zones.update": {
      "permission": "tables.change_zone",
      "transaction": true,
      "sql": [
        "commands/zone_update.sql"
      ],
      "emit": [
        "tables.zone.updated"
      ],
      "ai": {
        "description": "Updates the name or configuration of an existing zone"
      }
    },
    "tables.zones.delete": {
      "permission": "tables.delete_zone",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "delete_zone"
      },
      "emit": [
        "tables.zone.deleted"
      ],
      "ai": {
        "description": "Deletes a zone and all its associated tables (destructive)"
      }
    },
    "tables.tables.create": {
      "permission": "tables.add_table",
      "transaction": true,
      "sql": [
        "commands/table_create.sql"
      ],
      "emit": [
        "tables.table.created"
      ],
      "ai": {
        "description": "Creates a new table inside a zone"
      }
    },
    "tables.tables.update": {
      "permission": "tables.change_table",
      "transaction": true,
      "sql": [
        "commands/table_update.sql"
      ],
      "emit": [
        "tables.table.updated"
      ],
      "ai": {
        "description": "Updates a table's data (name, capacity, position)"
      }
    },
    "tables.tables.delete": {
      "permission": "tables.delete_table",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "delete_table"
      },
      "emit": [
        "tables.table.deleted"
      ],
      "ai": {
        "description": "Deletes a table from the system (destructive)"
      }
    },
    "tables.tables.bulk_create": {
      "permission": "tables.add_table",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "bulk_create_tables"
      },
      "emit": [
        "tables.table.created"
      ],
      "ai": {
        "description": "Creates multiple tables at once within a zone"
      }
    },
    "tables.sessions.open": {
      "permission": "tables.add_tablesession",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "open_session"
      },
      "emit": [
        "tables.session.opened"
      ],
      "ai": {
        "description": "Opens a session on a table to begin serving guests"
      }
    },
    "tables.sessions.close": {
      "permission": "tables.change_tablesession",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "close_session"
      },
      "emit": [
        "tables.session.closed"
      ],
      "ai": {
        "description": "Closes the active session on a table after payment"
      }
    },
    "tables.sessions.transfer": {
      "permission": "tables.change_tablesession",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "transfer_session"
      },
      "emit": [
        "tables.session.transferred"
      ],
      "ai": {
        "description": "Transfers the active session from one table to another"
      }
    },
    "tables.sessions.delete": {
      "permission": "tables.delete_tablesession",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "delete_session"
      },
      "emit": [
        "tables.session.deleted"
      ],
      "ai": {
        "description": "Deletes a table session (destructive, requires delete permission)"
      }
    },
    "tables._insert_table": {
      "permission": "tables.add_table",
      "sql": [
        "commands/_bulk_insert_table.sql",
        "commands/_bulk_insert_assert.sql",
        "commands/_gate_clear.sql"
      ]
    },
    "tables._session_open": {
      "permission": "tables.add_tablesession",
      "sql": [
        "commands/_session_open_insert.sql",
        "commands/_session_open_occupy.sql",
        "commands/_session_open_assert.sql",
        "commands/_gate_clear.sql"
      ]
    },
    "tables._session_close": {
      "permission": "tables.change_tablesession",
      "sql": [
        "commands/_session_close_update.sql",
        "commands/_session_close_free.sql",
        "commands/_session_close_assert.sql",
        "commands/_gate_clear.sql"
      ]
    },
    "tables._session_transfer": {
      "permission": "tables.change_tablesession",
      "sql": [
        "commands/_session_transfer_close.sql",
        "commands/_session_transfer_free.sql",
        "commands/_session_transfer_insert.sql",
        "commands/_session_transfer_occupy.sql",
        "commands/_session_transfer_assert.sql",
        "commands/_gate_clear.sql"
      ]
    },
    "tables._session_delete": {
      "permission": "tables.delete_tablesession",
      "sql": [
        "commands/_session_delete_update.sql",
        "commands/_session_delete_assert.sql",
        "commands/_gate_clear.sql"
      ]
    },
    "tables._zone_delete": {
      "permission": "tables.delete_zone",
      "sql": [
        "commands/_zone_delete_update.sql",
        "commands/_zone_delete_assert.sql",
        "commands/_gate_clear.sql"
      ]
    },
    "tables._table_delete": {
      "permission": "tables.delete_table",
      "sql": [
        "commands/_table_delete_update.sql",
        "commands/_table_delete_assert.sql",
        "commands/_gate_clear.sql"
      ]
    }
  },
  "ui": {
    "entry": "dist/tables.esm.js"
  }
}
