{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    // The workspace packages below are consumed as RAW TypeScript SOURCE (see `paths`: they point
    // at `src/index.ts`, not at a build output), and their own test runner is `node:test` over ESM
    // (`--experimental-transform-types`), which demands fully specified relative specifiers — hence
    // `packages/module-sdk/src/index.ts` re-exporting `from './quantity.ts'`. Without this flag TS
    // rejects that extension (TS5097) and `vue-tsc --noEmit` fails on a file this app does not own,
    // which is exactly what left the typecheck permanently red on `develop` (hub#422) and, since
    // `pnpm -F @erplora/web build` runs `vue-tsc` first, blocked the Docker image build too.
    // Legal because this project is `noEmit` — nothing here ever emits JS; Vite/esbuild resolve the
    // `.ts` specifier natively. Dropping the extension instead is NOT the fix: it takes down the
    // SDK's whole `index.test.ts` (commit c5614de).
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "preserve",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@erplora/module-types": ["../../packages/module-types/src/index.ts"],
      "@erplora/module-sdk": ["../../packages/module-sdk/src/index.ts"]
    }
  },
  // `tests/**` holds the Playwright suite (specs + playwright.config.ts). It was outside the
  // typecheck, so a spec could rot — reference a renamed selector, a removed helper, a changed
  // signature — and nothing would say so: the QA harness is code too. Adding it costs nothing
  // (measured: zero new errors) and closes the blind spot while we are here for hub#422.
  "include": ["src/**/*.ts", "src/**/*.vue", "tests/**/*.ts", "vite.config.ts", "env.d.ts"]
}
