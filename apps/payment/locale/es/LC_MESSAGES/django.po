msgid "That payment method does not exist in this business."
msgstr "Ese método de pago no existe en este negocio."

#, python-format
msgid "“%(said)s” matches several payment methods: %(names)s. Say which one."
msgstr "“%(said)s” encaja con varios métodos de pago: %(names)s. Di cuál."

msgid "That payment does not exist in this business."
msgstr "Ese pago no existe en este negocio."

msgid "The amount of a payment must be greater than 0."
msgstr "El importe de un pago tiene que ser mayor que 0."

msgid ""
"That IBAN is not valid: check the country, the check digits and the length."
msgstr ""
"Ese IBAN no es válido: revisa el país, los dígitos de control y la longitud."

msgid "That is not a currency code (ISO 4217, such as EUR)."
msgstr "Eso no es un código de moneda (ISO 4217, como EUR)."

msgid "Say which payment method: its id, or its name."
msgstr "Di qué método de pago: su id o su nombre."

msgid "Say which payment: its id, or its reference."
msgstr "Di qué pago: su id o su referencia."

msgid "Say why this payment is cancelled: the reason stays on the payment."
msgstr "Di por qué se cancela este pago: el motivo se queda en el pago."

msgid "There is already a payment method with that name. Pick another name."
msgstr "Ya hay un método de pago con ese nombre. Elige otro nombre."

msgid "That payment method is deactivated: pick an active one."
msgstr "Ese método de pago está desactivado: elige uno activo."

msgid "That payment method is already deactivated."
msgstr "Ese método de pago ya está desactivado."

msgid "That payment method is already active."
msgstr "Ese método de pago ya está activo."

#, python-format
msgid "Only a draft payment can be approved; this one is %(status)s."
msgstr "Solo se puede aprobar un pago en borrador; este está %(status)s."

#, python-format
msgid "Only an approved payment can be marked as sent; this one is %(status)s."
msgstr ""
"Solo se puede marcar como enviado un pago aprobado; este está %(status)s."

#, python-format
msgid "Only a sent payment can be marked as completed; this one is %(status)s."
msgstr ""
"Solo se puede marcar como completado un pago enviado; este está %(status)s."

msgid "This payment can no longer be cancelled."
msgstr "El pago ya no admite cancelación."

