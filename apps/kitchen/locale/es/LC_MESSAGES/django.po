#: queries.py:69
msgid "That kitchen ticket does not exist in this business."
msgstr "Esa comanda no existe en este negocio."

#: queries.py:71
#, python-format
msgid ""
"“%(said)s” matches several tickets: %(names)s. Say which one by its number."
msgstr ""
"«%(said)s» coincide con varias comandas: %(names)s. Di cuál por su número."

#: queries.py:73
msgid "That station does not exist in this business."
msgstr "Esa estación no existe en este negocio."

#: queries.py:74
#, python-format
msgid "“%(said)s” matches several stations: %(names)s. Say which one."
msgstr "«%(said)s» coincide con varias estaciones: %(names)s. Di cuál."

#: schemas.py:28
msgid "Say which ticket: its id, its number or its label."
msgstr "Di qué comanda: su id, su número o su etiqueta."

#: schemas.py:29
msgid "Say which station: its id or its name."
msgstr "Di qué estación: su id o su nombre."

#: schemas.py:30
msgid "Say one product or one category, not both."
msgstr "Di un producto o una categoría, no los dos."

#: schemas.py:31
msgid "Say which dish: a product of the catalogue or its name."
msgstr "Di qué plato: un producto del catálogo o su nombre."

#: schemas.py:32
msgid "Add at least one dish."
msgstr "Añade al menos un plato."

#: services.py:105
msgid ""
"That kitchen ticket is no longer in the state this action requires. Refresh "
"and try again."
msgstr ""
"Esa comanda ya no está en el estado que requiere esta acción. Actualiza e "
"inténtalo de nuevo."

#: services.py:107
msgid "That ticket is no longer being cooked."
msgstr "Esa comanda ya no se cocina."

#: services.py:108
msgid "That ticket is VIP: a rush does not change its priority."
msgstr "Esa comanda es VIP: marcarla urgente no cambia su prioridad."

#: services.py:110
msgid ""
"That ticket cannot be deleted: it comes from a check or it is already being "
"cooked. Cancel it instead."
msgstr ""
"Esa comanda no se puede borrar: viene de una cuenta o ya se está cocinando. "
"Cancélala."

#: services.py:112
msgid "That dish is not on this ticket."
msgstr "Ese plato no está en esta comanda."

#: services.py:114
msgid "Nothing of this ticket goes to paper: its stations are screen only."
msgstr ""
"Nada de esta comanda sale en papel: sus estaciones son solo de pantalla."

#: services.py:116
msgid "Nothing on this check is cooked: services do not go to the kitchen."
msgstr "Nada de esta cuenta se cocina: los servicios no van a cocina."

#: services.py:117
msgid "Printing is not active in this business."
msgstr "Impresión no está activa en este negocio."

#: services.py:118
#, python-format
msgid "The ticket could not be printed: %(reason)s"
msgstr "No se pudo imprimir la comanda: %(reason)s"

#: services.py:120
msgid "There is already a station with that name. Choose a different name."
msgstr "Ya hay una estación con ese nombre. Elige otro nombre."

#: services.py:123
msgid ""
"This station cannot be deleted: products or categories are routed to it, or "
"it has dishes to cook. Move them to another station first."
msgstr ""
"Esta estación no se puede eliminar: tiene productos o categorías enrutados, "
"o platos por hacer. Pásalos antes a otra estación."

#: services.py:127
msgid "That station is switched off: switch it on or choose another one."
msgstr "Esa estación está desactivada: actívala o elige otra."

#: services.py:129
msgid "That product does not exist in the catalogue."
msgstr "Ese producto no existe en el catálogo."

#: services.py:130
#, python-format
msgid "“%(said)s” matches several products: %(names)s. Say which one."
msgstr "«%(said)s» coincide con varios productos: %(names)s. Di cuál."

#: services.py:131
msgid "That category does not exist in the catalogue."
msgstr "Esa categoría no existe en el catálogo."

#: services.py:133
#, python-format
msgid "“%(said)s” matches several categories: %(names)s. Say which one."
msgstr "«%(said)s» coincide con varias categorías: %(names)s. Di cuál."

#: services.py:135
msgid "Nothing is routed from that product or category."
msgstr "Ese producto o esa categoría no van a ninguna estación."

#: services.py:136
msgid "The amber warning has to come before the red one."
msgstr "El aviso ámbar tiene que llegar antes que el rojo."

#: services.py:137
msgid "!! URGENT !!"
msgstr "!! URGENTE !!"

