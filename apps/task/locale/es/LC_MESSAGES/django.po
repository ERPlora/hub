#, python-format
msgid "There are several tasks called “%(text)s”: %(matches)s. Say which one."
msgstr "Hay varias tareas que se llaman «%(text)s»: %(matches)s. Di cuál."

#, python-format
msgid "There are several projects called “%(text)s”: %(matches)s. Say which one."
msgstr "Hay varios proyectos que se llaman «%(text)s»: %(matches)s. Di cuál."

msgid "Say which task: its id, its number or its title."
msgstr "Di qué tarea: su id, su número o su título."

msgid "Say which project: its id, its code or its name."
msgstr "Di qué proyecto: su id, su código o su nombre."

msgid "Choose one person: an id, a name or yourself."
msgstr "Elige una sola persona: un id, un nombre o tú."

msgid "Choose a date between 1900 and 2200."
msgstr "Elige una fecha entre 1900 y 2200."

msgid "A task takes at most 20 tags."
msgstr "Una tarea admite como mucho 20 etiquetas."

msgid "That task is already closed, so it was left as it was."
msgstr "Esa tarea ya está cerrada, así que se ha dejado como estaba."

msgid "That person is not active in the team."
msgstr "Esa persona no está activa en el equipo."

msgid "You have no staff record: you cannot be assigned tasks."
msgstr "No tienes ficha en Personal: no se te puede asignar."

msgid "There is already a project with that code."
msgstr "Ya hay un proyecto con ese código."

msgid "You can only change your own tasks."
msgstr "Solo puedes cambiar tus propias tareas."
