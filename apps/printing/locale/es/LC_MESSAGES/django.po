#, python-format
msgid "A full invoice needs “%(field)s”."
msgstr "Una factura completa necesita «%(field)s»."

msgid "A full invoice needs “tax_breakdown”: one {rate, base, tax} per VAT rate."
msgstr "Una factura completa necesita «tax_breakdown»: un {rate, base, tax} por cada tipo de IVA."

