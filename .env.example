# Local development of the Hub: copy to .env (never commit .env). config/settings.py reads the process environment
# first, then this checkout's .env. Production sets every value from Secrets Manager and the task definition.

# Off by default (production). On, the rest of the settings fall back to local defaults: no SECRET_KEY, SAAS_URL or
# INTERNAL_SHARED_SECRET are required.
DEBUG=True

# The root compose.yaml of erplora-next (control database `hub`).
DB_NAME=hub
DB_USER=hub
DB_PASSWORD=hub
DB_HOST=127.0.0.1
DB_PORT=5432
# Seconds a dead database is waited for, per connection attempt and for a pooled connection, so
# /readyz answers 503 before the health checks give up (psycopg alone: 30 s). Default shown.
# DB_CONNECT_TIMEOUT=5
SECRET_KEY=change-me-local-only

# Proxies in front of the Hub that append the caller's address to X-Forwarded-For: none locally (0, the default
# with DEBUG), the ALB in AWS (1, the default without it). The public website's limit counts callers by it.
# TRUSTED_PROXY_HOPS=0

# The Hub has no login of its own: without a session a page goes to {SAAS_URL}/hub-login/ and the SaaS comes back
# with a one-time code to /auth/callback; the Hub signs its redeem call with INTERNAL_SHARED_SECRET, the same value
# the SaaS has (both default to this one locally). Production: https://erplora.com.
SAAS_URL=http://localhost:8001
INTERNAL_SHARED_SECRET=local-internal-shared-secret

# Mail. Empty = the console with DEBUG; without it, SMTP from EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER and
# EMAIL_HOST_PASSWORD. Production (ECS) sets it: the SES API signed by the task role, no static keys.
SES_REGION=

# The Fernet key that seals a business's own VeriFactu certificate in its hub database (apps/verifactu/certificates.py).
# Empty = uploading a certificate is refused (verifactu.certificate_storage_unavailable). Never production's key: make
# one for this checkout with
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# `node tests/e2e/database.ts` (tests/e2e/README.md) fills it in when it is empty.
FISCAL_CERTIFICATE_KEY=
# The Fernet key that seals the secrets the automations use to call other systems (apps/flow/vault.py, FLOW-F26).
# Empty = saving or using a secret is refused (flow.secrets_key_missing). Never production's key: make one with the
# same command as above.
# `node tests/e2e/database.ts` (tests/e2e/README.md) fills it in when it is empty.
FLOW_SECRETS_KEY=

# Google's Places API (New) key with which the public website reads a business's rating and reviews on Google Maps
# (apps/website/reviews.py, server-side only: Place Details and Text Search). Empty = the reviews section asks
# nothing. Restrict the key to the Places API (New). In AWS it comes from Secrets Manager through the task definition.
GOOGLE_PLACES_API_KEY=

# The Claude API key of `manage.py translate_workbooks` only (base/management/commands/translate_workbooks.py): run by
# hand in development to write each module's WORKBOOK.en.md, never in CI nor in production, where nothing reads it.
# Without it the command stops naming it; `translate_workbooks --check` needs none. Your own key, never committed.
# ANTHROPIC_API_KEY=

# The bucket of the copies of each hub's database (base/tenancy/dumps.py: the pg_dump before «Reset the business» and
# when a business leaves). Empty = no copies: «Reset the business» answers 503 (base.dumps_unavailable). In AWS it is
# erplora-<env>-hub-dumps (aws s3_dumps.tf). For a local try against moto's S3: `uv run moto_server -p 5099`, a bucket
# made in it, HUB_DUMPS_ENDPOINT_URL=http://127.0.0.1:5099 and throwaway AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
HUB_DUMPS_BUCKET=
HUB_DUMPS_ENDPOINT_URL=
