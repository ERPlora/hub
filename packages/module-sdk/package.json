{
  "name": "@erplora/module-sdk",
  "version": "1.0.0",
  "type": "module",
  "description": "SDK frontend de módulos (Stencil WC): erplora.query/command/on con transporte intercambiable (IPC/HTTP+WS).",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ERPlora/hub.git",
    "directory": "packages/module-sdk"
  },
  "files": [
    "src",
    "!src/*.test.ts"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --experimental-transform-types --test src/*.test.ts",
    "contract:check": "node scripts/contract-check.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
