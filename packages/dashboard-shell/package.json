{
  "name": "@erplora/dashboard-shell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Chrome de dashboard React + Ionic compartida (shell del Hub y del Cloud): IonSplitPane + menú lateral + cabecera responsive. Sin lógica específica del Hub — rutas, menú, identidad, marca y acciones se inyectan por props.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/dashboard-shell.css"
  },
  "peerDependencies": {
    "@ionic/react": "^8.8.8",
    "ionicons": "^8.0.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^5.3.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-router-dom": "^5.3.3",
    "typescript": "^5.6.0"
  }
}
