#: ws_print.py:274
#, python-format
msgid "No hello within %(seconds)s seconds."
msgstr "No ha llegado el hello en %(seconds)s segundos."

#: ws_print.py:300
msgid "Say hello with a deviceId before draining."
msgstr "Envía hello con un deviceId antes de recoger trabajos."

#: ws_print.py:364
msgid ""
"This channel speaks JSON text frames: hello, claim, done, failed and beat."
msgstr ""
"Este canal habla con mensajes de texto JSON: hello, claim, done, failed y "
"beat."

#: ws_print.py:369
#, python-format
msgid "A frame of %(size)s bytes is over this channel's cap of %(cap)s bytes."
msgstr ""
"Un mensaje de %(size)s bytes supera el tope de este canal, %(cap)s bytes."

#: ws_print.py:378
msgid "This channel speaks hello, claim, done, failed and beat."
msgstr "Este canal habla hello, claim, done, failed y beat."

#: ws_print.py:393
msgid "This channel drains for one device: send its deviceId."
msgstr "Este canal recoge trabajos para un dispositivo: envía su deviceId."

#: ws_print.py:397
msgid "printers is the list of the ids of the printers this device reaches."
msgstr ""
"printers es la lista de los id de las impresoras a las que llega este "
"dispositivo."

#: ws_print.py:408
msgid ""
"This device is not set up to print in this hub: someone who manages the "
"printers sets it up in Printing → Devices."
msgstr ""
"Este dispositivo no está dado de alta para imprimir en este hub: quien "
"gestiona las impresoras lo da de alta en Impresión → Dispositivos."

#: ws_print.py:416
msgid ""
"This device reaches no active printer of this hub: choose its printers "
"before printing."
msgstr ""
"Este dispositivo no llega a ninguna impresora activa de este hub: elige sus "
"impresoras antes de imprimir."

#: ws_print.py:427
#, python-format
msgid "This device does not print «%(role)s» for this hub."
msgstr "Este dispositivo no imprime «%(role)s» para este hub."

#: ws_print.py:497
msgid "Sign in to this hub to print: this connection has no session."
msgstr ""
"Inicia sesión en este hub para imprimir: esta conexión no tiene sesión."

#: ws_print.py:504
msgid "This connection's session is not valid on this hub: sign in again."
msgstr ""
"La sesión de esta conexión no es válida en este hub: vuelve a iniciar sesión."

#: ws_print.py:625
msgid "jobId is the id of a job this hub handed out."
msgstr "jobId es el id de un trabajo que entregó este hub."

#: ws_print.py:653
msgid "Printing is not on in this hub."
msgstr "Impresión no está activada en este hub."

#: ws_print.py:664
msgid "Invalid frame."
msgstr "Mensaje no válido."

#: ws_print.py:690
#, python-format
msgid "%(field)s is text."
msgstr "%(field)s es un texto."

#: operations.py:62
msgid "No hub answers on this host."
msgstr "Ningún hub responde en este host."

#: throttle.py:27
msgid "Too many requests. Try again in a moment."
msgstr "Demasiadas peticiones. Inténtalo de nuevo en un momento."
