# Django 6.1.2 ships these with an empty Spanish translation, so the admin of hubs.erplora.com showed them in English
# (APP-ACCOUNTS-6). They are Django's messages, not base's: a makemessages of base marks them obsolete, keep them.
msgid "The file is larger than 20 MB, or holds more than a blueprint can."
msgstr ""
"El fichero pesa más de 20 MB, o trae más de lo que cabe en una plantilla."

msgid "This is not a .blueprint.zip file."
msgstr "No es un fichero .blueprint.zip."

msgid "The file has no manifest: it was not made by ERPlora."
msgstr "El fichero no tiene manifiesto: no lo ha hecho ERPlora."

msgid "The file is damaged or was changed by hand, so it cannot be read."
msgstr "El fichero está dañado o se cambió a mano, así que no se puede leer."

msgid ""
"The file was made by a newer version of ERPlora. Update this one to load it."
msgstr ""
"El fichero lo hizo una versión más reciente de ERPlora. Actualiza esta para "
"cargarlo."

msgid "Something went wrong loading this part; nothing else was affected."
msgstr "Algo falló al cargar esta parte; lo demás no se ha visto afectado."

msgid "A row has no name."
msgstr "Una fila no tiene nombre."

msgid ""
"«%(row)s»: the category «%(category)s» is not there, so it was left without "
"it."
msgstr ""
"«%(row)s»: la categoría «%(category)s» no está, así que se ha quedado sin "
"ella."

msgid "«%(row)s»: %(reason)s"
msgstr "«%(row)s»: %(reason)s"

msgid "Choose a template or a file, one of them."
msgstr "Elige una plantilla o un fichero, uno de los dos."

msgid "This template is no longer in the catalogue."
msgstr "Esta plantilla ya no está en el catálogo."

msgid ""
"This load came from a file uploaded by hand, so it cannot be retried by "
"itself. Upload the file again and choose only what failed."
msgstr ""
"Esta importación vino de un archivo subido a mano, así que no se puede "
"reintentar automáticamente. Vuelve a subir el archivo y elige solo lo que "
"falló."

msgid ""
"The version of the template this load used is no longer in the catalogue, so"
" it was not retried: another version could load different data."
msgstr ""
"La versión de la plantilla que usó esta importación ya no está en el "
"catálogo, así que el reintento no se ejecutó: otra versión podría cargar "
"datos distintos."

msgid "Everything of this load went in: there is nothing to retry."
msgstr "Todo lo de esta importación entró: no hay nada que reintentar."

msgid "This load was undone, so there is nothing to retry."
msgstr "Esta importación se deshizo, así que no hay nada que reintentar."

