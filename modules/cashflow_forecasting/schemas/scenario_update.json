{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cashflow_forecasting.scenarios.update",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id"],
  "properties": {
    "scenario_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "default": "" },
    "description": { "type": "string", "default": "" },
    "scenario_type": {
      "type": "string",
      "enum": ["", "baseline", "optimistic", "pessimistic", "custom"],
      "default": ""
    },
    "currency": { "type": "string", "maxLength": 8, "default": "" },
    "parameters": { "type": "string", "default": "" },
    "opening_balance": { "type": ["number", "null"], "default": null },
    "is_active": { "type": "string", "enum": ["", "0", "1"], "default": "" }
  }
}
