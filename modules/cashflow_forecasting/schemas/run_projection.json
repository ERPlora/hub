{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cashflow_forecasting.projections.run",
  "description": "Ejecuta una proyección para un escenario sobre un rango de periodos. La lógica de bucketing y cálculo de saldos vive en el handler WASM — ver WASM-TODO.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "period_start", "period_end"],
  "properties": {
    "scenario_id": { "type": "string", "minLength": 1 },
    "period_start": { "type": "string", "format": "date" },
    "period_end": { "type": "string", "format": "date" },
    "period_unit": {
      "type": "string",
      "enum": ["day", "week", "month"],
      "default": "month"
    },
    "inflows": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["amount"],
        "properties": {
          "date": { "type": ["string", "null"], "format": "date" },
          "amount": { "type": "number" },
          "source": { "type": "string", "enum": ["recurring", "expected", "historical"] }
        }
      }
    },
    "outflows": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["amount"],
        "properties": {
          "date": { "type": ["string", "null"], "format": "date" },
          "amount": { "type": "number" },
          "source": { "type": "string", "enum": ["recurring", "expected", "historical"] }
        }
      }
    }
  }
}
