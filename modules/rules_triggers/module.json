{
  "id": "rules_triggers",
  "name": "Rules & Triggers",
  "version": "1.0.0",
  "agent": {
    "description": "Manages business rules and event triggers: create, activate, deactivate, evaluate and test conditional automation rules.",
    "keywords": ["rule", "trigger", "automation", "condition", "event", "workflow"]
  },
  "depends_on": [],
  "permissions": [
    "rules_triggers.view_rule",
    "rules_triggers.manage_rule",
    "rules_triggers.execute_rule"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "rules_triggers.view_rule",
      "rules_triggers.manage_rule",
      "rules_triggers.execute_rule"
    ],
    "employee": [
      "rules_triggers.view_rule"
    ]
  },
  "navigation": [
    {
      "id": "rules",
      "label": "Rules",
      "icon": "git-pull-request-outline",
      "component": "erp-rules-triggers-rules"
    },
    {
      "id": "triggers",
      "label": "Triggers",
      "icon": "flash-outline",
      "component": "erp-rules-triggers-triggers"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "rules_triggers.triggers.list": {
      "permission": "rules_triggers.view_rule",
      "sql": "queries/triggers_list.sql",
      "ai": { "description": "Lists configured triggers with their status and associated event" }
    },
    "rules_triggers.rules.list": {
      "permission": "rules_triggers.view_rule",
      "sql": "queries/rules_list.sql",
      "ai": { "description": "Lists defined business rules with their status and conditions" }
    },
    "rules_triggers.rules.get": {
      "permission": "rules_triggers.view_rule",
      "sql": "queries/rule_get.sql",
      "ai": { "description": "Retrieves the full detail of a business rule by its identifier" }
    },
    "rules_triggers.evaluations.list": {
      "permission": "rules_triggers.view_rule",
      "sql": "queries/evaluations_list.sql",
      "ai": { "description": "Lists the history of rule evaluations with their outcome" }
    }
  },
  "commands": {
    "rules_triggers.triggers.create": {
      "permission": "rules_triggers.manage_rule",
      "transaction": true,
      "sql": [
        "commands/trigger_create.sql"
      ],
      "schema": "schemas/trigger_create.json",
      "emit": [
        "rules_triggers.trigger.created"
      ],
      "ai": { "description": "Creates a new trigger associated with a system event" }
    },
    "rules_triggers.triggers.activate": {
      "permission": "rules_triggers.manage_rule",
      "transaction": true,
      "sql": [
        "commands/trigger_activate.sql"
      ],
      "schema": "schemas/trigger_activate.json",
      "emit": [
        "rules_triggers.trigger.activated"
      ],
      "ai": { "description": "Activates a trigger so it starts listening for events" }
    },
    "rules_triggers.triggers.deactivate": {
      "permission": "rules_triggers.manage_rule",
      "transaction": true,
      "sql": [
        "commands/trigger_deactivate.sql"
      ],
      "schema": "schemas/trigger_deactivate.json",
      "emit": [
        "rules_triggers.trigger.deactivated"
      ],
      "ai": { "description": "Deactivates a trigger so it stops processing events" }
    },
    "rules_triggers.rules.deactivate": {
      "permission": "rules_triggers.manage_rule",
      "transaction": true,
      "sql": [
        "commands/rule_deactivate.sql"
      ],
      "schema": "schemas/rule_deactivate.json",
      "emit": [
        "rules_triggers.rule.deactivated"
      ],
      "ai": { "description": "Deactivates a business rule so it is no longer evaluated" }
    },
    "rules_triggers.rules.create": {
      "permission": "rules_triggers.manage_rule",
      "schema": "schemas/rule_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_rule"
      },
      "emit": [
        "rules_triggers.rule.created"
      ],
      "ai": { "description": "Creates a new business rule with its conditions and actions" }
    },
    "rules_triggers.rules.update": {
      "permission": "rules_triggers.manage_rule",
      "schema": "schemas/rule_update.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "update_rule"
      },
      "emit": [
        "rules_triggers.rule.updated"
      ],
      "ai": { "description": "Updates the conditions or actions of an existing business rule" }
    },
    "rules_triggers.rules.evaluate": {
      "permission": "rules_triggers.execute_rule",
      "schema": "schemas/rule_evaluate.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "evaluate_rules"
      },
      "emit": [
        "rules_triggers.rules.evaluated"
      ],
      "ai": { "description": "Evaluates active rules against a given context and executes the corresponding actions" }
    },
    "rules_triggers.rules.test": {
      "permission": "rules_triggers.execute_rule",
      "schema": "schemas/rule_test.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "test_rule"
      },
      "ai": { "description": "Tests a business rule with sample data without executing its real actions" }
    }
  },
  "events": {
    "listen": []
  },
  "ui": {
    "entry": "dist/rules_triggers.esm.js"
  }
}
