{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rules_triggers.triggers.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "name", "event_type"],
  "properties": {
    "code": { "type": "string", "minLength": 1, "maxLength": 100 },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "event_type": {
      "type": "string",
      "enum": ["entity_created", "entity_updated", "entity_deleted", "scheduled", "webhook"]
    },
    "entity_filter": { "type": "string", "default": "", "maxLength": 255 }
  }
}
