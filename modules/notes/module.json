{
  "id": "notes",
  "name": "Notas",
  "version": "1.0.0",
  "manifest_kind": "declarative",
  "permissions": ["notes.read", "notes.create"],
  "role_permissions": { "admin": ["*"], "employee": ["notes.read"] },
  "navigation": [
    { "id": "notes", "label": "Notas", "icon": "sticky-note", "component": "erp-notes-board" }
  ],
  "migrations": { "sqlite": ["migrations/sqlite/001_init.sql"] },
  "queries": {
    "notes.list": { "permission": "notes.read", "sql": "queries/list.sql", "schema": "schemas/list.json" }
  },
  "commands": {
    "notes.create": {
      "permission": "notes.create", "transaction": true,
      "sql": ["commands/create.sql"], "emit": ["notes.created"]
    }
  },
  "ui": { "entry": "dist/notes.esm.js" }
}
