{
  "id": "notes",
  "name": "Notas",
  "version": "1.0.0",
  "agent": {
    "description": "Manages internal notes on the hub note board: list existing notes and create new ones.",
    "keywords": ["notes", "board", "memo", "notepad"]
  },
  "permissions": ["notes.read", "notes.create"],
  "role_permissions": { "admin": ["*"], "employee": ["notes.read"] },
  "navigation": [
    { "id": "notes", "label": "Notas", "icon": "sticky-note", "component": "erp-notes-board" }
  ],
  "migrations": { "sqlite": ["migrations/sqlite/001_init.sql"] },
  "queries": {
    "notes.list": {
      "permission": "notes.read",
      "sql": "queries/list.sql",
      "schema": "schemas/list.json",
      "ai": { "description": "Lists all notes on the hub note board." }
    }
  },
  "commands": {
    "notes.create": {
      "permission": "notes.create",
      "transaction": true,
      "sql": ["commands/create.sql"],
      "emit": ["notes.created"],
      "ai": { "description": "Creates a new note on the note board." }
    }
  },
  "ui": { "entry": "dist/notes.esm.js" }
}
