{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "locations.bins.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["zone_id", "code"],
  "properties": {
    "zone_id": { "type": "string", "minLength": 1 },
    "code": { "type": "string", "minLength": 1, "maxLength": 50 },
