{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "locations.stock.count_bin",
  "type": "object",
  "additionalProperties": false,
  "required": ["bin_id", "counts"],
  "properties": {
    "bin_id": { "type": "string", "minLength": 1 },
    "counts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product_ref", "quantity"],
        "properties": {
          "product_ref": { "type": "string", "minLength": 1, "maxLength": 100 },
          "quantity": { "type": "number", "minimum": 0 },
          "lot_ref": { "type": "string", "default": "", "maxLength": 100 }
        }
      }
    }
  }
}
