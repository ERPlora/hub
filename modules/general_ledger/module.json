{
  "id": "general_ledger",
  "name": "General Ledger",
  "version": "1.0.0",
  "agent": {
    "description": "Manages the general ledger: maintains the chart of accounts and cost centers, posts and reverses journal entries, opens and closes accounting periods, and generates trial balance reports.",
    "keywords": ["general ledger", "journal entry", "chart of accounts", "cost center", "trial balance", "accounting period", "bookkeeping"]
  },
  "depends_on": [],
  "permissions": [
    "general_ledger.view_gl",
    "general_ledger.manage_chart",
    "general_ledger.post_gl",
    "general_ledger.close_period"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "general_ledger.view_gl",
      "general_ledger.manage_chart",
      "general_ledger.post_gl",
      "general_ledger.close_period"
    ],
    "employee": [
      "general_ledger.view_gl"
    ]
  },
  "navigation": [
    {
      "id": "chart",
      "label": "Chart",
      "icon": "library-outline",
      "component": "erp-general-ledger-chart"
    },
    {
      "id": "ledger",
      "label": "Ledger",
      "icon": "library-outline",
      "component": "erp-general-ledger-ledger"
    },
    {
      "id": "reports",
      "label": "Reports",
      "icon": "library-outline",
      "component": "erp-general-ledger-reports"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "general_ledger.accounts.list": {
      "permission": "general_ledger.view_gl",
      "sql": "queries/accounts_list.sql",
      "schema": "schemas/accounts_list.json",
      "ai": { "description": "Lists the chart-of-accounts entries with their code, name, and account type." }
    },
    "general_ledger.cost_centers.list": {
      "permission": "general_ledger.view_gl",
      "sql": "queries/cost_centers_list.sql",
      "schema": "schemas/cost_centers_list.json",
      "ai": { "description": "Lists the cost centers defined in the general ledger." }
    },
    "general_ledger.periods.list": {
      "permission": "general_ledger.view_gl",
      "sql": "queries/periods_list.sql",
      "schema": "schemas/periods_list.json",
      "ai": { "description": "Lists accounting periods with their status (open, closed) and date ranges." }
    },
    "general_ledger.entries.list": {
      "permission": "general_ledger.view_gl",
      "sql": "queries/entries_list.sql",
      "schema": "schemas/entries_list.json",
      "ai": { "description": "Lists journal entries in the general ledger with their date, reference, and status." }
    },
    "general_ledger.entries.get": {
      "permission": "general_ledger.view_gl",
      "sql": "queries/entry_get.sql",
      "schema": "schemas/entry_get.json",
      "ai": { "description": "Retrieves the full detail of a journal entry by its ID." }
    },
    "general_ledger.entries.lines": {
      "permission": "general_ledger.view_gl",
      "sql": "queries/entry_lines.sql",
      "schema": "schemas/entry_get.json",
      "ai": { "description": "Retrieves the debit and credit lines of a journal entry." }
    },
    "general_ledger.accounts.movements": {
      "permission": "general_ledger.view_gl",
      "sql": "queries/account_movements.sql",
      "schema": "schemas/account_movements.json",
      "ai": { "description": "Lists the movements of a ledger account within a date range or accounting period." }
    },
    "general_ledger.reports.trial_balance": {
      "permission": "general_ledger.view_gl",
      "sql": "queries/trial_balance.sql",
      "schema": "schemas/trial_balance.json",
      "ai": { "description": "Generates the trial balance (debit/credit totals and net balances) for the general ledger for a given period." }
    }
  },
  "commands": {
    "general_ledger.accounts.create": {
      "permission": "general_ledger.manage_chart",
      "transaction": true,
      "sql": [
        "commands/account_create.sql"
      ],
      "schema": "schemas/account_create.json",
      "emit": [
        "general_ledger.account.created"
      ],
      "ai": { "description": "Creates a new account in the chart of accounts." }
    },
    "general_ledger.cost_centers.create": {
      "permission": "general_ledger.manage_chart",
      "transaction": true,
      "sql": [
        "commands/cost_center_create.sql"
      ],
      "schema": "schemas/cost_center_create.json",
      "emit": [
        "general_ledger.cost_center.created"
      ],
      "ai": { "description": "Creates a new cost center for allocating expenses and revenues." }
    },
    "general_ledger.periods.create": {
      "permission": "general_ledger.close_period",
      "transaction": true,
      "sql": [
        "commands/period_create.sql"
      ],
      "schema": "schemas/period_create.json",
      "emit": [
        "general_ledger.period.created"
      ],
      "ai": { "description": "Creates a new accounting period in the general ledger." }
    },
    "general_ledger.periods.close": {
      "permission": "general_ledger.close_period",
      "transaction": true,
      "sql": [
        "commands/period_close.sql"
      ],
      "schema": "schemas/period_close.json",
      "emit": [
        "general_ledger.period.closed"
      ],
      "ai": { "description": "Closes an accounting period, preventing new journal entries from being posted to it." }
    },
    "general_ledger.periods.reopen": {
      "permission": "general_ledger.close_period",
      "transaction": true,
      "sql": [
        "commands/period_reopen.sql"
      ],
      "schema": "schemas/period_reopen.json",
      "emit": [
        "general_ledger.period.reopened"
      ],
      "ai": { "description": "Reopens a closed accounting period to allow corrections or additional journal entries." }
    },
    "general_ledger.entries.create": {
      "permission": "general_ledger.post_gl",
      "schema": "schemas/entry_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_entry"
      },
      "emit": [
        "general_ledger.entry.created"
      ],
      "ai": { "description": "Creates a new journal entry in the general ledger with its debit and credit lines." }
    },
    "general_ledger.entries.post": {
      "permission": "general_ledger.post_gl",
      "schema": "schemas/entry_post.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "post_entry"
      },
      "emit": [
        "general_ledger.entry.posted"
      ],
      "ai": { "description": "Posts a draft journal entry, making it permanent and final in the general ledger." }
    },
    "general_ledger.entries.reverse": {
      "permission": "general_ledger.post_gl",
      "schema": "schemas/entry_reverse.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "reverse_entry"
      },
      "emit": [
        "general_ledger.entry.reversed"
      ],
      "ai": { "description": "Creates a reversing journal entry that cancels the effects of an existing posted entry." }
    }
  },
  "events": {
    "listen": []
  },
  "ui": {
    "entry": "dist/general_ledger.esm.js"
  }
}
