{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "general_ledger.accounts.movements params",
  "type": "object",
  "additionalProperties": false,
  "required": ["account_id"],
  "properties": {
    "account_id": { "type": "string", "minLength": 1 },
    "period_id": {
      "type": "string",
      "description": "Filtro opcional por periodo; '' = todos.",
      "default": ""
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 200
    }
  }
}
