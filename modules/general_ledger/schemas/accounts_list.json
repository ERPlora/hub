{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "general_ledger.accounts.list params",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "account_type": {
      "type": "string",
      "description": "Filtro opcional por tipo; '' = todos.",
      "enum": ["", "asset", "liability", "equity", "income", "expense"],
      "default": ""
    },
    "active_only": {
      "type": "integer",
      "description": "1 = solo activas; 0 = todas.",
      "enum": [0, 1],
      "default": 1
    }
  }
}
