{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "uber_eats.stores.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["store_id", "name"],
  "properties": {
    "store_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "country": { "type": "string", "minLength": 2, "maxLength": 2, "default": "ES" },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3, "default": "EUR" }
  }
}
