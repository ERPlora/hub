{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "uber_eats.events.record",
  "description": "Persiste un evento de webhook de forma idempotente por event_id. Handler WASM: record_event.",
  "type": "object",
  "additionalProperties": false,
  "required": ["store_id", "event_type", "event_id", "payload"],
  "properties": {
    "store_id": { "type": "string", "minLength": 1, "description": "PK interno de uber_eats_store" },
    "event_type": {
      "type": "string",
      "enum": ["order_created", "order_updated", "order_cancelled", "menu_published", "store_online", "store_offline"]
    },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "payload": { "type": "object", "default": {} },
    "occurred_at": { "type": ["string", "null"], "default": null }
  }
}
