{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "uber_eats.menus.sync",
  "description": "Upsert de un menú por uber_menu_id (crea o actualiza). Handler WASM: sync_menu.",
  "type": "object",
  "additionalProperties": false,
  "required": ["store_id", "uber_menu_id", "name"],
  "properties": {
    "store_id": { "type": "string", "minLength": 1, "description": "PK interno de uber_eats_store" },
    "uber_menu_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "items_count": { "type": "integer", "minimum": 0, "default": 0 }
  }
}
