{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "uber_eats.orders.import",
  "description": "Importa un pedido de Uber Eats de forma idempotente por uber_order_id. Handler WASM: import_order.",
  "type": "object",
  "additionalProperties": false,
  "required": ["store_id", "uber_order_id", "items"],
  "properties": {
    "store_id": { "type": "string", "minLength": 1, "description": "PK interno de uber_eats_store" },
    "uber_order_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "customer_name": { "type": "string", "default": "", "maxLength": 255 },
    "total_amount": { "type": "string", "default": "0.00", "description": "Decimal como string; el handler hace quantize(0.01)" },
    "currency": { "type": "string", "default": "", "maxLength": 3, "description": "Vacío → hereda la moneda de la tienda" },
    "items": { "type": "array", "items": { "type": "object" }, "default": [] },
    "created_at_uber": { "type": ["string", "null"], "default": null },
    "customer_notes": { "type": "string", "default": "" }
  }
}
