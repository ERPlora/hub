{
  "id": "traceability",
  "name": "Traceability",
  "version": "1.0.0",
  "agent": {
    "description": "Tracks and audits the full chain of custody for entities and products: record traceability events, view timelines, link documents, and calculate product recall impact.",
    "keywords": ["traceability", "audit trail", "chain of custody", "recall", "batch", "lot", "events"]
  },
  "depends_on": [],
  "permissions": [
    "traceability.view_trace",
    "traceability.record_trace"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "traceability.view_trace",
      "traceability.record_trace"
    ],
    "employee": [
      "traceability.view_trace",
      "traceability.record_trace"
    ]
  },
  "navigation": [
    {
      "id": "audit",
      "label": "Audit Trail",
      "icon": "git-network-outline",
      "component": "erp-traceability-events"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "traceability.events.list": {
      "permission": "traceability.view_trace",
      "sql": "queries/events_list.sql",
      "ai": { "description": "Lists recorded traceability events." }
    },
    "traceability.events.get": {
      "permission": "traceability.view_trace",
      "sql": "queries/event_get.sql",
      "ai": { "description": "Retrieves the full detail of a specific traceability event." }
    },
    "traceability.events.timeline": {
      "permission": "traceability.view_trace",
      "sql": "queries/entity_timeline.sql",
      "ai": { "description": "Returns the chronological traceability event timeline for a given entity." }
    },
    "traceability.chain.list": {
      "permission": "traceability.view_trace",
      "sql": "queries/chain_list.sql",
      "ai": { "description": "Lists the complete chain of custody for a traced item." }
    }
  },
  "commands": {
    "traceability.events.link_document": {
      "permission": "traceability.record_trace",
      "transaction": true,
      "sql": [
        "commands/link_document.sql"
      ],
      "schema": "schemas/link_document.json",
      "emit": [
        "traceability.event.linked"
      ],
      "ai": { "description": "Links a document to an existing traceability event." }
    },
    "traceability.events.record": {
      "permission": "traceability.record_trace",
      "schema": "schemas/record_event.json",
      "emit": [
        "traceability.event.recorded"
      ],
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "record_event"
      },
      "ai": { "description": "Records a new event in the traceability chain." }
    },
    "traceability.recall.impact": {
      "permission": "traceability.view_trace",
      "schema": "schemas/recall_impact.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "recall_impact"
      },
      "ai": { "description": "Calculates the impact of a product recall by identifying all affected lots and downstream entities." }
    },
    "traceability.events.search_metadata": {
      "permission": "traceability.view_trace",
      "schema": "schemas/search_metadata.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "search_by_metadata"
      },
      "ai": { "description": "Searches traceability events filtered by custom metadata fields." }
    }
  },
  "events": {
    "listen": []
  },
  "ui": {
    "entry": "dist/traceability.esm.js"
  }
}
