{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "online_booking.settings.upsert",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "is_enabled": { "type": "boolean", "default": false },
    "page_title": { "type": "string", "default": "Book an Appointment", "maxLength": 255 },
    "welcome_message": { "type": "string", "default": "" },
    "primary_color": { "type": "string", "default": "#6366f1", "maxLength": 20 },
    "logo_url": { "type": "string", "default": "", "maxLength": 500 },
    "require_phone": { "type": "boolean", "default": true },
    "require_email": { "type": "boolean", "default": true },
    "allow_staff_selection": { "type": "boolean", "default": true },
    "allow_notes": { "type": "boolean", "default": true },
    "min_advance_hours": { "type": "integer", "minimum": 0, "maximum": 168, "default": 2 },
    "max_advance_days": { "type": "integer", "minimum": 1, "maximum": 365, "default": 30 },
    "slot_duration_minutes": { "type": "integer", "minimum": 5, "maximum": 480, "default": 30 },
    "buffer_minutes": { "type": "integer", "minimum": 0, "maximum": 120, "default": 0 },
    "confirmation_message": { "type": "string", "default": "" },
    "cancellation_policy": { "type": "string", "default": "" }
  }
}
