{
  "id": "quotes",
  "name": "Quotes",
  "version": "1.0.0",
  "agent": {
    "description": "Manages sales quotes: create, send, accept, reject and convert quotes to orders, and expire outdated ones.",
    "keywords": ["quote", "proposal", "estimate", "sales quote", "convert order"]
  },
  "depends_on": [],
  "permissions": [
    "quotes.view_quote",
    "quotes.add_quote",
    "quotes.send_quote",
    "quotes.convert_quote"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "quotes.view_quote",
      "quotes.add_quote",
      "quotes.send_quote",
      "quotes.convert_quote"
    ],
    "employee": [
      "quotes.view_quote",
      "quotes.add_quote"
    ]
  },
  "navigation": [
    {
      "id": "list",
      "label": "Quotes",
      "icon": "document-outline",
      "component": "erp-quotes-list"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "quotes.quotes.list": {
      "permission": "quotes.view_quote",
      "sql": "queries/quotes_list.sql",
      "schema": "schemas/quotes_list.json",
      "ai": { "description": "Lists quotes with their status, customer and totals" }
    },
    "quotes.quotes.get": {
      "permission": "quotes.view_quote",
      "sql": "queries/quote_get.sql",
      "schema": "schemas/quote_get.json",
      "ai": { "description": "Retrieves the full detail of a quote by its identifier" }
    },
    "quotes.quotes.lines": {
      "permission": "quotes.view_quote",
      "sql": "queries/quote_lines.sql",
      "schema": "schemas/quote_get.json",
      "ai": { "description": "Lists the product lines of a quote" }
    }
  },
  "commands": {
    "quotes.quotes.create": {
      "permission": "quotes.add_quote",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_quote"
      },
      "emit": [
        "quotes.quote.created"
      ],
      "ai": { "description": "Creates a new quote with product lines for a customer" }
    },
    "quotes.quotes.update_lines": {
      "permission": "quotes.add_quote",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "update_quote_lines"
      },
      "emit": [
        "quotes.quote.updated"
      ],
      "ai": { "description": "Updates the product lines of an existing quote" }
    },
    "quotes.quotes.send": {
      "permission": "quotes.send_quote",
      "transaction": true,
      "sql": [
        "commands/quote_send.sql"
      ],
      "emit": [
        "quotes.quote.sent"
      ],
      "ai": { "description": "Sends a quote to the customer and marks it as sent" }
    },
    "quotes.quotes.mark_accepted": {
      "permission": "quotes.send_quote",
      "transaction": true,
      "sql": [
        "commands/quote_mark_accepted.sql"
      ],
      "emit": [
        "quotes.quote.accepted"
      ],
      "ai": { "description": "Marks a quote as accepted by the customer" }
    },
    "quotes.quotes.mark_rejected": {
      "permission": "quotes.send_quote",
      "transaction": true,
      "sql": [
        "commands/quote_mark_rejected.sql"
      ],
      "emit": [
        "quotes.quote.rejected"
      ],
      "ai": { "description": "Marks a quote as rejected by the customer" }
    },
    "quotes.quotes.convert_to_order": {
      "permission": "quotes.convert_quote",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "convert_to_order"
      },
      "emit": [
        "quotes.quote.converted"
      ],
      "ai": { "description": "Converts an accepted quote into a sales order" }
    },
    "quotes.quotes.expire_old": {
      "permission": "quotes.view_quote",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "expire_old_quotes"
      },
      "emit": [
        "quotes.quote.expired"
      ],
      "ai": { "description": "Marks as expired all quotes that have passed their validity date" }
    },
    "quotes._insert_line": {
      "permission": "quotes.add_quote",
      "sql": [
        "commands/_insert_line.sql"
      ]
    },
    "quotes._set_status": {
      "permission": "quotes.send_quote",
      "sql": [
        "commands/_set_status.sql"
      ]
    }
  },
  "ui": {
    "entry": "dist/quotes.esm.js"
  }
}