{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verifactu.records.list",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "search": { "type": "string", "default": "", "maxLength": 200 },
    "status": {
      "type": "string",
      "enum": ["", "pending", "transmitted", "accepted", "rejected", "error", "retry"],
      "default": ""
    },
    "record_type": {
      "type": "string",
      "enum": ["", "alta", "anulacion"],
      "default": ""
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 }
  }
}
