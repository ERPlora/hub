{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verifactu.records.create",
  "description": "Crea un registro VeriFactu encadenado (alta/anulacion) a partir de una factura. La lógica (hash chain, secuencia atómica, QR, encolado) vive en WASM — ver WASM-TODO.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "issuer_nif", "issuer_name", "invoice_number", "invoice_date", "invoice_type"],
  "properties": {
    "record_type": { "type": "string", "enum": ["alta", "anulacion"] },
    "invoice_id": { "type": ["string", "null"], "default": null },
    "issuer_nif": { "type": "string", "minLength": 1, "maxLength": 15 },
    "issuer_name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "invoice_number": { "type": "string", "minLength": 1, "maxLength": 60 },
    "invoice_date": { "type": "string", "format": "date" },
    "invoice_type": { "type": "string", "enum": ["F1", "F2", "F3", "R1", "R2", "R3", "R4", "R5"] },
    "description": { "type": "string", "default": "", "maxLength": 500 },
    "base_amount": { "type": "number", "default": 0 },
    "tax_rate": { "type": "number", "default": 21 },
    "tax_amount": { "type": "number", "default": 0 },
    "total_amount": { "type": "number", "default": 0 }
  }
}
