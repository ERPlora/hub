{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "messaging.campaigns.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "channel"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "default": "" },
    "channel": { "type": "string", "enum": ["whatsapp", "sms", "email"] },
    "template_id": { "type": ["string", "null"], "default": null },
    "scheduled_at": { "type": ["string", "null"], "format": "date-time", "default": null },
    "target_filter": { "type": "string", "default": "{}" }
  }
}
