{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "messaging.templates.update",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "channel", "category", "subject", "body", "is_active"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "channel": { "type": "string", "enum": ["whatsapp", "sms", "email", "all"] },
    "category": {
      "type": "string",
      "enum": ["appointment_reminder", "booking_confirmation", "receipt", "marketing", "custom"]
    },
    "subject": { "type": "string", "maxLength": 255 },
    "body": { "type": "string", "minLength": 1 },
    "is_active": { "type": "integer", "enum": [0, 1] }
  }
}
