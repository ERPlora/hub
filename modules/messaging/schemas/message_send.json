{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "messaging.messages.send",
  "type": "object",
  "additionalProperties": false,
  "required": ["channel", "recipient_contact", "body"],
  "properties": {
    "channel": { "type": "string", "enum": ["whatsapp", "sms", "email"] },
    "recipient_name": { "type": "string", "default": "", "maxLength": 255 },
    "recipient_contact": { "type": "string", "minLength": 1, "maxLength": 255 },
    "subject": { "type": "string", "default": "", "maxLength": 255 },
    "body": { "type": "string", "minLength": 1 },
    "template_id": { "type": ["string", "null"], "default": null },
    "customer_id": { "type": ["string", "null"], "default": null },
    "extra_metadata": { "type": "object", "default": {} }
  }
}
