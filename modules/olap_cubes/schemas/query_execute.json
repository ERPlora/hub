{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "olap_cubes.query.execute",
  "type": "object",
  "additionalProperties": false,
  "required": ["cube_id", "measures"],
  "properties": {
    "cube_id": { "type": "string", "minLength": 1 },
    "dimensions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "measures": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "filters": { "type": "object", "default": {} },
    "data": {
      "type": "array",
      "items": { "type": "object" },
      "default": []
    }
  }
}
