{
  "id": "olap_cubes",
  "name": "OLAP Cubes",
  "version": "1.0.0",
  "agent": {
    "description": "Manages OLAP analytical cubes: define dimensions and metrics, execute analytical queries, and manage cached slices for fast reporting.",
    "keywords": ["olap", "cube", "analytics", "query", "slice", "cache", "reporting"]
  },
  "depends_on": [],
  "permissions": [
    "olap_cubes.view_cube",
    "olap_cubes.manage_cube",
    "olap_cubes.query"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "olap_cubes.view_cube",
      "olap_cubes.manage_cube",
      "olap_cubes.query"
    ],
    "employee": [
      "olap_cubes.view_cube",
      "olap_cubes.query"
    ]
  },
  "navigation": [
    {
      "id": "cubes",
      "label": "Cubes",
      "icon": "cube-outline",
      "component": "erp-olap-cubes-cubes"
    },
    {
      "id": "queries",
      "label": "Queries",
      "icon": "cube-outline",
      "component": "erp-olap-cubes-queries"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "olap_cubes.cubes.list": {
      "permission": "olap_cubes.view_cube",
      "sql": "queries/cubes_list.sql",
      "ai": { "description": "Lists all OLAP cubes defined in the hub." }
    },
    "olap_cubes.cubes.get": {
      "permission": "olap_cubes.view_cube",
      "sql": "queries/cube_get.sql",
      "ai": { "description": "Retrieves the details of an OLAP cube by its ID." }
    },
    "olap_cubes.queries.list": {
      "permission": "olap_cubes.view_cube",
      "sql": "queries/queries_list.sql",
      "ai": { "description": "Lists saved analytical queries defined over OLAP cubes." }
    },
    "olap_cubes.slices.list": {
      "permission": "olap_cubes.view_cube",
      "sql": "queries/slices_list.sql",
      "ai": { "description": "Lists available data slices for the OLAP cubes." }
    }
  },
  "commands": {
    "olap_cubes.cubes.create": {
      "permission": "olap_cubes.manage_cube",
      "transaction": true,
      "sql": [
        "commands/cube_create.sql"
      ],
      "schema": "schemas/cube_create.json",
      "emit": [
        "olap_cubes.cube.created"
      ],
      "ai": { "description": "Creates a new OLAP cube with its dimensions and metrics." }
    },
    "olap_cubes.cubes.update": {
      "permission": "olap_cubes.manage_cube",
      "transaction": true,
      "sql": [
        "commands/cube_update.sql"
      ],
      "schema": "schemas/cube_update.json",
      "emit": [
        "olap_cubes.cube.updated"
      ],
      "ai": { "description": "Updates the definition of an existing OLAP cube." }
    },
    "olap_cubes.cubes.deactivate": {
      "permission": "olap_cubes.manage_cube",
      "transaction": true,
      "sql": [
        "commands/cube_deactivate.sql"
      ],
      "schema": "schemas/cube_deactivate.json",
      "emit": [
        "olap_cubes.cube.deactivated"
      ],
      "ai": { "description": "Deactivates an OLAP cube so it is no longer available for queries." }
    },
    "olap_cubes.cache.invalidate": {
      "permission": "olap_cubes.manage_cube",
      "transaction": true,
      "sql": [
        "commands/cache_invalidate.sql"
      ],
      "schema": "schemas/cache_invalidate.json",
      "emit": [
        "olap_cubes.cache.invalidated"
      ],
      "ai": { "description": "Invalidates the result cache of an OLAP cube, forcing it to be recalculated." }
    },
    "olap_cubes.query.execute": {
      "permission": "olap_cubes.query",
      "schema": "schemas/query_execute.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "execute_query"
      },
      "emit": [
        "olap_cubes.query.executed"
      ],
      "ai": { "description": "Executes an analytical query over an OLAP cube and returns the results." }
    },
    "olap_cubes.cache.put": {
      "permission": "olap_cubes.manage_cube",
      "schema": "schemas/cache_put.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "cache_slice"
      },
      "emit": [
        "olap_cubes.slice.cached"
      ],
      "ai": { "description": "Stores a computed OLAP cube slice in the cache." }
    },
    "olap_cubes.cache.get": {
      "permission": "olap_cubes.query",
      "schema": "schemas/cache_get.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "get_cached_slice"
      },
      "ai": { "description": "Retrieves a previously cached slice from an OLAP cube." }
    }
  },
  "events": {
    "listen": []
  },
  "ui": {
    "entry": "dist/olap_cubes.esm.js"
  }
}
