{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "timesheets.entries.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["employee_id", "employee_name", "date", "duration_minutes"],
  "properties": {
    "employee_id": { "type": "string", "minLength": 1 },
    "employee_name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "date": { "type": "string", "format": "date" },
    "duration_minutes": { "type": "integer", "exclusiveMinimum": 0 },
    "description": { "type": "string", "default": "" },
    "project_name": { "type": "string", "default": "", "maxLength": 200 },
    "client_name": { "type": "string", "default": "", "maxLength": 200 },
    "billable": { "type": "boolean", "default": true },
    "hourly_rate_id": { "type": "string", "default": "" }
  }
}
