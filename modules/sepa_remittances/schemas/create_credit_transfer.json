{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sepa_remittances.remittances.create_credit_transfer",
  "type": "object",
  "additionalProperties": false,
  "required": ["execution_date", "lines"],
  "properties": {
    "execution_date": { "type": "string", "format": "date" },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3, "default": "EUR" },
    "notes": { "type": "string", "default": "" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["counterparty_name", "counterparty_iban", "amount"],
        "properties": {
          "counterparty_name": { "type": "string", "minLength": 1, "maxLength": 255 },
          "counterparty_iban": { "type": "string", "minLength": 1, "maxLength": 34 },
          "amount": { "type": "number", "exclusiveMinimum": 0 },
          "concept": { "type": "string", "default": "", "maxLength": 140 },
          "end_to_end_id": { "type": "string", "default": "", "maxLength": 35 }
        }
      }
    }
  }
}
