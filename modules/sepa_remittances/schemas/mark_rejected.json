{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sepa_remittances.remittances.mark_rejected",
  "type": "object",
  "additionalProperties": false,
  "required": ["remittance_id", "reason"],
  "properties": {
    "remittance_id": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "rejected_lines": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["line_id"],
        "properties": {
          "line_id": { "type": "string", "minLength": 1 },
          "rejection_reason": { "type": "string", "default": "" }
        }
      }
    }
  }
}
