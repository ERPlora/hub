{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sepa_remittances.mandates.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["mandate_id", "debtor_name", "debtor_iban", "creditor_id"],
  "properties": {
    "mandate_id": { "type": "string", "minLength": 1, "maxLength": 35 },
    "debtor_name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "debtor_iban": { "type": "string", "minLength": 1, "maxLength": 34 },
    "debtor_bic": { "type": "string", "default": "", "maxLength": 11 },
    "creditor_id": { "type": "string", "minLength": 1, "maxLength": 35 },
    "signed_date": { "type": ["string", "null"], "format": "date", "default": null },
    "scheme": { "type": "string", "enum": ["CORE", "B2B"], "default": "CORE" },
    "notes": { "type": "string", "default": "" }
  }
}
