{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sepa_remittances.remittances.list",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["", "draft", "generated", "sent", "processed", "rejected"],
      "default": ""
    },
    "remittance_type": {
      "type": "string",
      "enum": ["", "direct_debit", "credit_transfer"],
      "default": ""
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 50 }
  }
}
