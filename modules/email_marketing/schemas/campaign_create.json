{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "email_marketing.campaigns.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "subject", "list_id", "html_content", "sender_email"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "subject": { "type": "string", "minLength": 1, "maxLength": 255 },
    "list_id": { "type": "string", "minLength": 1 },
    "html_content": { "type": "string" },
    "plain_content": { "type": "string", "default": "" },
    "sender_email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 320 },
    "sender_name": { "type": "string", "default": "ERPlora", "maxLength": 120 }
  }
}
