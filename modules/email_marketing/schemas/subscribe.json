{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "email_marketing.subscribers.subscribe",
  "type": "object",
  "additionalProperties": false,
  "required": ["list_id", "email"],
  "properties": {
    "list_id": { "type": "string", "minLength": 1 },
    "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 320 },
    "first_name": { "type": "string", "default": "", "maxLength": 120 },
    "last_name": { "type": "string", "default": "", "maxLength": 120 }
  }
}
