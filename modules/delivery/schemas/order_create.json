{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "delivery.orders.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["customer_name", "customer_phone"],
  "properties": {
    "customer_name": { "type": "string", "minLength": 1, "maxLength": 150 },
    "customer_phone": { "type": "string", "minLength": 1, "maxLength": 30 },
    "order_type": {
      "type": "string",
      "enum": ["takeaway", "delivery"],
      "default": "delivery"
    },
    "delivery_address": { "type": "string", "default": "" },
    "delivery_zone_id": { "type": "string", "default": "" },
    "driver_id": { "type": "string", "default": "" },
    "delivery_fee": { "type": ["number", "null"], "minimum": 0, "default": null },
    "payment_method": { "type": "string", "default": "" },
    "notes": { "type": "string", "default": "" },
    "items": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product_name", "unit_price"],
        "properties": {
          "product_name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "quantity": { "type": "integer", "minimum": 1, "default": 1 },
          "unit_price": { "type": "number", "minimum": 0 },
          "notes": { "type": "string", "default": "" }
        }
      }
    }
  }
}
