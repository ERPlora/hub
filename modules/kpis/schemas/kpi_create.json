{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kpis.kpis.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "name", "unit", "kpi_type"],
  "properties": {
    "code": { "type": "string", "minLength": 1, "maxLength": 40 },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "default": "" },
    "unit": {
      "type": "string",
      "enum": ["currency", "percent", "count", "duration", "ratio", "score", "other"]
    },
    "kpi_type": {
      "type": "string",
      "enum": ["numerical", "percentage", "count", "ratio"]
    },
    "aggregation": {
      "type": "string",
      "enum": ["sum", "avg", "max", "min", "last"],
      "default": "last"
    },
    "category": { "type": "string", "default": "", "maxLength": 80 },
    "target_value": { "type": ["number", "null"], "default": null },
    "target_direction": {
      "type": "string",
      "enum": ["higher_is_better", "lower_is_better"],
      "default": "higher_is_better"
    },
    "critical_threshold": { "type": ["number", "null"], "default": null },
    "warning_threshold": { "type": ["number", "null"], "default": null },
    "owner_ref": { "type": ["string", "null"], "default": null }
  }
}
