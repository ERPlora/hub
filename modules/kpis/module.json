{
  "id": "kpis",
  "name": "KPIs",
  "version": "1.0.0",
  "agent": {
    "description": "Manages KPIs and performance metrics: define indicators, record values, monitor thresholds, and acknowledge alerts.",
    "keywords": ["kpi", "metric", "performance", "indicator", "alert", "threshold", "value"]
  },
  "depends_on": [],
  "permissions": [
    "kpis.view_kpi",
    "kpis.manage_kpi",
    "kpis.record_kpi"
  ],
  "role_permissions": {
    "admin": ["*"],
    "manager": ["kpis.view_kpi", "kpis.manage_kpi", "kpis.record_kpi"],
    "employee": ["kpis.view_kpi", "kpis.record_kpi"]
  },
  "navigation": [
    {
      "id": "list",
      "label": "KPIs",
      "icon": "trending-up-outline",
      "component": "erp-kpis-list"
    },
    {
      "id": "alerts",
      "label": "Alerts",
      "icon": "alert-circle-outline",
      "component": "erp-kpis-alerts"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "kpis.kpis.list": {
      "permission": "kpis.view_kpi",
      "sql": "queries/kpis_list.sql",
      "ai": { "description": "Lists all defined KPIs" }
    },
    "kpis.kpis.get": {
      "permission": "kpis.view_kpi",
      "sql": "queries/kpi_get.sql",
      "ai": { "description": "Retrieves the detail of a KPI by its identifier" }
    },
    "kpis.values.list": {
      "permission": "kpis.view_kpi",
      "sql": "queries/values_list.sql",
      "ai": { "description": "Lists the recorded values of a KPI within a given period" }
    },
    "kpis.alerts.list": {
      "permission": "kpis.view_kpi",
      "sql": "queries/alerts_list.sql",
      "ai": { "description": "Lists active KPI alerts where thresholds have been exceeded" }
    }
  },
  "commands": {
    "kpis.kpis.create": {
      "permission": "kpis.manage_kpi",
      "transaction": true,
      "sql": ["commands/kpi_create.sql"],
      "schema": "schemas/kpi_create.json",
      "emit": ["kpis.kpi.created"],
      "ai": { "description": "Creates a new KPI with its definition, unit, and thresholds" }
    },
    "kpis.kpis.update": {
      "permission": "kpis.manage_kpi",
      "transaction": true,
      "sql": ["commands/kpi_update.sql"],
      "schema": "schemas/kpi_update.json",
      "emit": ["kpis.kpi.updated"],
      "ai": { "description": "Updates the definition or thresholds of an existing KPI" }
    },
    "kpis.kpis.deactivate": {
      "permission": "kpis.manage_kpi",
      "transaction": true,
      "sql": ["commands/kpi_deactivate.sql"],
      "schema": "schemas/kpi_deactivate.json",
      "emit": ["kpis.kpi.deactivated"],
      "ai": { "description": "Deactivates a KPI so it stops receiving new values and alerts" }
    },
    "kpis.alerts.acknowledge": {
      "permission": "kpis.manage_kpi",
      "transaction": true,
      "sql": ["commands/alert_acknowledge.sql"],
      "schema": "schemas/alert_acknowledge.json",
      "emit": ["kpis.alert.acknowledged"],
      "ai": { "description": "Marks a KPI alert as acknowledged by the responsible user" }
    },
    "kpis.values.record": {
      "permission": "kpis.record_kpi",
      "schema": "schemas/value_record.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "record_value"
      },
      "emit": ["kpis.value.recorded", "kpis.alert.raised"],
      "ai": { "description": "Records a new value for a KPI and raises alerts if the threshold is exceeded" }
    }
  },
  "events": {
    "listen": []
  },
  "ui": {
    "entry": "dist/kpis.esm.js"
  }
}
