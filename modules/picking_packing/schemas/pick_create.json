{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "picking_packing.picks.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["lines"],
  "properties": {
    "order_ref": { "type": "string", "default": "", "maxLength": 100 },
    "assigned_to_ref": { "type": "string", "default": "", "maxLength": 100 },
    "notes": { "type": "string", "default": "" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product_ref", "quantity_requested"],
        "properties": {
          "product_ref": { "type": "string", "minLength": 1, "maxLength": 200 },
          "quantity_requested": { "type": "number", "exclusiveMinimum": 0 },
          "location_ref": { "type": "string", "default": "", "maxLength": 100 },
          "lot_ref": { "type": "string", "default": "", "maxLength": 100 }
        }
      }
    }
  }
}
