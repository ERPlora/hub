{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "picking_packing.picks.list",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["", "draft", "in_progress", "completed", "cancelled"],
