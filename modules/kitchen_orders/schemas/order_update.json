{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kitchen_orders.orders.update",
  "type": "object",
  "additionalProperties": false,
  "required": ["order_id"],
  "properties": {
    "order_id": { "type": "string", "minLength": 1 },
    "notes": { "type": ["string", "null"], "default": null },
    "priority": {
      "type": ["string", "null"],
      "enum": ["normal", "rush", "vip", null],
      "default": null
    },
    "order_type": {
      "type": ["string", "null"],
      "enum": ["dine_in", "takeaway", "delivery", null],
      "default": null
    },
    "table_id": { "type": ["string", "null"], "default": null },
    "waiter_id": { "type": ["string", "null"], "default": null },
    "customer_id": { "type": ["string", "null"], "default": null }
  }
}
