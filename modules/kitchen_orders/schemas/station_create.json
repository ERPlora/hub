{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kitchen_orders.stations.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "name_es": { "type": "string", "default": "", "maxLength": 100 },
    "description": { "type": "string", "default": "" },
    "color": { "type": "string", "default": "#F97316", "maxLength": 7 },
    "icon": { "type": "string", "default": "flame-outline", "maxLength": 50 },
    "printer_name": { "type": "string", "default": "", "maxLength": 100 },
    "sort_order": { "type": "integer", "minimum": 0, "default": 0 }
  }
}
