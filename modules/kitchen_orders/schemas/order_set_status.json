{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kitchen_orders.orders.set_status",
  "type": "object",
  "additionalProperties": false,
  "required": ["order_id", "action_name"],
  "properties": {
    "order_id": { "type": "string", "minLength": 1 },
    "action_name": {
      "type": "string",
      "enum": ["fire", "mark_ready", "mark_served", "cancel", "recall"]
    },
    "reason": { "type": "string", "default": "" }
  }
}
