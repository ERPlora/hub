{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "opportunities.opportunities.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["customer_name"],
  "properties": {
    "customer_name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "customer_email": { "type": "string", "default": "", "maxLength": 255 },
    "value": { "type": "string", "default": "0.00" },
    "expected_close_date": { "type": ["string", "null"], "format": "date", "default": null },
    "stage": {
      "type": "string",
      "enum": ["prospecting", "qualification", "proposal", "negotiation", "won", "lost"],
      "default": "prospecting"
    },
    "probability": { "type": ["integer", "null"], "minimum": 0, "maximum": 100, "default": null },
    "assigned_to": { "type": "string", "default": "" },
    "notes": { "type": "string", "default": "" }
  }
}
