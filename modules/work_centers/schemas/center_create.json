{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "work_centers.centers.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "name"],
  "properties": {
    "code": { "type": "string", "minLength": 1, "maxLength": 50 },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "center_type": {
      "type": "string",
      "enum": ["machine", "line", "station", "cell"],
      "default": "machine"
    },
    "capacity_per_hour": { "type": "number", "minimum": 0, "default": 0 },
    "hourly_cost": { "type": "number", "minimum": 0, "default": 0 },
    "location_ref": { "type": "string", "default": "", "maxLength": 100 },
    "calendar": { "type": "string", "default": "{}" },
    "notes": { "type": "string", "default": "" }
  }
}
