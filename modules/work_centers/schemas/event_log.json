{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "work_centers.events.log",
  "type": "object",
  "additionalProperties": false,
  "required": ["work_center_id", "event_type"],
  "properties": {
    "work_center_id": { "type": "string", "minLength": 1 },
    "event_type": {
      "type": "string",
      "enum": ["run", "stop", "breakdown", "setup", "maintenance", "idle"]
    },
    "started_at": { "type": ["string", "null"], "default": null },
    "ended_at": { "type": ["string", "null"], "default": null },
    "duration_minutes": { "type": ["integer", "null"], "minimum": 0, "default": null },
    "reason": { "type": "string", "default": "", "maxLength": 255 },
    "operator_ref": { "type": "string", "default": "", "maxLength": 100 },
    "notes": { "type": "string", "default": "" }
  }
}
