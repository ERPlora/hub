{
  "id": "fiscal_romania",
  "name": "Fiscal Romania",
  "version": "1.0.0",
  "agent": {
    "description": "Handles Romanian fiscal compliance: generates, validates, and submits e-Factura and e-Transport documents to ANAF, and produces JPK electronic accounting reports.",
    "keywords": ["efactura", "etransport", "anaf", "romania", "fiscal", "jpk", "compliance", "xml"]
  },
  "depends_on": [],
  "permissions": [
    "fiscal_romania.view_fiscal_ro",
    "fiscal_romania.submit_efactura",
    "fiscal_romania.submit_etransport"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "fiscal_romania.view_fiscal_ro",
      "fiscal_romania.submit_efactura",
      "fiscal_romania.submit_etransport"
    ],
    "employee": [
      "fiscal_romania.view_fiscal_ro"
    ]
  },
  "navigation": [
    {
      "id": "efactura",
      "label": "e-Factura",
      "icon": "shield-checkmark-outline",
      "component": "erp-fiscal-romania-efactura"
    },
    {
      "id": "etransport",
      "label": "e-Transport",
      "icon": "shield-checkmark-outline",
      "component": "erp-fiscal-romania-etransport"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "fiscal_romania.config.get": {
      "permission": "fiscal_romania.view_fiscal_ro",
      "sql": "queries/config_get.sql",
      "ai": { "description": "Retrieves the Romanian fiscal configuration (ANAF credentials, CUI, etc.) for the current hub." }
    },
    "fiscal_romania.efactura.list": {
      "permission": "fiscal_romania.view_fiscal_ro",
      "sql": "queries/efactura_list.sql",
      "schema": "schemas/efactura_list.json",
      "ai": { "description": "Lists the electronic invoices (e-Factura) issued by this hub." }
    },
    "fiscal_romania.efactura.get": {
      "permission": "fiscal_romania.view_fiscal_ro",
      "sql": "queries/efactura_get.sql",
      "schema": "schemas/efactura_get.json",
      "ai": { "description": "Retrieves the full detail of an e-Factura electronic invoice by its ID." }
    },
    "fiscal_romania.etransport.list": {
      "permission": "fiscal_romania.view_fiscal_ro",
      "sql": "queries/etransport_list.sql",
      "schema": "schemas/etransport_list.json",
      "ai": { "description": "Lists the registered electronic transport documents (e-Transport)." }
    },
    "fiscal_romania.jpk.list": {
      "permission": "fiscal_romania.view_fiscal_ro",
      "sql": "queries/jpk_list.sql",
      "schema": "schemas/jpk_list.json",
      "ai": { "description": "Lists the JPK electronic accounting reports generated for the Romanian fiscal authority." }
    }
  },
  "commands": {
    "fiscal_romania.config.update": {
      "permission": "fiscal_romania.submit_efactura",
      "schema": "schemas/config_update.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "update_config"
      },
      "emit": [
        "fiscal_romania.config.updated"
      ],
      "ai": { "description": "Updates the Romanian fiscal configuration (ANAF credentials, CUI, certificate, etc.)." }
    },
    "fiscal_romania.efactura.create": {
      "permission": "fiscal_romania.submit_efactura",
      "schema": "schemas/efactura_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_efactura"
      },
      "emit": [
        "fiscal_romania.efactura.created"
      ],
      "ai": { "description": "Creates a new e-Factura electronic invoice from sale data." }
    },
    "fiscal_romania.efactura.generate_xml": {
      "permission": "fiscal_romania.submit_efactura",
      "schema": "schemas/efactura_generate_xml.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "generate_efactura_xml"
      },
      "ai": { "description": "Generates the UBL XML for an e-Factura in the format required by ANAF." }
    },
    "fiscal_romania.efactura.submit": {
      "permission": "fiscal_romania.submit_efactura",
      "schema": "schemas/efactura_submit.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "submit_efactura"
      },
      "emit": [
        "fiscal_romania.efactura.submitted"
      ],
      "ai": { "description": "Submits an e-Factura to the Romanian ANAF SPV system for official validation." }
    },
    "fiscal_romania.efactura.validate": {
      "permission": "fiscal_romania.submit_efactura",
      "schema": "schemas/efactura_validate.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "validate_efactura"
      },
      "emit": [
        "fiscal_romania.efactura.validated"
      ],
      "ai": { "description": "Validates an e-Factura against ANAF fiscal rules before submission." }
    },
    "fiscal_romania.etransport.create": {
      "permission": "fiscal_romania.submit_etransport",
      "schema": "schemas/etransport_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_etransport"
      },
      "emit": [
        "fiscal_romania.etransport.created"
      ],
      "ai": { "description": "Creates a new electronic transport document (e-Transport) to declare goods transport to ANAF." }
    },
    "fiscal_romania.etransport.submit": {
      "permission": "fiscal_romania.submit_etransport",
      "schema": "schemas/etransport_submit.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "submit_etransport"
      },
      "emit": [
        "fiscal_romania.etransport.submitted"
      ],
      "ai": { "description": "Submits an e-Transport document to ANAF for official registration of goods transport." }
    },
    "fiscal_romania.jpk.generate": {
      "permission": "fiscal_romania.view_fiscal_ro",
      "schema": "schemas/jpk_generate.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "generate_jpk"
      },
      "emit": [
        "fiscal_romania.jpk.generated"
      ],
      "ai": { "description": "Generates the JPK electronic accounting book report for the specified fiscal period." }
    },
    "fiscal_romania._config_upsert": {
      "permission": "fiscal_romania.submit_efactura",
      "sql": [
        "commands/_config_upsert.sql"
      ]
    },
    "fiscal_romania._efactura_insert": {
      "permission": "fiscal_romania.submit_efactura",
      "sql": [
        "commands/_efactura_insert.sql"
      ]
    },
    "fiscal_romania._efactura_update": {
      "permission": "fiscal_romania.submit_efactura",
      "sql": [
        "commands/_efactura_update.sql"
      ]
    },
    "fiscal_romania._etransport_insert": {
      "permission": "fiscal_romania.submit_etransport",
      "sql": [
        "commands/_etransport_insert.sql"
      ]
    },
    "fiscal_romania._etransport_update": {
      "permission": "fiscal_romania.submit_etransport",
      "sql": [
        "commands/_etransport_update.sql"
      ]
    },
    "fiscal_romania._jpk_insert": {
      "permission": "fiscal_romania.view_fiscal_ro",
      "sql": [
        "commands/_jpk_insert.sql"
      ]
    }
  },
  "events": {
    "listen": []
  },
  "ui": {
    "entry": "dist/fiscal_romania.esm.js"
  }
}
