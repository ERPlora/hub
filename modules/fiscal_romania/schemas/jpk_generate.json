    "period_start": { "type": "string", "format": "date" },
    "period_end": { "type": "string", "format": "date" },
    "data": {
      "type": "object",
      "default": {},
      "properties": {
        "total_amount": { "type": ["string", "number"], "default": "0.00" }
      },
      "additionalProperties": true
    }
  }
}
