{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fiscal_romania.config.update",
  "type": "object",
  "additionalProperties": false,
  "required": ["company_cif", "company_name"],
  "properties": {
    "company_cif": {
      "type": "string",
      "minLength": 3,
      "maxLength": 20,
      "pattern": "^RO[0-9]+$"
    },
    "company_name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "anaf_environment": {
      "type": "string",
      "enum": ["test", "production"],
      "default": "test"
    }
  }
}
