{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fiscal_romania.etransport.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["transport_type", "origin_city", "destination_city", "vehicle_plate", "goods"],
  "properties": {
    "transport_type": {
      "type": "string",
      "enum": ["intra_eu", "national", "international"]
    },
    "origin_city": { "type": "string", "minLength": 1, "maxLength": 120 },
    "destination_city": { "type": "string", "minLength": 1, "maxLength": 120 },
    "vehicle_plate": { "type": "string", "minLength": 1, "maxLength": 20 },
    "departure_date": {
      "type": ["string", "null"],
      "format": "date",
      "default": null
    },
    "goods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "quantity": { "type": ["number", "string"] },
          "hs_code": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  }
}
