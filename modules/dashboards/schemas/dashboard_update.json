{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dashboards.dashboards.update",
  "type": "object",
  "additionalProperties": false,
  "required": ["dashboard_id", "code", "name"],
  "properties": {
    "dashboard_id": { "type": "string", "minLength": 1 },
    "code": { "type": "string", "minLength": 1, "maxLength": 100 },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "description": { "type": "string", "default": "" },
    "layout": { "type": ["object", "array", "null"], "default": null },
    "is_default": { "type": "integer", "enum": [0, 1], "default": 0 },
    "is_public": { "type": "integer", "enum": [0, 1], "default": 0 },
    "owner_ref": { "type": ["string", "null"], "default": null },
    "theme": { "type": "string", "enum": ["light", "dark", "auto"], "default": "light" },
    "refresh_interval_sec": { "type": "integer", "minimum": 0, "default": 0 }
  }
}
