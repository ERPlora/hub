{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "subscriptions.subscriptions.list",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["", "trialing", "active", "past_due", "cancelled", "expired"],
