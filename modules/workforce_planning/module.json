{
  "id": "workforce_planning",
  "name": "Workforce Planning",
  "version": "1.2.4",
  "agent": {
    "description": "Plans and manages workforce scheduling: define locations and shift templates, assign shifts to employees, manage the planning calendar, set coverage requirements, and surface unresolved scheduling conflicts.",
    "keywords": ["workforce", "scheduling", "shift", "assignment", "coverage", "planning", "calendar", "location"]
  },
  "depends_on": ["staff"],
  "permissions": [
    "workforce_planning.view_planning",
    "workforce_planning.add_planning",
    "workforce_planning.change_planning",
    "workforce_planning.manage_locations",
    "workforce_planning.manage_shifts",
    "workforce_planning.manage_calendar",
    "workforce_planning.manage_coverage",
    "workforce_planning.manage_settings"
  ],
  "role_permissions": {
    "admin": ["*"],
    "manager": [
      "workforce_planning.view_planning",
      "workforce_planning.add_planning",
      "workforce_planning.change_planning",
      "workforce_planning.manage_locations",
      "workforce_planning.manage_shifts",
      "workforce_planning.manage_calendar",
      "workforce_planning.manage_coverage",
      "workforce_planning.manage_settings"
    ],
    "employee": ["workforce_planning.view_planning"]
  },
  "navigation": [
    {
      "id": "planning",
      "label": "Planning",
      "icon": "calendar-outline",
      "component": "erp-workforce-planning-planning"
    },
    {
      "id": "locations",
      "label": "Locations",
      "icon": "location-outline",
      "component": "erp-workforce-planning-locations"
    },
    {
      "id": "shifts",
      "label": "Shifts",
      "icon": "time-outline",
      "component": "erp-workforce-planning-shifts"
    },
    {
      "id": "calendar",
      "label": "Calendar",
      "icon": "today-outline",
      "component": "erp-workforce-planning-calendar"
    },
    {
      "id": "coverage",
      "label": "Coverage",
      "icon": "people-outline",
      "component": "erp-workforce-planning-coverage"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "workforce_planning.locations.list": {
      "permission": "workforce_planning.view_planning",
      "sql": "queries/locations_list.sql",
      "ai": { "description": "Lists the locations or branches available for workforce planning" }
    },
    "workforce_planning.shift_templates.list": {
      "permission": "workforce_planning.view_planning",
      "sql": "queries/shift_templates_list.sql",
      "ai": { "description": "Lists the shift templates defined for workforce planning" }
    },
    "workforce_planning.assignments.list": {
      "permission": "workforce_planning.view_planning",
      "sql": "queries/assignments_list.sql",
      "ai": { "description": "Lists planned shift assignments for staff members" }
    },
    "workforce_planning.calendar.list": {
      "permission": "workforce_planning.view_planning",
      "sql": "queries/calendar_list.sql",
      "ai": { "description": "Lists events and periods in the workforce planning calendar" }
    },
    "workforce_planning.coverage.list": {
      "permission": "workforce_planning.view_planning",
      "sql": "queries/coverage_list.sql",
      "ai": { "description": "Lists minimum staffing coverage requirements by time slot or location" }
    },
    "workforce_planning.conflicts.unresolved": {
      "permission": "workforce_planning.view_planning",
      "sql": "queries/conflicts_unresolved.sql",
      "ai": { "description": "Lists unresolved workforce scheduling conflicts pending resolution" }
    }
  },
  "commands": {
    "workforce_planning.locations.create": {
      "permission": "workforce_planning.manage_locations",
      "transaction": true,
      "sql": ["commands/location_create.sql"],
      "schema": "schemas/location_create.json",
      "emit": ["workforce_planning.location.created"],
      "ai": { "description": "Creates a new location or branch for workforce planning" }
    },
    "workforce_planning.shift_templates.create": {
      "permission": "workforce_planning.manage_shifts",
      "transaction": true,
      "sql": ["commands/shift_template_create.sql"],
      "schema": "schemas/shift_template_create.json",
      "emit": ["workforce_planning.shift_template.created"],
      "ai": { "description": "Creates a new reusable shift template for workforce planning" }
    },
    "workforce_planning.calendar.create": {
      "permission": "workforce_planning.manage_calendar",
      "transaction": true,
      "sql": ["commands/calendar_create.sql"],
      "schema": "schemas/calendar_create.json",
      "emit": ["workforce_planning.calendar.created"],
      "ai": { "description": "Creates a new event or period in the workforce planning calendar" }
    },
    "workforce_planning.coverage.create": {
      "permission": "workforce_planning.manage_coverage",
      "transaction": true,
      "sql": ["commands/coverage_create.sql"],
      "schema": "schemas/coverage_create.json",
      "emit": ["workforce_planning.coverage.created"],
      "ai": { "description": "Defines a minimum staffing coverage requirement for a time slot or location" }
    },
    "workforce_planning.assignments.create": {
      "permission": "workforce_planning.change_planning",
      "schema": "schemas/assignment_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_shift_assignment"
      },
      "emit": ["workforce_planning.assignment.created"],
      "ai": { "description": "Assigns a shift to an employee, validating availability and checking for conflicts" }
    }
  },
  "events": {
    "listen": []
  },
  "ui": {
    "entry": "dist/workforce_planning.esm.js"
  }
}
