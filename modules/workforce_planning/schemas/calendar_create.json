{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workforce_planning.calendar.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "name"],
  "properties": {
    "date": { "type": "string", "format": "date" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "calendar_type": {
      "type": "string",
      "enum": ["public_holiday", "regional_holiday", "company_holiday", "special_day"],
      "default": "public_holiday"
    },
    "region": { "type": ["string", "null"], "maxLength": 10, "default": null },
    "is_working_day": { "type": "integer", "enum": [0, 1], "default": 0 },
    "pay_multiplier": { "type": "number", "minimum": 0, "maximum": 9.99, "default": 2.0 },
    "recurring_yearly": { "type": "integer", "enum": [0, 1], "default": 0 },
    "notes": { "type": "string", "default": "" }
  }
}
