{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workforce_planning.assignments.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["employee_id", "employee_name", "location_id", "date", "start_time", "end_time"],
  "properties": {
    "employee_id": { "type": "string", "minLength": 1 },
    "employee_name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "location_id": { "type": "string", "minLength": 1 },
    "shift_template_id": { "type": ["string", "null"], "default": null },
    "date": { "type": "string", "format": "date" },
    "start_time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "end_time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "break_minutes": { "type": "integer", "minimum": 0, "default": 0 },
    "notes": { "type": "string", "default": "" },
    "force": { "type": "boolean", "default": false, "description": "Sobrescribe conflictos bloqueantes (double_booking / insufficient_rest)" }
  }
}
