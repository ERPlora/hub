{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workforce_planning.shift_templates.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "start_time", "end_time"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "location_id": { "type": ["string", "null"], "default": null },
    "start_time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "end_time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "break_minutes": { "type": "integer", "minimum": 0, "default": 0 },
    "color": { "type": "string", "maxLength": 7, "default": "#3b82f6" },
    "min_staff": { "type": "integer", "minimum": 0, "default": 1 },
    "max_staff": { "type": "integer", "minimum": 0, "default": 0 },
    "role_required": { "type": ["string", "null"], "maxLength": 100, "default": null },
    "required_skills": { "type": "string", "default": "[]", "description": "JSON array de nombres de skill" }
  }
}
