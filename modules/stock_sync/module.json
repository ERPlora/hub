{
  "id": "stock_sync",
  "name": "Stock Sync",
  "version": "1.0.0",
  "agent": {
    "description": "Synchronises stock levels across stores or external systems: manage sync channels, start and complete sync runs, detect and resolve stock conflicts.",
    "keywords": ["stock", "sync", "synchronisation", "conflict", "channel", "inventory"]
  },
  "depends_on": [],
  "permissions": [
    "stock_sync.view_sync",
    "stock_sync.sync",
    "stock_sync.resolve_conflict"
  ],
  "role_permissions": {
    "admin": ["*"],
    "manager": [
      "stock_sync.view_sync",
      "stock_sync.sync",
      "stock_sync.resolve_conflict"
    ],
    "employee": [
      "stock_sync.view_sync"
    ]
  },
  "navigation": [
    {
      "id": "runs",
      "label": "Sync Runs",
      "icon": "sync-outline",
      "component": "erp-stock-sync-runs"
    },
    {
      "id": "conflicts",
      "label": "Conflicts",
      "icon": "git-compare-outline",
      "component": "erp-stock-sync-conflicts"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "stock_sync.channels.list": {
      "permission": "stock_sync.view_sync",
      "sql": "queries/channels_list.sql",
      "ai": { "description": "Lists all configured stock synchronisation channels." }
    },
    "stock_sync.runs.list": {
      "permission": "stock_sync.view_sync",
      "sql": "queries/runs_list.sql",
      "ai": { "description": "Lists the history of stock synchronisation runs." }
    },
    "stock_sync.runs.items": {
      "permission": "stock_sync.view_sync",
      "sql": "queries/run_items_list.sql",
      "ai": { "description": "Lists the items processed during a specific synchronisation run." }
    },
    "stock_sync.conflicts.list": {
      "permission": "stock_sync.view_sync",
      "sql": "queries/conflicts_list.sql",
      "ai": { "description": "Lists stock conflicts that are pending resolution." }
    }
  },
  "commands": {
    "stock_sync.channels.create": {
      "permission": "stock_sync.sync",
      "transaction": true,
      "sql": [
        "commands/channel_create.sql"
      ],
      "schema": "schemas/channel_create.json",
      "emit": [
        "stock_sync.channel.created"
      ],
      "ai": { "description": "Creates a new stock synchronisation channel between stores or external systems." }
    },
    "stock_sync.items.record": {
      "permission": "stock_sync.sync",
      "transaction": true,
      "sql": [
        "commands/sync_item_record.sql"
      ],
      "schema": "schemas/sync_item_record.json",
      "emit": [
        "stock_sync.item.recorded"
      ],
      "ai": { "description": "Records a stock item processed during a synchronisation run." }
    },
    "stock_sync.runs.start": {
      "permission": "stock_sync.sync",
      "schema": "schemas/sync_start.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "start_sync"
      },
      "emit": [
        "stock_sync.run.started"
      ],
      "ai": { "description": "Starts a new stock synchronisation run." }
    },
    "stock_sync.runs.complete": {
      "permission": "stock_sync.sync",
      "schema": "schemas/sync_complete.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "complete_sync"
      },
      "emit": [
        "stock_sync.run.completed"
      ],
      "ai": { "description": "Marks a stock synchronisation run as completed." }
    },
    "stock_sync.conflicts.detect": {
      "permission": "stock_sync.sync",
      "schema": "schemas/conflict_detect.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "detect_conflict"
      },
      "emit": [
        "stock_sync.conflict.detected"
      ],
      "ai": { "description": "Detects stock conflicts between source and destination data." }
    },
    "stock_sync.conflicts.resolve": {
      "permission": "stock_sync.resolve_conflict",
      "schema": "schemas/conflict_resolve.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "resolve_conflict"
      },
      "emit": [
        "stock_sync.conflict.resolved"
      ],
      "ai": { "description": "Resolves a stock conflict by selecting the correct value." }
    }
  },
  "events": {
    "listen": []
  },
  "ui": {
    "entry": "dist/stock_sync.esm.js"
  }
}
