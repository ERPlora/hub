{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "stock_sync.conflicts.detect",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_channel_id", "target_channel_id", "product_ref", "source_qty", "target_qty"],
  "properties": {
    "source_channel_id": { "type": "string", "minLength": 1 },
    "target_channel_id": { "type": "string", "minLength": 1 },
    "product_ref": { "type": "string", "minLength": 1, "maxLength": 100 },
    "source_qty": { "type": "number", "minimum": 0 },
    "target_qty": { "type": "number", "minimum": 0 }
  }
}
