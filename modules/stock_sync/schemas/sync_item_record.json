{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "stock_sync.items.record",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "product_ref", "source_quantity", "target_quantity"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "product_ref": { "type": "string", "minLength": 1, "maxLength": 100 },
    "source_quantity": { "type": "number", "minimum": 0 },
    "target_quantity": { "type": "number", "minimum": 0 },
    "action": {
      "type": "string",
      "enum": ["push", "pull", "skip", "conflict"],
      "default": "push"
    }
  }
}
