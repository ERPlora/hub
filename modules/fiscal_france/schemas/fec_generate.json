{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fiscal_france.fec.generate",
  "type": "object",
  "additionalProperties": false,
  "required": ["period_start", "period_end", "entries"],
  "properties": {
    "period_start": { "type": "string", "format": "date" },
    "period_end": { "type": "string", "format": "date" },
    "format_type": { "type": "string", "enum": ["csv", "xml"], "default": "csv" },
    "entries": {
      "type": "array",
      "items": { "type": "object" },
      "default": []
    }
  }
}
