{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fiscal_france.config.update",
  "type": "object",
  "additionalProperties": false,
  "required": ["siret", "siren", "company_name"],
  "properties": {
    "siret": { "type": "string", "minLength": 14, "maxLength": 14, "pattern": "^[0-9]{14}$" },
    "siren": { "type": "string", "minLength": 9, "maxLength": 9, "pattern": "^[0-9]{9}$" },
    "company_name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "chorus_pro_environment": {
      "type": "string",
      "enum": ["qualif", "production"],
      "default": "qualif"
    }
  }
}
