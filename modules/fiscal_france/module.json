{
  "id": "fiscal_france",
  "name": "Fiscal France",
  "version": "1.0.0",
  "agent": {
    "description": "Handles French fiscal compliance: generates and submits Factur-X e-invoices, sends invoices to Chorus Pro for the public sector, and exports FEC accounting files.",
    "keywords": ["factur-x", "chorus pro", "fec", "france", "fiscal", "e-invoice", "public sector"]
  },
  "depends_on": [],
  "permissions": [
    "fiscal_france.view_fiscal_fr",
    "fiscal_france.submit_facturx",
    "fiscal_france.submit_chorus"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "fiscal_france.view_fiscal_fr",
      "fiscal_france.submit_facturx",
      "fiscal_france.submit_chorus"
    ],
    "employee": [
      "fiscal_france.view_fiscal_fr"
    ]
  },
  "navigation": [
    {
      "id": "factur_x",
      "label": "Factur-X",
      "icon": "shield-checkmark-outline",
      "component": "erp-fiscal-france-facturx"
    },
    {
      "id": "chorus",
      "label": "Chorus Pro",
      "icon": "shield-checkmark-outline",
      "component": "erp-fiscal-france-chorus"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "fiscal_france.config.get": {
      "permission": "fiscal_france.view_fiscal_fr",
      "sql": "queries/config_get.sql",
      "ai": { "description": "Retrieves the French fiscal configuration for the hub." }
    },
    "fiscal_france.facturx.list": {
      "permission": "fiscal_france.view_fiscal_fr",
      "sql": "queries/facturx_list.sql",
      "schema": "schemas/facturx_list.json",
      "ai": { "description": "Lists generated Factur-X e-invoices." }
    },
    "fiscal_france.chorus.list": {
      "permission": "fiscal_france.view_fiscal_fr",
      "sql": "queries/chorus_list.sql",
      "schema": "schemas/chorus_list.json",
      "ai": { "description": "Lists invoices submitted to the Chorus Pro portal." }
    },
    "fiscal_france.fec.list": {
      "permission": "fiscal_france.view_fiscal_fr",
      "sql": "queries/fec_list.sql",
      "schema": "schemas/fec_list.json",
      "ai": { "description": "Lists generated FEC (Fichier des Écritures Comptables) accounting export files." }
    }
  },
  "commands": {
    "fiscal_france.config.update": {
      "permission": "fiscal_france.submit_facturx",
      "schema": "schemas/config_update.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "update_config"
      },
      "emit": [
        "fiscal_france.config.updated"
      ],
      "ai": { "description": "Updates the French fiscal configuration for the hub." }
    },
    "fiscal_france.facturx.create": {
      "permission": "fiscal_france.submit_facturx",
      "schema": "schemas/facturx_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_facturx"
      },
      "emit": [
        "fiscal_france.facturx.created"
      ],
      "ai": { "description": "Creates a new Factur-X record from an existing invoice." }
    },
    "fiscal_france.facturx.generate_xml": {
      "permission": "fiscal_france.submit_facturx",
      "schema": "schemas/facturx_generate_xml.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "generate_facturx_xml"
      },
      "emit": [
        "fiscal_france.facturx.generated"
      ],
      "ai": { "description": "Generates the Factur-X XML embedded in the invoice PDF." }
    },
    "fiscal_france.facturx.submit": {
      "permission": "fiscal_france.submit_facturx",
      "schema": "schemas/facturx_submit.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "submit_facturx"
      },
      "emit": [
        "fiscal_france.facturx.submitted"
      ],
      "ai": { "description": "Submits a Factur-X invoice to the recipient or fiscal platform." }
    },
    "fiscal_france.chorus.create": {
      "permission": "fiscal_france.submit_chorus",
      "schema": "schemas/chorus_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_chorus_invoice"
      },
      "emit": [
        "fiscal_france.chorus.created"
      ],
      "ai": { "description": "Creates an invoice for submission to the Chorus Pro portal (French public sector)." }
    },
    "fiscal_france.chorus.submit": {
      "permission": "fiscal_france.submit_chorus",
      "transaction": true,
      "sql": [
        "commands/chorus_submit.sql"
      ],
      "schema": "schemas/chorus_submit.json",
      "emit": [
        "fiscal_france.chorus.uploaded"
      ],
      "ai": { "description": "Submits an invoice to the Chorus Pro portal and records the submission result." }
    },
    "fiscal_france.chorus.update_status": {
      "permission": "fiscal_france.submit_chorus",
      "schema": "schemas/chorus_update_status.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "update_chorus_status"
      },
      "emit": [
        "fiscal_france.chorus.status_changed"
      ],
      "ai": { "description": "Updates the processing status of an invoice in Chorus Pro." }
    },
    "fiscal_france.fec.generate": {
      "permission": "fiscal_france.view_fiscal_fr",
      "schema": "schemas/fec_generate.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "generate_fec"
      },
      "emit": [
        "fiscal_france.fec.generated"
      ],
      "ai": { "description": "Generates the FEC accounting export file required by the French tax authority." }
    },
    "fiscal_france._insert_config": {
      "permission": "fiscal_france.submit_facturx",
      "sql": [
        "commands/_insert_config.sql"
      ]
    },
    "fiscal_france._update_config": {
      "permission": "fiscal_france.submit_facturx",
      "sql": [
        "commands/_update_config.sql"
      ]
    },
    "fiscal_france._insert_facturx": {
      "permission": "fiscal_france.submit_facturx",
      "sql": [
        "commands/_insert_facturx.sql"
      ]
    },
    "fiscal_france._set_facturx_xml": {
      "permission": "fiscal_france.submit_facturx",
      "sql": [
        "commands/_set_facturx_xml.sql"
      ]
    },
    "fiscal_france._set_facturx_submitted": {
      "permission": "fiscal_france.submit_facturx",
      "sql": [
        "commands/_set_facturx_submitted.sql"
      ]
    },
    "fiscal_france._insert_chorus": {
      "permission": "fiscal_france.submit_chorus",
      "sql": [
        "commands/_insert_chorus.sql"
      ]
    },
    "fiscal_france._set_chorus_status": {
      "permission": "fiscal_france.submit_chorus",
      "sql": [
        "commands/_set_chorus_status.sql"
      ]
    },
    "fiscal_france._insert_fec": {
      "permission": "fiscal_france.view_fiscal_fr",
      "sql": [
        "commands/_insert_fec.sql"
      ]
    }
  },
  "events": {
    "listen": []
  },
  "ui": {
    "entry": "dist/fiscal_france.esm.js"
  }
}
