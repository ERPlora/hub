{
  "id": "commissions",
  "name": "Commissions",
  "version": "1.0.8",
  "agent": {
    "description": "Manages employee commissions: configure calculation rules, accrue commission transactions from sales, approve and process payouts, and apply manual adjustments.",
    "keywords": ["commissions", "payout", "sales commission", "employee", "rule", "adjustment", "transaction"]
  },
  "depends_on": ["staff", "services", "inventory", "sales", "appointments"],
  "permissions": [
    "commissions.view_transaction",
    "commissions.add_transaction",
    "commissions.approve_transaction",
    "commissions.view_rule",
    "commissions.add_rule",
    "commissions.change_rule",
    "commissions.delete_rule",
    "commissions.view_payout",
    "commissions.add_payout",
    "commissions.approve_payout",
    "commissions.process_payout",
    "commissions.view_adjustment",
    "commissions.add_adjustment",
    "commissions.delete_adjustment",
    "commissions.manage_settings",
    "commissions.calculate"
  ],
  "role_permissions": {
    "admin": ["*"],
    "manager": [
      "commissions.view_transaction",
      "commissions.approve_transaction",
      "commissions.view_rule",
      "commissions.add_rule",
      "commissions.change_rule",
      "commissions.view_payout",
      "commissions.add_payout",
      "commissions.approve_payout",
      "commissions.process_payout",
      "commissions.view_adjustment",
      "commissions.add_adjustment",
      "commissions.calculate"
    ],
    "employee": [
      "commissions.view_transaction",
      "commissions.view_rule",
      "commissions.view_payout",
      "commissions.view_adjustment"
    ]
  },
  "navigation": [
    {
      "id": "transactions",
      "label": "Transactions",
      "icon": "receipt-outline",
      "component": "erp-commissions-transactions"
    },
    {
      "id": "payouts",
      "label": "Payouts",
      "icon": "cash-outline",
      "component": "erp-commissions-payouts"
    },
    {
      "id": "rules",
      "label": "Rules",
      "icon": "options-outline",
      "component": "erp-commissions-rules"
    },
    {
      "id": "adjustments",
      "label": "Adjustments",
      "icon": "swap-horizontal-outline",
      "component": "erp-commissions-adjustments"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "commissions.rules.list": {
      "permission": "commissions.view_rule",
      "sql": "queries/rules_list.sql",
      "schema": "schemas/rules_list.json",
      "ai": { "description": "Lists the configured commission calculation rules" }
    },
    "commissions.rules.get": {
      "permission": "commissions.view_rule",
      "sql": "queries/rule_get.sql",
      "schema": "schemas/rule_get.json",
      "ai": { "description": "Returns the details of a commission rule" }
    },
    "commissions.transactions.list": {
      "permission": "commissions.view_transaction",
      "sql": "queries/transactions_list.sql",
      "schema": "schemas/transactions_list.json",
      "ai": { "description": "Lists the commission transactions accrued for employees" }
    },
    "commissions.payouts.list": {
      "permission": "commissions.view_payout",
      "sql": "queries/payouts_list.sql",
      "schema": "schemas/payouts_list.json",
      "ai": { "description": "Lists commission payouts that have been processed or are pending" }
    },
    "commissions.adjustments.list": {
      "permission": "commissions.view_adjustment",
      "sql": "queries/adjustments_list.sql",
      "schema": "schemas/adjustments_list.json",
      "ai": { "description": "Lists manual adjustments applied to employee commissions" }
    },
    "commissions.settings.get": {
      "permission": "commissions.view_rule",
      "sql": "queries/settings_get.sql",
      "schema": "schemas/settings_get.json",
      "ai": { "description": "Returns the general settings of the commissions module" }
    }
  },
  "commands": {
    "commissions.rules.create": {
      "permission": "commissions.add_rule",
      "transaction": true,
      "sql": ["commands/rule_create.sql"],
      "schema": "schemas/rule_create.json",
      "emit": ["commissions.rule.created"],
      "ai": { "description": "Creates a new commission calculation rule" }
    },
    "commissions.rules.update": {
      "permission": "commissions.change_rule",
      "transaction": true,
      "sql": ["commands/rule_update.sql"],
      "schema": "schemas/rule_update.json",
      "emit": ["commissions.rule.updated"],
      "ai": { "description": "Updates the parameters of an existing commission rule" }
    },
    "commissions.rules.delete": {
      "permission": "commissions.delete_rule",
      "transaction": true,
      "sql": ["commands/rule_delete.sql"],
      "schema": "schemas/rule_delete.json",
      "emit": ["commissions.rule.deleted"],
      "ai": { "description": "Deletes a commission rule (destructive)" }
    },
    "commissions.transactions.approve": {
      "permission": "commissions.approve_transaction",
      "transaction": true,
      "sql": ["commands/transaction_approve.sql"],
      "schema": "schemas/transaction_approve.json",
      "emit": ["commissions.transaction.approved"],
      "ai": { "description": "Approves a pending commission transaction for inclusion in a payout" }
    },
    "commissions.payouts.approve": {
      "permission": "commissions.approve_payout",
      "transaction": true,
      "sql": ["commands/payout_approve.sql"],
      "schema": "schemas/payout_approve.json",
      "emit": ["commissions.payout.approved"],
      "ai": { "description": "Approves a commission payout so it can be processed" }
    },
    "commissions.adjustments.create": {
      "permission": "commissions.add_adjustment",
      "transaction": true,
      "sql": ["commands/adjustment_create.sql"],
      "schema": "schemas/adjustment_create.json",
      "emit": ["commissions.adjustment.created"],
      "ai": { "description": "Creates a manual adjustment to an employee's commission balance" }
    },
    "commissions.adjustments.delete": {
      "permission": "commissions.delete_adjustment",
      "transaction": true,
      "sql": ["commands/adjustment_delete.sql"],
      "schema": "schemas/adjustment_delete.json",
      "emit": ["commissions.adjustment.deleted"],
      "ai": { "description": "Deletes a manual commission adjustment (destructive)" }
    },
    "commissions.settings.upsert": {
      "permission": "commissions.manage_settings",
      "transaction": true,
      "sql": ["commands/settings_upsert.sql"],
      "schema": "schemas/settings_upsert.json",
      "emit": ["commissions.settings.updated"],
      "ai": { "description": "Saves or updates the general settings of the commissions module" }
    },
    "commissions.payouts.create": {
      "permission": "commissions.add_payout",
      "schema": "schemas/payout_create.json",
      "handler": { "type": "wasm", "file": "dist/handler.wasm", "function": "create_payout" },
      "emit": ["commissions.payout.created"],
      "ai": { "description": "Creates a new commission payout by grouping approved transactions" }
    },
    "commissions.payouts.process": {
      "permission": "commissions.process_payout",
      "schema": "schemas/payout_process.json",
      "handler": { "type": "wasm", "file": "dist/handler.wasm", "function": "process_payout" },
      "emit": ["commissions.payout.completed"],
      "ai": { "description": "Processes and marks an approved commission payout as completed" }
    },
    "commissions.calculate": {
      "permission": "commissions.calculate",
      "schema": "schemas/calculate.json",
      "handler": { "type": "wasm", "file": "dist/handler.wasm", "function": "calculate_commission" },
      "ai": { "description": "Calculates the commission amount for a sale by applying the active rules" }
    },
    "commissions.transactions.accrue_from_sale": {
      "permission": "commissions.add_transaction",
      "schema": "schemas/accrue_from_sale.json",
      "handler": { "type": "wasm", "file": "dist/handler.wasm", "function": "accrue_from_sale" },
      "emit": ["commissions.transaction.created"],
      "ai": { "description": "Accrues commission transactions for employees from a completed sale" }
    }
  },
  "events": {
    "listen": [
      {
        "event": "sales.completed",
        "command": "commissions.transactions.accrue_from_sale"
      }
    ]
  },
  "ui": {
    "entry": "dist/commissions.esm.js"
  }
}
