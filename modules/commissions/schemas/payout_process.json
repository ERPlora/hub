{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "commissions.payouts.process",
  "type": "object",
  "additionalProperties": false,
  "required": ["payout_id"],
  "properties": {
    "payout_id": { "type": "string", "minLength": 1 },
    "payment_method": {
      "type": "string",
      "enum": ["", "cash", "bank_transfer", "check", "payroll", "other"],
      "default": ""
    },
    "payment_reference": { "type": "string", "default": "", "maxLength": 100 }
  }
}
