{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "commissions.rules.update",
  "type": "object",
  "additionalProperties": false,
  "required": ["rule_id"],
  "properties": {
    "rule_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "default": "", "maxLength": 100 },
    "description": { "type": ["string", "null"], "default": null },
    "rule_type": { "type": "string", "enum": ["", "flat", "percentage", "tiered"], "default": "" },
    "rate": { "type": ["number", "null"], "minimum": 0, "default": null },
    "tier_thresholds": { "type": "string", "default": "" },
    "effective_from": { "type": ["string", "null"], "format": "date", "default": null },
    "effective_until": { "type": ["string", "null"], "format": "date", "default": null },
    "priority": { "type": "integer", "default": -1 },
    "is_active": { "type": "integer", "enum": [-1, 0, 1], "default": -1 }
  }
}
