{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "commissions.rules.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "rule_type", "rate"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "default": "" },
    "rule_type": {
      "type": "string",
      "enum": ["flat", "percentage", "tiered"],
      "default": "percentage"
    },
    "rate": { "type": "number", "minimum": 0 },
    "staff_id": { "type": ["string", "null"], "default": null },
    "service_id": { "type": ["string", "null"], "default": null },
    "category_id": { "type": ["string", "null"], "default": null },
    "product_id": { "type": ["string", "null"], "default": null },
    "tier_thresholds": { "type": "string", "default": "[]" },
    "effective_from": { "type": ["string", "null"], "format": "date", "default": null },
    "effective_until": { "type": ["string", "null"], "format": "date", "default": null },
    "priority": { "type": "integer", "minimum": 0, "default": 0 }
  }
}
