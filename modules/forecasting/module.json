{
  "id": "forecasting",
  "name": "Forecasting",
  "version": "1.0.0",
  "agent": {
    "description": "Manages forecasting models and runs predictions: creates and configures prediction models, executes forecasts, and records accuracy metrics against actual values.",
    "keywords": ["forecast", "prediction", "model", "time series", "accuracy", "analytics", "demand"]
  },
  "depends_on": [],
  "permissions": [
    "forecasting.view_forecast",
    "forecasting.manage_model",
    "forecasting.run_forecast"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "forecasting.view_forecast",
      "forecasting.manage_model",
      "forecasting.run_forecast"
    ],
    "employee": [
      "forecasting.view_forecast"
    ]
  },
  "navigation": [
    {
      "id": "models",
      "label": "Models",
      "icon": "analytics-outline",
      "component": "erp-forecasting-models"
    },
    {
      "id": "forecasts",
      "label": "Forecasts",
      "icon": "analytics-outline",
      "component": "erp-forecasting-forecasts"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "forecasting.models.list": {
      "permission": "forecasting.view_forecast",
      "sql": "queries/models_list.sql",
      "ai": { "description": "Lists the forecasting models configured in the system." }
    },
    "forecasting.models.get": {
      "permission": "forecasting.view_forecast",
      "sql": "queries/model_get.sql",
      "ai": { "description": "Retrieves the full detail of a forecasting model by its ID." }
    },
    "forecasting.forecasts.list": {
      "permission": "forecasting.view_forecast",
      "sql": "queries/forecasts_list.sql",
      "ai": { "description": "Lists generated forecasts with their status and accuracy metrics." }
    },
    "forecasting.forecasts.get": {
      "permission": "forecasting.view_forecast",
      "sql": "queries/forecast_get.sql",
      "ai": { "description": "Retrieves the full detail of a specific forecast run by its ID." }
    },
    "forecasting.points.list": {
      "permission": "forecasting.view_forecast",
      "sql": "queries/points_list.sql",
      "ai": { "description": "Lists the data points of a time series used by forecasting models." }
    }
  },
  "commands": {
    "forecasting.models.create": {
      "permission": "forecasting.manage_model",
      "transaction": true,
      "sql": [
        "commands/model_create.sql"
      ],
      "schema": "schemas/model_create.json",
      "emit": [
        "forecasting.model.created"
      ],
      "ai": { "description": "Creates a new forecasting model with its algorithm configuration and parameters." }
    },
    "forecasting.models.update": {
      "permission": "forecasting.manage_model",
      "transaction": true,
      "sql": [
        "commands/model_update.sql"
      ],
      "schema": "schemas/model_update.json",
      "emit": [
        "forecasting.model.updated"
      ],
      "ai": { "description": "Updates the configuration of an existing forecasting model." }
    },
    "forecasting.models.deactivate": {
      "permission": "forecasting.manage_model",
      "transaction": true,
      "sql": [
        "commands/model_deactivate.sql"
      ],
      "schema": "schemas/model_deactivate.json",
      "emit": [
        "forecasting.model.deactivated"
      ],
      "ai": { "description": "Deactivates a forecasting model so it is no longer used in new forecast runs." }
    },
    "forecasting.forecasts.run": {
      "permission": "forecasting.run_forecast",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "run_forecast"
      },
      "schema": "schemas/forecast_run.json",
      "emit": [
        "forecasting.forecast.completed"
      ],
      "ai": { "description": "Executes a forecast using the selected model and generates the forecast data points." }
    },
    "forecasting.forecasts.record_accuracy": {
      "permission": "forecasting.manage_model",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "record_accuracy"
      },
      "schema": "schemas/forecast_record_accuracy.json",
      "emit": [
        "forecasting.forecast.accuracy_recorded"
      ],
      "ai": { "description": "Records the actual accuracy of a forecast by comparing predicted values against real outcomes." }
    }
  },
  "events": {
    "listen": []
  },
  "ui": {
    "entry": "dist/forecasting.esm.js"
  }
}
