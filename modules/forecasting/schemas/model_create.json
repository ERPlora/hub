{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "forecasting.models.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "name", "model_type", "target_metric"],
  "properties": {
    "code": { "type": "string", "minLength": 1, "maxLength": 64 },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "model_type": {
      "type": "string",
      "enum": ["moving_average", "linear_trend", "exponential_smoothing", "seasonal", "manual"],
      "default": "moving_average"
    },
    "target_metric": {
      "type": "string",
      "enum": ["sales", "demand", "cashflow", "inventory"],
      "default": "sales"
    },
    "parameters": { "type": "object", "default": {} },
    "training_period_days": { "type": "integer", "minimum": 1, "default": 90 }
  }
}
