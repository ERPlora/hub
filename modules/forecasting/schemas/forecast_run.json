{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "forecasting.forecasts.run",
  "type": "object",
  "additionalProperties": false,
  "required": ["model_id"],
  "properties": {
    "model_id": { "type": "string", "minLength": 1 },
    "horizon_periods": { "type": "integer", "minimum": 1, "default": 12 },
    "period_unit": {
      "type": "string",
      "enum": ["day", "week", "month", "quarter"],
      "default": "month"
    },
    "historical_data": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "value": { "type": "number" },
          "y": { "type": "number" },
          "amount": { "type": "number" }
        }
      }
    }
  }
}
