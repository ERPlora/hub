{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "forecasting.models.update",
  "type": "object",
  "additionalProperties": false,
  "required": ["model_id", "name", "model_type", "target_metric", "parameters", "training_period_days", "is_active"],
  "properties": {
    "model_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "model_type": {
      "type": "string",
      "enum": ["moving_average", "linear_trend", "exponential_smoothing", "seasonal", "manual"]
    },
    "target_metric": {
      "type": "string",
      "enum": ["sales", "demand", "cashflow", "inventory"]
    },
    "parameters": { "type": "object" },
    "training_period_days": { "type": "integer", "minimum": 1 },
    "is_active": { "type": "boolean" }
  }
}
