{
  "id": "customers",
  "name": "Customers",
  "version": "2.2.10",
  "manifest_kind": "declarative",
  "depends_on": [],
  "permissions": [
    "customers.view_customer", "customers.add_customer", "customers.change_customer",
    "customers.delete_customer", "customers.export_customer",
    "customers.view_customergroup", "customers.add_customergroup",
    "customers.change_customergroup", "customers.delete_customergroup",
    "customers.view_customertag", "customers.add_customertag",
    "customers.change_customertag", "customers.delete_customertag",
    "customers.view_activity", "customers.add_note",
    "customers.manage_custom_fields", "customers.manage_settings"
  ],
  "role_permissions": {
    "admin": ["*"],
    "manager": [
      "customers.add_customer", "customers.add_customergroup", "customers.add_customertag",
      "customers.add_note", "customers.change_customer", "customers.change_customergroup",
      "customers.change_customertag", "customers.export_customer", "customers.manage_custom_fields",
      "customers.view_activity", "customers.view_customer", "customers.view_customergroup",
      "customers.view_customertag"
    ],
    "employee": [
      "customers.add_customer", "customers.add_note", "customers.view_activity",
      "customers.view_customer", "customers.view_customergroup", "customers.view_customertag"
    ]
  },
  "navigation": [
    { "id": "customers", "label": "Customers", "icon": "users", "component": "erp-customers-list" }
  ],
  "migrations": { "sqlite": ["migrations/sqlite/001_init.sql"] },
  "queries": {
    "customers.list":         { "permission": "customers.view_customer",      "sql": "queries/list.sql" },
    "customers.get":          { "permission": "customers.view_customer",      "sql": "queries/get.sql" },
    "customers.stats":        { "permission": "customers.view_customer",      "sql": "queries/stats.sql" },
    "customers.groups.list":  { "permission": "customers.view_customergroup", "sql": "queries/groups_list.sql" },
    "customers.tags.list":    { "permission": "customers.view_customertag",   "sql": "queries/tags_list.sql" },
    "customers.fields.list":  { "permission": "customers.view_customer",      "sql": "queries/fields_list.sql" },
    "customers.activities":   { "permission": "customers.view_activity",      "sql": "queries/activities.sql" }
  },
  "commands": {
    "customers.create": { "permission": "customers.add_customer", "transaction": true, "sql": ["commands/create.sql"], "emit": ["customer.created"] },
    "customers.update": { "permission": "customers.change_customer", "transaction": true, "sql": ["commands/update.sql"], "emit": ["customer.updated"] },
    "customers.delete": { "permission": "customers.delete_customer", "transaction": true, "sql": ["commands/delete.sql"], "emit": ["customer.deleted"] },
    "customers.record_purchase": { "permission": "customers.change_customer", "transaction": true, "sql": ["commands/record_purchase.sql"] },
    "customers.bulk_create": { "permission": "customers.add_customer", "handler": { "type": "wasm", "file": "dist/handler.wasm", "function": "bulk_create" } },
    "customers.set_groups": { "permission": "customers.change_customer", "handler": { "type": "wasm", "file": "dist/handler.wasm", "function": "set_groups" } },
    "customers.set_tags": { "permission": "customers.change_customer", "handler": { "type": "wasm", "file": "dist/handler.wasm", "function": "set_tags" } },
    "customers.groups.create": { "permission": "customers.add_customergroup", "transaction": true, "sql": ["commands/group_create.sql"] },
    "customers.groups.update": { "permission": "customers.change_customergroup", "transaction": true, "sql": ["commands/group_update.sql"] },
    "customers.groups.delete": { "permission": "customers.delete_customergroup", "transaction": true, "sql": ["commands/group_delete.sql"] },
    "customers.tags.create": { "permission": "customers.add_customertag", "transaction": true, "sql": ["commands/tag_create.sql"] },
    "customers.tags.update": { "permission": "customers.change_customertag", "transaction": true, "sql": ["commands/tag_update.sql"] },
    "customers.tags.delete": { "permission": "customers.delete_customertag", "transaction": true, "sql": ["commands/tag_delete.sql"] },
    "customers.fields.create": { "permission": "customers.manage_custom_fields", "transaction": true, "sql": ["commands/field_create.sql"] },
    "customers.fields.update": { "permission": "customers.manage_custom_fields", "transaction": true, "sql": ["commands/field_update.sql"] },
    "customers.fields.delete": { "permission": "customers.manage_custom_fields", "transaction": true, "sql": ["commands/field_delete.sql"] },
    "customers.notes.add": { "permission": "customers.add_note", "transaction": true, "sql": ["commands/note_create.sql"] },
    "customers.activity.add": { "permission": "customers.view_activity", "transaction": true, "sql": ["commands/activity_add.sql"] },
    "customers._group_clear": { "permission": "customers.change_customer", "sql": ["commands/_group_clear.sql"] },
    "customers._group_add": { "permission": "customers.change_customer", "sql": ["commands/_group_add.sql"] },
    "customers._tag_clear": { "permission": "customers.change_customer", "sql": ["commands/_tag_clear.sql"] },
    "customers._tag_add": { "permission": "customers.change_customer", "sql": ["commands/_tag_add.sql"] },
    "customers._field_value_set": { "permission": "customers.change_customer", "sql": ["commands/_field_value_set.sql"] }
  },
  "events": {
    "listen": {
      "sale.completed": { "command": "customers.record_purchase" }
    }
  },
  "ui": { "entry": "dist/customers.esm.js" }
}
