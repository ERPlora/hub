{
  "id": "glovo",
  "name": "Glovo",
  "version": "1.0.0",
  "agent": {
    "description": "Manages Glovo delivery integration: configure stores, sync product menus, import incoming orders, and track order status.",
    "keywords": ["glovo", "delivery", "orders", "menu", "sync", "store", "import"]
  },
  "depends_on": [],
  "permissions": [
    "glovo.view_glovo",
    "glovo.manage_glovo",
    "glovo.sync_glovo"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "glovo.view_glovo",
      "glovo.manage_glovo",
      "glovo.sync_glovo"
    ],
    "employee": [
      "glovo.view_glovo"
    ]
  },
  "navigation": [
    {
      "id": "stores",
      "label": "Stores",
      "icon": "bicycle-outline",
      "component": "erp-glovo-stores"
    },
    {
      "id": "orders",
      "label": "Orders",
      "icon": "receipt-outline",
      "component": "erp-glovo-orders"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "glovo.stores.list": {
      "permission": "glovo.view_glovo",
      "sql": "queries/stores_list.sql",
      "schema": "schemas/stores_list.json",
      "ai": { "description": "Lists the Glovo stores configured in the hub." }
    },
    "glovo.orders.list": {
      "permission": "glovo.view_glovo",
      "sql": "queries/orders_list.sql",
      "schema": "schemas/orders_list.json",
      "ai": { "description": "Lists orders received from Glovo." }
    },
    "glovo.orders.get": {
      "permission": "glovo.view_glovo",
      "sql": "queries/order_get.sql",
      "schema": "schemas/order_get.json",
      "ai": { "description": "Retrieves the full detail of a Glovo order by its identifier." }
    },
    "glovo.products.list": {
      "permission": "glovo.view_glovo",
      "sql": "queries/products_list.sql",
      "schema": "schemas/products_list.json",
      "ai": { "description": "Lists products published in the Glovo menu." }
    },
    "glovo.menu_syncs.list": {
      "permission": "glovo.view_glovo",
      "sql": "queries/menu_syncs_list.sql",
      "schema": "schemas/menu_syncs_list.json",
      "ai": { "description": "Lists the history of menu synchronizations with Glovo." }
    }
  },
  "commands": {
    "glovo.stores.create": {
      "permission": "glovo.manage_glovo",
      "transaction": true,
      "sql": [
        "commands/store_create.sql"
      ],
      "schema": "schemas/store_create.json",
      "emit": [
        "glovo.store.created"
      ],
      "ai": { "description": "Creates a new Glovo store associated with the hub." }
    },
    "glovo.stores.update_status": {
      "permission": "glovo.sync_glovo",
      "transaction": true,
      "sql": [
        "commands/store_update_status.sql"
      ],
      "schema": "schemas/store_update_status.json",
      "emit": [
        "glovo.store.status_changed"
      ],
      "ai": { "description": "Updates the operational status of a Glovo store (open, closed, etc.)." }
    },
    "glovo.orders.update_status": {
      "permission": "glovo.sync_glovo",
      "transaction": true,
      "sql": [
        "commands/order_update_status.sql"
      ],
      "schema": "schemas/order_update_status.json",
      "emit": [
        "glovo.order.status_changed"
      ],
      "ai": { "description": "Updates the status of a Glovo order (accepted, preparing, delivered, etc.)." }
    },
    "glovo.menu_syncs.start": {
      "permission": "glovo.sync_glovo",
      "transaction": true,
      "sql": [
        "commands/start_menu_sync.sql"
      ],
      "schema": "schemas/start_menu_sync.json",
      "emit": [
        "glovo.menu_sync.started"
      ],
      "ai": { "description": "Starts a product menu synchronization toward Glovo." }
    },
    "glovo.orders.import": {
      "permission": "glovo.sync_glovo",
      "schema": "schemas/import_order.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "import_order"
      },
      "emit": [
        "glovo.order.imported"
      ],
      "ai": { "description": "Imports an incoming Glovo order and registers it in the system." }
    },
    "glovo.menu_syncs.complete": {
      "permission": "glovo.sync_glovo",
      "schema": "schemas/complete_menu_sync.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "complete_menu_sync"
      },
      "emit": [
        "glovo.menu_sync.completed"
      ],
      "ai": { "description": "Marks a Glovo menu synchronization as completed." }
    },
    "glovo.products.sync": {
      "permission": "glovo.sync_glovo",
      "schema": "schemas/sync_product.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "sync_product"
      },
      "emit": [
        "glovo.product.synced"
      ],
      "ai": { "description": "Syncs a product from the local catalog to the Glovo menu." }
    }
  },
  "events": {
    "listen": {}
  },
  "ui": {
    "entry": "dist/glovo.esm.js"
  }
}
