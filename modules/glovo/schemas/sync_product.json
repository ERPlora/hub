{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "glovo.products.sync",
  "type": "object",
  "additionalProperties": false,
  "required": ["store_id_internal", "glovo_product_id", "name", "price"],
  "properties": {
    "store_id_internal": { "type": "string", "minLength": 1 },
    "glovo_product_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "local_product_ref": { "type": "string", "default": "", "maxLength": 100 },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "price": { "type": ["number", "string"], "minimum": 0 },
    "is_available": { "type": "boolean", "default": true }
  }
}
