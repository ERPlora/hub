{
  "id": "attendance",
  "name": "Attendance & Clock-in",
  "version": "2.0.8",
  "agent": {
    "description": "Tracks employee attendance and clock-in/clock-out records: registers work start and end times, lists open shifts, corrects records, and manages attendance settings.",
    "keywords": ["attendance", "clock-in", "clock-out", "timekeeping", "shift", "employee", "presence"]
  },
  "depends_on": [
    "staff"
  ],
  "permissions": [
    "attendance.view_attendance",
    "attendance.add_attendance",
    "attendance.change_attendance",
    "attendance.delete_attendance",
    "attendance.manage_settings"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "attendance.view_attendance",
      "attendance.add_attendance",
      "attendance.change_attendance",
      "attendance.delete_attendance",
      "attendance.manage_settings"
    ],
    "employee": [
      "attendance.view_attendance",
      "attendance.add_attendance"
    ]
  },
  "navigation": [
    {
      "id": "records",
      "label": "Records",
      "icon": "time-outline",
      "component": "erp-attendance-records"
    },
    {
      "id": "settings",
      "label": "Settings",
      "icon": "settings-outline",
      "component": "erp-attendance-settings"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "attendance.records.list": {
      "permission": "attendance.view_attendance",
      "sql": "queries/records_list.sql",
      "schema": "schemas/records_list.json",
      "ai": { "description": "Lists staff attendance and clock-in records with filters by date and employee." }
    },
    "attendance.records.open": {
      "permission": "attendance.view_attendance",
      "sql": "queries/records_open.sql",
      "schema": "schemas/records_open.json",
      "ai": { "description": "Lists open attendance records for employees who have clocked in but not yet clocked out." }
    },
    "attendance.settings.get": {
      "permission": "attendance.manage_settings",
      "sql": "queries/settings_get.sql",
      "ai": { "description": "Retrieves the configuration of the attendance and clock-in module." }
    }
  },
  "commands": {
    "attendance.records.clock_in": {
      "permission": "attendance.add_attendance",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "clock_in"
      },
      "emit": [
        "attendance.record.clocked_in"
      ],
      "ai": { "description": "Records an employee's clock-in (work start time)." }
    },
    "attendance.records.clock_out": {
      "permission": "attendance.add_attendance",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "clock_out"
      },
      "emit": [
        "attendance.record.clocked_out"
      ],
      "ai": { "description": "Records an employee's clock-out (work end time)." }
    },
    "attendance.records.update": {
      "permission": "attendance.change_attendance",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "update_record"
      },
      "emit": [
        "attendance.record.updated"
      ],
      "ai": { "description": "Updates an attendance record to correct a clock-in or clock-out time." }
    },
    "attendance.records.delete": {
      "permission": "attendance.delete_attendance",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "delete_record"
      },
      "emit": [
        "attendance.record.deleted"
      ],
      "ai": { "description": "Permanently deletes an attendance record (destructive)." }
    },
    "attendance.settings.update": {
      "permission": "attendance.manage_settings",
      "transaction": true,
      "sql": [
        "commands/settings_update.sql"
      ],
      "schema": "schemas/settings_update.json",
      "emit": [
        "attendance.settings.updated"
      ],
      "ai": { "description": "Updates the configuration of the attendance and clock-in module." }
    },
    "attendance._insert_record": {
      "permission": "attendance.add_attendance",
      "sql": [
        "commands/_insert_record.sql"
      ]
    },
    "attendance._close_record": {
      "permission": "attendance.add_attendance",
      "sql": [
        "commands/_close_record.sql"
      ]
    },
    "attendance._update_record": {
      "permission": "attendance.change_attendance",
      "sql": [
        "commands/_update_record.sql"
      ]
    },
    "attendance._delete_record": {
      "permission": "attendance.delete_attendance",
      "sql": [
        "commands/_delete_record.sql"
      ]
    },
    "attendance._insert_settings": {
      "permission": "attendance.manage_settings",
      "sql": [
        "commands/_insert_settings.sql"
      ]
    }
  },
  "events": {
    "listen": [
      "staff.member_deactivated"
    ]
  },
  "ui": {
    "entry": "dist/attendance.esm.js"
  }
}
