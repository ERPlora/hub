{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai_reports.requests.stats",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "since_iso": {
      "type": "string",
      "description": "ISO 8601 timestamp; only requests with created_at >= since_iso are aggregated.",
      "format": "date-time"
    }
  },
  "required": ["since_iso"]
}
