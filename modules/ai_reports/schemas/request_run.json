{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai_reports.requests.run",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "llm_response"],
  "properties": {
    "request_id": { "type": "string", "minLength": 1 },
    "llm_response": { "type": "string" },
    "tokens_used": { "type": "integer", "minimum": 0, "default": 0 },
    "cost_eur": {
      "type": "string",
      "description": "Decimal string with up to 6 fractional digits (EUR).",
      "default": "0.00"
    },
    "prompt_used": { "type": "string", "default": "" }
  }
}
