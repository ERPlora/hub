{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "courier_integrations.connections.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["courier_code", "name", "api_endpoint"],
  "properties": {
    "courier_code": {
      "type": "string",
      "enum": ["seur", "mrw", "gls", "dhl", "ups", "correos", "nacex"]
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "api_endpoint": { "type": "string", "minLength": 1, "maxLength": 500 },
    "account_number": { "type": "string", "default": "", "maxLength": 100 },
    "environment": {
      "type": "string",
      "enum": ["test", "production"],
      "default": "test"
    }
  }
}
