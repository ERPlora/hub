{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "courier_integrations.calls.record",
  "type": "object",
  "additionalProperties": false,
  "required": ["connection_id", "call_type", "request_payload"],
  "properties": {
    "connection_id": { "type": "string", "minLength": 1 },
    "call_type": {
      "type": "string",
      "enum": ["create_shipment", "get_label", "track_shipment", "cancel_shipment", "get_rate"]
    },
    "request_payload": { "type": "object" },
    "response_payload": { "type": ["object", "null"], "default": null },
    "status_code": { "type": ["integer", "null"], "default": null },
    "status": {
      "type": "string",
      "enum": ["success", "failed", "timeout"],
      "default": "success"
    },
    "response_time_ms": { "type": "integer", "minimum": 0, "default": 0 },
    "error_message": { "type": ["string", "null"], "default": null }
  }
}
