{
  "id": "courier_integrations",
  "name": "Courier Integrations",
  "version": "1.0.0",
  "agent": {
    "description": "Manages courier and shipping carrier integrations: configure connections, create shipments, track deliveries, retrieve labels, and log API calls to external courier services.",
    "keywords": ["courier", "shipment", "tracking", "shipping", "carrier", "label", "delivery", "api"]
  },
  "depends_on": [],
  "permissions": [
    "courier_integrations.view_courier_api",
    "courier_integrations.manage_courier_api",
    "courier_integrations.call_api"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "courier_integrations.view_courier_api",
      "courier_integrations.manage_courier_api",
      "courier_integrations.call_api"
    ],
    "employee": [
      "courier_integrations.view_courier_api"
    ]
  },
  "navigation": [
    {
      "id": "connections",
      "label": "Connections",
      "icon": "globe-outline",
      "component": "erp-courier-integrations-connections"
    },
    {
      "id": "logs",
      "label": "API Logs",
      "icon": "globe-outline",
      "component": "erp-courier-integrations-logs"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "courier_integrations.connections.list": {
      "permission": "courier_integrations.view_courier_api",
      "sql": "queries/connections_list.sql",
      "schema": "schemas/connections_list.json",
      "ai": { "description": "Lists configured connections with courier or shipping carriers." }
    },
    "courier_integrations.calls.list": {
      "permission": "courier_integrations.view_courier_api",
      "sql": "queries/calls_list.sql",
      "schema": "schemas/calls_list.json",
      "ai": { "description": "Lists the history of API calls made to courier services." }
    },
    "courier_integrations.mappings.list": {
      "permission": "courier_integrations.view_courier_api",
      "sql": "queries/mappings_list.sql",
      "schema": "schemas/mappings_list.json",
      "ai": { "description": "Lists the field mappings between the system and courier APIs." }
    }
  },
  "commands": {
    "courier_integrations.connections.create": {
      "permission": "courier_integrations.manage_courier_api",
      "transaction": true,
      "sql": [
        "commands/connection_create.sql"
      ],
      "schema": "schemas/connection_create.json",
      "emit": [
        "courier_integrations.connection.created"
      ],
      "ai": { "description": "Creates a new connection to an external courier or shipping carrier." }
    },
    "courier_integrations.connections.deactivate": {
      "permission": "courier_integrations.manage_courier_api",
      "transaction": true,
      "sql": [
        "commands/connection_deactivate.sql"
      ],
      "schema": "schemas/connection_deactivate.json",
      "emit": [
        "courier_integrations.connection.deactivated"
      ],
      "ai": { "description": "Deactivates an existing courier connection." }
    },
    "courier_integrations.calls.record": {
      "permission": "courier_integrations.call_api",
      "schema": "schemas/record_call.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "record_call"
      },
      "emit": [
        "courier_integrations.call.recorded"
      ],
      "ai": { "description": "Records an outbound API call to a courier service in the log." }
    },
    "courier_integrations.shipments.create": {
      "permission": "courier_integrations.call_api",
      "schema": "schemas/create_shipment.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_shipment_via_courier"
      },
      "emit": [
        "courier_integrations.shipment.created"
      ],
      "ai": { "description": "Creates a shipment in the external courier's system and records the result." }
    },
    "courier_integrations.shipments.get_label": {
      "permission": "courier_integrations.call_api",
      "schema": "schemas/get_label.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "get_label_url"
      },
      "ai": { "description": "Retrieves the shipping label URL from the courier for a given shipment." }
    },
    "courier_integrations.shipments.track": {
      "permission": "courier_integrations.call_api",
      "schema": "schemas/track_shipment.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "track_shipment_via_courier"
      },
      "emit": [
        "courier_integrations.shipment.tracked"
      ],
      "ai": { "description": "Queries the tracking status of a shipment from the external courier." }
    },
    "courier_integrations.shipments.cancel": {
      "permission": "courier_integrations.call_api",
      "schema": "schemas/cancel_shipment.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "cancel_shipment_via_courier"
      },
      "emit": [
        "courier_integrations.shipment.cancelled"
      ],
      "ai": { "description": "Cancels an already-created shipment in the external courier's system." }
    },
    "courier_integrations.metrics.get": {
      "permission": "courier_integrations.view_courier_api",
      "schema": "schemas/get_api_metrics.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "get_api_metrics"
      },
      "ai": { "description": "Retrieves usage and performance metrics for courier API calls." }
    }
  },
  "events": {
    "listen": []
  },
  "ui": {
    "entry": "dist/courier_integrations.esm.js"
  }
}
