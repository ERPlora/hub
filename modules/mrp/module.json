{
  "id": "mrp",
  "name": "MRP",
  "version": "1.0.0",
  "agent": {
    "description": "Runs Material Requirements Planning (MRP) calculations: compute material needs from demand, generate replenishment suggestions, and approve or reject purchase and production orders.",
    "keywords": ["mrp", "planning", "replenishment", "requirements", "suggestion", "purchase", "production", "demand"]
  },
  "depends_on": [],
  "permissions": [
    "mrp.view_mrp",
    "mrp.run_mrp",
    "mrp.approve_suggestion"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "mrp.view_mrp",
      "mrp.run_mrp",
      "mrp.approve_suggestion"
    ],
    "employee": [
      "mrp.view_mrp"
    ]
  },
  "navigation": [
    {
      "id": "runs",
      "label": "Runs",
      "icon": "analytics-outline",
      "component": "erp-mrp-runs"
    },
    {
      "id": "requirements",
      "label": "Requirements",
      "icon": "list-outline",
      "component": "erp-mrp-requirements"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "mrp.runs.list": {
      "permission": "mrp.view_mrp",
      "sql": "queries/runs_list.sql",
      "ai": { "description": "Lists MRP calculation runs with their dates and processing status." }
    },
    "mrp.runs.get": {
      "permission": "mrp.view_mrp",
      "sql": "queries/run_get.sql",
      "ai": { "description": "Returns the details of an MRP run including the generated requirements and suggestions." }
    },
    "mrp.requirements.list": {
      "permission": "mrp.view_mrp",
      "sql": "queries/requirements_list.sql",
      "ai": { "description": "Lists material requirements calculated by MRP to cover projected demand." }
    },
    "mrp.suggestions.list": {
      "permission": "mrp.view_mrp",
      "sql": "queries/suggestions_list.sql",
      "ai": { "description": "Lists pending purchase or manufacturing order suggestions generated by the MRP run, awaiting approval." }
    }
  },
  "commands": {
    "mrp.runs.create": {
      "permission": "mrp.run_mrp",
      "schema": "schemas/run_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_run"
      },
      "emit": [
        "mrp.run.completed"
      ],
      "ai": { "description": "Executes an MRP calculation for a planning horizon and generates replenishment suggestions." }
    },
    "mrp.suggestions.approve": {
      "permission": "mrp.approve_suggestion",
      "transaction": true,
      "sql": [
        "commands/suggestion_approve.sql"
      ],
      "schema": "schemas/suggestion_approve.json",
      "emit": [
        "mrp.suggestion.approved"
      ],
      "ai": { "description": "Approves an MRP suggestion, automatically converting it into a purchase or manufacturing order." }
    },
    "mrp.suggestions.reject": {
      "permission": "mrp.approve_suggestion",
      "transaction": true,
      "sql": [
        "commands/suggestion_reject.sql"
      ],
      "schema": "schemas/suggestion_reject.json",
      "emit": [
        "mrp.suggestion.rejected"
      ],
      "ai": { "description": "Rejects an MRP suggestion, discarding it from the replenishment plan (destructive)." }
    }
  },
  "events": {
    "listen": []
  },
  "ui": {
    "entry": "dist/mrp.esm.js"
  }
}
