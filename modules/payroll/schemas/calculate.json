{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "payroll.calculate",
  "type": "object",
  "additionalProperties": false,
  "required": ["employee_id", "period_start", "period_end"],
  "properties": {
    "employee_id": { "type": "string", "minLength": 1 },
    "period_start": { "type": "string", "format": "date" },
    "period_end": { "type": "string", "format": "date" },
    "confirm": {
      "type": "boolean",
      "default": false,
      "description": "false = solo devuelve el borrador calculado; true = persiste como Payslip + líneas."
    }
  }
}
