{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "carriers.shipments.create",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "carrier_id",
    "origin_address",
    "destination_address",
    "weight_kg",
    "service_type"
  ],
  "properties": {
    "carrier_id": { "type": "string", "minLength": 1 },
    "origin_address": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "street": { "type": "string" },
        "city": { "type": "string" },
        "country": { "type": "string" }
      }
    },
    "destination_address": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "street": { "type": "string" },
        "city": { "type": "string" },
        "country": { "type": "string" }
      }
    },
    "weight_kg": { "type": "number", "minimum": 0 },
    "service_type": { "type": "string", "minLength": 1, "maxLength": 50 },
    "reference": { "type": ["string", "null"], "default": "", "maxLength": 120 },
    "tracking_number": { "type": ["string", "null"], "default": null, "maxLength": 80 },
    "dimensions": { "type": ["object", "null"], "default": null },
    "shipping_cost": { "type": "number", "minimum": 0, "default": 0 }
  }
}
