{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "carriers.rates.add",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "carrier_id",
    "service_type",
    "origin_country",
    "destination_country",
    "weight_from_kg",
    "weight_to_kg",
    "price"
  ],
  "properties": {
    "carrier_id": { "type": "string", "minLength": 1 },
    "service_type": { "type": "string", "minLength": 1, "maxLength": 50 },
    "origin_country": { "type": "string", "minLength": 2, "maxLength": 2 },
    "destination_country": { "type": "string", "minLength": 2, "maxLength": 2 },
    "weight_from_kg": { "type": "number", "minimum": 0 },
    "weight_to_kg": { "type": "number", "minimum": 0 },
    "price": { "type": "number", "minimum": 0 },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3, "default": "EUR" },
    "delivery_days_min": { "type": "integer", "minimum": 0, "default": 1 },
    "delivery_days_max": { "type": "integer", "minimum": 0, "default": 5 },
    "valid_from": { "type": ["string", "null"], "format": "date", "default": null },
    "valid_until": { "type": ["string", "null"], "format": "date", "default": null }
  }
}
