{
  "id": "carriers",
  "name": "Carriers",
  "version": "1.0.0",
  "agent": {
    "description": "Manages shipping carriers, rates, and shipments: create and dispatch shipments, track delivery status, and record tracking events.",
    "keywords": ["carrier", "shipment", "shipping", "delivery", "tracking", "rate", "dispatch"]
  },
  "depends_on": [],
  "permissions": [
    "carriers.view_carrier",
    "carriers.manage_carrier",
    "carriers.ship",
    "carriers.track"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "carriers.view_carrier",
      "carriers.manage_carrier",
      "carriers.ship",
      "carriers.track"
    ],
    "employee": [
      "carriers.view_carrier",
      "carriers.ship",
      "carriers.track"
    ]
  },
  "navigation": [
    {
      "id": "list",
      "label": "Carriers",
      "icon": "airplane-outline",
      "component": "erp-carriers-list"
    },
    {
      "id": "shipments",
      "label": "Shipments",
      "icon": "cube-outline",
      "component": "erp-carriers-shipments"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "carriers.carriers.list": {
      "permission": "carriers.view_carrier",
      "sql": "queries/carriers_list.sql",
      "ai": { "description": "Lists all shipping carriers available in the system" }
    },
    "carriers.rates.list": {
      "permission": "carriers.view_carrier",
      "sql": "queries/rates_list.sql",
      "ai": { "description": "Lists shipping rates configured for carriers" }
    },
    "carriers.shipments.list": {
      "permission": "carriers.view_carrier",
      "sql": "queries/shipments_list.sql",
      "ai": { "description": "Lists registered shipments with their current status" }
    },
    "carriers.shipments.get": {
      "permission": "carriers.view_carrier",
      "sql": "queries/shipment_get.sql",
      "ai": { "description": "Retrieves the full detail of a specific shipment" }
    },
    "carriers.shipments.events": {
      "permission": "carriers.track",
      "sql": "queries/shipment_events.sql",
      "ai": { "description": "Lists tracking events recorded for a shipment" }
    },
    "carriers.shipments.track": {
      "permission": "carriers.track",
      "sql": "queries/shipment_track.sql",
      "ai": { "description": "Queries the current tracking status of a shipment" }
    }
  },
  "commands": {
    "carriers.carriers.create": {
      "permission": "carriers.manage_carrier",
      "transaction": true,
      "sql": [
        "commands/carrier_create.sql"
      ],
      "schema": "schemas/carrier_create.json",
      "emit": [
        "carriers.carrier.created"
      ],
      "ai": { "description": "Creates a new shipping carrier with its details and shipping configuration" }
    },
    "carriers.carriers.deactivate": {
      "permission": "carriers.manage_carrier",
      "transaction": true,
      "sql": [
        "commands/carrier_deactivate.sql"
      ],
      "schema": "schemas/carrier_deactivate.json",
      "emit": [
        "carriers.carrier.deactivated"
      ],
      "ai": { "description": "Deactivates a carrier, preventing it from being used in new shipments" }
    },
    "carriers.rates.add": {
      "permission": "carriers.manage_carrier",
      "transaction": true,
      "sql": [
        "commands/rate_add.sql"
      ],
      "schema": "schemas/rate_add.json",
      "emit": [
        "carriers.rate.added"
      ],
      "ai": { "description": "Adds a new shipping rate to a carrier" }
    },
    "carriers.shipments.create": {
      "permission": "carriers.ship",
      "schema": "schemas/shipment_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_shipment"
      },
      "emit": [
        "carriers.shipment.created"
      ],
      "ai": { "description": "Creates a new shipment assigning a carrier, rate, and recipient" }
    },
    "carriers.shipments.dispatch": {
      "permission": "carriers.ship",
      "transaction": true,
      "sql": [
        "commands/shipment_dispatch.sql"
      ],
      "schema": "schemas/shipment_dispatch.json",
      "emit": [
        "carriers.shipment.dispatched"
      ],
      "ai": { "description": "Marks a shipment as dispatched and starts its tracking" }
    },
    "carriers.shipments.mark_delivered": {
      "permission": "carriers.ship",
      "transaction": true,
      "sql": [
        "commands/shipment_mark_delivered.sql"
      ],
      "schema": "schemas/shipment_mark_delivered.json",
      "emit": [
        "carriers.shipment.delivered"
      ],
      "ai": { "description": "Marks a shipment as delivered to the recipient" }
    },
    "carriers.tracking.record_event": {
      "permission": "carriers.track",
      "transaction": true,
      "sql": [
        "commands/tracking_record_event.sql"
      ],
      "schema": "schemas/tracking_record_event.json",
      "emit": [
        "carriers.tracking.recorded"
      ],
      "ai": { "description": "Records a tracking event (location update, incident) in a shipment's history" }
    }
  },
  "events": {
    "listen": []
  },
  "ui": {
    "entry": "dist/carriers.esm.js"
  }
}
