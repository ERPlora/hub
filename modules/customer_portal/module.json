{
  "id": "customer_portal",
  "name": "Customer Portal",
  "version": "1.0.0",
  "agent": {
    "description": "Manages customer self-service portal accounts: invite customers, activate accounts, manage sessions, suspend, reactivate, and close portal access.",
    "keywords": ["customer portal", "account", "invitation", "session", "access", "suspend", "activate", "customer"]
  },
  "depends_on": [],
  "permissions": [
    "customer_portal.view_portal",
    "customer_portal.manage_portal",
    "customer_portal.invite_customer"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "customer_portal.view_portal",
      "customer_portal.manage_portal",
      "customer_portal.invite_customer"
    ],
    "employee": [
      "customer_portal.view_portal"
    ]
  },
  "navigation": [
    {
      "id": "accounts",
      "label": "Accounts",
      "icon": "person-circle-outline",
      "component": "erp-customer-portal-accounts"
    },
    {
      "id": "sessions",
      "label": "Active Sessions",
      "icon": "key-outline",
      "component": "erp-customer-portal-sessions"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "customer_portal.accounts.list": {
      "permission": "customer_portal.view_portal",
      "sql": "queries/accounts_list.sql",
      "schema": "schemas/accounts_list.json",
      "ai": { "description": "Lists customer portal access accounts." }
    },
    "customer_portal.accounts.get": {
      "permission": "customer_portal.view_portal",
      "sql": "queries/account_get.sql",
      "schema": "schemas/account_get.json",
      "ai": { "description": "Retrieves the details of a customer portal account by its identifier." }
    },
    "customer_portal.accounts.by_email": {
      "permission": "customer_portal.view_portal",
      "sql": "queries/account_by_email.sql",
      "schema": "schemas/account_by_email.json",
      "ai": { "description": "Looks up a customer portal account by email address." }
    },
    "customer_portal.sessions.list": {
      "permission": "customer_portal.view_portal",
      "sql": "queries/sessions_list.sql",
      "schema": "schemas/sessions_list.json",
      "ai": { "description": "Lists active customer sessions in the portal." }
    },
    "customer_portal.invitations.list": {
      "permission": "customer_portal.view_portal",
      "sql": "queries/invitations_list.sql",
      "ai": { "description": "Lists invitations sent to customers for portal access." }
    }
  },
  "commands": {
    "customer_portal.invitations.create": {
      "permission": "customer_portal.invite_customer",
      "schema": "schemas/invitation_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_invitation"
      },
      "emit": [
        "customer_portal.invitation.created"
      ],
      "ai": { "description": "Creates and sends a portal invitation to a customer." }
    },
    "customer_portal.invitations.accept": {
      "permission": "customer_portal.view_portal",
      "schema": "schemas/invitation_accept.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "accept_invitation"
      },
      "emit": [
        "customer_portal.account.activated"
      ],
      "ai": { "description": "Accepts a pending invitation and activates the customer's portal account." }
    },
    "customer_portal.accounts.suspend": {
      "permission": "customer_portal.manage_portal",
      "transaction": true,
      "sql": [
        "commands/account_suspend.sql"
      ],
      "schema": "schemas/account_suspend.json",
      "emit": [
        "customer_portal.account.suspended"
      ],
      "ai": { "description": "Suspends a customer's portal access." }
    },
    "customer_portal.accounts.reactivate": {
      "permission": "customer_portal.manage_portal",
      "transaction": true,
      "sql": [
        "commands/account_reactivate.sql"
      ],
      "schema": "schemas/account_reactivate.json",
      "emit": [
        "customer_portal.account.reactivated"
      ],
      "ai": { "description": "Reactivates a suspended customer's portal account." }
    },
    "customer_portal.accounts.close": {
      "permission": "customer_portal.manage_portal",
      "transaction": true,
      "sql": [
        "commands/account_close.sql"
      ],
      "schema": "schemas/account_close.json",
      "emit": [
        "customer_portal.account.closed"
      ],
      "ai": { "description": "Permanently closes a customer's portal account (destructive)." }
    },
    "customer_portal.sessions.create": {
      "permission": "customer_portal.view_portal",
      "schema": "schemas/session_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_session"
      },
      "emit": [
        "customer_portal.session.created"
      ],
      "ai": { "description": "Creates a new authenticated session for a customer in the portal." }
    },
    "customer_portal.sessions.revoke": {
      "permission": "customer_portal.manage_portal",
      "transaction": true,
      "sql": [
        "commands/session_revoke.sql"
      ],
      "schema": "schemas/session_revoke.json",
      "emit": [
        "customer_portal.session.revoked"
      ],
      "ai": { "description": "Revokes an active customer session in the portal, terminating their access." }
    },
    "customer_portal.sessions.cleanup_expired": {
      "permission": "customer_portal.manage_portal",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "cleanup_expired_sessions"
      },
      "emit": [
        "customer_portal.sessions.cleaned"
      ],
      "ai": { "description": "Deletes all expired portal sessions to keep the database clean." }
    }
  },
  "events": {
    "listen": []
  },
  "ui": {
    "entry": "dist/customer_portal.esm.js"
  }
}
