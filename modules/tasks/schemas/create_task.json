{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tasks.tasks.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["title"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 255 },
    "description": { "type": "string", "default": "", "maxLength": 5000 },
    "project_id": { "type": ["string", "null"], "default": null },
    "assigned_to_ref": { "type": ["string", "null"], "default": null },
    "due_date": {
      "type": ["string", "null"],
      "description": "ISO YYYY-MM-DD o datetime completo, o null.",
      "default": null
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high", "urgent"],
      "default": "medium"
    },
    "parent_task_id": { "type": ["string", "null"], "default": null },
    "created_by_ref": { "type": ["string", "null"], "default": null },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  }
}
