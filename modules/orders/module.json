{
  "id": "orders",
  "name": "Orders",
  "version": "1.2.9",
  "agent": {
    "description": "Manages customer orders through their full lifecycle: create, confirm, complete, cancel, and link to sales.",
    "keywords": ["order", "orders", "pipeline", "confirm", "cancel", "complete", "customer"]
  },
  "depends_on": ["sales", "customers", "inventory"],
  "permissions": [
    "orders.view_order",
    "orders.add_order",
    "orders.change_order",
    "orders.complete_order",
    "orders.cancel_order",
    "orders.manage_settings"
  ],
  "role_permissions": {
    "admin": ["*"],
    "manager": [
      "orders.view_order",
      "orders.add_order",
      "orders.change_order",
      "orders.complete_order",
      "orders.cancel_order",
      "orders.manage_settings"
    ],
    "employee": [
      "orders.view_order",
      "orders.add_order",
      "orders.complete_order"
    ]
  },
  "navigation": [
    {
      "id": "pipeline",
      "label": "Pipeline",
      "icon": "funnel",
      "component": "erp-orders-pipeline"
    }
  ],
  "migrations": {
    "sqlite": ["migrations/sqlite/001_init.sql"]
  },
  "queries": {
    "orders.orders.list": {
      "permission": "orders.view_order",
      "sql": "queries/orders_list.sql",
      "schema": "schemas/orders_list.json",
      "ai": { "description": "Lists orders with their status and customer information." }
    },
    "orders.orders.get": {
      "permission": "orders.view_order",
      "sql": "queries/order_get.sql",
      "schema": "schemas/order_get.json",
      "ai": { "description": "Retrieves the full details of a single order by its ID." }
    },
    "orders.notes.list": {
      "permission": "orders.view_order",
      "sql": "queries/notes_list.sql",
      "schema": "schemas/notes_list.json",
      "ai": { "description": "Lists the internal notes and comments attached to an order." }
    },
    "orders.settings.get": {
      "permission": "orders.manage_settings",
      "sql": "queries/settings_get.sql",
      "ai": { "description": "Retrieves the current configuration of the orders module." }
    }
  },
  "commands": {
    "orders.create": {
      "permission": "orders.add_order",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_order"
      },
      "emit": ["orders.order_created"],
      "ai": { "description": "Creates a new order with its product lines." }
    },
    "orders.confirm": {
      "permission": "orders.change_order",
      "transaction": true,
      "sql": ["commands/order_set_status.sql"],
      "emit": ["orders.order_confirmed"],
      "ai": { "description": "Confirms a draft order, changing its status to confirmed." }
    },
    "orders.complete": {
      "permission": "orders.complete_order",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "complete_order"
      },
      "emit": ["orders.order_completed"],
      "ai": { "description": "Marks an order as completed after delivery or service fulfilment." }
    },
    "orders.cancel": {
      "permission": "orders.cancel_order",
      "transaction": true,
      "sql": ["commands/order_set_status.sql"],
      "emit": ["orders.order_cancelled"],
      "ai": { "description": "Cancels an existing order (destructive status change) and emits the cancellation event." }
    },
    "orders.notes.add": {
      "permission": "orders.change_order",
      "transaction": true,
      "sql": ["commands/note_create.sql"],
      "ai": { "description": "Adds an internal note or comment to an order." }
    },
    "orders.settings.update": {
      "permission": "orders.manage_settings",
      "transaction": true,
      "sql": ["commands/settings_upsert.sql"],
      "ai": { "description": "Updates the configuration settings of the orders module." }
    },
    "orders._note_status_change": {
      "permission": "orders.change_order",
      "sql": ["commands/note_status_change.sql"]
    },
    "orders.link_to_sale": {
      "permission": "orders.change_order",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "link_to_sale"
      },
      "ai": { "description": "Links an order to a completed sale in the sales module." }
    }
  },
  "events": {
    "listen": {
      "sales.after_checkout": {
        "command": "orders.link_to_sale"
      }
    }
  },
  "ui": {
    "entry": "dist/orders.esm.js"
  }
}
