{
  "id": "audit_log",
  "name": "Audit Log",
  "version": "1.0.0",
  "agent": {
    "description": "Records and queries the full audit trail of system events: lists, searches, and retrieves audit events by entity, user, or action, generates compliance reports, and manages event retention.",
    "keywords": ["audit", "log", "compliance", "history", "event", "activity", "report"]
  },
  "depends_on": [],
  "permissions": [
    "audit_log.view_audit",
    "audit_log.export_audit",
    "audit_log.admin_audit"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "audit_log.view_audit",
      "audit_log.export_audit"
    ],
    "employee": [
      "audit_log.view_audit"
    ]
  },
  "navigation": [
    {
      "id": "events",
      "label": "Events",
      "icon": "eye-outline",
      "component": "erp-audit-log-events"
    },
    {
      "id": "reports",
      "label": "Compliance",
      "icon": "document-text-outline",
      "component": "erp-audit-log-reports"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "audit_log.events.list": {
      "permission": "audit_log.view_audit",
      "sql": "queries/events_list.sql",
      "schema": "schemas/events_list.json",
      "ai": { "description": "Lists audit log events with filters by date range, module, and user." }
    },
    "audit_log.events.get": {
      "permission": "audit_log.view_audit",
      "sql": "queries/event_get.sql",
      "schema": "schemas/event_get.json",
      "ai": { "description": "Retrieves the full detail of a single audit log event by its identifier." }
    },
    "audit_log.events.search": {
      "permission": "audit_log.view_audit",
      "sql": "queries/events_search.sql",
      "schema": "schemas/events_search.json",
      "ai": { "description": "Searches audit log events by free text, entity type, or action name." }
    },
    "audit_log.events.entity_history": {
      "permission": "audit_log.view_audit",
      "sql": "queries/entity_history.sql",
      "schema": "schemas/entity_history.json",
      "ai": { "description": "Retrieves the complete audit change history of a specific entity." }
    },
    "audit_log.events.user_activity": {
      "permission": "audit_log.view_audit",
      "sql": "queries/user_activity.sql",
      "schema": "schemas/user_activity.json",
      "ai": { "description": "Retrieves the activity log of a specific user across the system." }
    },
    "audit_log.categories.list": {
      "permission": "audit_log.view_audit",
      "sql": "queries/categories_list.sql",
      "ai": { "description": "Lists the available audit event categories." }
    },
    "audit_log.reports.list": {
      "permission": "audit_log.view_audit",
      "sql": "queries/reports_list.sql",
      "schema": "schemas/reports_list.json",
      "ai": { "description": "Lists generated audit and compliance reports." }
    },
    "audit_log.reports.get": {
      "permission": "audit_log.view_audit",
      "sql": "queries/report_get.sql",
      "schema": "schemas/report_get.json",
      "ai": { "description": "Retrieves the content of an audit report by its identifier." }
    },
    "audit_log.compliance.summary": {
      "permission": "audit_log.view_audit",
      "sql": "queries/compliance_summary.sql",
      "schema": "schemas/compliance_summary.json",
      "ai": { "description": "Retrieves a compliance summary derived from the audit event log." }
    }
  },
  "commands": {
    "audit_log.categories.create": {
      "permission": "audit_log.admin_audit",
      "transaction": true,
      "sql": [
        "commands/category_create.sql"
      ],
      "schema": "schemas/category_create.json",
      "emit": [
        "audit_log.category.created"
      ],
      "ai": { "description": "Creates a new audit event category." }
    },
    "audit_log.reports.generate": {
      "permission": "audit_log.export_audit",
      "schema": "schemas/report_generate.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "generate_report"
      },
      "emit": [
        "audit_log.report.generated"
      ],
      "ai": { "description": "Generates an audit or compliance report for a given time period and criteria." }
    },
    "audit_log.events.cleanup": {
      "permission": "audit_log.admin_audit",
      "schema": "schemas/events_cleanup.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "cleanup_old_events"
      },
      "emit": [
        "audit_log.events.cleaned"
      ],
      "ai": { "description": "Deletes old audit events according to a defined retention policy (destructive)." }
    }
  },
  "events": {
    "listen": []
  },
  "ui": {
    "entry": "dist/audit_log.esm.js"
  }
}
