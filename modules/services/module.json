{
  "id": "services",
  "name": "Services",
  "version": "1.1.7",
  "agent": {
    "description": "Manages the service catalogue: create, update and delete services, categories, and service packages; list available services and packages; configure module settings.",
    "keywords": ["service", "catalogue", "category", "package", "booking", "offering", "price"]
  },
  "depends_on": [],
  "permissions": [
    "services.view_service",
    "services.add_service",
    "services.change_service",
    "services.delete_service",
    "services.view_category",
    "services.add_category",
    "services.change_category",
    "services.delete_category",
    "services.view_package",
    "services.add_package",
    "services.change_package",
    "services.delete_package",
    "services.manage_settings"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "services.view_service",
      "services.add_service",
      "services.change_service",
      "services.view_category",
      "services.add_category",
      "services.change_category",
      "services.view_package",
      "services.add_package",
      "services.change_package"
    ],
    "employee": [
      "services.view_service",
      "services.add_service",
      "services.view_category",
      "services.view_package"
    ]
  },
  "navigation": [
    {
      "id": "services",
      "label": "Services",
      "icon": "briefcase",
      "component": "erp-services-list"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "services.services.list": {
      "permission": "services.view_service",
      "sql": "queries/services_list.sql",
      "schema": "schemas/services_list.json",
      "ai": { "description": "Lists the services available in the catalogue" }
    },
    "services.services.get": {
      "permission": "services.view_service",
      "sql": "queries/service_get.sql",
      "schema": "schemas/service_get.json",
      "ai": { "description": "Retrieves the full detail of a service by its identifier" }
    },
    "services.categories.list": {
      "permission": "services.view_category",
      "sql": "queries/categories_list.sql",
      "ai": { "description": "Lists the defined service categories" }
    },
    "services.packages.list": {
      "permission": "services.view_package",
      "sql": "queries/packages_list.sql",
      "ai": { "description": "Lists the available service packages" }
    },
    "services.packages.get": {
      "permission": "services.view_package",
      "sql": "queries/package_get.sql",
      "schema": "schemas/package_get.json",
      "ai": { "description": "Retrieves the full detail of a service package by its identifier" }
    },
    "services.package_items.list": {
      "permission": "services.view_package",
      "sql": "queries/package_items_list.sql",
      "schema": "schemas/package_items_list.json",
      "ai": { "description": "Lists the individual services included in a package" }
    },
    "services.settings.get": {
      "permission": "services.view_service",
      "sql": "queries/settings_get.sql",
      "ai": { "description": "Retrieves the general settings of the services module" }
    }
  },
  "commands": {
    "services.services.create": {
      "permission": "services.add_service",
      "transaction": true,
      "sql": [
        "commands/service_create.sql"
      ],
      "emit": [
        "services.service.created"
      ],
      "ai": { "description": "Creates a new service in the catalogue" }
    },
    "services.services.update": {
      "permission": "services.change_service",
      "transaction": true,
      "sql": [
        "commands/service_update.sql"
      ],
      "emit": [
        "services.service.updated"
      ],
      "ai": { "description": "Updates the details of an existing service" }
    },
    "services.services.delete": {
      "permission": "services.delete_service",
      "transaction": true,
      "sql": [
        "commands/service_delete.sql"
      ],
      "emit": [
        "services.service.deleted"
      ],
      "ai": { "description": "Deletes a service from the catalogue (destructive)" }
    },
    "services.services.bulk_create": {
      "permission": "services.change_service",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "bulk_create_services"
      },
      "ai": { "description": "Creates multiple services in a single bulk operation" }
    },
    "services._insert_service": {
      "permission": "services.add_service",
      "sql": [
        "commands/_insert_service.sql"
      ]
    },
    "services.categories.create": {
      "permission": "services.add_category",
      "transaction": true,
      "sql": [
        "commands/category_create.sql"
      ],
      "ai": { "description": "Creates a new service category" }
    },
    "services.categories.update": {
      "permission": "services.change_category",
      "transaction": true,
      "sql": [
        "commands/category_update.sql"
      ],
      "ai": { "description": "Updates the details of an existing service category" }
    },
    "services.categories.delete": {
      "permission": "services.delete_category",
      "transaction": true,
      "sql": [
        "commands/category_delete.sql"
      ],
      "ai": { "description": "Deletes a service category (destructive)" }
    },
    "services.packages.create": {
      "permission": "services.add_package",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_package"
      },
      "emit": [
        "services.package.created"
      ],
      "ai": { "description": "Creates a new package grouping multiple services together" }
    },
    "services.packages.update": {
      "permission": "services.change_package",
      "transaction": true,
      "sql": [
        "commands/package_update.sql"
      ],
      "emit": [
        "services.package.updated"
      ],
      "ai": { "description": "Updates the details of an existing service package" }
    },
    "services.packages.delete": {
      "permission": "services.delete_package",
      "transaction": true,
      "sql": [
        "commands/package_delete.sql"
      ],
      "emit": [
        "services.package.deleted"
      ],
      "ai": { "description": "Deletes a service package (destructive)" }
    },
    "services._insert_package": {
      "permission": "services.add_package",
      "sql": [
        "commands/_insert_package.sql"
      ]
    },
    "services._insert_package_item": {
      "permission": "services.add_package",
      "sql": [
        "commands/_insert_package_item.sql"
      ]
    },
    "services.settings.update": {
      "permission": "services.manage_settings",
      "transaction": true,
      "sql": [
        "commands/settings_upsert.sql"
      ],
      "ai": { "description": "Updates the general settings of the services module" }
    }
  },
  "ui": {
    "entry": "dist/services.esm.js"
  }
}
