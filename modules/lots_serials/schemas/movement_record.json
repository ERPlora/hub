{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lots_serials.lots.record_movement",
  "type": "object",
  "additionalProperties": false,
  "required": ["lot_id", "movement_type", "quantity_delta"],
  "properties": {
    "lot_id": { "type": "string", "minLength": 1 },
    "movement_type": {
      "type": "string",
      "enum": ["intake", "consume", "adjust", "expire", "recall"]
    },
    "quantity_delta": { "type": ["string", "number"] },
    "reference": { "type": "string", "default": "", "maxLength": 255 },
    "notes": { "type": "string", "default": "" }
  }
}
