{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lots_serials.lots.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["lot_number", "product_ref"],
  "properties": {
    "lot_number": { "type": "string", "minLength": 1, "maxLength": 100 },
    "product_ref": { "type": "string", "minLength": 1, "maxLength": 255 },
    "quantity_initial": { "type": ["string", "number"], "default": "0" },
    "manufactured_date": { "type": ["string", "null"], "format": "date", "default": null },
    "expiry_date": { "type": ["string", "null"], "format": "date", "default": null },
    "notes": { "type": "string", "default": "" }
  }
}
