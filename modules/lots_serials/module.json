{
  "id": "lots_serials",
  "name": "Lots & Serials",
  "version": "1.0.0",
  "agent": {
    "description": "Manages product lots and serial numbers: track traceability, expiry dates, stock movements, recalls, and individual unit status.",
    "keywords": ["lot", "serial", "traceability", "expiry", "recall", "movement", "batch"]
  },
  "depends_on": [],
  "permissions": [
    "lots_serials.view_lot",
    "lots_serials.manage_lot",
    "lots_serials.manage_serial"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "lots_serials.view_lot",
      "lots_serials.manage_lot",
      "lots_serials.manage_serial"
    ],
    "employee": [
      "lots_serials.view_lot"
    ]
  },
  "navigation": [
    {
      "id": "lots",
      "label": "Lots",
      "icon": "barcode-outline",
      "component": "erp-lots-serials-lots"
    },
    {
      "id": "serials",
      "label": "Serial Numbers",
      "icon": "barcode-outline",
      "component": "erp-lots-serials-serials"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "lots_serials.lots.list": {
      "permission": "lots_serials.view_lot",
      "sql": "queries/lots_list.sql",
      "ai": { "description": "Lists all registered lots with their traceability information." }
    },
    "lots_serials.lots.get": {
      "permission": "lots_serials.view_lot",
      "sql": "queries/lot_get.sql",
      "ai": { "description": "Returns the full details of a specific lot by its identifier." }
    },
    "lots_serials.lots.expiring": {
      "permission": "lots_serials.view_lot",
      "sql": "queries/lots_expiring.sql",
      "ai": { "description": "Lists lots that are approaching their expiry date, ordered by expiration date." }
    },
    "lots_serials.movements.list": {
      "permission": "lots_serials.view_lot",
      "sql": "queries/movements_list.sql",
      "ai": { "description": "Lists stock-in and stock-out movements for a given lot." }
    },
    "lots_serials.serials.list": {
      "permission": "lots_serials.view_lot",
      "sql": "queries/serials_list.sql",
      "ai": { "description": "Lists registered serial numbers with their current status." }
    }
  },
  "commands": {
    "lots_serials.lots.create": {
      "permission": "lots_serials.manage_lot",
      "schema": "schemas/lot_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_lot"
      },
      "emit": [
        "lots_serials.lot.created"
      ],
      "ai": { "description": "Creates a new lot with expiry date and traceability data." }
    },
    "lots_serials.lots.record_movement": {
      "permission": "lots_serials.manage_lot",
      "schema": "schemas/movement_record.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "record_movement"
      },
      "emit": [
        "lots_serials.movement.recorded"
      ],
      "ai": { "description": "Records a stock movement (in or out) against a lot." }
    },
    "lots_serials.lots.mark_recalled": {
      "permission": "lots_serials.manage_lot",
      "schema": "schemas/lot_mark_recalled.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "mark_recalled"
      },
      "emit": [
        "lots_serials.lot.recalled"
      ],
      "ai": { "description": "Marks a lot as recalled from the market due to a safety or quality alert (destructive)." }
    },
    "lots_serials.serials.register": {
      "permission": "lots_serials.manage_serial",
      "transaction": true,
      "sql": [
        "commands/serial_register.sql"
      ],
      "schema": "schemas/serial_register.json",
      "emit": [
        "lots_serials.serial.registered"
      ],
      "ai": { "description": "Registers a new serial number linked to a product and lot." }
    },
    "lots_serials.serials.mark_sold": {
      "permission": "lots_serials.manage_serial",
      "transaction": true,
      "sql": [
        "commands/serial_mark_sold.sql"
      ],
      "schema": "schemas/serial_mark_sold.json",
      "emit": [
        "lots_serials.serial.sold"
      ],
      "ai": { "description": "Marks a serial number as sold and associates it with a sale record." }
    },
    "lots_serials.serials.mark_returned": {
      "permission": "lots_serials.manage_serial",
      "transaction": true,
      "sql": [
        "commands/serial_mark_returned.sql"
      ],
      "schema": "schemas/serial_mark_returned.json",
      "emit": [
        "lots_serials.serial.returned"
      ],
      "ai": { "description": "Marks a serial number as returned and restores it to available stock." }
    }
  },
  "events": {
    "listen": []
  },
  "ui": {
    "entry": "dist/lots_serials.esm.js"
  }
}
