{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "training.programs.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "description": { "type": "string", "default": "" },
    "duration_hours": { "type": "integer", "minimum": 0, "default": 0 },
    "is_mandatory": { "type": "integer", "enum": [0, 1], "default": 0 },
    "category": { "type": ["string", "null"], "maxLength": 100, "default": null },
    "provider": { "type": ["string", "null"], "maxLength": 255, "default": null },
    "cost": { "type": "number", "minimum": 0, "default": 0 },
    "max_participants": { "type": "integer", "minimum": 0, "default": 0 }
  }
}
