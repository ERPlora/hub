{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "training.enrollments.update_status",
  "type": "object",
  "additionalProperties": false,
  "required": ["enrollment_id", "status"],
  "properties": {
    "enrollment_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["not_started", "in_progress", "completed", "failed", "expired"]
    },
    "score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100, "default": null }
  }
}
