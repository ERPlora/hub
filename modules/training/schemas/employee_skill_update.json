{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "training.employee_skills.update",
  "type": "object",
  "additionalProperties": false,
  "required": ["employee_skill_id", "proficiency_level"],
  "properties": {
    "employee_skill_id": { "type": "string", "minLength": 1 },
    "proficiency_level": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced", "expert"]
    },
    "acquired_date": { "type": ["string", "null"], "format": "date", "default": null },
    "notes": { "type": "string", "default": "" }
  }
}
