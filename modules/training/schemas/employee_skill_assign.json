{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "training.employee_skills.assign",
  "type": "object",
  "additionalProperties": false,
  "required": ["employee_id", "employee_name", "skill_id"],
  "properties": {
    "employee_id": { "type": "string", "minLength": 1 },
    "employee_name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "skill_id": { "type": "string", "minLength": 1 },
    "proficiency_level": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced", "expert"],
      "default": "beginner"
    },
    "acquired_date": { "type": ["string", "null"], "format": "date", "default": null },
    "notes": { "type": "string", "default": "" }
  }
}
