{
  "id": "training",
  "name": "Training & Skills",
  "version": "2.0.7",
  "agent": {
    "description": "Manages employee training programs, skills catalogue, and enrollments: create programs, assign and track skills, enroll employees, and maintain the skills matrix.",
    "keywords": ["training", "skills", "enrollment", "programs", "competency", "learning", "staff development"]
  },
  "depends_on": [
    "staff"
  ],
  "permissions": [
    "training.view_program",
    "training.add_program",
    "training.change_program",
    "training.delete_program",
    "training.view_skill",
    "training.add_skill",
    "training.change_skill",
    "training.delete_skill",
    "training.view_enrollment",
    "training.manage_enrollment",
    "training.view_skills_matrix",
    "training.manage_settings"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "training.view_program",
      "training.add_program",
      "training.change_program",
      "training.delete_program",
      "training.view_skill",
      "training.add_skill",
      "training.change_skill",
      "training.delete_skill",
      "training.view_enrollment",
      "training.manage_enrollment",
      "training.view_skills_matrix",
      "training.manage_settings"
    ],
    "employee": [
      "training.view_program",
      "training.view_skill",
      "training.view_enrollment",
      "training.view_skills_matrix"
    ]
  },
  "navigation": [
    {
      "id": "programs",
      "label": "Programs",
      "icon": "school-outline",
      "component": "erp-training-programs"
    },
    {
      "id": "skills",
      "label": "Skills",
      "icon": "ribbon-outline",
      "component": "erp-training-skills"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "training.programs.list": {
      "permission": "training.view_program",
      "sql": "queries/programs_list.sql",
      "schema": "schemas/programs_list.json",
      "ai": { "description": "Lists available training programs." }
    },
    "training.programs.get": {
      "permission": "training.view_program",
      "sql": "queries/program_get.sql",
      "schema": "schemas/program_get.json",
      "ai": { "description": "Retrieves the full detail of a specific training program." }
    },
    "training.skills.list": {
      "permission": "training.view_skill",
      "sql": "queries/skills_list.sql",
      "schema": "schemas/skills_list.json",
      "ai": { "description": "Lists all skills defined in the skills catalogue." }
    },
    "training.skills.get": {
      "permission": "training.view_skill",
      "sql": "queries/skill_get.sql",
      "schema": "schemas/skill_get.json",
      "ai": { "description": "Retrieves the detail of a specific skill." }
    },
    "training.enrollments.list": {
      "permission": "training.view_enrollment",
      "sql": "queries/enrollments_list.sql",
      "schema": "schemas/enrollments_list.json",
      "ai": { "description": "Lists employee enrollments in training programs with their status." }
    },
    "training.skills_matrix.list": {
      "permission": "training.view_skills_matrix",
      "sql": "queries/skills_matrix_list.sql",
      "ai": { "description": "Returns the employee skills matrix showing competency levels across the team." }
    },
    "training.settings.get": {
      "permission": "training.view_program",
      "sql": "queries/settings_get.sql",
      "ai": { "description": "Retrieves the current configuration of the training module." }
    }
  },
  "commands": {
    "training.programs.create": {
      "permission": "training.add_program",
      "transaction": true,
      "sql": [
        "commands/program_create.sql"
      ],
      "schema": "schemas/program_create.json",
      "emit": [
        "training.program.created"
      ],
      "ai": { "description": "Creates a new training program." }
    },
    "training.programs.update": {
      "permission": "training.change_program",
      "transaction": true,
      "sql": [
        "commands/program_update.sql"
      ],
      "schema": "schemas/program_update.json",
      "emit": [
        "training.program.updated"
      ],
      "ai": { "description": "Updates the details of an existing training program." }
    },
    "training.programs.toggle_active": {
      "permission": "training.change_program",
      "transaction": true,
      "sql": [
        "commands/program_toggle_active.sql"
      ],
      "schema": "schemas/program_toggle_active.json",
      "emit": [
        "training.program.updated"
      ],
      "ai": { "description": "Activates or deactivates a training program." }
    },
    "training.programs.delete": {
      "permission": "training.delete_program",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "delete_program"
      },
      "schema": "schemas/program_delete.json",
      "emit": [
        "training.program.deleted"
      ],
      "ai": { "description": "Deletes a training program (destructive)." }
    },
    "training.skills.create": {
      "permission": "training.add_skill",
      "transaction": true,
      "sql": [
        "commands/skill_create.sql"
      ],
      "schema": "schemas/skill_create.json",
      "emit": [
        "training.skill.created"
      ],
      "ai": { "description": "Creates a new skill in the skills catalogue." }
    },
    "training.skills.update": {
      "permission": "training.change_skill",
      "transaction": true,
      "sql": [
        "commands/skill_update.sql"
      ],
      "schema": "schemas/skill_update.json",
      "emit": [
        "training.skill.updated"
      ],
      "ai": { "description": "Updates the details of an existing skill." }
    },
    "training.skills.delete": {
      "permission": "training.delete_skill",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "delete_skill"
      },
      "schema": "schemas/skill_delete.json",
      "emit": [
        "training.skill.deleted"
      ],
      "ai": { "description": "Deletes a skill from the catalogue (destructive)." }
    },
    "training.enrollments.enroll": {
      "permission": "training.manage_enrollment",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "enroll_employee"
      },
      "schema": "schemas/enrollment_enroll.json",
      "emit": [
        "training.enrollment.created"
      ],
      "ai": { "description": "Enrolls an employee in a training program." }
    },
    "training.enrollments.update_status": {
      "permission": "training.manage_enrollment",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "update_training_status"
      },
      "schema": "schemas/enrollment_update_status.json",
      "emit": [
        "training.enrollment.updated"
      ],
      "ai": { "description": "Updates the enrollment status of an employee in a training program." }
    },
    "training.employee_skills.assign": {
      "permission": "training.manage_enrollment",
      "transaction": true,
      "sql": [
        "commands/employee_skill_assign.sql"
      ],
      "schema": "schemas/employee_skill_assign.json",
      "emit": [
        "training.employee_skill.assigned"
      ],
      "ai": { "description": "Assigns a skill to an employee with a competency level." }
    },
    "training.employee_skills.update": {
      "permission": "training.manage_enrollment",
      "transaction": true,
      "sql": [
        "commands/employee_skill_update.sql"
      ],
      "schema": "schemas/employee_skill_update.json",
      "emit": [
        "training.employee_skill.updated"
      ],
      "ai": { "description": "Updates the competency level of a skill assigned to an employee." }
    },
    "training.employee_skills.remove": {
      "permission": "training.manage_enrollment",
      "transaction": true,
      "sql": [
        "commands/employee_skill_remove.sql"
      ],
      "schema": "schemas/employee_skill_remove.json",
      "emit": [
        "training.employee_skill.removed"
      ],
      "ai": { "description": "Removes a skill assignment from an employee (destructive)." }
    },
    "training.settings.save": {
      "permission": "training.manage_settings",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "save_settings"
      },
      "schema": "schemas/settings_save.json",
      "emit": [
        "training.settings.updated"
      ],
      "ai": { "description": "Saves the training module configuration." }
    }
  },
  "events": {
    "listen": [
      "staff.member_created"
    ]
  },
  "ui": {
    "entry": "dist/training.esm.js"
  }
}
