{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "manufacturing_orders.orders.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["product_ref", "quantity_planned", "materials"],
  "properties": {
    "product_ref": { "type": "string", "minLength": 1, "maxLength": 255 },
    "quantity_planned": { "type": "number", "exclusiveMinimum": 0 },
    "scheduled_date": { "type": ["string", "null"], "format": "date", "default": null },
    "due_date": { "type": ["string", "null"], "format": "date", "default": null },
    "priority": {
      "type": "string",
      "enum": ["low", "normal", "high", "urgent"],
      "default": "normal"
    },
    "work_center_ref": { "type": "string", "default": "", "maxLength": 100 },
    "notes": { "type": "string", "default": "" },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["material_ref", "quantity_planned"],
        "properties": {
          "material_ref": { "type": "string", "minLength": 1, "maxLength": 255 },
          "quantity_planned": { "type": "number", "exclusiveMinimum": 0 },
          "unit": { "type": "string", "default": "unit", "maxLength": 20 }
        }
      }
    }
  }
}
