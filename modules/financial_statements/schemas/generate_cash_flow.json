{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "financial_statements.reports.generate_cash_flow",
  "type": "object",
  "additionalProperties": false,
  "required": ["template_id", "cash_movements"],
  "properties": {
    "template_id": { "type": "string", "minLength": 1 },
    "period_start": { "type": ["string", "null"], "format": "date", "default": null },
    "period_end": { "type": ["string", "null"], "format": "date", "default": null },
    "cash_movements": {
      "type": "object",
      "description": "Mapa {movement_code: amount}. Tratado igual que account_balances.",
      "additionalProperties": { "type": ["string", "number"] }
    },
    "notes": { "type": "string", "default": "", "maxLength": 2000 }
  }
}
