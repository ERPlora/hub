{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gantt.tasks.add",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "name"],
  "properties": {
    "project_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "start_date": { "type": ["string", "null"], "format": "date", "default": null },
    "end_date": { "type": ["string", "null"], "format": "date", "default": null },
    "assigned_to_ref": { "type": ["string", "null"], "default": null },
    "parent_task_id": { "type": ["string", "null"], "default": null },
    "is_milestone": { "type": "boolean", "default": false },
    "order": { "type": "integer", "minimum": 0, "default": 0 }
  }
}
