{
  "id": "gantt",
  "name": "Project Gantt",
  "version": "1.0.0",
  "agent": {
    "description": "Manages Gantt chart projects and tasks: creates projects, adds and schedules tasks, defines dependencies, tracks progress, and calculates the critical path.",
    "keywords": ["gantt", "project", "task", "timeline", "dependency", "critical path", "scheduling", "progress"]
  },
  "depends_on": [],
  "permissions": [
    "gantt.view_gantt",
    "gantt.manage_gantt"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "gantt.view_gantt",
      "gantt.manage_gantt"
    ],
    "employee": [
      "gantt.view_gantt"
    ]
  },
  "navigation": [
    {
      "id": "projects",
      "label": "Projects",
      "icon": "bar-chart-outline",
      "component": "erp-gantt-projects"
    },
    {
      "id": "timeline",
      "label": "Timeline",
      "icon": "bar-chart-outline",
      "component": "erp-gantt-timeline"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "gantt.projects.list": {
      "permission": "gantt.view_gantt",
      "sql": "queries/projects_list.sql",
      "ai": { "description": "Lists Gantt chart projects with their status and dates." }
    },
    "gantt.projects.get": {
      "permission": "gantt.view_gantt",
      "sql": "queries/project_get.sql",
      "ai": { "description": "Retrieves the full detail of a Gantt project by its ID." }
    },
    "gantt.projects.tasks": {
      "permission": "gantt.view_gantt",
      "sql": "queries/project_tasks.sql",
      "ai": { "description": "Lists the tasks of a project with their start/end dates and progress percentage." }
    },
    "gantt.projects.dependencies": {
      "permission": "gantt.view_gantt",
      "sql": "queries/project_dependencies.sql",
      "ai": { "description": "Lists the dependencies between tasks in a Gantt project." }
    },
    "gantt.projects.summary": {
      "permission": "gantt.view_gantt",
      "sql": "queries/project_summary.sql",
      "ai": { "description": "Retrieves the overall progress summary and statistics for a Gantt project." }
    }
  },
  "commands": {
    "gantt.projects.create": {
      "permission": "gantt.manage_gantt",
      "transaction": true,
      "sql": [
        "commands/project_create.sql"
      ],
      "schema": "schemas/project_create.json",
      "emit": [
        "gantt.project.created"
      ],
      "ai": { "description": "Creates a new Gantt chart project with its dates and description." }
    },
    "gantt.tasks.add": {
      "permission": "gantt.manage_gantt",
      "schema": "schemas/task_add.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "add_task"
      },
      "emit": [
        "gantt.task.created"
      ],
      "ai": { "description": "Adds a new task to a Gantt project with its scheduled dates and assignment." }
    },
    "gantt.dependencies.add": {
      "permission": "gantt.manage_gantt",
      "schema": "schemas/dependency_add.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "add_dependency"
      },
      "emit": [
        "gantt.dependency.created"
      ],
      "ai": { "description": "Adds a finish-to-start dependency between two Gantt tasks (task B cannot start until task A finishes)." }
    },
    "gantt.tasks.update_progress": {
      "permission": "gantt.manage_gantt",
      "schema": "schemas/task_update_progress.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "update_task_progress"
      },
      "emit": [
        "gantt.task.progress_updated"
      ],
      "ai": { "description": "Updates the completion percentage of a Gantt task." }
    },
    "gantt.tasks.shift": {
      "permission": "gantt.manage_gantt",
      "schema": "schemas/task_shift.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "shift_task"
      },
      "emit": [
        "gantt.task.shifted"
      ],
      "ai": { "description": "Shifts a Gantt task's dates by a given offset and recalculates dependent tasks." }
    },
    "gantt.projects.critical_path": {
      "permission": "gantt.view_gantt",
      "schema": "schemas/project_critical_path.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "calculate_critical_path"
      },
      "ai": { "description": "Calculates the critical path of a Gantt project to identify the tasks that determine the total project duration." }
    }
  },
  "events": {
    "listen": []
  },
  "ui": {
    "entry": "dist/gantt.esm.js"
  }
}
