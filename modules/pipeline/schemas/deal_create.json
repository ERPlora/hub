{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pipeline.deals.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["pipeline_id", "stage_id", "deal_name"],
  "properties": {
    "pipeline_id": { "type": "string", "minLength": 1 },
    "stage_id": { "type": "string", "minLength": 1 },
    "deal_name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "deal_value": { "type": "string", "default": "0.00" },
    "customer_name": { "type": "string", "maxLength": 255, "default": "" },
    "expected_close_date": { "type": ["string", "null"], "format": "date", "default": null }
  }
}
