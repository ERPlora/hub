{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pipeline.stages.add",
  "type": "object",
  "additionalProperties": false,
  "required": ["pipeline_id", "code", "name", "order"],
  "properties": {
    "pipeline_id": { "type": "string", "minLength": 1 },
    "code": { "type": "string", "minLength": 1, "maxLength": 50 },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "order": { "type": "integer", "minimum": 0 },
    "probability_default": { "type": "integer", "minimum": 0, "maximum": 100, "default": 50 },
    "is_won": { "type": "integer", "enum": [0, 1], "default": 0 },
    "is_lost": { "type": "integer", "enum": [0, 1], "default": 0 },
    "color": { "type": "string", "maxLength": 20, "default": "" }
  }
}
