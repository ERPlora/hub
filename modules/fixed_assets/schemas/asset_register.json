{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fixed_assets.assets.register",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "name", "acquisition_cost", "useful_life_years"],
  "properties": {
    "code": { "type": "string", "minLength": 1, "maxLength": 100 },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "description": { "type": "string", "default": "" },
    "asset_category": { "type": "string", "default": "", "maxLength": 100 },
    "acquisition_date": { "type": ["string", "null"], "format": "date", "default": null },
    "acquisition_cost": { "type": "number", "minimum": 0 },
    "useful_life_years": { "type": "integer", "minimum": 0 },
    "depreciation_method": {
      "type": "string",
      "enum": ["linear", "declining", "units_of_production"],
      "default": "linear"
    },
    "residual_value": { "type": "number", "minimum": 0, "default": 0 },
    "location_ref": { "type": "string", "default": "", "maxLength": 100 },
    "supplier_ref": { "type": "string", "default": "", "maxLength": 100 }
  }
}
