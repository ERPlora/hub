{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "time_control.records.clock",
  "description": "Fichaje (clock in/out) con validación de estado y geofence. La lógica vive en WASM — ver WASM-TODO.",
  "type": "object",
  "additionalProperties": false,
  "required": ["employee_id", "employee_name", "action_type"],
  "properties": {
    "employee_id": { "type": "string", "minLength": 1 },
    "employee_name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "action_type": { "type": "string", "enum": ["clock_in", "clock_out"] },
    "workplace_id": { "type": "string", "default": "" },
    "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90, "default": null },
    "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180, "default": null },
    "notes": { "type": "string", "default": "", "maxLength": 2000 },
    "method": { "type": "string", "enum": ["pin", "auto", "manual", "api"], "default": "api" }
  }
}
