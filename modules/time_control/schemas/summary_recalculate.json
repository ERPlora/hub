{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "time_control.summaries.recalculate",
  "description": "Recalcula el resumen diario emparejando fichajes cronológicamente. Lógica en WASM — ver WASM-TODO.",
  "type": "object",
  "additionalProperties": false,
  "required": ["employee_id", "date"],
  "properties": {
    "employee_id": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "format": "date" },
    "employee_name": { "type": "string", "default": "", "maxLength": 255 }
  }
}
