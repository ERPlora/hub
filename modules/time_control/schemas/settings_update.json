{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "time_control.settings.update",
  "description": "Upsert del singleton de ajustes con invariant legal (data_retention_months >= 48, RDL 8/2019). Lógica en WASM — ver WASM-TODO.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "geolocation_enabled": { "type": ["boolean", "null"], "default": null },
    "geolocation_required": { "type": ["boolean", "null"], "default": null },
    "geofence_radius_meters": { "type": ["integer", "null"], "minimum": 10, "maximum": 10000, "default": null },
    "auto_clock_out_enabled": { "type": ["boolean", "null"], "default": null },
    "auto_clock_out_hours": { "type": ["integer", "null"], "minimum": 1, "maximum": 24, "default": null },
    "allow_manual_records": { "type": ["boolean", "null"], "default": null },
    "require_notes_manual": { "type": ["boolean", "null"], "default": null },
    "data_retention_months": { "type": ["integer", "null"], "minimum": 48, "maximum": 120, "default": null }
  }
}
