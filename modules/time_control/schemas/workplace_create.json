{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "time_control.workplaces.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "address": { "type": "string", "default": "", "maxLength": 1000 },
    "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90, "default": null },
    "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180, "default": null },
    "radius_meters": { "type": "integer", "minimum": 10, "maximum": 10000, "default": 100 },
    "is_default": { "type": "boolean", "default": false }
  }
}
