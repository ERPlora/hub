{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai_setup_wizard.recommendations.add",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "category", "title", "description"],
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["modules", "integrations", "workflows", "config"]
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 255 },
    "description": { "type": "string", "default": "" },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "default": "medium"
    },
    "related_module_id": { "type": "string", "default": "", "maxLength": 80 }
  }
}
