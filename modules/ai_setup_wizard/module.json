{
  "id": "ai_setup_wizard",
  "name": "AI Setup Wizard",
  "version": "1.0.0",
  "agent": {
    "description": "Guides the initial business setup through an AI-driven wizard: starts sessions, collects answers, generates recommendations, and applies the suggested configuration.",
    "keywords": ["setup", "wizard", "onboarding", "configuration", "ai", "recommendation"]
  },
  "depends_on": [],
  "permissions": [
    "ai_setup_wizard.view_setup",
    "ai_setup_wizard.manage_setup"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "ai_setup_wizard.view_setup",
      "ai_setup_wizard.manage_setup"
    ],
    "employee": [
      "ai_setup_wizard.view_setup"
    ]
  },
  "navigation": [
    {
      "id": "sessions",
      "label": "AI Setup",
      "icon": "compass-outline",
      "component": "erp-ai-setup-wizard-sessions"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "ai_setup_wizard.sessions.list": {
      "permission": "ai_setup_wizard.view_setup",
      "sql": "queries/sessions_list.sql",
      "ai": { "description": "Lists all AI setup wizard sessions for the current hub." }
    },
    "ai_setup_wizard.sessions.get": {
      "permission": "ai_setup_wizard.view_setup",
      "sql": "queries/session_get.sql",
      "ai": { "description": "Retrieves the full detail of a setup wizard session by its identifier." }
    },
    "ai_setup_wizard.questions.by_session": {
      "permission": "ai_setup_wizard.view_setup",
      "sql": "queries/questions_by_session.sql",
      "ai": { "description": "Lists all wizard questions associated with a given setup session." }
    },
    "ai_setup_wizard.recommendations.by_session": {
      "permission": "ai_setup_wizard.view_setup",
      "sql": "queries/recommendations_by_session.sql",
      "ai": { "description": "Lists all configuration recommendations generated for a given setup session." }
    }
  },
  "commands": {
    "ai_setup_wizard.sessions.start": {
      "permission": "ai_setup_wizard.manage_setup",
      "schema": "schemas/session_start.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "start_session"
      },
      "emit": [
        "ai_setup_wizard.session.started"
      ],
      "ai": { "description": "Starts a new guided AI setup wizard session for the business." }
    },
    "ai_setup_wizard.sessions.complete": {
      "permission": "ai_setup_wizard.manage_setup",
      "schema": "schemas/session_complete.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "complete_session"
      },
      "emit": [
        "ai_setup_wizard.session.completed"
      ],
      "ai": { "description": "Marks a setup wizard session as completed and applies the suggested changes." }
    },
    "ai_setup_wizard.sessions.abandon": {
      "permission": "ai_setup_wizard.manage_setup",
      "schema": "schemas/session_abandon.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "abandon_session"
      },
      "emit": [
        "ai_setup_wizard.session.abandoned"
      ],
      "ai": { "description": "Abandons and cancels an in-progress setup wizard session without applying any changes." }
    },
    "ai_setup_wizard.questions.add": {
      "permission": "ai_setup_wizard.manage_setup",
      "schema": "schemas/question_add.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "add_question"
      },
      "emit": [
        "ai_setup_wizard.question.added"
      ],
      "ai": { "description": "Adds a new question to the wizard flow of a setup session." }
    },
    "ai_setup_wizard.questions.answer": {
      "permission": "ai_setup_wizard.manage_setup",
      "transaction": true,
      "sql": [
        "commands/question_answer.sql"
      ],
      "schema": "schemas/question_answer.json",
      "emit": [
        "ai_setup_wizard.question.answered"
      ],
      "ai": { "description": "Records the user's answer to a setup wizard question." }
    },
    "ai_setup_wizard.recommendations.add": {
      "permission": "ai_setup_wizard.manage_setup",
      "transaction": true,
      "sql": [
        "commands/recommendation_add.sql"
      ],
      "schema": "schemas/recommendation_add.json",
      "emit": [
        "ai_setup_wizard.recommendation.added"
      ],
      "ai": { "description": "Adds a configuration recommendation to a setup wizard session." }
    },
    "ai_setup_wizard.recommendations.apply": {
      "permission": "ai_setup_wizard.manage_setup",
      "schema": "schemas/recommendation_apply.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "apply_recommendation"
      },
      "emit": [
        "ai_setup_wizard.recommendation.applied"
      ],
      "ai": { "description": "Applies a setup wizard recommendation to the system configuration." }
    }
  },
  "events": {
    "listen": []
  },
  "ui": {
    "entry": "dist/ai_setup_wizard.esm.js"
  }
}
