{
  "id": "communications",
  "name": "Communications",
  "version": "2.1.1",
  "agent": {
    "description": "Manages a unified multi-channel inbox: read and reply to email threads, compose and schedule emails, assign conversations, configure routing rules, manage email accounts and templates.",
    "keywords": ["email", "inbox", "thread", "compose", "reply", "schedule", "routing", "template", "imap"]
  },
  "depends_on": [],
  "ai_context": "Unified multi-channel inbox: email, group-based routing, AI-assisted compose/reply, scheduled sending and a configurable footer. Entities: accounts (IMAP/SMTP, hub/user), routing groups, threads, messages, attachments, routing rules, assignments (audited), scheduled messages, email templates and singleton settings. The AI uses the typed queries/commands (no text-to-SQL); actual email sending, IMAP sync and AI compose go through the WASM/host handler.",
  "permissions": [
    "communications.view_inbox",
    "communications.compose_email",
    "communications.manage_accounts",
    "communications.manage_groups",
    "communications.manage_settings",
    "communications.assign_threads",
    "communications.view_all_groups"
  ],
  "role_permissions": {
    "admin": ["*"],
    "manager": [
      "communications.view_inbox",
      "communications.compose_email",
      "communications.assign_threads",
      "communications.manage_groups"
    ],
    "employee": [
      "communications.view_inbox",
      "communications.compose_email"
    ]
  },
  "navigation": [
    {
      "id": "inbox",
      "label": "Inbox",
      "icon": "mail-outline",
      "component": "erp-communications-inbox"
    },
    {
      "id": "templates",
      "label": "Templates",
      "icon": "document-text-outline",
      "component": "erp-communications-templates"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "communications.threads.list": {
      "permission": "communications.view_inbox",
      "sql": "queries/threads_list.sql",
      "schema": "schemas/threads_list.json",
      "ai": { "description": "Lists conversation threads in the inbox with their status and assignment" }
    },
    "communications.threads.get": {
      "permission": "communications.view_inbox",
      "sql": "queries/thread_get.sql",
      "schema": "schemas/thread_get.json",
      "ai": { "description": "Returns the details of a conversation thread including all its messages" }
    },
    "communications.messages.list": {
      "permission": "communications.view_inbox",
      "sql": "queries/messages_list.sql",
      "schema": "schemas/messages_list.json",
      "ai": { "description": "Lists the messages within a conversation thread" }
    },
    "communications.accounts.list": {
      "permission": "communications.manage_accounts",
      "sql": "queries/accounts_list.sql",
      "ai": { "description": "Lists the configured email accounts (IMAP/SMTP)" }
    },
    "communications.groups.list": {
      "permission": "communications.view_inbox",
      "sql": "queries/groups_list.sql",
      "ai": { "description": "Lists the available message routing groups" }
    },
    "communications.routing_rules.list": {
      "permission": "communications.manage_groups",
      "sql": "queries/routing_rules_list.sql",
      "ai": { "description": "Lists the automatic routing rules that assign messages to groups" }
    },
    "communications.scheduled.list": {
      "permission": "communications.compose_email",
      "sql": "queries/scheduled_list.sql",
      "schema": "schemas/scheduled_list.json",
      "ai": { "description": "Lists scheduled emails that are pending delivery" }
    },
    "communications.templates.list": {
      "permission": "communications.compose_email",
      "sql": "queries/templates_list.sql",
      "schema": "schemas/templates_list.json",
      "ai": { "description": "Lists the available email templates for composition" }
    },
    "communications.templates.get": {
      "permission": "communications.compose_email",
      "sql": "queries/template_get.sql",
      "schema": "schemas/template_get.json",
      "ai": { "description": "Returns the content and variables of an email template" }
    },
    "communications.settings.get": {
      "permission": "communications.manage_settings",
      "sql": "queries/settings_get.sql",
      "ai": { "description": "Returns the general settings of the communications module (footer, etc.)" }
    }
  },
  "commands": {
    "communications.accounts.create": {
      "permission": "communications.manage_accounts",
      "transaction": true,
      "sql": ["commands/account_create.sql"],
      "schema": "schemas/account_create.json",
      "emit": ["communications.account.created"],
      "ai": { "description": "Creates a new email account (IMAP/SMTP) in the system" }
    },
    "communications.accounts.update": {
      "permission": "communications.manage_accounts",
      "transaction": true,
      "sql": ["commands/account_update.sql"],
      "schema": "schemas/account_update.json",
      "emit": ["communications.account.updated"],
      "ai": { "description": "Updates the configuration of an existing email account" }
    },
    "communications.accounts.delete": {
      "permission": "communications.manage_accounts",
      "transaction": true,
      "sql": ["commands/account_delete.sql"],
      "schema": "schemas/account_delete.json",
      "emit": ["communications.account.deleted"],
      "ai": { "description": "Deletes an email account from the system (destructive)" }
    },
    "communications.groups.create": {
      "permission": "communications.manage_groups",
      "transaction": true,
      "sql": ["commands/group_create.sql"],
      "schema": "schemas/group_create.json",
      "emit": ["communications.group.created"],
      "ai": { "description": "Creates a new routing group to organize message handling" }
    },
    "communications.groups.update": {
      "permission": "communications.manage_groups",
      "transaction": true,
      "sql": ["commands/group_update.sql"],
      "schema": "schemas/group_update.json",
      "ai": { "description": "Updates the name or configuration of a routing group" }
    },
    "communications.groups.delete": {
      "permission": "communications.manage_groups",
      "transaction": true,
      "sql": ["commands/group_delete.sql"],
      "schema": "schemas/group_delete.json",
      "ai": { "description": "Deletes a message routing group (destructive)" }
    },
    "communications.routing_rules.create": {
      "permission": "communications.manage_groups",
      "transaction": true,
      "sql": ["commands/routing_rule_create.sql"],
      "schema": "schemas/routing_rule_create.json",
      "ai": { "description": "Creates an automatic routing rule that assigns incoming messages to a group based on criteria" }
    },
    "communications.routing_rules.delete": {
      "permission": "communications.manage_groups",
      "transaction": true,
      "sql": ["commands/routing_rule_delete.sql"],
      "schema": "schemas/routing_rule_delete.json",
      "ai": { "description": "Deletes an automatic routing rule (destructive)" }
    },
    "communications.templates.create": {
      "permission": "communications.compose_email",
      "transaction": true,
      "sql": ["commands/template_create.sql"],
      "schema": "schemas/template_create.json",
      "emit": ["communications.template.created"],
      "ai": { "description": "Creates a new reusable email template" }
    },
    "communications.templates.update": {
      "permission": "communications.compose_email",
      "transaction": true,
      "sql": ["commands/template_update.sql"],
      "schema": "schemas/template_update.json",
      "ai": { "description": "Updates the content or name of an email template" }
    },
    "communications.templates.delete": {
      "permission": "communications.compose_email",
      "transaction": true,
      "sql": ["commands/template_delete.sql"],
      "schema": "schemas/template_delete.json",
      "ai": { "description": "Deletes an email template (destructive)" }
    },
    "communications.threads.set_status": {
      "permission": "communications.view_inbox",
      "transaction": true,
      "sql": ["commands/thread_set_status.sql"],
      "schema": "schemas/thread_set_status.json",
      "emit": ["communications.thread.status_changed"],
      "ai": { "description": "Changes the status of a thread (open, resolved, pending, etc.)" }
    },
    "communications.scheduled.cancel": {
      "permission": "communications.compose_email",
      "transaction": true,
      "sql": ["commands/scheduled_cancel.sql"],
      "schema": "schemas/scheduled_cancel.json",
      "emit": ["communications.scheduled.cancelled"],
      "ai": { "description": "Cancels a scheduled email before it is sent" }
    },
    "communications.compose.send": {
      "permission": "communications.compose_email",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "compose_send"
      },
      "ai": { "description": "Composes and sends a new email from a hub account" }
    },
    "communications.threads.reply": {
      "permission": "communications.compose_email",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "reply_to_thread"
      },
      "ai": { "description": "Sends a reply to an existing conversation thread" }
    },
    "communications.compose.schedule": {
      "permission": "communications.compose_email",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "schedule_email"
      },
      "ai": { "description": "Schedules an email to be sent at a future date and time" }
    },
    "communications.threads.assign": {
      "permission": "communications.assign_threads",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "assign_thread"
      },
      "ai": { "description": "Assigns a conversation thread to a user or group for handling" }
    },
    "communications.email.sync": {
      "permission": "communications.manage_accounts",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "sync_account"
      },
      "ai": { "description": "Synchronizes messages for an email account via IMAP" }
    },
    "communications.settings.upsert": {
      "permission": "communications.manage_settings",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "upsert_settings"
      },
      "ai": { "description": "Saves or updates the general settings of the communications module" }
    }
  },
  "events": {
    "listen": {}
  },
  "ui": {
    "entry": "dist/communications.esm.js"
  }
}
