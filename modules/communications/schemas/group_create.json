{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "communications.groups.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "default": "" },
    "icon": { "type": "string", "default": "people-outline", "maxLength": 50 },
    "color": { "type": "string", "default": "#6366f1", "maxLength": 20 },
    "is_active": { "type": "integer", "enum": [0, 1], "default": 1 },
    "is_default": { "type": "integer", "enum": [0, 1], "default": 0 }
  }
}
