{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "communications.accounts.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "account_type": { "type": "string", "enum": ["hub", "user"], "default": "hub" },
    "channel": { "type": "string", "enum": ["email", "whatsapp", "instagram", "facebook"], "default": "email" },
    "owner_id": { "type": ["string", "null"], "default": null },
    "email_address": { "type": "string", "default": "", "maxLength": 255 },
    "imap_host": { "type": "string", "default": "", "maxLength": 255 },
    "imap_port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 993 },
    "imap_username": { "type": "string", "default": "", "maxLength": 255 },
    "imap_password_encrypted": { "type": "string", "default": "" },
    "imap_use_ssl": { "type": "integer", "enum": [0, 1], "default": 1 },
    "smtp_host": { "type": "string", "default": "", "maxLength": 255 },
    "smtp_port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 587 },
    "smtp_username": { "type": "string", "default": "", "maxLength": 255 },
    "smtp_password_encrypted": { "type": "string", "default": "" },
    "smtp_use_tls": { "type": "integer", "enum": [0, 1], "default": 1 }
  }
}
