{
  "id": "project_costing",
  "name": "Project Costing",
  "version": "1.0.0",
  "agent": {
    "description": "Manages project cost budgets and cost entries: create and approve budgets, record cost allocations by category, approve or reject entries, and generate budget-vs-actual reports.",
    "keywords": ["project costing", "budget", "cost", "expense", "allocation", "approval", "project", "report"]
  },
  "depends_on": [],
  "permissions": [
    "project_costing.view_cost",
    "project_costing.manage_cost",
    "project_costing.approve_cost"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "project_costing.view_cost",
      "project_costing.manage_cost",
      "project_costing.approve_cost"
    ],
    "employee": [
      "project_costing.view_cost",
      "project_costing.manage_cost"
    ]
  },
  "navigation": [
    {
      "id": "projects",
      "label": "Projects",
      "icon": "analytics-outline",
      "component": "erp-project-costing-projects"
    },
    {
      "id": "reports",
      "label": "Reports",
      "icon": "analytics-outline",
      "component": "erp-project-costing-reports"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "project_costing.budgets.list": {
      "permission": "project_costing.view_cost",
      "sql": "queries/budgets_list.sql",
      "ai": { "description": "Lists project cost budgets with their approval status." }
    },
    "project_costing.entries.list": {
      "permission": "project_costing.view_cost",
      "sql": "queries/entries_list.sql",
      "ai": { "description": "Lists cost entries recorded against a project." }
    },
    "project_costing.categories.list": {
      "permission": "project_costing.view_cost",
      "sql": "queries/categories_list.sql",
      "ai": { "description": "Lists available cost categories used to classify project expenses." }
    }
  },
  "commands": {
    "project_costing.budgets.create": {
      "permission": "project_costing.manage_cost",
      "transaction": true,
      "sql": [
        "commands/budget_create.sql"
      ],
      "schema": "schemas/budget_create.json",
      "emit": [
        "project_costing.budget.created"
      ],
      "ai": { "description": "Creates a cost budget for a project with a total amount and categories." }
    },
    "project_costing.budgets.approve": {
      "permission": "project_costing.approve_cost",
      "transaction": true,
      "sql": [
        "commands/budget_approve.sql"
      ],
      "schema": "schemas/budget_approve.json",
      "emit": [
        "project_costing.budget.approved"
      ],
      "ai": { "description": "Approves a project cost budget, enabling cost entries to be recorded against it." }
    },
    "project_costing.budgets.close": {
      "permission": "project_costing.approve_cost",
      "transaction": true,
      "sql": [
        "commands/budget_close.sql"
      ],
      "schema": "schemas/budget_close.json",
      "emit": [
        "project_costing.budget.closed"
      ],
      "ai": { "description": "Closes a cost budget, preventing any further cost entries from being recorded." }
    },
    "project_costing.entries.record": {
      "permission": "project_costing.manage_cost",
      "transaction": true,
      "sql": [
        "commands/entry_record.sql"
      ],
      "schema": "schemas/entry_record.json",
      "emit": [
        "project_costing.entry.recorded"
      ],
      "ai": { "description": "Records a cost allocation against a project budget and category." }
    },
    "project_costing.entries.approve": {
      "permission": "project_costing.approve_cost",
      "transaction": true,
      "sql": [
        "commands/entry_approve.sql"
      ],
      "schema": "schemas/entry_approve.json",
      "emit": [
        "project_costing.entry.approved"
      ],
      "ai": { "description": "Approves a pending cost entry awaiting review." }
    },
    "project_costing.entries.reject": {
      "permission": "project_costing.approve_cost",
      "transaction": true,
      "sql": [
        "commands/entry_reject.sql"
      ],
      "schema": "schemas/entry_reject.json",
      "emit": [
        "project_costing.entry.rejected"
      ],
      "ai": { "description": "Rejects a cost entry with a reason for the denial." }
    },
    "project_costing.categories.create": {
      "permission": "project_costing.manage_cost",
      "transaction": true,
      "sql": [
        "commands/category_create.sql"
      ],
      "schema": "schemas/category_create.json",
      "emit": [
        "project_costing.category.created"
      ],
      "ai": { "description": "Creates a new cost category for classifying project expenses." }
    },
    "project_costing.reports.project_total": {
      "permission": "project_costing.view_cost",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "get_project_total_cost"
      },
      "ai": { "description": "Calculates the total accumulated cost for a project broken down by category." }
    },
    "project_costing.reports.budget_vs_actual": {
      "permission": "project_costing.view_cost",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "get_budget_vs_actual"
      },
      "ai": { "description": "Generates a comparison report of planned budget versus actual cost for a project." }
    }
  },
  "events": {
    "listen": []
  },
  "ui": {
    "entry": "dist/project_costing.esm.js"
  }
}
