{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fiscal_italy.config.upsert",
  "type": "object",
  "additionalProperties": false,
  "required": ["partita_iva", "codice_fiscale", "company_name"],
  "properties": {
    "partita_iva": { "type": "string", "pattern": "^[0-9]{11}$" },
    "codice_fiscale": { "type": "string", "minLength": 1, "maxLength": 20 },
    "company_name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "sdi_environment": {
      "type": "string",
      "enum": ["test", "production"],
      "default": "test"
    },
    "default_codice_destinatario": {
      "type": "string",
      "minLength": 7,
      "maxLength": 7,
      "default": "0000000"
    }
  }
}
