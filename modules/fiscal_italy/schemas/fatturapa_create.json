{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fiscal_italy.fatturapa.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["supplier_piva", "customer_piva", "total_imponibile", "total_iva"],
  "properties": {
    "invoice_ref": { "type": "string", "default": "", "maxLength": 100 },
    "supplier_piva": { "type": "string", "minLength": 1, "maxLength": 20 },
    "customer_piva": { "type": "string", "minLength": 1, "maxLength": 20 },
    "customer_codice_destinatario": {
      "type": "string",
      "minLength": 7,
      "maxLength": 7,
      "default": "0000000"
    },
    "total_imponibile": { "type": "number", "minimum": 0 },
    "total_iva": { "type": "number", "minimum": 0 }
  }
}
