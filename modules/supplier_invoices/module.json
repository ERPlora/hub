{
  "id": "supplier_invoices",
  "name": "Supplier Invoices",
  "version": "1.0.0",
  "agent": {
    "description": "Manages supplier invoices: record, validate, mark as paid, and cancel incoming invoices from suppliers including their line items.",
    "keywords": ["supplier", "invoice", "payable", "purchase", "accounts-payable", "payment"]
  },
  "depends_on": [],
  "permissions": [
    "supplier_invoices.view_si",
    "supplier_invoices.add_si",
    "supplier_invoices.validate_si",
    "supplier_invoices.pay_si"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "supplier_invoices.view_si",
      "supplier_invoices.add_si",
      "supplier_invoices.validate_si",
      "supplier_invoices.pay_si"
    ],
    "employee": [
      "supplier_invoices.view_si"
    ]
  },
  "navigation": [
    {
      "id": "list",
      "label": "Supplier Invoices",
      "icon": "document-text-outline",
      "component": "erp-supplier-invoices-list"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "supplier_invoices.invoices.list": {
      "permission": "supplier_invoices.view_si",
      "sql": "queries/invoices_list.sql",
      "ai": { "description": "Lists recorded supplier invoices." }
    },
    "supplier_invoices.invoices.get": {
      "permission": "supplier_invoices.view_si",
      "sql": "queries/invoice_get.sql",
      "ai": { "description": "Returns the details of a single supplier invoice by its identifier." }
    },
    "supplier_invoices.invoices.lines": {
      "permission": "supplier_invoices.view_si",
      "sql": "queries/invoice_lines.sql",
      "ai": { "description": "Lists the line items of a supplier invoice." }
    }
  },
  "commands": {
    "supplier_invoices.invoices.create": {
      "permission": "supplier_invoices.add_si",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_invoice"
      },
      "schema": "schemas/create_invoice.json",
      "emit": [
        "supplier_invoices.invoice.created"
      ],
      "ai": { "description": "Creates a new supplier invoice with its line items." }
    },
    "supplier_invoices.invoices.validate": {
      "permission": "supplier_invoices.validate_si",
      "transaction": true,
      "sql": [
        "commands/invoice_validate.sql"
      ],
      "emit": [
        "supplier_invoices.invoice.validated"
      ],
      "ai": { "description": "Validates and approves a supplier invoice that is pending review." }
    },
    "supplier_invoices.invoices.mark_paid": {
      "permission": "supplier_invoices.pay_si",
      "transaction": true,
      "sql": [
        "commands/invoice_mark_paid.sql"
      ],
      "emit": [
        "supplier_invoices.invoice.paid"
      ],
      "ai": { "description": "Marks a supplier invoice as paid." }
    },
    "supplier_invoices.invoices.cancel": {
      "permission": "supplier_invoices.add_si",
      "transaction": true,
      "sql": [
        "commands/invoice_cancel.sql"
      ],
      "emit": [
        "supplier_invoices.invoice.cancelled"
      ],
      "ai": { "description": "Cancels an unpaid supplier invoice, setting its status to cancelled (destructive)." }
    },
    "supplier_invoices._insert_invoice": {
      "permission": "supplier_invoices.add_si",
      "sql": [
        "commands/_insert_invoice.sql"
      ]
    },
    "supplier_invoices._insert_line": {
      "permission": "supplier_invoices.add_si",
      "sql": [
        "commands/_insert_line.sql"
      ]
    }
  },
  "ui": {
    "entry": "dist/supplier_invoices.esm.js"
  }
}
