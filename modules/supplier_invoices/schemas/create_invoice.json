{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "supplier_invoices.invoices.create payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["supplier_name", "invoice_number", "lines"],
  "properties": {
    "supplier_name": { "type": "string", "minLength": 1 },
    "invoice_number": { "type": "string", "minLength": 1 },
    "supplier_tax_id": { "type": "string", "default": "" },
    "invoice_date": { "type": ["string", "null"], "description": "ISO YYYY-MM-DD" },
    "due_date": { "type": ["string", "null"], "description": "ISO YYYY-MM-DD" },
    "purchase_order_ref": { "type": "string", "default": "" },
    "tax_amount": { "type": ["number", "string"], "default": "0.00" },
    "notes": { "type": "string", "default": "" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "quantity": { "type": ["number", "string"], "default": "1" },
          "unit_price": { "type": ["number", "string"], "default": "0" }
        }
      }
    }
  }
}
