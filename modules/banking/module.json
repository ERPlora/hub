{
  "id": "banking",
  "name": "Banking",
  "version": "1.0.0",
  "agent": {
    "description": "Manages bank accounts and transactions: list accounts, record transactions, and reconcile entries against official bank statements.",
    "keywords": ["bank", "account", "transaction", "reconcile", "balance", "banking"]
  },
  "depends_on": [],
  "permissions": [
    "banking.view_bank",
    "banking.manage_bank",
    "banking.reconcile"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "banking.view_bank",
      "banking.manage_bank",
      "banking.reconcile"
    ],
    "employee": [
      "banking.view_bank"
    ]
  },
  "navigation": [
    {
      "id": "accounts",
      "label": "Accounts",
      "icon": "card-outline",
      "component": "erp-banking-accounts"
    },
    {
      "id": "transactions",
      "label": "Transactions",
      "icon": "card-outline",
      "component": "erp-banking-transactions"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "banking.accounts.list": {
      "permission": "banking.view_bank",
      "sql": "queries/accounts_list.sql",
      "ai": { "description": "Lists all bank accounts registered in the system" }
    },
    "banking.accounts.get": {
      "permission": "banking.view_bank",
      "sql": "queries/account_get.sql",
      "ai": { "description": "Retrieves the full detail of a specific bank account" }
    },
    "banking.transactions.list": {
      "permission": "banking.view_bank",
      "sql": "queries/transactions_list.sql",
      "ai": { "description": "Lists movements or transactions for a bank account" }
    },
    "banking.transactions.get": {
      "permission": "banking.view_bank",
      "sql": "queries/transaction_get.sql",
      "ai": { "description": "Retrieves the full detail of a specific bank transaction" }
    }
  },
  "commands": {
    "banking.accounts.create": {
      "permission": "banking.manage_bank",
      "transaction": true,
      "sql": [
        "commands/account_create.sql"
      ],
      "schema": "schemas/account_create.json",
      "emit": [
        "banking.account.created"
      ],
      "ai": { "description": "Creates a new bank account in the system" }
    },
    "banking.transactions.add": {
      "permission": "banking.manage_bank",
      "schema": "schemas/transaction_add.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "add_transaction"
      },
      "emit": [
        "banking.transaction.added"
      ],
      "ai": { "description": "Records a new transaction on a bank account" }
    },
    "banking.transactions.reconcile": {
      "permission": "banking.reconcile",
      "transaction": true,
      "sql": [
        "commands/transaction_reconcile.sql"
      ],
      "schema": "schemas/transaction_reconcile.json",
      "emit": [
        "banking.transaction.reconciled"
      ],
      "ai": { "description": "Marks a bank transaction as reconciled against the official statement" }
    },
    "banking.transactions.unreconcile": {
      "permission": "banking.reconcile",
      "transaction": true,
      "sql": [
        "commands/transaction_unreconcile.sql"
      ],
      "schema": "schemas/transaction_unreconcile.json",
      "emit": [
        "banking.transaction.unreconciled"
      ],
      "ai": { "description": "Reverses the reconciliation of a previously reconciled bank transaction" }
    }
  },
  "events": {
    "listen": []
  },
  "ui": {
    "entry": "dist/banking.esm.js"
  }
}
