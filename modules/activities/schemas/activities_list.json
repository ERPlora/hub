{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "activities.activities.list",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "activity_type": {
      "type": "string",
      "enum": ["", "call", "email", "meeting", "task", "note", "sms"],
      "default": ""
    },
    "status": {
      "type": "string",
      "enum": ["", "pending", "completed", "cancelled"],
      "default": ""
    },
    "related_entity_type": {
      "type": "string",
      "enum": ["", "lead", "opportunity", "customer", "deal"],
      "default": ""
    },
    "related_entity_ref": { "type": "string", "default": "", "maxLength": 100 },
    "assigned_to": { "type": "string", "default": "", "maxLength": 100 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 }
  }
}
