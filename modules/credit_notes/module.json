{
  "id": "credit_notes",
  "name": "Credit Notes",
  "version": "1.0.0",
  "agent": {
    "description": "Manages credit notes issued to customers or received from suppliers: create, issue, apply to invoices, unapply, cancel, and query remaining credit balances.",
    "keywords": ["credit note", "refund", "invoice", "credit", "apply", "cancel", "supplier", "customer"]
  },
  "depends_on": [],
  "permissions": [
    "credit_notes.view_cn",
    "credit_notes.add_cn",
    "credit_notes.apply_cn",
    "credit_notes.cancel_cn"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "credit_notes.view_cn",
      "credit_notes.add_cn",
      "credit_notes.apply_cn",
      "credit_notes.cancel_cn"
    ],
    "employee": [
      "credit_notes.view_cn"
    ]
  },
  "navigation": [
    {
      "id": "customer",
      "label": "To Customers",
      "icon": "return-down-back-outline",
      "component": "erp-credit-notes-list"
    },
    {
      "id": "supplier",
      "label": "From Suppliers",
      "icon": "return-down-back-outline",
      "component": "erp-credit-notes-list"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "credit_notes.notes.list": {
      "permission": "credit_notes.view_cn",
      "sql": "queries/notes_list.sql",
      "schema": "schemas/notes_list.json",
      "ai": { "description": "Lists all credit notes with their status and main details." }
    },
    "credit_notes.notes.get": {
      "permission": "credit_notes.view_cn",
      "sql": "queries/note_get.sql",
      "schema": "schemas/note_get.json",
      "ai": { "description": "Retrieves the full details of a credit note by its identifier." }
    },
    "credit_notes.notes.lines": {
      "permission": "credit_notes.view_cn",
      "sql": "queries/note_lines.sql",
      "schema": "schemas/note_get.json",
      "ai": { "description": "Lists the line items of a credit note." }
    },
    "credit_notes.notes.applications": {
      "permission": "credit_notes.view_cn",
      "sql": "queries/note_applications.sql",
      "schema": "schemas/note_get.json",
      "ai": { "description": "Lists the applications of a credit note to existing invoices." }
    },
    "credit_notes.notes.remaining_credit": {
      "permission": "credit_notes.view_cn",
      "sql": "queries/note_remaining_credit.sql",
      "schema": "schemas/note_get.json",
      "ai": { "description": "Returns the remaining available credit balance on a credit note." }
    }
  },
  "commands": {
    "credit_notes.notes.create": {
      "permission": "credit_notes.add_cn",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_credit_note"
      },
      "emit": [
        "credit_notes.note.created"
      ],
      "ai": { "description": "Creates a new credit note with its line items." }
    },
    "credit_notes.notes.issue": {
      "permission": "credit_notes.add_cn",
      "transaction": true,
      "sql": [
        "commands/note_issue.sql"
      ],
      "emit": [
        "credit_notes.note.issued"
      ],
      "ai": { "description": "Issues a draft credit note, making it available for application to invoices." }
    },
    "credit_notes.notes.apply": {
      "permission": "credit_notes.apply_cn",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "apply_to_invoice"
      },
      "emit": [
        "credit_notes.note.applied"
      ],
      "ai": { "description": "Applies a credit note to an invoice, reducing the outstanding balance." }
    },
    "credit_notes.notes.unapply": {
      "permission": "credit_notes.apply_cn",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "unapply"
      },
      "emit": [
        "credit_notes.note.unapplied"
      ],
      "ai": { "description": "Reverses the application of a credit note to an invoice, restoring the credit balance." }
    },
    "credit_notes.notes.cancel": {
      "permission": "credit_notes.cancel_cn",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "cancel_credit_note"
      },
      "emit": [
        "credit_notes.note.cancelled"
      ],
      "ai": { "description": "Cancels a credit note, preventing any future use (destructive)." }
    },
    "credit_notes._insert_note": {
      "permission": "credit_notes.add_cn",
      "sql": [
        "commands/_insert_note.sql"
      ]
    },
    "credit_notes._insert_line": {
      "permission": "credit_notes.add_cn",
      "sql": [
        "commands/_insert_line.sql"
      ]
    },
    "credit_notes._insert_application": {
      "permission": "credit_notes.apply_cn",
      "sql": [
        "commands/_insert_application.sql"
      ]
    },
    "credit_notes._delete_application": {
      "permission": "credit_notes.apply_cn",
      "sql": [
        "commands/_delete_application.sql"
      ]
    },
    "credit_notes._set_applied": {
      "permission": "credit_notes.apply_cn",
      "sql": [
        "commands/_set_applied.sql"
      ]
    }
  },
  "events": {
    "listen": {}
  },
  "ui": {
    "entry": "dist/credit_notes.esm.js"
  }
}
