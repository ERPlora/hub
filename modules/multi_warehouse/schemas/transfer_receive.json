{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "multi_warehouse.transfers.receive",
  "type": "object",
  "additionalProperties": false,
  "required": ["transfer_id", "received_lines"],
  "properties": {
    "transfer_id": { "type": "string", "minLength": 1 },
    "received_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["line_id", "quantity_received"],
        "properties": {
          "line_id": { "type": "string", "minLength": 1 },
          "quantity_received": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
