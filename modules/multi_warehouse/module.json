{
  "id": "multi_warehouse",
  "name": "Multi-Warehouse",
  "version": "1.0.0",
  "agent": {
    "description": "Manages multiple warehouses and inter-warehouse stock transfers: list warehouses, create transfers, dispatch and receive stock movements.",
    "keywords": ["warehouse", "transfer", "stock", "multi-warehouse", "dispatch", "receive"]
  },
  "depends_on": [],
  "permissions": [
    "multi_warehouse.view_warehouse",
    "multi_warehouse.manage_warehouse",
    "multi_warehouse.transfer"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "multi_warehouse.view_warehouse",
      "multi_warehouse.manage_warehouse",
      "multi_warehouse.transfer"
    ],
    "employee": [
      "multi_warehouse.view_warehouse",
      "multi_warehouse.transfer"
    ]
  },
  "navigation": [
    {
      "id": "list",
      "label": "Warehouses",
      "icon": "business-outline",
      "component": "erp-multi-warehouse-list"
    },
    {
      "id": "transfers",
      "label": "Transfers",
      "icon": "swap-horizontal-outline",
      "component": "erp-multi-warehouse-transfers"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "multi_warehouse.warehouses.list": {
      "permission": "multi_warehouse.view_warehouse",
      "sql": "queries/warehouses_list.sql",
      "schema": "schemas/warehouses_list.json",
      "ai": { "description": "Lists all warehouses available in the hub." }
    },
    "multi_warehouse.transfers.list": {
      "permission": "multi_warehouse.view_warehouse",
      "sql": "queries/transfers_list.sql",
      "schema": "schemas/transfers_list.json",
      "ai": { "description": "Lists stock transfer movements between warehouses." }
    },
    "multi_warehouse.transfers.get": {
      "permission": "multi_warehouse.view_warehouse",
      "sql": "queries/transfer_get.sql",
      "schema": "schemas/transfer_get.json",
      "ai": { "description": "Retrieves the details of a warehouse transfer by its ID." }
    },
    "multi_warehouse.transfers.lines": {
      "permission": "multi_warehouse.view_warehouse",
      "sql": "queries/transfer_lines.sql",
      "schema": "schemas/transfer_get.json",
      "ai": { "description": "Retrieves the product lines of a warehouse transfer." }
    }
  },
  "commands": {
    "multi_warehouse.warehouses.create": {
      "permission": "multi_warehouse.manage_warehouse",
      "schema": "schemas/warehouse_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_warehouse"
      },
      "emit": [
        "multi_warehouse.warehouse.created"
      ],
      "ai": { "description": "Creates a new warehouse in the hub." }
    },
    "multi_warehouse.warehouses.set_default": {
      "permission": "multi_warehouse.manage_warehouse",
      "schema": "schemas/warehouse_set_default.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "set_default_warehouse"
      },
      "emit": [
        "multi_warehouse.warehouse.default_changed"
      ],
      "ai": { "description": "Sets a warehouse as the default warehouse for the hub." }
    },
    "multi_warehouse.transfers.create": {
      "permission": "multi_warehouse.transfer",
      "schema": "schemas/transfer_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_transfer"
      },
      "emit": [
        "multi_warehouse.transfer.created"
      ],
      "ai": { "description": "Creates a new stock transfer between two warehouses." }
    },
    "multi_warehouse.transfers.dispatch": {
      "permission": "multi_warehouse.transfer",
      "schema": "schemas/transfer_dispatch.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "dispatch_transfer"
      },
      "emit": [
        "multi_warehouse.transfer.dispatched"
      ],
      "ai": { "description": "Marks a transfer as dispatched from the source warehouse." }
    },
    "multi_warehouse.transfers.receive": {
      "permission": "multi_warehouse.transfer",
      "schema": "schemas/transfer_receive.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "receive_transfer"
      },
      "emit": [
        "multi_warehouse.transfer.received"
      ],
      "ai": { "description": "Records the receipt of a transfer at the destination warehouse." }
    },
    "multi_warehouse.transfers.cancel": {
      "permission": "multi_warehouse.transfer",
      "transaction": true,
      "sql": [
        "commands/transfer_cancel.sql"
      ],
      "schema": "schemas/transfer_cancel.json",
      "emit": [
        "multi_warehouse.transfer.cancelled"
      ],
      "ai": { "description": "Cancels a pending warehouse transfer (destructive)." }
    }
  },
  "events": {
    "listen": []
  },
  "ui": {
    "entry": "dist/multi_warehouse.esm.js"
  }
}
