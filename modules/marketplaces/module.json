{
  "id": "marketplaces",
  "name": "Marketplaces",
  "version": "1.0.0",
  "agent": {
    "description": "Manages marketplace channel integrations: connect to external sales channels (Amazon, eBay, etc.), map products to SKUs, import orders, and synchronize inventory.",
    "keywords": ["marketplace", "amazon", "ebay", "channel", "sync", "order-import", "sku", "multichannel"]
  },
  "depends_on": [],
  "permissions": [
    "marketplaces.view_mp",
    "marketplaces.manage_mp",
    "marketplaces.sync_mp"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "marketplaces.view_mp",
      "marketplaces.manage_mp",
      "marketplaces.sync_mp"
    ],
    "employee": [
      "marketplaces.view_mp"
    ]
  },
  "navigation": [
    {
      "id": "connections",
      "label": "Connections",
      "icon": "globe-outline",
      "component": "erp-marketplaces-connections"
    },
    {
      "id": "syncs",
      "label": "Syncs",
      "icon": "sync-outline",
      "component": "erp-marketplaces-syncs"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "marketplaces.connections.list": {
      "permission": "marketplaces.view_mp",
      "sql": "queries/connections_list.sql",
      "schema": "schemas/connections_list.json",
      "ai": { "description": "Lists configured connections to external sales channels (Amazon, eBay, etc.)." }
    },
    "marketplaces.connections.summary": {
      "permission": "marketplaces.view_mp",
      "sql": "queries/connection_summary.sql",
      "schema": "schemas/connection_summary.json",
      "ai": { "description": "Returns the status summary and metrics for a specific external sales channel connection." }
    },
    "marketplaces.mappings.list": {
      "permission": "marketplaces.view_mp",
      "sql": "queries/mappings_list.sql",
      "schema": "schemas/mappings_list.json",
      "ai": { "description": "Lists mappings between internal products and their corresponding SKUs on external sales channels." }
    },
    "marketplaces.orders.list": {
      "permission": "marketplaces.view_mp",
      "sql": "queries/orders_list.sql",
      "schema": "schemas/orders_list.json",
      "ai": { "description": "Lists orders imported from external sales channels with their fulfillment status." }
    },
    "marketplaces.syncs.list": {
      "permission": "marketplaces.view_mp",
      "sql": "queries/syncs_list.sql",
      "schema": "schemas/syncs_list.json",
      "ai": { "description": "Lists the history of synchronization runs performed with external sales channels." }
    }
  },
  "commands": {
    "marketplaces.connections.create": {
      "permission": "marketplaces.manage_mp",
      "transaction": true,
      "sql": [
        "commands/connection_create.sql"
      ],
      "schema": "schemas/connection_create.json",
      "emit": [
        "marketplaces.connection.created"
      ],
      "ai": { "description": "Creates a new connection to an external sales channel by configuring its credentials." }
    },
    "marketplaces.connections.deactivate": {
      "permission": "marketplaces.manage_mp",
      "transaction": true,
      "sql": [
        "commands/connection_deactivate.sql"
      ],
      "schema": "schemas/connection_deactivate.json",
      "emit": [
        "marketplaces.connection.deactivated"
      ],
      "ai": { "description": "Deactivates an external sales channel connection, stopping all its synchronizations (destructive)." }
    },
    "marketplaces.mappings.create": {
      "permission": "marketplaces.manage_mp",
      "transaction": true,
      "sql": [
        "commands/mapping_create.sql"
      ],
      "schema": "schemas/mapping_create.json",
      "emit": [
        "marketplaces.mapping.created"
      ],
      "ai": { "description": "Creates a mapping between an internal product and its equivalent SKU on an external sales channel." }
    },
    "marketplaces.orders.fulfill": {
      "permission": "marketplaces.sync_mp",
      "transaction": true,
      "sql": [
        "commands/order_fulfill.sql"
      ],
      "schema": "schemas/order_fulfill.json",
      "emit": [
        "marketplaces.order.fulfilled"
      ],
      "ai": { "description": "Marks an external channel order as fulfilled by recording the shipment details." }
    },
    "marketplaces.syncs.start": {
      "permission": "marketplaces.sync_mp",
      "transaction": true,
      "sql": [
        "commands/sync_start.sql"
      ],
      "schema": "schemas/sync_start.json",
      "emit": [
        "marketplaces.sync.started"
      ],
      "ai": { "description": "Starts an inventory and order synchronization with an external sales channel." }
    },
    "marketplaces.orders.import": {
      "permission": "marketplaces.sync_mp",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "import_order"
      },
      "schema": "schemas/order_import.json",
      "emit": [
        "marketplaces.order.imported"
      ],
      "ai": { "description": "Imports an order received from an external sales channel into the internal system." }
    },
    "marketplaces.syncs.complete": {
      "permission": "marketplaces.sync_mp",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "complete_sync"
      },
      "schema": "schemas/sync_complete.json",
      "emit": [
        "marketplaces.sync.completed"
      ],
      "ai": { "description": "Finalizes a synchronization run with an external channel, recording the result and statistics." }
    }
  },
  "ui": {
    "entry": "dist/marketplaces.esm.js"
  }
}
