{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "marketplaces.orders.import",
  "type": "object",
  "additionalProperties": false,
  "required": ["connection_id", "external_order_id", "customer_name", "total_amount", "items"],
  "properties": {
    "connection_id": { "type": "string", "minLength": 1 },
    "external_order_id": { "type": "string", "minLength": 1, "maxLength": 255 },
    "customer_name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "customer_email": { "type": "string", "default": "", "maxLength": 255 },
    "total_amount": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "external_sku": { "type": "string" },
          "description": { "type": "string" },
          "quantity": { "type": "number" },
          "unit_price": { "type": "number" }
        }
      }
    }
  }
}
