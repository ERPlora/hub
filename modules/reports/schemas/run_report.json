{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reports.reports.run",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_id"],
  "properties": {
    "report_id": { "type": "string", "minLength": 1 },
    "filters_override": { "type": ["object", "null"], "default": null },
    "output_format": {
      "type": "string",
      "enum": ["json", "csv", "xlsx", "pdf"],
      "default": "json"
    },
    "data": { "type": ["array", "null"], "default": null },
    "run_by_ref": { "type": ["string", "null"], "default": null }
  }
}
