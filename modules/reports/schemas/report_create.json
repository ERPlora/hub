{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reports.reports.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "name", "data_source", "columns"],
  "properties": {
    "code": { "type": "string", "minLength": 1, "maxLength": 100 },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "description": { "type": "string", "default": "" },
    "report_type": {
      "type": "string",
      "enum": ["table", "pivot", "timeseries", "comparison", "funnel"],
      "default": "table"
    },
    "data_source": { "type": "string", "minLength": 1, "maxLength": 255 },
    "columns": { "type": "array", "minItems": 1 },
    "filters": { "type": ["object", "null"], "default": null },
    "groupings": { "type": ["array", "null"], "default": null },
    "sorts": { "type": ["array", "null"], "default": null },
    "is_public": { "type": "boolean", "default": false },
    "schedule": { "type": ["object", "null"], "default": null },
    "owner_ref": { "type": ["string", "null"], "default": null }
  }
}
