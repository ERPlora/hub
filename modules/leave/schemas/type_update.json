{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "leave.types.update",
  "type": "object",
  "additionalProperties": false,
  "required": ["leave_type_id"],
  "properties": {
    "leave_type_id": { "type": "string", "minLength": 1 },
    "name": { "type": ["string", "null"], "maxLength": 100, "default": null },
    "days_per_year": { "type": ["integer", "null"], "minimum": 0, "default": null },
    "is_paid": { "type": ["boolean", "null"], "default": null },
    "color": { "type": ["string", "null"], "pattern": "^#[0-9a-fA-F]{6}$", "default": null },
    "is_active": { "type": ["boolean", "null"], "default": null }
  }
}
