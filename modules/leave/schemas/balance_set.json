{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "leave.balances.set",
  "type": "object",
  "additionalProperties": false,
  "required": ["employee_id", "employee_name", "leave_type_id", "year"],
  "properties": {
    "employee_id": { "type": "string", "minLength": 1 },
    "employee_name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "leave_type_id": { "type": "string", "minLength": 1 },
    "year": { "type": "integer", "minimum": 2000, "maximum": 2100 },
    "entitled_days": { "type": ["number", "null"], "minimum": 0, "default": null },
    "carried_over": { "type": ["number", "null"], "minimum": 0, "default": null }
  }
}
