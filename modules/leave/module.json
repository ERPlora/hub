{
  "id": "leave",
  "name": "Leave",
  "version": "2.1.5",
  "agent": {
    "description": "Manages employee leave requests: submit, approve, reject, or cancel absences, configure leave types, and track leave balances.",
    "keywords": ["leave", "absence", "vacation", "holiday", "time-off", "approval", "balance", "hr"]
  },
  "depends_on": ["staff"],
  "permissions": [
    "leave.view_leave_request",
    "leave.add_leave_request",
    "leave.change_leave_request",
    "leave.delete_leave_request",
    "leave.approve_leave_request",
    "leave.view_leave_type",
    "leave.manage_leave_type",
    "leave.view_leave_balance",
    "leave.manage_leave_balance",
    "leave.manage_settings"
  ],
  "role_permissions": {
    "admin": ["*"],
    "manager": [
      "leave.view_leave_request",
      "leave.add_leave_request",
      "leave.change_leave_request",
      "leave.approve_leave_request",
      "leave.view_leave_type",
      "leave.manage_leave_type",
      "leave.view_leave_balance",
      "leave.manage_leave_balance",
      "leave.manage_settings"
    ],
    "employee": [
      "leave.view_leave_request",
      "leave.add_leave_request",
      "leave.view_leave_balance"
    ]
  },
  "navigation": [
    {
      "id": "requests",
      "label": "Requests",
      "icon": "document-text-outline",
      "component": "erp-leave-requests"
    },
    {
      "id": "types",
      "label": "Leave Types",
      "icon": "list-outline",
      "component": "erp-leave-types"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "leave.requests.list": {
      "permission": "leave.view_leave_request",
      "sql": "queries/requests_list.sql",
      "schema": "schemas/requests_list.json",
      "ai": { "description": "Lists leave requests filtered by status or employee" }
    },
    "leave.requests.get": {
      "permission": "leave.view_leave_request",
      "sql": "queries/request_get.sql",
      "schema": "schemas/request_get.json",
      "ai": { "description": "Retrieves the full detail of a leave request by its identifier" }
    },
    "leave.requests.pending_count": {
      "permission": "leave.view_leave_request",
      "sql": "queries/pending_count.sql",
      "ai": { "description": "Returns the number of leave requests pending approval" }
    },
    "leave.types.list": {
      "permission": "leave.view_leave_type",
      "sql": "queries/types_list.sql",
      "ai": { "description": "Lists the configured leave types (vacation, sick leave, etc.)" }
    },
    "leave.balances.list": {
      "permission": "leave.view_leave_balance",
      "sql": "queries/balances_list.sql",
      "schema": "schemas/balances_list.json",
      "ai": { "description": "Lists available leave day balances per employee and leave type" }
    },
    "leave.settings.get": {
      "permission": "leave.manage_settings",
      "sql": "queries/settings_get.sql",
      "ai": { "description": "Retrieves the settings for the leave module" }
    }
  },
  "commands": {
    "leave.types.create": {
      "permission": "leave.manage_leave_type",
      "transaction": true,
      "sql": ["commands/type_create.sql"],
      "schema": "schemas/type_create.json",
      "emit": ["leave.type.created"],
      "ai": { "description": "Creates a new leave type (vacation, sick leave, etc.)" }
    },
    "leave.types.update": {
      "permission": "leave.manage_leave_type",
      "transaction": true,
      "sql": ["commands/type_update.sql"],
      "schema": "schemas/type_update.json",
      "emit": ["leave.type.updated"],
      "ai": { "description": "Updates the configuration of an existing leave type" }
    },
    "leave.types.delete": {
      "permission": "leave.manage_leave_type",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "delete_leave_type"
      },
      "schema": "schemas/type_delete.json",
      "emit": ["leave.type.deleted"],
      "ai": { "description": "Deletes a leave type (destructive)" }
    },
    "leave.requests.create": {
      "permission": "leave.add_leave_request",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_request"
      },
      "schema": "schemas/request_create.json",
      "emit": ["leave.request.created"],
      "ai": { "description": "Creates a new leave request for an employee" }
    },
    "leave.requests.update": {
      "permission": "leave.change_leave_request",
      "transaction": true,
      "sql": ["commands/request_update.sql"],
      "schema": "schemas/request_update.json",
      "emit": ["leave.request.updated"],
      "ai": { "description": "Updates the dates or details of a pending leave request" }
    },
    "leave.requests.approve": {
      "permission": "leave.approve_leave_request",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "approve_request"
      },
      "schema": "schemas/request_approve.json",
      "emit": ["leave.request_approved"],
      "ai": { "description": "Approves a leave request and deducts the corresponding balance" }
    },
    "leave.requests.reject": {
      "permission": "leave.approve_leave_request",
      "transaction": true,
      "sql": ["commands/request_reject.sql"],
      "schema": "schemas/request_reject.json",
      "emit": ["leave.request_rejected"],
      "ai": { "description": "Rejects a leave request with a stated reason" }
    },
    "leave.requests.cancel": {
      "permission": "leave.delete_leave_request",
      "transaction": true,
      "sql": ["commands/request_cancel.sql"],
      "schema": "schemas/request_cancel.json",
      "emit": ["leave.request.cancelled"],
      "ai": { "description": "Cancels an approved or pending leave request" }
    },
    "leave.balances.set": {
      "permission": "leave.manage_leave_balance",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "set_balance"
      },
      "schema": "schemas/balance_set.json",
      "emit": ["leave.balance.set"],
      "ai": { "description": "Sets or adjusts the leave day balance for an employee for a given leave type" }
    },
    "leave._insert_request": {
      "permission": "leave.add_leave_request",
      "sql": ["commands/_insert_request.sql"]
    },
    "leave._set_request_status": {
      "permission": "leave.approve_leave_request",
      "sql": ["commands/_set_request_status.sql"]
    },
    "leave._balance_insert": {
      "permission": "leave.manage_leave_balance",
      "sql": ["commands/_balance_insert.sql"]
    },
    "leave._balance_update": {
      "permission": "leave.manage_leave_balance",
      "sql": ["commands/_balance_update.sql"]
    }
  },
  "events": {
    "listen": [
      "leave.request_approved",
      "leave.request_rejected"
    ]
  },
  "ui": {
    "entry": "dist/leave.esm.js"
  }
}
