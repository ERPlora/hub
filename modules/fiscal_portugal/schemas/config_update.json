{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fiscal_portugal.config.update",
  "type": "object",
  "additionalProperties": false,
  "required": ["nif", "company_name"],
  "properties": {
    "nif": { "type": "string", "pattern": "^[0-9]{9}$" },
    "company_name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "at_environment": {
      "type": "string",
      "enum": ["test", "production"],
      "default": "test"
    },
    "serie_certification_code": {
      "type": ["string", "null"],
      "maxLength": 20,
      "default": null
    }
  }
}
