{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fiscal_portugal.atcud.assign",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_type", "document_series_code", "document_number"],
  "properties": {
    "document_type": {
      "type": "string",
      "enum": ["invoice", "credit_note", "receipt"]
    },
    "document_series_code": { "type": "string", "minLength": 1, "maxLength": 40 },
    "document_number": { "type": "string", "minLength": 1, "maxLength": 60 },
    "invoice_ref": { "type": "string", "default": "", "maxLength": 100 },
    "hash_value": { "type": ["string", "null"], "default": null, "maxLength": 255 }
  }
}
