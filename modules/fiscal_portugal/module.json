{
  "id": "fiscal_portugal",
  "name": "Fiscal Portugal",
  "version": "1.0.0",
  "agent": {
    "description": "Handles Portuguese fiscal compliance: generates and submits SAF-T PT files, assigns ATCUD codes to fiscal documents, and communicates invoices and receipts to the Autoridade Tributária.",
    "keywords": ["saft", "atcud", "portugal", "fiscal", "at", "e-invoice", "tax authority"]
  },
  "depends_on": [],
  "permissions": [
    "fiscal_portugal.view_fiscal_pt",
    "fiscal_portugal.export_saft",
    "fiscal_portugal.submit_at"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "fiscal_portugal.view_fiscal_pt",
      "fiscal_portugal.export_saft",
      "fiscal_portugal.submit_at"
    ],
    "employee": [
      "fiscal_portugal.view_fiscal_pt"
    ]
  },
  "navigation": [
    {
      "id": "saft",
      "label": "SAF-T PT",
      "icon": "shield-checkmark-outline",
      "component": "erp-fiscal-portugal-saft"
    },
    {
      "id": "comunicacao",
      "label": "Comunicação AT",
      "icon": "paper-plane-outline",
      "component": "erp-fiscal-portugal-comunicacao"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "fiscal_portugal.config.get": {
      "permission": "fiscal_portugal.view_fiscal_pt",
      "sql": "queries/config_get.sql",
      "schema": "schemas/config_get.json",
      "ai": { "description": "Retrieves the Portuguese fiscal configuration for the hub." }
    },
    "fiscal_portugal.saft.list": {
      "permission": "fiscal_portugal.view_fiscal_pt",
      "sql": "queries/saft_list.sql",
      "schema": "schemas/saft_list.json",
      "ai": { "description": "Lists generated SAF-T PT files for the Portuguese tax authority." }
    },
    "fiscal_portugal.atcud.list": {
      "permission": "fiscal_portugal.view_fiscal_pt",
      "sql": "queries/atcud_list.sql",
      "schema": "schemas/atcud_list.json",
      "ai": { "description": "Lists ATCUD codes assigned to Portuguese fiscal documents." }
    },
    "fiscal_portugal.at_comm.list": {
      "permission": "fiscal_portugal.view_fiscal_pt",
      "sql": "queries/at_comm_list.sql",
      "schema": "schemas/at_comm_list.json",
      "ai": { "description": "Lists communications sent to the Portuguese Autoridade Tributária." }
    }
  },
  "commands": {
    "fiscal_portugal.config.update": {
      "permission": "fiscal_portugal.submit_at",
      "schema": "schemas/config_update.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "update_config"
      },
      "emit": [
        "fiscal_portugal.config.updated"
      ],
      "ai": { "description": "Updates the Portuguese fiscal configuration for the hub." }
    },
    "fiscal_portugal.saft.generate": {
      "permission": "fiscal_portugal.export_saft",
      "schema": "schemas/saft_generate.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "generate_saft"
      },
      "emit": [
        "fiscal_portugal.saft.generated"
      ],
      "ai": { "description": "Generates the SAF-T PT file with accounting data for the period for fiscal export." }
    },
    "fiscal_portugal.saft.submit": {
      "permission": "fiscal_portugal.export_saft",
      "schema": "schemas/saft_submit.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "submit_saft"
      },
      "emit": [
        "fiscal_portugal.saft.submitted"
      ],
      "ai": { "description": "Submits the SAF-T PT file to the Portuguese Autoridade Tributária." }
    },
    "fiscal_portugal.atcud.assign": {
      "permission": "fiscal_portugal.export_saft",
      "schema": "schemas/atcud_assign.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "assign_atcud"
      },
      "emit": [
        "fiscal_portugal.atcud.assigned"
      ],
      "ai": { "description": "Assigns a unique ATCUD code to a Portuguese fiscal document." }
    },
    "fiscal_portugal.at_comm.create": {
      "permission": "fiscal_portugal.submit_at",
      "schema": "schemas/at_comm_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_at_communication"
      },
      "emit": [
        "fiscal_portugal.at_comm.created"
      ],
      "ai": { "description": "Creates a communication to be sent to the Portuguese AT (invoices, receipts, etc.)." }
    },
    "fiscal_portugal.at_comm.submit": {
      "permission": "fiscal_portugal.submit_at",
      "schema": "schemas/at_comm_submit.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "submit_at_communication"
      },
      "emit": [
        "fiscal_portugal.at_comm.submitted"
      ],
      "ai": { "description": "Submits a communication to the Portuguese Autoridade Tributária via webservice." }
    },
    "fiscal_portugal.at_comm.set_status": {
      "permission": "fiscal_portugal.submit_at",
      "schema": "schemas/at_comm_set_status.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "update_communication_status"
      },
      "emit": [
        "fiscal_portugal.at_comm.status_changed"
      ],
      "ai": { "description": "Updates the status of a communication sent to the Portuguese AT." }
    },
    "fiscal_portugal._config_upsert": {
      "permission": "fiscal_portugal.submit_at",
      "sql": [
        "commands/_config_upsert.sql"
      ]
    },
    "fiscal_portugal._config_update": {
      "permission": "fiscal_portugal.submit_at",
      "sql": [
        "commands/_config_update.sql"
      ]
    },
    "fiscal_portugal._saft_insert": {
      "permission": "fiscal_portugal.export_saft",
      "sql": [
        "commands/_saft_insert.sql"
      ]
    },
    "fiscal_portugal._saft_submit": {
      "permission": "fiscal_portugal.export_saft",
      "sql": [
        "commands/_saft_submit.sql"
      ]
    },
    "fiscal_portugal._atcud_insert": {
      "permission": "fiscal_portugal.export_saft",
      "sql": [
        "commands/_atcud_insert.sql"
      ]
    },
    "fiscal_portugal._at_comm_insert": {
      "permission": "fiscal_portugal.submit_at",
      "sql": [
        "commands/_at_comm_insert.sql"
      ]
    },
    "fiscal_portugal._at_comm_submit": {
      "permission": "fiscal_portugal.submit_at",
      "sql": [
        "commands/_at_comm_submit.sql"
      ]
    },
    "fiscal_portugal._at_comm_set_status": {
      "permission": "fiscal_portugal.submit_at",
      "sql": [
        "commands/_at_comm_set_status.sql"
      ]
    }
  },
  "events": {
    "listen": []
  },
  "ui": {
    "entry": "dist/fiscal_portugal.esm.js"
  }
}
