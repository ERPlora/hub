{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai_predictions.models.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "name", "prediction_type", "entity_type"],
  "properties": {
    "code": { "type": "string", "minLength": 1, "maxLength": 64 },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "prediction_type": {
      "type": "string",
      "enum": ["churn", "lead_score", "upsell", "sales_forecast", "risk", "anomaly"]
    },
    "entity_type": { "type": "string", "minLength": 1, "maxLength": 64 },
    "model_version": { "type": "string", "default": "1.0.0", "maxLength": 40 },
    "features": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    }
  }
}
