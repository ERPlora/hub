{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai_predictions.predictions.record",
  "type": "object",
  "additionalProperties": false,
  "required": ["model_id", "entity_ref", "prediction_value", "confidence"],
  "properties": {
    "model_id": { "type": "string", "minLength": 1 },
    "entity_ref": { "type": "string", "minLength": 1, "maxLength": 255 },
    "prediction_value": { "type": "number" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "features_used": { "type": "object", "default": {} },
    "explanation": { "type": "string", "default": "" }
  }
}
