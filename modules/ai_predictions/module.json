{
  "id": "ai_predictions",
  "name": "AI Predictions",
  "version": "1.0.0",
  "agent": {
    "description": "Manages predictive model definitions and their predictions: register and deactivate models, record predictions from external ML systems, collect feedback, and query accuracy metrics.",
    "keywords": ["prediction", "forecast", "ml model", "churn", "lead score", "accuracy", "feedback", "anomaly"]
  },
  "depends_on": [],
  "permissions": [
    "ai_predictions.view_pred",
    "ai_predictions.manage_model",
    "ai_predictions.predict"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "ai_predictions.view_pred",
      "ai_predictions.manage_model",
      "ai_predictions.predict"
    ],
    "employee": [
      "ai_predictions.view_pred",
      "ai_predictions.predict"
    ]
  },
  "navigation": [
    {
      "id": "models",
      "label": "Models",
      "icon": "eye-outline",
      "component": "erp-ai-predictions-models"
    },
    {
      "id": "predictions",
      "label": "Predictions",
      "icon": "eye-outline",
      "component": "erp-ai-predictions-predictions"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "ai_predictions.models.list": {
      "permission": "ai_predictions.view_pred",
      "sql": "queries/models_list.sql",
      "ai": { "description": "Lists registered predictive models with their type and current accuracy." }
    },
    "ai_predictions.predictions.list": {
      "permission": "ai_predictions.view_pred",
      "sql": "queries/predictions_list.sql",
      "ai": { "description": "Lists predictions generated by AI models." }
    },
    "ai_predictions.predictions.get": {
      "permission": "ai_predictions.view_pred",
      "sql": "queries/prediction_get.sql",
      "ai": { "description": "Gets the detail of a specific prediction including its value and confidence score." }
    },
    "ai_predictions.feedback.list": {
      "permission": "ai_predictions.view_pred",
      "sql": "queries/feedback_list.sql",
      "ai": { "description": "Lists feedback recorded on predictions for evaluating model quality." }
    }
  },
  "commands": {
    "ai_predictions.models.create": {
      "permission": "ai_predictions.manage_model",
      "transaction": true,
      "sql": [
        "commands/model_create.sql"
      ],
      "schema": "schemas/model_create.json",
      "emit": [
        "ai_predictions.model.created"
      ],
      "ai": { "description": "Registers a new predictive model in the catalog." }
    },
    "ai_predictions.models.deactivate": {
      "permission": "ai_predictions.manage_model",
      "transaction": true,
      "sql": [
        "commands/model_deactivate.sql"
      ],
      "schema": "schemas/model_deactivate.json",
      "emit": [
        "ai_predictions.model.deactivated"
      ],
      "ai": { "description": "Deactivates a predictive model so it no longer generates new predictions (destructive)." }
    },
    "ai_predictions.models.update_accuracy": {
      "permission": "ai_predictions.manage_model",
      "schema": "schemas/model_update_accuracy.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "update_model_accuracy"
      },
      "emit": [
        "ai_predictions.model.accuracy_updated"
      ],
      "ai": { "description": "Updates the accuracy metric of a predictive model." }
    },
    "ai_predictions.predictions.record": {
      "permission": "ai_predictions.predict",
      "schema": "schemas/prediction_record.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "record_prediction"
      },
      "emit": [
        "ai_predictions.prediction.recorded"
      ],
      "ai": { "description": "Records a new prediction generated by an external ML model." }
    },
    "ai_predictions.feedback.record": {
      "permission": "ai_predictions.manage_model",
      "schema": "schemas/feedback_record.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "record_feedback"
      },
      "emit": [
        "ai_predictions.feedback.recorded"
      ],
      "ai": { "description": "Records feedback on a prediction to improve model evaluation." }
    },
    "ai_predictions.models.accuracy": {
      "permission": "ai_predictions.view_pred",
      "schema": "schemas/model_accuracy.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "get_model_accuracy"
      },
      "ai": { "description": "Gets the current accuracy metrics of a predictive model." }
    }
  },
  "events": {
    "listen": []
  },
  "ai_context": "Predictive models registry + per-entity predictions and feedback (churn, lead score, upsell, sales forecast, risk, anomaly). Stores records of predictions made by external LLM/ML systems; model training and inference happen outside the hub. This module is the catalog + audit trail + accuracy gauge. Entities (PredictionModel, Prediction, PredictionFeedback). Queries: ai_predictions.models.list, ai_predictions.predictions.list, ai_predictions.predictions.get, ai_predictions.feedback.list. Commands: models.create, models.deactivate, models.update_accuracy, predictions.record, feedback.record, models.accuracy.",
  "ui": {
    "entry": "dist/ai_predictions.esm.js"
  }
}
