{
  "id": "credit_risk",
  "name": "Credit Risk",
  "version": "1.0.0",
  "agent": {
    "description": "Manages customer credit risk: register credit profiles, set and update credit limits, block or unblock customers for credit operations, record risk events, recalculate risk scores, and manage alerts.",
    "keywords": ["credit risk", "credit limit", "block", "score", "alert", "customer", "payment", "risk"]
  },
  "depends_on": [],
  "permissions": [
    "credit_risk.view_risk",
    "credit_risk.manage_risk",
    "credit_risk.override"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "credit_risk.view_risk",
      "credit_risk.manage_risk",
      "credit_risk.override"
    ],
    "employee": [
      "credit_risk.view_risk"
    ]
  },
  "navigation": [
    {
      "id": "customers",
      "label": "Customers",
      "icon": "shield-half-outline",
      "component": "erp-credit-risk-customers"
    },
    {
      "id": "alerts",
      "label": "Alerts",
      "icon": "warning-outline",
      "component": "erp-credit-risk-alerts"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "credit_risk.customers.list": {
      "permission": "credit_risk.view_risk",
      "sql": "queries/customers_list.sql",
      "schema": "schemas/customers_list.json",
      "ai": { "description": "Lists customers with their credit risk profile and credit limit." }
    },
    "credit_risk.customers.get": {
      "permission": "credit_risk.view_risk",
      "sql": "queries/customer_get.sql",
      "schema": "schemas/customer_get.json",
      "ai": { "description": "Retrieves the detailed credit risk profile of a customer." }
    },
    "credit_risk.events.list": {
      "permission": "credit_risk.view_risk",
      "sql": "queries/events_list.sql",
      "schema": "schemas/events_list.json",
      "ai": { "description": "Lists the risk events recorded for customers." }
    },
    "credit_risk.alerts.list": {
      "permission": "credit_risk.view_risk",
      "sql": "queries/alerts_list.sql",
      "schema": "schemas/alerts_list.json",
      "ai": { "description": "Lists active or historical credit risk alerts." }
    }
  },
  "commands": {
    "credit_risk.customers.register": {
      "permission": "credit_risk.manage_risk",
      "transaction": true,
      "sql": [
        "commands/customer_register.sql"
      ],
      "schema": "schemas/customer_register.json",
      "emit": [
        "credit_risk.customer.registered"
      ],
      "ai": { "description": "Registers a customer in the credit risk system with an initial credit limit." }
    },
    "credit_risk.customers.block": {
      "permission": "credit_risk.manage_risk",
      "transaction": true,
      "sql": [
        "commands/customer_block.sql"
      ],
      "schema": "schemas/customer_block.json",
      "emit": [
        "credit_risk.customer.blocked"
      ],
      "ai": { "description": "Blocks a customer to prevent new credit operations." }
    },
    "credit_risk.customers.unblock": {
      "permission": "credit_risk.manage_risk",
      "transaction": true,
      "sql": [
        "commands/customer_unblock.sql"
      ],
      "schema": "schemas/customer_unblock.json",
      "emit": [
        "credit_risk.customer.unblocked"
      ],
      "ai": { "description": "Unblocks a customer to allow credit operations again." }
    },
    "credit_risk.alerts.acknowledge": {
      "permission": "credit_risk.manage_risk",
      "transaction": true,
      "sql": [
        "commands/alert_acknowledge.sql"
      ],
      "schema": "schemas/alert_acknowledge.json",
      "emit": [
        "credit_risk.alert.acknowledged"
      ],
      "ai": { "description": "Marks a credit risk alert as reviewed and handled." }
    },
    "credit_risk.customers.update_limit": {
      "permission": "credit_risk.manage_risk",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "update_limit"
      },
      "schema": "schemas/customer_update_limit.json",
      "emit": [
        "credit_risk.limit.updated"
      ],
      "ai": { "description": "Updates the credit limit of a customer." }
    },
    "credit_risk.events.record": {
      "permission": "credit_risk.manage_risk",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "record_event"
      },
      "schema": "schemas/event_record.json",
      "emit": [
        "credit_risk.event.recorded",
        "credit_risk.alert.triggered"
      ],
      "ai": { "description": "Records a risk event (late payment, default, etc.) for a customer and may trigger alerts." }
    },
    "credit_risk.customers.update_score": {
      "permission": "credit_risk.manage_risk",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "update_score"
      },
      "schema": "schemas/customer_update_score.json",
      "emit": [
        "credit_risk.score.updated",
        "credit_risk.alert.triggered"
      ],
      "ai": { "description": "Recalculates and updates the credit risk score of a customer." }
    },
    "credit_risk.customers.check_limit": {
      "permission": "credit_risk.view_risk",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "check_limit"
      },
      "schema": "schemas/customer_check_limit.json",
      "ai": { "description": "Checks whether a customer has sufficient credit limit available for a given operation." }
    }
  },
  "events": {
    "listen": []
  },
  "ui": {
    "entry": "dist/credit_risk.esm.js"
  }
}
