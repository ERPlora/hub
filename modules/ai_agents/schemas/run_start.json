{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai_agents.runs.start",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_id", "input_query"],
  "properties": {
    "agent_id": { "type": "string", "minLength": 1 },
    "input_query": { "type": "string", "minLength": 1 },
    "trigger_type": {
      "type": "string",
      "enum": ["manual", "scheduled", "event"],
      "default": "manual"
    }
  }
}
