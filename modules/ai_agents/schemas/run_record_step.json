{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai_agents.runs.record_step",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "step_type", "content"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "step_type": {
      "type": "string",
      "enum": ["thought", "tool_call", "observation", "answer"]
    },
    "content": { "type": "string" },
    "tool_name": { "type": "string", "default": "" },
    "tokens_used": { "type": "integer", "minimum": 0, "default": 0 }
  }
}
