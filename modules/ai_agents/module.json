{
  "id": "ai_agents",
  "name": "AI Agents",
  "version": "1.0.0",
  "agent": {
    "description": "Manages autonomous AI agents: define agents with system prompts and allowed tools, start and monitor runs, record step-by-step traces, and mark runs as completed or failed.",
    "keywords": ["ai agent", "agent run", "agent step", "automation", "tool call", "llm", "run lifecycle"]
  },
  "depends_on": [],
  "ai_context": "Autonomous AI agents — define, execute and monitor agent runs and steps. Models: Agent (system prompt + allowed tools + config), AgentRun (one execution with status/token/cost accounting), AgentStep (step-by-step trace: thought/tool_call/observation/answer). Read with ai_agents.agents.list / ai_agents.runs.list / ai_agents.runs.get / ai_agents.steps.list. Mutate with ai_agents.agents.create/update/deactivate and the run lifecycle ai_agents.runs.start/record_step/complete/fail.",
  "permissions": [
    "ai_agents.view_agent",
    "ai_agents.manage_agent",
    "ai_agents.run_agent"
  ],
  "role_permissions": {
    "admin": ["*"],
    "manager": [
      "ai_agents.view_agent",
      "ai_agents.manage_agent",
      "ai_agents.run_agent"
    ],
    "employee": ["ai_agents.view_agent"]
  },
  "navigation": [
    {
      "id": "agents",
      "label": "Agents",
      "icon": "hardware-chip-outline",
      "component": "erp-ai-agents-agents"
    },
    {
      "id": "runs",
      "label": "Runs",
      "icon": "hardware-chip-outline",
      "component": "erp-ai-agents-runs"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "ai_agents.agents.list": {
      "permission": "ai_agents.view_agent",
      "sql": "queries/agents_list.sql",
      "ai": { "description": "Lists defined AI agents with their configuration and allowed tools." }
    },
    "ai_agents.runs.list": {
      "permission": "ai_agents.view_agent",
      "sql": "queries/runs_list.sql",
      "ai": { "description": "Lists AI agent runs with their status and token cost." }
    },
    "ai_agents.runs.get": {
      "permission": "ai_agents.view_agent",
      "sql": "queries/run_get.sql",
      "ai": { "description": "Gets the full detail of a specific AI agent run." }
    },
    "ai_agents.steps.list": {
      "permission": "ai_agents.view_agent",
      "sql": "queries/steps_list.sql",
      "ai": { "description": "Lists the steps of an agent run (thought, tool call, observation, answer)." }
    }
  },
  "commands": {
    "ai_agents.agents.create": {
      "permission": "ai_agents.manage_agent",
      "transaction": true,
      "sql": ["commands/agent_create.sql"],
      "schema": "schemas/agent_create.json",
      "emit": ["ai_agents.agent.created"],
      "ai": { "description": "Creates a new AI agent with its system prompt and authorized tools." }
    },
    "ai_agents.agents.update": {
      "permission": "ai_agents.manage_agent",
      "transaction": true,
      "sql": ["commands/agent_update.sql"],
      "schema": "schemas/agent_update.json",
      "emit": ["ai_agents.agent.updated"],
      "ai": { "description": "Updates the configuration of an existing AI agent." }
    },
    "ai_agents.agents.deactivate": {
      "permission": "ai_agents.manage_agent",
      "transaction": true,
      "sql": ["commands/agent_deactivate.sql"],
      "schema": "schemas/agent_deactivate.json",
      "emit": ["ai_agents.agent.deactivated"],
      "ai": { "description": "Deactivates an AI agent so it can no longer be executed (destructive)." }
    },
    "ai_agents.runs.start": {
      "permission": "ai_agents.run_agent",
      "schema": "schemas/run_start.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "start_run"
      },
      "emit": ["ai_agents.run.started"],
      "ai": { "description": "Starts a new execution run for an AI agent." }
    },
    "ai_agents.runs.record_step": {
      "permission": "ai_agents.run_agent",
      "schema": "schemas/run_record_step.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "record_step"
      },
      "emit": ["ai_agents.run.step_recorded"],
      "ai": { "description": "Records a step in an agent run (thought, tool call, observation, or answer)." }
    },
    "ai_agents.runs.complete": {
      "permission": "ai_agents.run_agent",
      "schema": "schemas/run_complete.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "complete_run"
      },
      "emit": ["ai_agents.run.completed"],
      "ai": { "description": "Marks an AI agent run as successfully completed." }
    },
    "ai_agents.runs.fail": {
      "permission": "ai_agents.run_agent",
      "schema": "schemas/run_fail.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "fail_run"
      },
      "emit": ["ai_agents.run.failed"],
      "ai": { "description": "Records the failure of an AI agent run with the error reason." }
    }
  },
  "events": {
    "listen": []
  },
  "ui": {
    "entry": "dist/ai_agents.esm.js"
  }
}
