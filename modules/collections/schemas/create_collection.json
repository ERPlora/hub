{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "collections.collections.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["collection_date", "amount", "payer_name"],
  "properties": {
    "collection_date": { "type": "string", "format": "date" },
    "amount": { "type": "string", "minLength": 1, "description": "Decimal como string para evitar redondeo de float; debe ser > 0" },
    "payer_name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "concept": { "type": "string", "default": "" },
    "payer_iban": { "type": ["string", "null"], "default": "", "maxLength": 34 },
    "method": {
      "type": "string",
      "enum": ["transfer", "card", "cash", "sepa", "other"],
      "default": "transfer"
    },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3, "default": "EUR" }
  }
}
