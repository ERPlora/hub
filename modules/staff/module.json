{
  "id": "staff",
  "name": "Staff",
  "version": "2.0.4",
  "agent": {
    "description": "Manages staff members, roles, schedules and time-off requests: list, create, update and deactivate employees, manage work schedules, and approve or reject time-off.",
    "keywords": ["staff", "employee", "roles", "schedule", "time-off", "hr", "personnel"]
  },
  "depends_on": [],
  "permissions": [
    "staff.view_staff_member",
    "staff.add_staff_member",
    "staff.change_staff_member",
    "staff.delete_staff_member",
    "staff.view_time_off",
    "staff.manage_time_off",
    "staff.manage_settings"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "staff.view_staff_member",
      "staff.add_staff_member",
      "staff.change_staff_member",
      "staff.view_time_off",
      "staff.manage_time_off",
      "staff.manage_settings"
    ],
    "employee": [
      "staff.view_staff_member",
      "staff.view_time_off"
    ]
  },
  "navigation": [
    {
      "id": "staff",
      "label": "Staff",
      "icon": "people-outline",
      "component": "erp-staff-members"
    },
    {
      "id": "roles",
      "label": "Roles",
      "icon": "shield-outline",
      "component": "erp-staff-roles"
    },
    {
      "id": "time_off",
      "label": "Time Off",
      "icon": "calendar-outline",
      "component": "erp-staff-time-off"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "staff.members.list": {
      "permission": "staff.view_staff_member",
      "sql": "queries/members_list.sql",
      "ai": { "description": "Lists all staff members with their status and role." }
    },
    "staff.members.get": {
      "permission": "staff.view_staff_member",
      "sql": "queries/member_get.sql",
      "ai": { "description": "Returns the details of a single staff member by their identifier." }
    },
    "staff.roles.list": {
      "permission": "staff.view_staff_member",
      "sql": "queries/roles_list.sql",
      "ai": { "description": "Lists all available staff roles and their assigned permissions." }
    },
    "staff.time_off.list": {
      "permission": "staff.view_time_off",
      "sql": "queries/time_off_list.sql",
      "ai": { "description": "Lists time-off requests for staff members, optionally filtered by status or member." }
    },
    "staff.settings.get": {
      "permission": "staff.view_staff_member",
      "sql": "queries/settings_get.sql",
      "ai": { "description": "Returns the general configuration settings for the staff module." }
    },
    "staff.schedules.list_for_member": {
      "permission": "staff.view_staff_member",
      "sql": "queries/schedules_list_for_member.sql",
      "ai": { "description": "Lists the work schedules assigned to a specific staff member." }
    }
  },
  "commands": {
    "staff.members.create": {
      "permission": "staff.add_staff_member",
      "transaction": true,
      "sql": [
        "commands/member_create.sql"
      ],
      "schema": "schemas/member_create.json",
      "emit": [
        "staff.member.created"
      ],
      "ai": { "description": "Creates a new staff member and emits a member-created event." }
    },
    "staff.members.update": {
      "permission": "staff.change_staff_member",
      "transaction": true,
      "sql": [
        "commands/member_update.sql"
      ],
      "schema": "schemas/member_update.json",
      "emit": [
        "staff.member.updated"
      ],
      "ai": { "description": "Updates the details of an existing staff member." }
    },
    "staff.members.deactivate": {
      "permission": "staff.delete_staff_member",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "deactivate_staff_member"
      },
      "schema": "schemas/member_deactivate.json",
      "emit": [
        "staff.member.deactivated"
      ],
      "ai": { "description": "Deactivates a staff member without permanently deleting them." }
    },
    "staff.members.delete": {
      "permission": "staff.delete_staff_member",
      "transaction": true,
      "sql": [
        "commands/member_delete.sql"
      ],
      "schema": "schemas/member_delete.json",
      "emit": [
        "staff.member.terminated"
      ],
      "ai": { "description": "Terminates a staff member by soft-deleting their record (destructive)." }
    },
    "staff.members.bulk_create": {
      "permission": "staff.add_staff_member",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "bulk_create_staff_members"
      },
      "schema": "schemas/member_bulk_create.json",
      "emit": [
        "staff.member.created"
      ],
      "ai": { "description": "Creates multiple staff members in a single batch operation." }
    },
    "staff.roles.create": {
      "permission": "staff.manage_settings",
      "transaction": true,
      "sql": [
        "commands/role_create.sql"
      ],
      "schema": "schemas/role_create.json",
      "emit": [
        "staff.role.created"
      ],
      "ai": { "description": "Creates a new staff role with its associated permissions." }
    },
    "staff.time_off.create": {
      "permission": "staff.manage_time_off",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_time_off"
      },
      "schema": "schemas/time_off_create.json",
      "emit": [
        "staff.time_off.created"
      ],
      "ai": { "description": "Registers a new time-off request for a staff member." }
    },
    "staff.time_off.set_status": {
      "permission": "staff.manage_time_off",
      "transaction": true,
      "sql": [
        "commands/time_off_set_status.sql"
      ],
      "schema": "schemas/time_off_set_status.json",
      "emit": [
        "staff.time_off.status_changed"
      ],
      "ai": { "description": "Changes the status of a time-off request (e.g. approved, rejected)." }
    },
    "staff.schedules.create": {
      "permission": "staff.manage_settings",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_schedule"
      },
      "schema": "schemas/schedule_create.json",
      "emit": [
        "staff.schedule.created"
      ],
      "ai": { "description": "Creates a new work schedule and assigns it to a staff member." }
    },
    "staff.settings.update": {
      "permission": "staff.manage_settings",
      "transaction": true,
      "sql": [
        "commands/settings_update.sql"
      ],
      "schema": "schemas/settings_update.json",
      "emit": [
        "staff.settings.updated"
      ],
      "ai": { "description": "Updates the general configuration settings for the staff module." }
    }
  },
  "events": {
    "listen": [
      "appointment.created"
    ]
  },
  "ui": {
    "entry": "dist/staff.esm.js"
  }
}
