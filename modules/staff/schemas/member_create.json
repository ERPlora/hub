{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "staff.members.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["first_name", "last_name"],
  "properties": {
    "first_name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "last_name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "email": { "type": "string", "default": "", "maxLength": 254 },
    "phone": { "type": "string", "default": "", "maxLength": 20 },
    "employee_id": { "type": "string", "default": "", "maxLength": 50 },
    "role_id": { "type": ["string", "null"], "default": null },
    "hire_date": { "type": ["string", "null"], "format": "date", "default": null },
    "status": {
      "type": "string",
      "enum": ["active", "inactive", "on_leave", "terminated"],
      "default": "active"
    },
    "bio": { "type": "string", "default": "" },
    "specialties": { "type": "string", "default": "" },
    "is_bookable": { "type": "integer", "enum": [0, 1], "default": 1 },
    "color": { "type": "string", "default": "", "maxLength": 7 },
    "hourly_rate": { "type": "number", "minimum": 0, "default": 0 },
    "commission_rate": { "type": "number", "minimum": 0, "maximum": 100, "default": 0 },
    "notes": { "type": "string", "default": "" }
  }
}
