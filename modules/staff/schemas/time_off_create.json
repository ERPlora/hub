{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "staff.time_off.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["staff_id", "start_date", "end_date"],
  "properties": {
    "staff_id": { "type": "string", "minLength": 1 },
    "leave_type": {
      "type": "string",
      "enum": ["vacation", "sick", "personal", "training", "other"],
      "default": "vacation"
    },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "is_full_day": { "type": "integer", "enum": [0, 1], "default": 1 },
    "start_time": { "type": ["string", "null"], "default": null },
    "end_time": { "type": ["string", "null"], "default": null },
    "reason": { "type": "string", "default": "" },
    "notes": { "type": "string", "default": "" }
  }
}
