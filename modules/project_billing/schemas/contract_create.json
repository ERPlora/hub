{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project_billing.contracts.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["customer_name", "billing_type"],
  "properties": {
    "project_ref": { "type": "string", "default": "", "maxLength": 100 },
    "customer_name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "billing_type": {
      "type": "string",
      "enum": ["fixed_price", "time_and_material", "milestone", "retainer"]
    },
    "total_amount": { "type": ["string", "number"], "default": "0" },
    "hourly_rate": { "type": ["string", "number"], "default": "0" },
    "currency": { "type": "string", "default": "EUR", "minLength": 3, "maxLength": 3 },
    "start_date": { "type": ["string", "null"], "format": "date", "default": null },
    "end_date": { "type": ["string", "null"], "format": "date", "default": null },
    "notes": { "type": "string", "default": "" }
  }
}
