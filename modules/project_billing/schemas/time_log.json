{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project_billing.time_entries.log",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "hours", "employee_ref"],
  "properties": {
    "contract_id": { "type": "string", "minLength": 1 },
    "hours": { "type": ["string", "number"], "exclusiveMinimum": 0 },
    "employee_ref": { "type": "string", "minLength": 1, "maxLength": 100 },
    "entry_date": { "type": ["string", "null"], "format": "date", "default": null },
    "hourly_rate": { "type": ["string", "number", "null"], "default": null },
    "description": { "type": "string", "default": "" }
  }
}
