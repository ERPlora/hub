{
  "id": "purchase_orders",
  "name": "Purchase Orders",
  "version": "1.0.0",
  "agent": {
    "description": "Manages purchase orders and suppliers: create, confirm, receive and cancel orders, and maintain the supplier catalogue.",
    "keywords": ["purchase order", "supplier", "procurement", "receiving", "po", "vendor"]
  },
  "depends_on": [
    "inventory"
  ],
  "permissions": [
    "purchase_orders.view_po",
    "purchase_orders.add_po",
    "purchase_orders.confirm_po",
    "purchase_orders.receive_po"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "purchase_orders.view_po",
      "purchase_orders.add_po",
      "purchase_orders.confirm_po",
      "purchase_orders.receive_po"
    ],
    "employee": [
      "purchase_orders.view_po"
    ]
  },
  "navigation": [
    {
      "id": "list",
      "label": "Orders",
      "icon": "shopping-cart",
      "component": "erp-purchase-orders-list"
    },
    {
      "id": "suppliers",
      "label": "Suppliers",
      "icon": "truck",
      "component": "erp-purchase-orders-suppliers"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ]
  },
  "queries": {
    "purchase_orders.orders.list": {
      "permission": "purchase_orders.view_po",
      "sql": "queries/orders_list.sql",
      "schema": "schemas/orders_list.json",
      "ai": { "description": "Lists purchase orders with their status and associated supplier" }
    },
    "purchase_orders.orders.get": {
      "permission": "purchase_orders.view_po",
      "sql": "queries/order_get.sql",
      "schema": "schemas/order_get.json",
      "ai": { "description": "Retrieves the full detail of a purchase order by its identifier" }
    },
    "purchase_orders.orders.lines": {
      "permission": "purchase_orders.view_po",
      "sql": "queries/order_lines.sql",
      "schema": "schemas/order_lines.json",
      "ai": { "description": "Lists the product lines of a purchase order" }
    },
    "purchase_orders.suppliers.list": {
      "permission": "purchase_orders.view_po",
      "sql": "queries/suppliers_list.sql",
      "ai": { "description": "Lists all registered suppliers" }
    }
  },
  "commands": {
    "purchase_orders.orders.create": {
      "permission": "purchase_orders.add_po",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_order"
      },
      "schema": "schemas/create_order.json",
      "emit": [
        "purchase_orders.order.created"
      ],
      "ai": { "description": "Creates a new purchase order with its product lines" }
    },
    "purchase_orders.orders.confirm": {
      "permission": "purchase_orders.confirm_po",
      "transaction": true,
      "sql": [
        "commands/order_confirm.sql"
      ],
      "schema": "schemas/order_id.json",
      "emit": [
        "purchase_orders.order.confirmed"
      ],
      "ai": { "description": "Confirms a purchase order by changing its status to confirmed" }
    },
    "purchase_orders.orders.receive": {
      "permission": "purchase_orders.receive_po",
      "transaction": true,
      "sql": [
        "commands/order_receive.sql"
      ],
      "schema": "schemas/order_id.json",
      "emit": [
        "purchase_orders.order.received"
      ],
      "ai": { "description": "Records the receipt of goods for a confirmed purchase order" }
    },
    "purchase_orders.orders.cancel": {
      "permission": "purchase_orders.confirm_po",
      "transaction": true,
      "sql": [
        "commands/order_cancel.sql"
      ],
      "schema": "schemas/order_cancel.json",
      "emit": [
        "purchase_orders.order.cancelled"
      ],
      "ai": { "description": "Cancels a purchase order and records the cancellation reason (destructive)" }
    },
    "purchase_orders.suppliers.create": {
      "permission": "purchase_orders.add_po",
      "transaction": true,
      "sql": [
        "commands/supplier_create.sql"
      ],
      "schema": "schemas/supplier_create.json",
      "emit": [
        "purchase_orders.supplier.created"
      ],
      "ai": { "description": "Creates a new supplier in the system" }
    },
    "purchase_orders._bump_counter": {
      "permission": "purchase_orders.add_po",
      "sql": [
        "commands/_bump_counter.sql"
      ]
    },
    "purchase_orders._insert_order": {
      "permission": "purchase_orders.add_po",
      "sql": [
        "commands/_insert_order.sql"
      ]
    },
    "purchase_orders._insert_line": {
      "permission": "purchase_orders.add_po",
      "sql": [
        "commands/_insert_line.sql"
      ]
    }
  },
  "ui": {
    "entry": "dist/purchase_orders.esm.js"
  }
}
