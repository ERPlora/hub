{
  "id": "till",
  "name": "Till",
  "version": "1.0.0",
  "permissions": [
    "till.view_sale",
    "till.add_sale",
    "till.take_payment",
    "till.void_sale",
    "till.manage_settings"
  ],
  "role_permissions": {
    "admin": ["*"],
    "manager": ["till.view_sale", "till.add_sale", "till.take_payment", "till.void_sale"],
    "employee": ["till.view_sale", "till.add_sale"]
  },
  "navigation": [],
  "migrations": {
    "postgres": ["migrations/postgres/001_init.sql", "migrations/postgres/002_drawer.sql"]
  },
  "queries": {
    "till.sales.list": { "permission": "till.view_sale", "sql": "queries/sales_list.sql" },
    "till.reports.revenue": {
      "permission": "till.take_payment",
      "sql": "queries/sales_list.sql"
    }
  },
  "commands": {
    "till.sale.create": {
      "permission": "till.add_sale",
      "transaction": true,
      "sql": ["commands/sale_create.sql"]
    },
    "till.sale.take_payment": {
      "permission": "till.take_payment",
      "transaction": true,
      "sql": ["commands/sale_create.sql"]
    },
    "till.sale.void": {
      "permission": "till.void_sale",
      "transaction": true,
      "sql": ["commands/sale_create.sql"]
    },
    "till.drawer.open": {
      "permission": "till.void_sale",
      "transaction": true,
      "sql": ["commands/drawer_open.sql"]
    },
    "till.settings.save": {
      "permission": "till.manage_settings",
      "transaction": true,
      "sql": ["commands/sale_create.sql"]
    },
    "till._settle": {
      "permission": "till.take_payment",
      "transaction": true,
      "sql": ["commands/sale_create.sql"]
    }
  }
}
