    },
    "pbind.items.by_status": {
      "permission": "pbind.read",
      "sql": "queries/items_by_status.sql"
    },
    "pbind.items.tagged": {
      "permission": "pbind.read",
      "sql": "queries/items_tagged.sql"
    },
    "pbind.items.due": {
      "permission": "pbind.read",
      "sql": "queries/items_due.sql",
      "schema": "schemas/items_due.json"
    },
    "pbind.items.all": {
      "permission": "pbind.read",
      "sql": "queries/items_all.sql"
    }
  }
}
