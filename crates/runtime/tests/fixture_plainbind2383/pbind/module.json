{
  "id": "pbind",
  "name": "Plain Query Required Bind",
  "version": "1.0.0",
  "permissions": [
    "pbind.read"
  ],
  "migrations": {
    "postgres": [
      "migrations/postgres/001_init.sql"
    ]
  },
  "queries": {
