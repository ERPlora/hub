{
  "id": "syncdemo",
  "name": "Sync Demo",
  "version": "1.0.0",
  "permissions": ["syncdemo.write"],
  "migrations": { "postgres": ["migrations/postgres/001_init.sql"] },
  "commands": {
    "syncdemo.create": {
      "permission": "syncdemo.write",
      "transaction": true,
      "sql": ["sql/create.sql"]
    }
  },
  "sync": [
    { "table": "syncdemo_item", "pk": ["id"], "hub_scoped": true, "updated_at": "updated_at" }
  ]
}
