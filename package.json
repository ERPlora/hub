  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@vue/test-utils": "^2.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^21.0.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.3.13"
