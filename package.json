{
  "name": "erplora-hub",
  "private": true,
  "version": "0.0.0",
  "description": "ERPlora hub — monorepo. JS/TS via pnpm workspaces (pnpm-workspace.yaml); Rust crates via Cargo workspace (Cargo.toml).",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@types/react": "^18.3.12",
      "@types/react-dom": "^18.3.1"
    }
  },
  "scripts": {
    "build:inventory": "pnpm -F @erplora/module-cli build:inventory",
    "verify": "pnpm -F @erplora/web verify",
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm -F @erplora/web dev",
    "dev:runtime": "cargo run -p erplora-server",
    "tauri": "cd apps/tauri && cargo tauri dev",
    "tauri:build": "cd apps/tauri && cargo tauri build",
    "build:modules": "pnpm -F @erplora/module-cli build:all"
  },
  "devDependencies": {
    "@types/node": "^25.9.2"
  }
}
