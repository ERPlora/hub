# JS/TS
node_modules/
dist/
*.tsbuildinfo
package-lock.json

# Stencil compiler output (intermediate build artifact; el bundle final va a dist/)
.stencil-out/
# Stencil internal build cache (logs/diagnósticos; nunca debe commitearse)
.stencil/

# Rust
target/

# OS / tmp
.DS_Store

# Módulos de negocio: viven en sus propios repos, no se versionan en el hub.
# Excepción: modules/_shared/ es infra UI compartida del hub (motor DataTable, etc.).
modules/*
!modules/_shared/