#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# pre-push — LOCAL test gate for the Hub.
#
# It runs the packages THIS PUSH CAN BREAK — not the whole workspace (hub#1207).
#
# History, because the header used to claim the opposite: this gate was born to
# REPLACE the `pull_request` trigger of "Hub tests (Rust · Postgres)"
# (.github/workflows/test-hub.yml), which was burning ~96% of the repo's Actions
# minutes. That replacement ended with hub#873: since 2026-08-11 the jobs run on
# the org's own runners, whose minutes are not billed, so `test-hub.yml` declares
# `on: pull_request` again and the full suite runs there, for free, on every PR.
#
# What was left here was the same suite a second time — and the expensive copy,
# because it holds a machine-wide lock for ~20-40 min. With the autonomous fleet
# that lock IS the ceiling: ~8-10 issues/day regardless of how many workers push.
#
# So the division of labour is now explicit:
#   · HERE  — fast feedback on the branch: the touched packages and everything
#             that depends on them, `--no-fail-fast` (without it cargo stops at
#             the first failing binary and reports one failure out of twenty).
#   · ACTIONS — `cargo test --workspace` on the PR, and that is the one that
#             decides the merge (`merge-pr.sh` still refuses on CI silence).
# What this trades away, said plainly: a branch can leave this machine broken
# OUTSIDE its scope. Actions catches it on the PR, before the merge. That is one
# wasted CI round now and then instead of 40 serialized minutes on every push.
#
# The full workspace still runs here whenever the scope cannot be trusted —
# Cargo.lock, the workspace manifest, the toolchain, `schemas/`, or any failure
# to resolve the diff. See `resolve_scope` below.
#
# Two properties keep this survivable with the autonomous fleet (~19 worktrees
# sharing this hook):
#   · a per-tree cache — the same tree is only ever compiled once, so the second
#     push of an unchanged tree is instant;
#   · a lock — suites run one at a time instead of melting the machine.
#
# On green it publishes a commit status on the pushed sha, and the CONTEXT says
# which run it was (hub#1207): `local-gate/hub-tests` only for a real full
# workspace run, `local-gate/hub-tests-scoped` for a scoped one. That matters
# because `merge-pr.sh` reads the first as proof the WORKSPACE suite ran; a
# scoped run posting it would answer a question it never tested. With its own
# context, merge-pr.sh sees the full-suite one as absent and falls through to
# the `cargo test --workspace` check Actions really did run — and still refuses
# to merge when neither exists (pm#58/#60). The status is an ATTESTATION that
# the run happened here — it is not an independent verification. It posts only AFTER a background step
# verifies the remote ref really advanced to (or past) the pushed sha
# (hub#574): a pre-push runs before the transfer and cannot know whether the
# push will land.
#
# ── ARMING ───────────────────────────────────────────────────────────────────
#     git config --bool hooks.hubPrepushGate true      # arm
#     git config --bool hooks.hubPrepushGate false     # disarm
# Disarmed by default: .git/hooks is shared by every worktree, so arming it
# arms the whole fleet at once.
#
# Bypass:  SKIP_HUB_TESTS=1 git push     (this gate only)
#          git push --no-verify          (every hook)
#
# Injection points, used by scripts/prepush-gate.test.sh:
#   HUB_GATE_TEST_CMD · HUB_GATE_STATUS_CMD · HUB_GATE_STATE_DIR · HUB_GATE_LOCK_WAIT
#   HUB_GATE_METADATA_CMD · HUB_GATE_BASE_REFS · HUB_GATE_EXCLUDES ·
#   HUB_GATE_RUST_DIRS · HUB_GATE_NO_SELFHEAL (hub#1207: the scope resolver and
#   the self-resync, driven without cargo, without GitHub and without touching
#   the machine's installed hook)
#   HUB_GATE_SCOPE=workspace forces the old behaviour for one push.
#   HUB_GATE_MATERIALIZE_CMD · HUB_GATE_MODULES_FLOOR (hub#1153: how the
#   PUBLISHED module catalogue is materialised, and the minimum number of
#   manifests it must contain — driven without network or deploy keys)
#   HUB_GATE_UNPROTECTED_LOCK_WAIT (hub#788: lock-wait cap while the SSH
#   connection has no keepalive; the rule is keepalive margin > max lock wait)
#   HUB_GATE_PUSH_POLL_TRIES · HUB_GATE_PUSH_POLL_DELAY (hub#574: how long the
#   background publish step polls origin for the ref before giving up)
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

ZERO=0000000000000000000000000000000000000000
CONTEXT=local-gate/hub-tests
PG_CONTAINER=erplora-test-pg-5433
PG_DSN=postgres://postgres:test@localhost:5433/hub_test
# pgvector, not plain `postgres:18` — `crates/vector/tests/pg_store.rs` does `CREATE EXTENSION
# vector`, and on a stock image every one of its 9 tests dies with
#   type "public.vector" does not exist
# which is a red the pusher cannot fix and did not cause. Same PG major, so the data dir is
# compatible; the extension is merely AVAILABLE, the tests still create it themselves.
# The tuning mirrors the container the vector work already uses on 5434 —
# `max_locks_per_transaction` is the one that matters: the suite opens a schema per test and the
# default (64) runs out mid-run.
PG_IMAGE=pgvector/pgvector:pg18
PG_ARGS="-c max_locks_per_transaction=1024 -c max_connections=300 -c shared_buffers=512MB"
# hub#788: `git push` opens the SSH transport BEFORE this hook runs, so every
# second spent waiting on the gate lock is spent on an IDLE connection that
# GitHub eventually closes — the push then dies in silence with zero tests run.
# The keepalive below gives a margin of Interval × CountMax = 7200s, and the
# INEQUALITY that must hold is: keepalive margin > maximum lock wait
# (HUB_GATE_LOCK_WAIT, default 3600s). The hook enforces it by clamping the
# wait, never by trusting the connection; see ensure_ssh_keepalive.
KEEPALIVE_SSH="ssh -o ServerAliveInterval=30 -o ServerAliveCountMax=240 -o TCPKeepAlive=yes"

armed="$(git config --bool hooks.hubPrepushGate 2>/dev/null || echo false)"
if [ "$armed" != "true" ]; then
    echo "ℹ️  pre-push: Hub test gate DISARMED → letting the push through." >&2
    echo "    Arm it with:  git config --bool hooks.hubPrepushGate true" >&2
    exit 0
fi

if [ "${SKIP_HUB_TESTS:-0}" = "1" ]; then
    echo "⏭️  pre-push: SKIP_HUB_TESTS=1 → skipping the Hub test gate." >&2
    exit 0
fi

# git feeds us "<local ref> <local sha> <remote ref> <remote sha>" per ref.
# A pure branch deletion carries no tree to test. The remote ref is kept for
# hub#574: the publish step verifies that THIS ref really advanced before
# attesting anything.
#
# stdin is BUFFERED rather than consumed line by line: since hub#1207 a stale
# installed hook re-execs the repo's copy, and that copy needs the same refs on
# its stdin — which git only ever sends once.
GATE_STDIN="$(cat)"
pushed_sha=""
pushed_ref=""
remote_sha=""
while read -r _local_ref local_sha remote_ref line_remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    [ "$local_sha" = "$ZERO" ] && continue
    pushed_sha="$local_sha"
    pushed_ref="$remote_ref"
    remote_sha="${line_remote_sha:-}"
done <<< "$GATE_STDIN"
if [ -z "$pushed_sha" ]; then
    exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 1

# ── hub#1207: what does this push actually CHANGE? ───────────────────────────
# Everything below — which packages to test, whether to resync the hook — hangs
# off this diff, so failing to resolve it is never silent: the gate degrades to
# the full workspace, which is what it always did.
#
# The base is the remote sha git handed us; for a NEW branch (the fleet's
# normal shape, remote sha all-zeros) it is the merge-base with the integration
# branch. `HUB_GATE_BASE_REFS` exists so the tests can point elsewhere.
GATE_BASE_REFS="${HUB_GATE_BASE_REFS:-origin/develop origin/main}"
base_sha=""
changed_files=""
changed_known=0
resolve_base() {
    local ref b
    if [ -n "$remote_sha" ] && [ "$remote_sha" != "$ZERO" ] \
        && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
        printf '%s' "$remote_sha"
        return 0
    fi
    for ref in $GATE_BASE_REFS; do
        git rev-parse --verify --quiet "${ref}^{commit}" >/dev/null 2>&1 || continue
        b="$(git merge-base "$ref" "$pushed_sha" 2>/dev/null)" || continue
        [ -n "$b" ] && { printf '%s' "$b"; return 0; }
    done
    return 1
}
base_sha="$(resolve_base || true)"
if [ -n "$base_sha" ]; then
    if changed_files="$(git diff --name-only "$base_sha" "$pushed_sha" 2>/dev/null)"; then
        changed_known=1
    else
        changed_files=""
    fi
fi
diff_touches() {   # $1 = exact path
    [ "$changed_known" = 1 ] || return 1
    printf '%s\n' "$changed_files" | grep -qxF "$1"
}

# ── hub#746: the copy that RUNS is whatever core.hooksPath points at ─────────
# (on the fleet machine: ~/.erplora/hooks/hub) and nothing syncs it with the
# versioned .githooks/pre-push. Drift is silent in BOTH directions: a stale
# copy re-reds already-fixed tests (false red), or skips checks the repo added
# while still publishing the attestation (false green — indistinguishable on
# the PR). So: check ourselves on every push and shout, and stamp the
# attestation with the hash of the copy that actually ran (see publish_status).
# A WARNING, not a refusal: a branch that edits this very hook is a legitimate
# state where the two copies must differ.
SELF="${BASH_SOURCE[0]:-$0}"
HOOK_ID="$(git hash-object "$SELF" 2>/dev/null || true)"
HOOK_ID="${HOOK_ID:0:12}"
hook_drift_check() {
    local versioned=".githooks/pre-push" self_abs versioned_abs versioned_id
    [ -f "$versioned" ] || return 0
    self_abs="$(cd "$(dirname "$SELF")" 2>/dev/null && pwd -P)/$(basename "$SELF")"
    versioned_abs="$(cd "$(dirname "$versioned")" && pwd -P)/pre-push"
    [ "$self_abs" = "$versioned_abs" ] && return 0
    if ! cmp -s "$SELF" "$versioned" 2>/dev/null; then
        versioned_id="$(git hash-object "$versioned" 2>/dev/null || true)"
        {
            echo "⚠️  pre-push: the INSTALLED hook is OUT OF SYNC with the versioned .githooks/pre-push."
            echo "    running   : $self_abs (hook ${HOOK_ID:-?})"
            echo "    versioned : $versioned_abs (hook ${versioned_id:0:12})"
            echo "    The gate that decides this push is the INSTALLED copy. Unless this branch"
            echo "    deliberately edits the hook itself, resync with:  bash scripts/install-hooks.sh"
        } >&2
    fi
}
hook_drift_check

# ── hub#1207: warning was not enough — the installed copy RESYNCS ITSELF ─────
# hub#746 made drift visible; it stayed visible and unfixed. The fleet ran a
# copy from 2026-08-13 for two weeks, so every change to `.githooks/pre-push`
# was a change to a file nothing executed — including the scoping below.
#
# So when the copy that runs is stale, it replaces itself with the CANONICAL
# copy and re-runs this push through it. Four guards keep that from being a
# foot-gun:
#   · the source is the INTEGRATION ref's blob (`git show origin/develop:…`),
#     NEVER this worktree's checkout — a branch based on an older develop
#     carries an older committed copy, and an uncommitted edit sits in no diff
#     at all; sourcing the working tree would install either one on every
#     worktree of the machine (they share core.hooksPath);
#   · a canonical copy that cannot heal itself (no HUB_GATE_RESYNCED in it —
#     i.e. a pre-hub#1207 blob from a stale fetch) is refused: installing it
#     would make the downgrade sticky, back to warn-only drift;
#   · exactly one hop, tracked by HUB_GATE_RESYNCED, so a hook that somehow
#     never matches cannot loop;
#   · the copy is swapped by rename, never written in place: bash reads a
#     script incrementally and overwriting the running file corrupts it.
hook_self_heal() {
    local versioned=".githooks/pre-push" self_abs versioned_abs tmp ref canon_src="" canon_ref=""
    [ "${HUB_GATE_RESYNCED:-0}" = 1 ] && return 0
    [ "${HUB_GATE_NO_SELFHEAL:-0}" = 1 ] && return 0
    self_abs="$(cd "$(dirname "$SELF")" 2>/dev/null && pwd -P)/$(basename "$SELF")"
    versioned_abs="$(cd "$(dirname "$versioned")" 2>/dev/null && pwd -P)/pre-push"
    [ -n "$versioned_abs" ] && [ "$self_abs" = "$versioned_abs" ] && return 0

    canon_src="$(mktemp "${TMPDIR:-/tmp}/hub-gate-canon.XXXXXX" 2>/dev/null)" || return 0
    for ref in $GATE_BASE_REFS; do
        if git show "${ref}:.githooks/pre-push" >"$canon_src" 2>/dev/null; then
            canon_ref="$ref"
            break
        fi
    done
    [ -n "$canon_ref" ] || { rm -f "$canon_src"; return 0; }
    if ! grep -q 'HUB_GATE_RESYNCED' "$canon_src" 2>/dev/null; then
        # A blob that cannot heal itself is a downgrade trap — keep the warning.
        rm -f "$canon_src"
        return 0
    fi
    if cmp -s "$SELF" "$canon_src" 2>/dev/null; then
        rm -f "$canon_src"
        return 0
    fi

    tmp="${self_abs}.resync.$$"
    if ! install -m 0755 "$canon_src" "$tmp" 2>/dev/null; then
        echo "⚠️  pre-push: could not write next to $self_abs — resync by hand: bash scripts/install-hooks.sh" >&2
        rm -f "$tmp" "$canon_src" 2>/dev/null || true
        return 0
    fi
    rm -f "$canon_src" 2>/dev/null || true
    if ! mv -f "$tmp" "$self_abs" 2>/dev/null; then
        echo "⚠️  pre-push: could not replace $self_abs — resync by hand: bash scripts/install-hooks.sh" >&2
        rm -f "$tmp" 2>/dev/null || true
        return 0
    fi
    echo "🔄 pre-push: the installed hook was stale — RESYNCED from ${canon_ref}:.githooks/pre-push and re-running this push through it." >&2
    printf '%s\n' "$GATE_STDIN" | HUB_GATE_RESYNCED=1 bash "$self_abs"
    exit $?
}
hook_self_heal

# ── hub#788: keepalive in the repo, and never wait longer than it protects ───
# The keepalive can only be effective if it was configured BEFORE git opened
# this push's SSH connection. So: if it is already there, this run is
# protected; if not, the hook installs it for every FUTURE push (self-healing
# — the fix used to live in one machine's .git/config only) and treats the
# CURRENT run as unprotected, capping its lock wait so the connection dies
# after the hook has already failed fast with a clear retry message, not
# mid-transfer in silence.
SSH_PROTECTED=0
ssh_keepalive_margin() {   # echoes Interval × CountMax in seconds; empty if no keepalive
    local cmd interval countmax
    cmd="${GIT_SSH_COMMAND:-}"
    [ -n "$cmd" ] || cmd="$(git config core.sshCommand 2>/dev/null || true)"
    interval="$(printf '%s' "$cmd" | sed -n 's/.*ServerAliveInterval[= ]\([0-9][0-9]*\).*/\1/p')"
    countmax="$(printf '%s' "$cmd" | sed -n 's/.*ServerAliveCountMax[= ]\([0-9][0-9]*\).*/\1/p')"
    [ -n "$interval" ] || return 0
    [ -n "$countmax" ] || countmax=3   # OpenSSH default
    echo $((interval * countmax))
}
ensure_ssh_keepalive() {
    if [ -n "$(ssh_keepalive_margin)" ]; then
        SSH_PROTECTED=1
        return 0
    fi
    # GIT_SSH_COMMAND overrides the config, so writing the config would not
    # help; and an existing core.sshCommand without keepalive is someone's
    # deliberate setup — warn rather than rewrite.
    if [ -z "${GIT_SSH_COMMAND:-}" ] && [ -z "$(git config core.sshCommand 2>/dev/null || true)" ]; then
        if git config --local core.sshCommand "$KEEPALIVE_SSH" 2>/dev/null; then
            echo "ℹ️  pre-push: no SSH keepalive was configured — armed core.sshCommand for future pushes (hub#788)." >&2
        fi
    else
        echo "⚠️  pre-push: the effective SSH command has no keepalive (ServerAliveInterval) — add one, or lock waits will outlive the connection (hub#788)." >&2
    fi
}
ensure_ssh_keepalive

STATE_DIR="${HUB_GATE_STATE_DIR:-$(git rev-parse --git-common-dir)/hub-gate}"
mkdir -p "$STATE_DIR"

# ── hub#1207: the SCOPE — run the packages this diff can break, not all of them ─
#
# `cargo test --workspace` here is a minute-for-minute DUPLICATE of the suite
# `test-hub.yml` runs on every `pull_request` over the org's own runners, whose
# minutes are not billed. The duplicate is the expensive copy — it holds a
# machine-wide lock for ~40 min — so it, and only it, is the fleet's ceiling:
# ~8-10 issues/day no matter how many workers push. What it buys over Actions
# is speed of feedback on the branch, and that is exactly what a scoped run
# still gives.
#
# So the local gate becomes a fast smoke over what CHANGED, and the full suite
# stays where it is free: Actions, on the PR, before the merge. Note what is
# NOT touched — the LOCK stays (hub#526: two suites at once melt the machine).
# What shrinks is how long it is held, and a lock held for minutes drains a
# queue that a lock held for forty minutes does not.
#
# Ownership is asked of `cargo metadata`, never hand-mapped, by the SAME resolver
# `test-hub.yml` runs (`scripts/ci/test-scope.py`), and it is
# deliberately conservative in three places:
#   · DEPENDENTS come along — touching `erplora-db` runs whoever builds on it,
#     because that is the breakage a scoped gate would otherwise wave through;
#   · anything TRANSVERSAL (Cargo.lock, the workspace manifest, the toolchain,
#     `schemas/` — read by runtime tests) falls back to the whole workspace;
#   · so does any failure to resolve the diff, the metadata, or python3.
# A diff with no Rust in it runs no Rust: the web has its own checks, and
# queueing behind a Rust suite for a `.ts` file is pure waiting for nothing.
GATE_METADATA_CMD="${HUB_GATE_METADATA_CMD:-cargo metadata --no-deps --format-version 1}"
# Same two the workspace command always excluded: `test-shell.yml` runs them on
# PRs, so demanding them here would be asking twice for the same proof.
GATE_EXCLUDES="${HUB_GATE_EXCLUDES:-erplora-tauri tauri-plugin-erplora-android}"
# Top-level directories that are Rust by construction: a file in one of them
# that no package claims (a crate not yet in `members`, a shared fixture) is a
# reason to widen, not to ignore.
GATE_RUST_DIRS="${HUB_GATE_RUST_DIRS:-crates}"
# El resolutor VIVE EN EL REPO (hub#1346/#1347), no aquí dentro. El hook llevaba una
# copia inline de las mismas 66 líneas: dos copias del mismo algoritmo divergen
# solas, y cuando divergen el gate local y `test-hub.yml` dejan de medir lo mismo
# sin dejar rojo en ningún sitio. Se lee del árbol que se empuja —no de junto al
# hook— porque la copia que CORRE vive en `core.hooksPath`, fuera del repo, donde
# no hay `scripts/`. Contrato: scripts/tests/test-scope.test.sh.
SCOPE_RESOLVER="${HUB_GATE_SCOPE_RESOLVER:-$(git rev-parse --show-toplevel)/scripts/ci/test-scope.py}"

SCOPE_MODE=workspace
SCOPE_PACKAGES=""
SCOPE_REASON="the diff could not be resolved"

scope_from_metadata() {
    local meta out
    meta="$STATE_DIR/metadata.$$.json"
    if ! eval "$GATE_METADATA_CMD" >"$meta" 2>/dev/null; then
        rm -f "$meta"
        SCOPE_REASON="\`cargo metadata\` failed, so package ownership is unknown"
        return 0
    fi
    out="$(printf '%s\n' "$changed_files" \
        | HUB_GATE_RUST_DIRS="$GATE_RUST_DIRS" \
            python3 "$SCOPE_RESOLVER" "$meta" $GATE_EXCLUDES 2>/dev/null)" || {
        rm -f "$meta"
        SCOPE_REASON="the scope could not be computed from \`cargo metadata\`"
        return 0
    }
    rm -f "$meta"
    [ -n "$out" ] || { SCOPE_REASON="the scope resolver returned nothing"; return 0; }
    SCOPE_MODE="$(printf '%s\n' "$out" | sed -n 1p)"
    SCOPE_REASON="$(printf '%s\n' "$out" | sed -n 2p)"
    SCOPE_PACKAGES="$(printf '%s\n' "$out" | sed -n '3,$p' | tr '\n' ' ' | sed 's/ *$//')"
}

resolve_scope() {
    if [ "${HUB_GATE_SCOPE:-}" = workspace ]; then
        SCOPE_REASON="HUB_GATE_SCOPE=workspace was set"
        return 0
    fi
    if [ "$changed_known" != 1 ]; then
        SCOPE_REASON="no base to diff against (tried: $GATE_BASE_REFS)"
        return 0
    fi
    if ! command -v python3 >/dev/null 2>&1; then
        SCOPE_REASON="python3 is not on PATH, so package ownership cannot be resolved"
        return 0
    fi
    if [ ! -f "$SCOPE_RESOLVER" ]; then
        SCOPE_REASON="the scope resolver (scripts/ci/test-scope.py) is not in this checkout"
        return 0
    fi
    scope_from_metadata
}
resolve_scope

# The local half of hub#526 (CI was hub#565). `postgres:18` ships with
# `max_locks_per_transaction=64` and `max_connections=100` — a GLOBAL ceiling of ~6 400 locks. The
# suite creates an ephemeral schema PER TEST with every system table inside, so it exhausts that
# ceiling and crashes whichever test passes by with `53200 out of shared memory`. Red tests that
# have nothing to do with the diff, different each run — the most expensive flaky to diagnose.
#
# Raise the three settings (same as CI: 4096 / 300 / 512MB → ceiling ~1.2M) and restart, but ONLY
# when the ceiling is still the low default. That keeps it idempotent: a container already raised
# (a second push, or one that survived from a previous run) is not restarted, so this never adds
# latency to the common path. `ALTER SYSTEM` needs a restart to take effect.
raise_lock_limits() {
    local current
    current=$(docker exec "$PG_CONTAINER" psql -U postgres -tAc \
        "SELECT current_setting('max_locks_per_transaction')::int * (current_setting('max_connections')::int + current_setting('max_prepared_transactions')::int);" 2>/dev/null | tr -d '[:space:]')
    # 6 400 is the stock ceiling (64 × 100). Anything already above it was raised before — skip.
    if [ -n "$current" ] && [ "$current" -gt 6400 ] 2>/dev/null; then
        return 0
    fi
    echo "pre-push: raising Postgres lock limits (hub#526) — was ${current:-?}, restarting ${PG_CONTAINER}…"
    docker exec "$PG_CONTAINER" psql -U postgres -c "ALTER SYSTEM SET max_locks_per_transaction = 4096;" >/dev/null
    docker exec "$PG_CONTAINER" psql -U postgres -c "ALTER SYSTEM SET max_connections = 300;" >/dev/null
    docker exec "$PG_CONTAINER" psql -U postgres -c "ALTER SYSTEM SET shared_buffers = '512MB';" >/dev/null
    docker restart "$PG_CONTAINER" >/dev/null
    local tries=0
    until docker exec "$PG_CONTAINER" pg_isready -U postgres >/dev/null 2>&1; do
        tries=$((tries + 1))
        [ "$tries" -gt 30 ] && { echo "❌ pre-push: $PG_CONTAINER never came back after raising limits." >&2; return 1; }
        sleep 1
    done
    local after
    after=$(docker exec "$PG_CONTAINER" psql -U postgres -tAc \
        "SELECT current_setting('max_locks_per_transaction')::int * (current_setting('max_connections')::int + current_setting('max_prepared_transactions')::int);" 2>/dev/null | tr -d '[:space:]')
    echo "pre-push: lock ceiling now ${after:-?} (was ${current:-?})."
}

# Definida AQUÍ, y no más abajo, porque `ensure_postgres` la llama: en bash una función
# tiene que estar definida ANTES de la llamada en tiempo de ejecución, y el camino
# temprano (diff solo-web, alcance Rust `none`) corre mucho antes de donde vivía. Ahí
# moría con `command not found` — y el hook va sin `set -e`, así que no abortaba nada:
# un fallo mudo que dejaba los límites de locks sin subir (hub#1375, familia de
# hub#1355). Banco: scripts/prepush-gate.test.sh fija el orden.
# Bring up the Postgres the suite needs, unless the caller pinned the command
# (the tests do) or already exported a DSN.
ensure_postgres() {
    [ -n "${DATABASE_URL:-}" ] && return 0
    if ! command -v docker >/dev/null 2>&1; then
        echo "❌ pre-push: the suite is Postgres-only (ADR-0154) and docker is not on PATH." >&2
        echo "   Export DATABASE_URL yourself, or install/start Docker." >&2
        return 1
    fi
    # A container built from the OLD image has to be REPLACED, not started. Everyone who ran this
    # gate before pgvector was needed already has an `erplora-test-pg-5433` made from `postgres:18`,
    # and `docker start` would happily bring the broken one back up — the fix would then only work
    # on machines that never ran the gate, which is nobody's.
    #
    # Dropping it is safe: this container holds throwaway test schemas and nothing else.
    if [ -n "$(docker ps -aq -f "name=^${PG_CONTAINER}$")" ]; then
        current=$(docker inspect "$PG_CONTAINER" --format '{{.Config.Image}}' 2>/dev/null || echo '')
        if [ "$current" != "$PG_IMAGE" ]; then
            echo "ℹ️  pre-push: $PG_CONTAINER runs '$current', but the suite needs '$PG_IMAGE'" >&2
            echo "   (crates/vector needs the pgvector extension). Recreating it — test data only." >&2
            docker rm -f "$PG_CONTAINER" >/dev/null 2>&1 || true
        fi
    fi

    if ! docker ps --format '{{.Names}}' | grep -qx "$PG_CONTAINER"; then
        if docker ps -a --format '{{.Names}}' | grep -qx "$PG_CONTAINER"; then
            docker start "$PG_CONTAINER" >/dev/null
        else
            # shellcheck disable=SC2086  # PG_ARGS is a deliberate list of -c flags.
            docker run -d --name "$PG_CONTAINER" -p 5433:5432 \
                -e POSTGRES_PASSWORD=test -e POSTGRES_DB=hub_test "$PG_IMAGE" $PG_ARGS >/dev/null
        fi
        local tries=0
        until docker exec "$PG_CONTAINER" pg_isready -U postgres >/dev/null 2>&1; do
            tries=$((tries + 1))
            [ "$tries" -gt 30 ] && { echo "❌ pre-push: $PG_CONTAINER never became ready." >&2; return 1; }
            sleep 1
        done
    fi
    raise_lock_limits
    export DATABASE_URL="$PG_DSN"
}

# ── Etapa WEB (decisión de Ioan, 2026-08-29) ─────────────────────────────────
# `cargo test --workspace` + e2e de módulos + web + playwright se ejecutan AQUÍ, en local, en
# cada push, y NO en Actions: la nube se quedó con `develop`/`main` (la red post-merge de
# hub#572). Consecuencia buscada: si algo está rojo, el push se aborta y sin push no hay PR.
# Los ficheros que la disparan son LOS MISMOS que filtraba `test-web.yml`; si esa lista cambia
# allí, cambia aquí (`scripts/tests/test-web-workflow.test.sh` fija la de allí).
WEB_PREFIXES="apps/web/ packages/"
WEB_FILES="package.json pnpm-lock.yaml pnpm-workspace.yaml"
# Los que DEFINEN la tubería web en vez de ser la app: la guardia que `pnpm verify` corre
# primero (hub#1244/#1247), el contrato del workflow y el propio YAML. Faltaban de la lista,
# y sin `pull_request` en `test-web.yml` eso dejaba un agujero: un push que solo tocara uno
# de los tres no disparaba la etapa web en local NI ningún check en la nube — la única red
# era el push a develop/main, o sea POST-MERGE (hub#1356).
# Disparan, sí, pero por el camino BARATO: lo que cambió es la guardia, no el navegador.
# Meterlos en la lista de arriba haría que un comentario del YAML se llevara
# `cargo build` + `vite build` + playwright, ~20-40 min por nada.
WEB_LIGHT_FILES="scripts/tests/no-dead-packages.test.mjs scripts/tests/test-web-workflow.test.sh .github/workflows/test-web.yml"
# Si no hay base contra la que diffear no se sabe qué toca el cambio. Para Rust el gate ya se
# ensancha al workspace; aquí igual —pero solo si este repo TIENE web: ensanchar en un repo sin
# `apps/web` no protegería nada y rompería cualquier push (no hay `package.json` que instalar).
web_touched=0
if [ "$changed_known" != 1 ] && { [ -d apps/web ] || [ -f package.json ]; }; then
    web_touched=1
fi
web_light_touched=0
if [ "$changed_known" = 1 ]; then
    while IFS= read -r _f; do
        [ -n "$_f" ] || continue
        for _p in $WEB_PREFIXES; do
            case "$_f" in "$_p"*) web_touched=1 ;; esac
        done
        for _n in $WEB_FILES; do
            [ "$_f" = "$_n" ] && web_touched=1
        done
        for _n in $WEB_LIGHT_FILES; do
            [ "$_f" = "$_n" ] && web_light_touched=1
        done
    done <<EOF
$changed_files
EOF
fi

# Corre la etapa web y aborta el push si está roja. Se llama en los DOS caminos (con Rust y
# sin él), porque un cambio solo de `apps/web/**` no toca ningún paquete Rust y antes salía
# por la puerta de `none` sin que nadie lo probara.
# El banco de e2e de playwright necesita DOS bases sobre el Postgres del gate, y tienen que
# EXISTIR (el runtime no las crea — lo dice `apps/web/tests/playwright.config.ts`). Además el spec
# del asistente cae por defecto en `localhost:5434`, que en local no existe: sin exportar los DSN,
# el playwright de cada push que toque web moriría al arrancar el runtime.
ensure_e2e_databases() {
    if [ -n "${HUB_GATE_E2E_DB_CMD:-}" ]; then
        eval "$HUB_GATE_E2E_DB_CMD" || return 1
    else
        local db
        for db in hub_e2e_web hub_e2e_assistant; do
            docker exec "$PG_CONTAINER" psql -U postgres -tAc \
                "SELECT 1 FROM pg_database WHERE datname='$db'" 2>/dev/null | grep -q 1 && continue
            if ! docker exec "$PG_CONTAINER" psql -U postgres -c "CREATE DATABASE $db;" >/dev/null 2>&1; then
                echo "❌ pre-push: no pude crear la base '$db' en $PG_CONTAINER (la necesita el e2e de web)." >&2
                return 1
            fi
            echo "ℹ️  pre-push: creada la base '$db' del banco de e2e." >&2
        done
    fi
    export HUB_E2E_DATABASE_URL="${HUB_E2E_DATABASE_URL:-postgres://postgres:test@localhost:5433/hub_e2e_web}"
    export E2E_DATABASE_URL="${E2E_DATABASE_URL:-postgres://postgres:test@localhost:5433/hub_e2e_assistant}"
    return 0
}

run_web_stage() {
    local web_tier=""
    if [ "$web_touched" = 1 ]; then
        web_tier=full
    elif [ "$web_light_touched" = 1 ]; then
        web_tier=light
    else
        return 0
    fi

    # Nivel LIGERO: solo lo que esos ficheros gobiernan de verdad. Node basta —la guardia
    # usa únicamente builtins—, así que no hace falta `pnpm install` ni Postgres ni docker.
    if [ "$web_tier" = light ]; then
        if [ "${SKIP_HUB_WEB:-0}" = 1 ]; then
            echo "⏭️  pre-push: SKIP_HUB_WEB=1 — la guardia web NO se ha corrido." >&2
            WEB_SKIPPED=1
            return 0
        fi
        local light_cmd
        if [ -n "${HUB_GATE_WEB_LIGHT_CMD:-}" ]; then
            light_cmd="$HUB_GATE_WEB_LIGHT_CMD"
        else
            light_cmd='node --test scripts/tests/no-dead-packages.test.mjs \
                && bash scripts/tests/test-web-workflow.test.sh'
        fi
        echo "🧪 pre-push: el diff toca la tubería web (guardia/contrato/YAML) → sus comprobaciones…" >&2
        if ! eval "$light_cmd"; then
            echo "" >&2
            echo "❌ pre-push: la guardia de la tubería web está ROJA → push ABORTADO." >&2
            return 1
        fi
        echo "✅ pre-push: guardia de la tubería web verde." >&2
        return 0
    fi

    local web_cmd
    if [ -n "${HUB_GATE_WEB_CMD:-}" ]; then
        web_cmd="$HUB_GATE_WEB_CMD"
    else
        command -v pnpm >/dev/null 2>&1 || command -v corepack >/dev/null 2>&1 || {
            echo "❌ pre-push: el diff toca web y no hay 'pnpm' ni 'corepack' en el PATH." >&2
            echo "   Instálalos (corepack enable) o sáltate la etapa con SKIP_HUB_WEB=1." >&2
            return 1
        }
        # Lo mismo que corría `test-web.yml`, en el mismo orden: instalar, verificar
        # (vue-tsc + vitest + module-sdk) y los e2e de playwright contra el runtime real.
        web_cmd='pnpm install --frozen-lockfile \
            && pnpm verify \
            && cargo build -p erplora-server \
            && pnpm -F @erplora/web exec vite build \
            && pnpm -F @erplora/web exec playwright install chromium \
            && pnpm -F @erplora/web test:e2e'
    fi
    if [ "${SKIP_HUB_WEB:-0}" = 1 ]; then
        echo "⏭️  pre-push: SKIP_HUB_WEB=1 — la etapa web NO se ha corrido (nadie más la corre: Actions ya no la mira en las PRs)." >&2
        WEB_SKIPPED=1
        return 0
    fi
    ensure_postgres || return 1
    ensure_e2e_databases || return 1
    echo "🧪 pre-push: el diff toca web → pnpm verify + playwright en local…" >&2
    if ! eval "$web_cmd"; then
        echo "" >&2
        echo "❌ pre-push: la etapa WEB está ROJA → push ABORTADO." >&2
        echo "   Arréglalo y reintenta. (Sáltatela a sabiendas con 'SKIP_HUB_WEB=1 git push'.)" >&2
        return 1
    fi
    echo "✅ pre-push: etapa web verde." >&2
    return 0
}

# ── Política de alcance (Ioan, 2026-08-29) ───────────────────────────────────
# `workspace` (defecto): una PR con Rust corre la suite ENTERA aquí. Es obligatorio desde que
# Actions dejó de correrla en las PRs: `merge-pr.sh` autoriza el merge con la atestación de este
# gate (pm#58/#60), y una pasada parcial dejaría el merge apoyado en menos de lo que promete.
# `scoped`: el reparto de hub#1207 (local rápido + Actions completo). Volver a él es cambiar esta
# variable, cuando la nube vuelva a correr la suite en las PRs.
GATE_SCOPE_POLICY="${HUB_GATE_SCOPE_POLICY:-workspace}"
if [ "$GATE_SCOPE_POLICY" = workspace ] && [ "$SCOPE_MODE" = packages ]; then
    SCOPE_MODE=workspace
    SCOPE_REASON="$SCOPE_REASON — pero la política es correr el workspace entero (pm#58/#60)"
fi

case "$SCOPE_MODE" in
    none)
        echo "⏭️  pre-push: no Rust in this diff ($SCOPE_REASON) → the Hub suite has nothing to run." >&2
        # OJO: ya no vale «lo cubren sus checks en la PR». Desde el 29/08 Actions no corre web ni
        # los e2e en una PR, así que si el diff toca web hay que probarlo AQUÍ o no lo prueba nadie.
        run_web_stage || exit 1
        exit 0
        ;;
    packages)
        CONTEXT=local-gate/hub-tests-scoped
        echo "🎯 pre-push: scoped run — $SCOPE_REASON: $SCOPE_PACKAGES" >&2
        ;;
    *)
        SCOPE_MODE=workspace
        echo "🌍 pre-push: full workspace run — $SCOPE_REASON." >&2
        ;;
esac
export HUB_GATE_SCOPE_MODE="$SCOPE_MODE"
export HUB_GATE_SCOPE_PACKAGES="$SCOPE_PACKAGES"

# ── hub#1207 §4: the attestation names what REALLY ran ───────────────────────
# `merge-pr.sh` reads `local-gate/hub-tests` as proof the WORKSPACE suite ran —
# that is the question it asks ("did the thing that tests this run?"). A scoped
# run publishing that context would answer yes to a question it did not test,
# which is the same antipattern as a test asserting on prose. So a scoped run
# gets its own context: merge-pr.sh then sees the full-suite one as ABSENT and
# falls through to the `cargo test --workspace` check that Actions really did
# run on the PR — and still refuses to merge if that check is missing or red.
# The description says the packages out loud, so the PR page shows the scope.
GATE_CMD_LABEL="cargo test --workspace"
if [ "$SCOPE_MODE" = packages ]; then
    GATE_CMD_LABEL="cargo test"
    for _p in $SCOPE_PACKAGES; do GATE_CMD_LABEL="$GATE_CMD_LABEL -p $_p"; done
fi
GATE_DESC="$GATE_CMD_LABEL green on the pusher's machine (hook ${HOOK_ID:-unknown})"
if [ "$SCOPE_MODE" = packages ]; then
    GATE_DESC="$GATE_DESC — scoped to the diff, NOT the whole workspace"
fi
# GitHub truncates a status description at 140 chars; do it here so what gets
# cut is the tail of the package list and never the "scoped" caveat.
if [ "${#GATE_DESC}" -gt 140 ]; then
    GATE_DESC="$(printf '%s' "$SCOPE_PACKAGES" | wc -w | tr -d ' ') packages scoped to the diff, NOT the whole workspace (hook ${HOOK_ID:-unknown}): $SCOPE_PACKAGES"
    GATE_DESC="${GATE_DESC:0:137}..."
fi

# The cache key is the TREE, not the commit: a reworded commit or a rebase that
# does not change a single byte of content must not pay for the suite twice.
tree="$(git rev-parse "${pushed_sha}^{tree}" 2>/dev/null)" || exit 1
# …and by the SCOPE (hub#1207): the same tree pushed against a base that moved
# resolves to a WIDER set of packages, and reusing the narrow green for it would
# skip packages nothing ever ran.
scope_key="$(printf '%s|%s' "$SCOPE_MODE" "$SCOPE_PACKAGES" | git hash-object --stdin 2>/dev/null)"
green="$STATE_DIR/$tree.${scope_key:0:12}.green"

PUBLISH_LOG="$STATE_DIR/publish-status.log"

# Everything the human needs to tell "the attestation was not published" apart from
# "GitHub Actions is down" — because from the PR page the two look IDENTICAL (no
# checks), and only one of them is a reason to go anywhere near the merge button.
# This block used to not exist: the publish step `exit 0`'d in silence (hub#739).
unpublished_report() {
    # $4 is the repo when we got far enough to know it — so the copy-paste command
    # below is the real one, not a template the reader has to fill in.
    local reason=$1 detail=$2 sha=$3 slug=${4:-<owner>/<repo>}
    echo "⚠️  pre-push: the Hub suite was GREEN, but its attestation could not be published."
    echo "    context : $CONTEXT"
    echo "    commit  : $sha"
    echo "    reason  : $reason"
    if [ -n "$detail" ]; then
        printf '    gh said : %s\n' "$(printf '%s' "$detail" | head -5)"
    fi
    echo "    the gh account it tried:"
    if command -v gh >/dev/null 2>&1; then
        gh auth status 2>&1 | sed 's/^[[:space:]]*/      /'
    else
        echo "      (none — gh is not on PATH)"
    fi
    echo "    Consequence: the PR will show up WITHOUT CHECKS, exactly like a dead CI."
    echo "    Do NOT force the merge on that — merge-pr.sh refuses on silence by design"
    echo "    (pm#58/#60; forcing past it is how saas#1184 landed unverified)."
    echo "    Switch gh to an account that can see the repo and push again, or post it by hand:"
    echo "      gh api -X POST repos/<owner>/<repo>/statuses/$sha \\"
    echo "        -f state=success -f context=$CONTEXT -f description='local gate green'"
}

# Two channels, on purpose.
#   · the LOG is the durable one: the publish step outlives the hook, so a message
#     printed when it finally fails can land after the shell prompt is already back.
#   · the terminal is the loud one. In the background half it is /dev/tty, opened
#     here rather than inherited: a background writer holding git's stderr pipe can
#     stall the push for the whole two minutes the poll lasts.
log_report() {
    { printf '\n===== %s =====\n' "$(date '+%F %T')"; printf '%s\n' "$1"; } >>"$PUBLISH_LOG" 2>/dev/null || true
}
report_sync() {
    local msg; msg="$(unpublished_report "$@")"
    log_report "$msg"
    printf '%s\n' "$msg" >&2
}
report_async() {
    local msg; msg="$(unpublished_report "$@")"
    log_report "$msg"
    printf '%s\n' "$msg" >/dev/tty 2>/dev/null || true
}

# Publish the attestation in the background: the commit does not exist on the
# remote until the push we are gating actually lands.
publish_status() {
    local sha=$1
    if [ -n "${HUB_GATE_STATUS_CMD:-}" ]; then
        ( set -- "$sha"; eval "$HUB_GATE_STATUS_CMD" ) >/dev/null 2>&1 &
        return 0
    fi

    # Resolved SYNCHRONOUSLY and on purpose: this is the call that fails when the
    # active gh account cannot see the repo (Ioan carries one account per company,
    # each checkout its own), and a warning printed here lands while the human is
    # still watching the push, instead of behind their prompt two minutes later.
    if ! command -v gh >/dev/null 2>&1; then
        report_sync "gh is not on PATH, so nothing can attest this run" "" "$sha"
        return 0
    fi
    local repo rc err out="$STATE_DIR/.repo.$$"
    err="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>&1 1>"$out")"
    rc=$?
    repo="$(cat "$out" 2>/dev/null)"
    rm -f "$out"
    if [ "$rc" -ne 0 ] || [ -z "$repo" ]; then
        report_sync "the active gh account cannot resolve this repository" "$err" "$sha"
        return 0
    fi

    (
        # hub#574: the attestation is the CONSEQUENCE of the push landing. A
        # pre-push hook runs BEFORE the transfer, so it cannot know — instead,
        # this background step verifies the REMOTE REF really advanced to (or
        # past) the pushed sha before posting. "The commit exists on origin"
        # is not enough: the same sha may already be there from an earlier
        # push to another ref while THIS push died (SIGPIPE / exit 141 /
        # closed SSH — three sightings in one day, 2026-08-08).
        local tries=0 seen=0 perr poll_tries poll_delay
        poll_tries="${HUB_GATE_PUSH_POLL_TRIES:-24}"
        poll_delay="${HUB_GATE_PUSH_POLL_DELAY:-5}"
        landed() {
            local got cmpstat
            if [ -n "$pushed_ref" ]; then
                got="$(gh api "repos/$repo/git/ref/${pushed_ref#refs/}" -q .object.sha 2>/dev/null)" || return 1
                [ "$got" = "$sha" ] && return 0
                [ -n "$got" ] || return 1
                # The ref may have moved PAST our sha already (a fleet mate
                # pushed on top): landed means "the ref contains the sha".
                cmpstat="$(gh api "repos/$repo/compare/$sha...$got" -q .status 2>/dev/null)" || return 1
                [ "$cmpstat" = "ahead" ] || [ "$cmpstat" = "identical" ]
            else
                gh api "repos/$repo/commits/$sha" >/dev/null 2>&1
            fi
        }
        while [ "$tries" -lt "$poll_tries" ]; do
            landed && { seen=1; break; }
            sleep "$poll_delay"
            tries=$((tries + 1))
        done
        if [ "$seen" != 1 ]; then
            report_async "the remote ref ${pushed_ref:-?} never advanced to $sha — the push DID NOT LAND (SIGPIPE / closed SSH / killed process). Retry the push: the tree is cached green, so the retry is instant" "" "$sha" "$repo"
            exit 0
        fi
        if ! perr="$(gh api -X POST "repos/$repo/statuses/$sha" \
                -f state=success \
                -f context="$CONTEXT" \
                -f description="$GATE_DESC" \
                2>&1 >/dev/null)"; then
            report_async "gh refused to post the status to $repo" "$perr" "$sha"
            exit 0
        fi
        log_report "published $CONTEXT=success on $repo@$sha"
    ) >/dev/null 2>&1 &
    disown 2>/dev/null || true
}

if [ -f "$green" ]; then
    echo "✅ pre-push: this tree already passed the suite → skipping the rebuild." >&2
    publish_status "$pushed_sha"
    # Verde → se le encarga la review local del código a un revisor Fable. No corre
    # tests ni bloquea: el handoff sale 0 pase lo que pase, porque un gate roto
    # para a toda la flota y una review perdida solo cuesta una review.
    review_handoff="${ERPLORA_FLEET_DIR:-$HOME/.erplora/fleet}/pr-reviewer-handoff.sh"
[ -x "$review_handoff" ] && "$review_handoff" "$pushed_ref" "$pushed_sha" >/dev/null 2>&1
    exit 0
fi

# ── hub#855 (P0): test the tree you attest ───────────────────────────────────
# The suite below runs on the WORKING TREE, while the cache key and the
# attestation name the PUSHED sha. If they are not the same content, a green
# here signs code that never ran — and records the lie as a `.green` everyone
# else will trust. It happens without malice: pushing another branch from a
# stacked worktree, pushing a tag from whatever checkout is current, or just
# a dirty tree. Since hub#854 removed Rust from CI, this gate is the ONLY
# Rust verification, so: refuse unless working tree == pushed tree.
# Trees, not shas — a reworded/rebased commit with identical content is fine.
# Untracked non-ignored files count: cargo compiles what is on disk.
# (A tree already recorded green is handled above: that content really ran.)
head_tree="$(git rev-parse 'HEAD^{tree}' 2>/dev/null)"
wt_status="$(git status --porcelain 2>/dev/null)"
if [ "$head_tree" != "$tree" ] || [ -n "$wt_status" ]; then
    {
        echo "❌ pre-push: REFUSING — this working tree is not the tree being pushed, so the"
        echo "   suite would test one thing and attest another (hub#855)."
        echo "     pushed sha   : $pushed_sha (tree ${tree:0:12})"
        echo "     HEAD tree    : ${head_tree:0:12}"
        if [ -n "$wt_status" ]; then
            echo "     dirty files  :"
            printf '%s\n' "$wt_status" | sed 's/^/       /' | head -10
        fi
        echo "   Push from a checkout sitting at that sha with a clean tree (commit or drop"
        echo "   local changes), or run the gate there first so the tree is proven green."
        echo "   Bypass (NOT attested): SKIP_HUB_TESTS=1 git push"
    } >&2
    exit 1
fi

# mkdir is atomic on every filesystem we care about; flock is not on macOS.
#
# hub#575: the lock knows its OWNER. A push killed mid-suite used to leave the
# bare directory behind, and every later push waited up to an hour for a dead
# owner — while the message claimed a suite was running. Worse, the manual
# remedy invited breaking a LIVE lock (two parallel suites = the hub#526
# failure this lock exists to prevent). So:
#   · the holder writes $LOCK/owner (pid + pushed sha + epoch);
#   · a waiter that finds the owner DEAD breaks the lock out loud;
#   · a lock with NO owner file is indistinguishable from a write in flight
#     (or a pre-hub#575 holder), so when in doubt we WAIT — conservative by
#     contract.
# `kill -0` also fails with EPERM on another user's PID; the installed hook is
# per-user (~/.erplora), so every legitimate holder is our own user.
LOCK="$STATE_DIR/lock"
lock_owner_field() { sed -n "s/^$1=//p" "$LOCK/owner" 2>/dev/null; }
write_lock_owner() {
    {
        echo "pid=$$"
        echo "sha=$pushed_sha"
        echo "since=$(date +%s 2>/dev/null || echo '')"
    } > "$LOCK/owner" 2>/dev/null || true
}
lock_wait="${HUB_GATE_LOCK_WAIT:-3600}"
# hub#788: the connection must outlive the wait — cap the wait, never trust
# the connection. Two cases:
#   · protected (keepalive was active when git opened the connection): keep
#     lock_wait strictly BELOW the keepalive margin;
#   · unprotected (keepalive just installed, or absent): GitHub will close the
#     idle connection long before an hour — fail fast with a retry message
#     instead of dying mid-transfer in silence.
if [ "$SSH_PROTECTED" = 1 ]; then
    margin="$(ssh_keepalive_margin)"
    if [ -n "$margin" ] && [ "$lock_wait" -ge "$margin" ] 2>/dev/null; then
        clamped=$((margin / 2))
        echo "⚠️  pre-push: HUB_GATE_LOCK_WAIT (${lock_wait}s) ≥ SSH keepalive margin (${margin}s) — clamped the wait to ${clamped}s so the connection outlives it (hub#788)." >&2
        lock_wait=$clamped
    fi
else
    unprotected_wait="${HUB_GATE_UNPROTECTED_LOCK_WAIT:-240}"
    if [ "$lock_wait" -gt "$unprotected_wait" ] 2>/dev/null; then
        echo "⚠️  pre-push: this push's SSH connection has NO keepalive — capping the lock wait at ${unprotected_wait}s. If it times out, just retry: the next connection is protected (hub#788)." >&2
        lock_wait=$unprotected_wait
    fi
fi
waited=0
announced=0
while ! mkdir "$LOCK" 2>/dev/null; do
    owner_pid="$(lock_owner_field pid)"
    if [ -n "$owner_pid" ] && ! kill -0 "$owner_pid" 2>/dev/null; then
        # Re-read right before breaking: the lock may have just changed hands.
        # The window between this check and the mv is small and the direction
        # of the remaining race is a broken FRESH lock, which the new holder's
        # own mkdir loop recovers from — never two suites at once.
        [ "$(lock_owner_field pid)" = "$owner_pid" ] || continue
        echo "🧹 pre-push: the gate lock is ORPHANED — its owner (PID $owner_pid) is dead. Breaking it." >&2
        stale="$LOCK.stale.$$"
        if mv "$LOCK" "$stale" 2>/dev/null; then
            rm -rf "$stale" 2>/dev/null || true
        fi
        continue
    fi
    if [ "$waited" -ge "$lock_wait" ]; then
        echo "❌ pre-push: the gate lock has been held for ${lock_wait}s by PID ${owner_pid:-unknown}," >&2
        if [ -n "$owner_pid" ]; then
            echo "   which is still ALIVE — most likely a real suite. Retry later, or if you are" >&2
            echo "   CERTAIN it is stuck, remove the lock by hand:  rm -rf '$LOCK'" >&2
        else
            echo "   whose owner file is missing (pre-hub#575 lock?). Check for a running suite" >&2
            echo "   first; only then remove it by hand:  rm -rf '$LOCK'" >&2
        fi
        exit 1
    fi
    if [ "$announced" = 0 ]; then
        since="$(lock_owner_field since)"
        held=""
        now="$(date +%s 2>/dev/null || echo '')"
        case "$since$now" in *[!0-9]*|'') ;; *) [ -n "$since" ] && [ -n "$now" ] && held=$((now - since)) ;; esac
        echo "⏳ pre-push: another push is running the suite (PID ${owner_pid:-unknown}${held:+, holding for ${held}s}) — waiting up to ${lock_wait}s…" >&2
        announced=1
    fi
    sleep 2
    waited=$((waited + 2))
done
write_lock_owner
# Release only OUR lock: if someone wrongly broke ours and a new holder took
# over, their owner pid differs and we must not delete their lock.
trap 'p="$(lock_owner_field pid)"; if [ -z "$p" ] || [ "$p" = "$$" ]; then rm -rf "$LOCK" 2>/dev/null || true; fi' EXIT

# Whoever held the lock may have just turned this very tree green.
if [ -f "$green" ]; then
    echo "✅ pre-push: another push just validated this tree → skipping the rebuild." >&2
    publish_status "$pushed_sha"
    # Verde → se le encarga la review local del código a un revisor Fable. No corre
    # tests ni bloquea: el handoff sale 0 pase lo que pase, porque un gate roto
    # para a toda la flota y una review perdida solo cuesta una review.
    review_handoff="${ERPLORA_FLEET_DIR:-$HOME/.erplora/fleet}/pr-reviewer-handoff.sh"
[ -x "$review_handoff" ] && "$review_handoff" "$pushed_ref" "$pushed_sha" >/dev/null 2>&1
    exit 0
fi

# The module e2e — the ones that install the real modules — are the one place where "run what CI
# ran" needs saying out loud, because `test-hub.yml` does NOT run them: the guard sees `CI=true`
# and takes a legitimate skip (hub#253). They run in `test-hub-modules.yml`, against the PUBLISHED
# catalogue, and that is the shape this gate has to reproduce or stay quiet about.
#
# Default is therefore parity with `test-hub.yml`: skip. `HUB_GATE_WITH_MODULES=1` opts into the
# stricter run.
#
# ── hub#1153: WHICH modules, and why it is not the sibling checkout ──────────
# This used to export `ERPLORA_MODULES_DIR=<monorepo>/modules-workspace/modules`, i.e. whatever
# branch the last agent left each module on — 9 of 27 were off `main` on 2026-08-28. A gate whose
# verdict depends on that is a raffle, and it fails in BOTH directions: a module BEHIND reds a push
# that did not cause it (`sales_e2e`: 4 operations vs 5, several half-hour diagnoses), a module
# AHEAD greens a contract that already moved in production (hub#540) — the expensive one, because
# nothing looks wrong.
#
# So the catalogue is MATERIALISED from each module's `origin/main` into a cache under $STATE_DIR,
# by `scripts/materialize-published-modules.sh` — the SAME script `test-hub-modules.yml` runs, so
# the local gate and the "crater/runbot" job cannot drift apart (the Postgres config living in
# three copies already cost `main` once, hub#647). `modules-workspace` is still consulted, but
# ONLY for the module ids and their remote URLs; its content never reaches the suite. Pulling or
# resetting it is not an option either way — those checkouts hold other agents' unpushed commits.
#
# The failure is LOUD, never a downgrade: opting in is a request for the published catalogue, and
# a run that silently skipped the module e2e would be a green that proved nothing — the very hole
# this closes. Contract: `architecture/hub/kernel-contract.md` §6 hole #2 (ADR «El Hub se CIERRA
# como KERNEL», 2026-08-27).
#
# Escape hatches, both documented: `ERPLORA_MODULES_DIR` set by hand still wins (debugging a tree),
# and dropping `HUB_GATE_WITH_MODULES` goes back to CI parity.
MODULES_FLOOR="${HUB_GATE_MODULES_FLOOR:-25}"
resolve_modules_dir() {
    # Por defecto SÍ (Ioan, 2026-08-29): `test-hub-modules.yml` ya no corre en las PRs, así que si
    # el gate se saltara los e2e de módulos no los correría NADIE — y esa es exactamente la vía por
    # la que una PR del kernel rompe un módulo en producción. Medido el 29/08 sobre develop limpio:
    # 30 binarios, 1 365 tests, 0 fallos, 5m07s (hub#1353). `HUB_GATE_WITH_MODULES=0` los salta a
    # sabiendas — y como cualquier salto, deja el push sin atestiguar más abajo.
    if [ "${HUB_GATE_WITH_MODULES:-1}" != "1" ]; then
        export ERPLORA_E2E_ALLOW_SKIP=1
        return 0
    fi
    if [ -n "${ERPLORA_MODULES_DIR:-}" ]; then
        echo "ℹ️  pre-push: ERPLORA_MODULES_DIR is set by hand ($ERPLORA_MODULES_DIR) → using it as-is." >&2
        return 0
    fi

    # The id source. The relative path only resolves from a checkout inside the monorepo and the
    # fleet works out of /private/tmp worktrees, so it is resolved here rather than left to luck.
    local ids_from="" candidate
    for candidate in \
        "$(git rev-parse --show-toplevel)/../modules-workspace/modules" \
        "${HOME:-}/workspace/code/ERPlora/modules-workspace/modules"
    do
        if [ -d "$candidate" ]; then
            ids_from="$(cd "$candidate" && pwd -P)"
            break
        fi
    done

    local dest="$STATE_DIR/modules-main" cmd
    if [ -n "${HUB_GATE_MATERIALIZE_CMD:-}" ]; then
        cmd="$HUB_GATE_MATERIALIZE_CMD"
    else
        local script
        script="$(git rev-parse --show-toplevel)/scripts/materialize-published-modules.sh"
        if [ ! -f "$script" ]; then
            echo "❌ pre-push: HUB_GATE_WITH_MODULES=1 but scripts/materialize-published-modules.sh is not in this checkout." >&2
            echo "   Without it the only catalogue available is the PARKED modules-workspace, and measuring" >&2
            echo "   against that is what hub#1153 abolished. Update the branch, or drop HUB_GATE_WITH_MODULES." >&2
            return 1
        fi
        cmd="bash \"$script\""
    fi

    local args="--dest \"$dest\" --floor \"$MODULES_FLOOR\""
    [ -n "$ids_from" ] && args="$args --ids-from \"$ids_from\""

    echo "📦 pre-push: materialising the PUBLISHED module catalogue into $dest (hub#1153)…" >&2
    local resolved
    if ! resolved="$(eval "$cmd $args")" || [ -z "$resolved" ]; then
        echo "" >&2
        echo "❌ pre-push: the PUBLISHED module catalogue could not be materialised → push ABORTED." >&2
        echo "   HUB_GATE_WITH_MODULES=1 asks for the published catalogue; running the suite without it" >&2
        echo "   would skip the module e2e in silence and report a green that proved nothing (hub#1153)." >&2
        echo "   Fix the access above, or push without HUB_GATE_WITH_MODULES for the usual CI parity." >&2
        return 1
    fi
    ERPLORA_MODULES_DIR="$resolved"
    export ERPLORA_MODULES_DIR
}
resolve_modules_dir || exit 1

# A `resolve_blueprints_dir` used to sit here: `sector_packs_pg_e2e` read its sector seeds out of
# the sibling `blueprints` checkout, those two tests have no opt-in, and from a /private/tmp
# worktree — where the whole fleet works — the relative path missed and the gate died with
# "no se pudo leer …/seed.sql" on EVERY gated push. hub#1050 moved the seeds into this repo
# (`crates/runtime/tests/fixtures/sector_pack_es/`), so there is nothing left to locate and nothing
# left to red-line. `modules-workspace` is still a sibling repo and keeps its resolver above.

if [ -n "${HUB_GATE_TEST_CMD:-}" ]; then
    test_cmd="$HUB_GATE_TEST_CMD"
else
    ensure_postgres || exit 1
    command -v cargo >/dev/null 2>&1 || {
        echo "❌ pre-push: 'cargo' is not on PATH." >&2
        exit 1
    }
    if [ "$SCOPE_MODE" = packages ]; then
        # `--no-fail-fast` for the same reason as the workspace run: without it
        # cargo stops at the first failing binary and reports one failure when
        # there may be twenty.
        test_cmd="cargo test"
        for _p in $SCOPE_PACKAGES; do test_cmd="$test_cmd -p $_p"; done
        test_cmd="$test_cmd --no-fail-fast"
    else
        test_cmd="cargo test --workspace --no-fail-fast --exclude erplora-tauri --exclude tauri-plugin-erplora-android"
    fi
fi

if [ "$SCOPE_MODE" = packages ]; then
    echo "🧪 pre-push: running $GATE_CMD_LABEL locally — the FULL suite runs on the PR (test-hub.yml)…" >&2
else
    echo "🧪 pre-push: running the whole Hub suite locally ($SCOPE_REASON)…" >&2
fi
if ! eval "$test_cmd"; then
    echo "" >&2
    echo "❌ pre-push: the Hub suite is RED → push ABORTED." >&2
    echo "   Fix it and retry, or bypass with 'SKIP_HUB_TESTS=1 git push'." >&2
    exit 1
fi

run_web_stage || exit 1

# Saltarse la etapa web deja pasar el push, pero ni cachea el verde ni atestigua: la atestación
# es lo que `merge-pr.sh` usa para autorizar el merge, y firmar lo que no se ha corrido es
# exactamente la razón por la que dejó de aceptarla en su día. Sin sello, no hay merge.
if [ "${WEB_SKIPPED:-0}" = 1 ]; then
    echo "⚠️  pre-push: la suite Rust está verde, pero como la etapa web se saltó NO se atestigua." >&2
    echo "   Este push no autoriza ningún merge: corre el gate entero (sin SKIP_HUB_WEB) y reempuja." >&2
    exit 0
fi

: > "$green"
# hub#574: attest the TEST, never claim the push — this line used to say
# "→ pushing, and attesting it", and workers read it while the transfer died
# behind it (SIGPIPE/closed SSH) with the branch never reaching origin.
echo "✅ pre-push: suite green → letting the push proceed. The $CONTEXT status posts only after the ref is verified on origin." >&2
publish_status "$pushed_sha"
# Verde → se le encarga la review local del código a un revisor Fable. No corre
# tests ni bloquea: el handoff sale 0 pase lo que pase, porque un gate roto
# para a toda la flota y una review perdida solo cuesta una review.
review_handoff="${ERPLORA_FLEET_DIR:-$HOME/.erplora/fleet}/pr-reviewer-handoff.sh"
[ -x "$review_handoff" ] && "$review_handoff" "$pushed_ref" "$pushed_sha" >/dev/null 2>&1
exit 0
