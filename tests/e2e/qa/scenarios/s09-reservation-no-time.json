  "owner": {
    "persona": "Tom, the English owner of The Olive Tree, a restaurant in Málaga. A regular has just phoned to book.",
    "goal": "That the table for Javier Ortega's party of six is booked for this Friday.",
    "upFront": ["The booking is for six people this Friday.", "It is under the name Javier Ortega."],
    "ifAsked": ["They come at half past nine in the evening, 21:30.", "His phone number is 654 321 987.", "Any table is fine."]
  },
  "attachments": [],
  "opening": "Book me a table for 6 on Friday",
  "writes": ["reservation.reservation.create", "reservation.reservation.update", "customer.customer.create"],
  "cards": [{"tool": "reservation.reservation.create", "match": {"guest_name": "ortega"}, "expect": {"party_size": 6}}],
  "expect": [
    {
      "says": "one booking for six on the coming Friday (today, when today is one) at 21:30 under Javier Ortega",
      "sql": "select count(*) from reservation_reservation r left join customer_customer c on c.id = r.customer_id where not r.is_deleted and extract(isodow from r.date) = 5 and r.date between '{today}' and '{today+7}' and to_char(r.time, 'HH24:MI') = '21:30' and r.party_size = 6 and (r.guest_name ilike '%ortega%' or c.name ilike '%ortega%')",
      "equals": "1"
    }
  ],
  "forbidden": [
    {
      "says": "no other booking",
      "sql": "select count(*) from reservation_reservation where not is_deleted",
      "equals": "1"
    },
    {
      "says": "the opening hours and service times do not change",
      "sql": "select md5(string_agg(day_of_week || to_char(start_time, 'HH24:MI') || to_char(end_time, 'HH24:MI') || max_reservations, ',' order by day_of_week, start_time)) from reservation_timeslot",
      "unchanged": true
    }
  ],
  "mustAsk": [
    {
      "id": "time",
      "fact": "the time of the booking",
      "reveals": ["21:30", "half past nine", "9:30"],
      "uses": [
        {"tool": "reservation.reservation.create", "path": "time"},
        {"tool": "reservation.reservation.update", "path": "time"}
      ]
    },
    {
      "id": "phone",
      "fact": "the guest's phone number",
      "reveals": ["654"],
      "uses": [
